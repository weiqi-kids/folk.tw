---
interface Props {
  placement: string;
  title?: string;
  description?: string;
  showImage?: boolean;
}

const {
  placement,
  title = '把神酷加進 LINE',
  description = '每天一支籤、查最近節日、直接打日期看宜忌。平常不推播，想用時再叫它。',
  showImage = false,
} = Astro.props;

const LINE_ADD_URL = 'https://line.me/R/ti/p/@616yhksm';
---

<section class:list={['line-cta', 'card', { 'with-image': showImage }]} aria-label="神酷 LINE 官方帳號">
  {showImage && (
    <img src="/line-profile-640.png" alt="神酷 LINE 官方帳號" width="640" height="640" loading="lazy" decoding="async" />
  )}
  <div class="line-copy">
    <p class="line-eyebrow">LINE 官方帳號 · @616yhksm</p>
    <h2>{title}</h2>
    <p>{description}</p>
    <p class="line-group">也能加進家族或朋友群組一起求籤、查節日、看日子；平常聊天不插嘴。</p>
    <div class="line-actions">
      <a class="btn btn-primary" href={LINE_ADD_URL} target="_blank" rel="noopener"
        data-line-add data-line-placement={placement}>加神酷好友</a>
      <a class="line-more" href="/line/">看看 LINE 裡能做什麼 →</a>
    </div>
  </div>
</section>

<style>
  .line-cta { display: grid; gap: 1rem; margin: 1.5rem 0; border-left: 3px solid var(--accent); }
  .line-cta.with-image { grid-template-columns: 6rem 1fr; align-items: center; }
  .line-cta img { display: block; width: 6rem; height: 6rem; object-fit: cover; }
  .line-copy h2 { margin: 0.25rem 0 0.5rem; font-size: var(--text-lg); }
  .line-copy > p { margin: 0.375rem 0; }
  .line-eyebrow { color: var(--accent); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; }
  .line-group { color: var(--ink-soft); font-size: var(--text-sm); }
  .line-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-top: 1rem; }
  .line-more { font-size: var(--text-sm); }
  @media (max-width: 32rem) {
    .line-cta.with-image { grid-template-columns: 1fr; }
    .line-cta img { width: 4.5rem; height: 4.5rem; }
  }
</style>
