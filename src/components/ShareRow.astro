---
// 全站分享列（Base.astro 於 footer 內渲染；404 等頁可用 share={false} 關掉）。
//
// 🔴 為什麼是「一顆系統分享鈕＋兩個 intent」而不是三顆平行按鈕：
//    **Instagram 沒有網頁分享 API**——不像 Facebook 的 sharer.php 或 Threads 的 intent/post，
//    IG 無法用「開一個網址」把內容貼進動態。唯一能到 IG 的路徑是行動裝置的系統分享匣
//    （navigator.share），由使用者自己在匣裡選 Instagram。
//    所以版面是：能叫出系統分享匣就讓它當主鈕（IG／Threads／LINE 全在裡面），
//    叫不出來（多數桌機瀏覽器）就由「複製連結」遞補當主鈕。
//
// 🔴 markup 全部靜態、JS 只切 `hidden` 屬性與 class／文字，**不注入任何 DOM**：
//    Astro 的 scoped `<style>` 套不到 JS 注入的節點（記憶 astro-scoped-style-innerhtml-pitfall），
//    注入式寫法會靜默失樣。同理，分享鈕在沒有 JS 的環境也要是可用的連結（FB／Threads 是 <a>）。
//
// 2026-08-08 改版（用戶回報「分享做得超醜」）：原本四顆同權重的灰框鈕並排，沒有主次，
//    使用者不知道該點哪個；「分享到…」這個字面也沒說要分享到哪，偏偏它才是唯一能到 IG 的路徑。
//    現在：**永遠只有一顆主鈕**（有 navigator.share → 實心朱紅「分享」；沒有 → 「複製連結」遞補），
//    其餘降成低調的次鈕。複製成功不再只換字，會同時進入 .done 狀態給顏色回饋。
//    另外拿掉本元件自己的 border-top——它和 site-footer 的 border-top 只差約 40px，
//    每一頁結尾都出現兩條平行細線；現在分隔線只由 footer 出一條（見 Base.astro）。
//
// ⚠️ 分享出去長什麼樣由 og:image 決定，不由本元件決定。廟宇／籤詩／神明頁各有專屬卡，
//    其餘頁面仍是全站品牌卡 `public/og.png`。
interface Props {
  /** 分享標題（不給則由頁面 og 標題帶入）。 */
  title: string;
  /** 正規網址（絕對）。 */
  url: string;
}
const { title, url } = Astro.props;

const fb = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
// Threads 的 intent 只吃 text，故把標題與網址併成一段。
const threads = `https://www.threads.net/intent/post?text=${encodeURIComponent(`${title} ${url}`)}`;
---

<aside class="share" aria-label="分享這一頁" data-pagefind-ignore>
  <div class="share-btns">
    {/* 系統分享匣：唯一能到 Instagram 的路徑。無 navigator.share 的環境由 inline script 隱藏，
        並把 .share-copy 升為主鈕（加上 .primary）。 */}
    <button type="button" class="share-btn primary share-native" data-share-native data-share-method="native" hidden
      data-title={title} data-url={url}>分享</button>
    <button type="button" class="share-btn share-copy" data-share-copy data-share-method="copy" data-url={url}>
      <span data-copy-label>複製連結</span>
    </button>
    <a class="share-btn" href={fb} data-share-method="facebook" data-url={url} target="_blank" rel="noopener nofollow">Facebook</a>
    <a class="share-btn" href={threads} data-share-method="threads" data-url={url} target="_blank" rel="noopener nofollow">Threads</a>
  </div>
</aside>

<script is:inline>
  (() => {
    const trackShare = (method, url) => {
      if (typeof window.gtag !== 'function') return;
      let itemId = url;
      try { itemId = new URL(url).pathname; } catch { /* 保留原值 */ }
      window.gtag('event', 'share', { method, content_type: 'page', item_id: itemId });
    };
    // 系統分享匣有支援才顯示那顆鈕（桌機多數瀏覽器沒有）；沒有的話讓「複製連結」遞補當主鈕，
    // 版面上永遠恰好有一顆主鈕，不會出現一排同權重的灰框。
    if (navigator.share) {
      for (const b of document.querySelectorAll('[data-share-native]')) b.hidden = false;
    } else {
      for (const b of document.querySelectorAll('[data-share-copy]')) b.classList.add('primary');
    }
    document.addEventListener('click', async (e) => {
      const nativeBtn = e.target.closest?.('[data-share-native]');
      if (nativeBtn) {
        try {
          await navigator.share({ title: nativeBtn.dataset.title, url: nativeBtn.dataset.url });
          trackShare('native', nativeBtn.dataset.url);
        } catch {
          /* 使用者取消分享會 reject，那不是錯誤，不要跳任何東西 */
        }
        return;
      }
      const copyBtn = e.target.closest?.('[data-share-copy]');
      if (!copyBtn) return;
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.url);
        trackShare('copy', copyBtn.dataset.url);
        const label = copyBtn.querySelector('[data-copy-label]');
        if (!label || copyBtn.classList.contains('done')) return;
        const before = label.textContent;
        label.textContent = '已複製';
        copyBtn.classList.add('done');
        setTimeout(() => {
          label.textContent = before;
          copyBtn.classList.remove('done');
        }, 1600);
      } catch {
        /* 沒有剪貼簿權限就什麼都不做——網址列本來就看得到 */
      }
    });
    document.addEventListener('click', (e) => {
      const intent = e.target.closest?.('a[data-share-method]');
      if (intent) trackShare(intent.dataset.shareMethod, intent.dataset.url);
    });
  })();
</script>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem 1rem; }
  .share-btns { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.625rem; }
  /* 🔴 `hidden` 必須自己擋掉 display（2026-08-08 實測抓到，且是舊有的病）：
     UA 樣式表給 [hidden] 的 display:none 會被**任何**作者端 display 宣告蓋掉，
     原本 `.share-btn { display: inline-block }` 就已經讓那顆「分享到…」在沒有
     navigator.share 的桌機上照樣顯示——版面因此永遠是四顆鈕，主鈕邏輯等於沒生效。 */
  .share-btn[hidden] { display: none; }
  .share-btn {
    display: inline-flex; align-items: center; gap: 0.4em;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--ink-soft);
    font-family: inherit;
    font-size: var(--text-xs);
    line-height: var(--lh-tight);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }
  .share-btn:hover {
    border-color: var(--accent-soft);
    color: var(--accent);
    text-decoration: none;
  }
  /* 主鈕：實心朱紅，一眼看得出要點哪個。同一時間只會有一顆（見上方 script）。 */
  .share-btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper-2);
    font-weight: 700;
  }
  .share-btn.primary:hover {
    background: var(--accent-soft);
    border-color: var(--accent-soft);
    color: var(--paper-2);
  }
  /* 複製成功：不只換字，連顏色一起給回饋。 */
  .share-btn.done {
    border-color: var(--ok-green);
    color: var(--ok-green);
    background: transparent;
  }
  .share-btn.done.primary { background: var(--ok-green); border-color: var(--ok-green); color: var(--paper-2); }
</style>
