---
// 正文主視覺的共用入口：資料型照片沿用 image-credit 的授權標示；站內自製 SVG 不需署名。
// 這裡只負責呈現，不把圖片升格為 og:image（分享卡仍由 Base 的 ogImage 決定）。
import { imageCredit, imageCreditTitle, type ImageMeta } from '../lib/image-credit';

interface Props {
  src?: string;
  alt?: string;
  image?: ImageMeta;
  eager?: boolean;
}

const { src, alt, image, eager = true } = Astro.props;
const actualSrc = image?.src ?? src;
const actualAlt = image?.alt ?? alt ?? '';
if (!actualSrc) throw new Error('LeadVisual 需要 src 或 image');
const credit = image ? imageCredit(image) : null;
---

<figure class="lead-visual">
  <img
    src={actualSrc}
    alt={actualAlt}
    title={image ? imageCreditTitle(image) : undefined}
    width="1200"
    height="630"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
  {credit && (
    <figcaption>
      {credit.href ? <a href={credit.href} rel="nofollow noopener" target="_blank">{credit.text}</a> : credit.text}
    </figcaption>
  )}
</figure>

<style>
  .lead-visual {
    margin: 1rem 0 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    background: var(--paper-2);
  }
  .lead-visual img {
    display: block;
    width: 100%;
    aspect-ratio: 40 / 21;
    object-fit: cover;
  }
  .lead-visual figcaption {
    padding: 0.4rem 0.75rem;
    color: var(--ink-soft);
    font-size: var(--text-xs);
  }
  .lead-visual figcaption a { color: inherit; }
</style>
