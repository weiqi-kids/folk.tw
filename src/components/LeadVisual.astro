---
// 正文主視覺的共用入口：資料型照片沿用 image-credit 的授權標示；站內自製 SVG 不需署名。
// 這裡只負責呈現，不把圖片升格為 og:image（分享卡仍由 Base 的 ogImage 決定）。
// 🔴 尺寸是配角（2026-08-16 用戶裁示，全站統一）：一律 min(100%, 20rem)，不得滿版——
// 滿版主視覺會把正文與行動按鈕推離首屏（qiugian 先被抓，後確認 good-days／systems
// 等 30 個使用點同病）。`compact` 現在只差在 margin（供 qiugian 樞紐的並排格用），
// 尺寸兩者相同；要恢復滿版是設計決策，先問用戶。
import { imageCreditTitle, type ImageMeta } from '../lib/image-credit';
import ImageCredit from './ImageCredit.astro';
import { visualSvgPath, type VisualStem } from '../lib/page-head';

interface Props {
  /**
   * 站內通用視覺（`/visuals/<stem>.svg`）。**與 Base 的 `og={{ family: 'visual', stem }}`
   * 吃同一個 `VisualStem`**：頁面只宣告一次 stem，正文主視覺與分享圖就不可能指到兩張不同的圖。
   * 重構前這兩處是毫無關聯的字串字面值（`/visuals/qian-slips.svg` vs `/og/discover/qian-slips.webp`）。
   */
  visual?: VisualStem;
  src?: string;
  alt?: string;
  image?: ImageMeta;
  eager?: boolean;
  compact?: boolean;
}

const { visual, src, alt, image, eager = true, compact = false } = Astro.props;
const actualSrc = image?.src ?? (visual ? visualSvgPath(visual) : src);
const actualAlt = image?.alt ?? alt ?? '';
if (!actualSrc) throw new Error('LeadVisual 需要 src 或 image');
---

<figure class:list={['lead-visual', { compact }]}>
  <img
    src={actualSrc}
    alt={actualAlt}
    title={image ? imageCreditTitle(image) : undefined}
    width="1200"
    height="630"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
  {image && (
    <figcaption>
      <ImageCredit image={image} />
    </figcaption>
  )}
</figure>

<style>
  .lead-visual {
    width: min(100%, 20rem);
    margin: 1rem 0 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    background: var(--paper-2);
  }
  .lead-visual img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 40 / 21;
    object-fit: cover;
  }
  .lead-visual figcaption {
    padding: 0.4rem 0.75rem;
    color: var(--ink-soft);
    font-size: var(--text-xs);
  }
  /* <a> 由 ImageCredit 產生（帶的是它的 scope），故此處必須 :global，否則規則靜默失效。 */
  .lead-visual figcaption :global(a) { color: inherit; }
  .lead-visual.compact { margin: 0; }
</style>
