---
// 來源標示的**唯一渲染入口**：外層元素、空值判斷、class 與 CSS 全在這一支。
//
// 🔴 出處標示是授權義務（緣由見 src/lib/sources.ts 檔頭）。呼叫端**只選版型**，
//    不要自己再寫一次 `<p class="src">`、也不要自己再寫一次 `sources.length > 0`——
//    2026-08-19 重構前這兩件事被 20 個呼叫端各做一遍：外層元素在 p／div／span 之間游移、
//    `.src` 的 CSS 在 21 個檔裡長出 4 種互不相容的變體，而空值判斷本來就多餘
//    （本檔一向在 `parsed.length === 0` 時什麼都不畫）。
//
// 文字內容與分隔符自 2026-08-08 起一個字都沒動過（來源標示是授權條件，不動它）。
import { parseSourceRef, isSameOrigin, type SourceRef } from '../lib/sources';

/**
 * 版型＝呼叫端唯一要決定的事。
 * - `footer`   頁尾整段來源：`<p>`，與正文拉開距離、行距放寬（來源常有七八筆到十幾筆）。
 * - `block`    區塊內獨立的一段來源：`<p>`，緊接在它所標註的區塊之後。
 * - `attached` 貼著上一列的來源：`<div>`，**無上下外距**（用在清單列內，如神明頁的聖誕列）。
 * - `inline`   接在一句話後面的來源：`<span>`。
 * - `bare`     已經在別人的元素裡與其他文字混排（如 `<span class="muted small">　— …</span>`）：
 *              只出文字、不加外層、不套 `.src` 顏色，由那個元素自己決定樣子。
 */
type SourcesVariant = 'footer' | 'block' | 'attached' | 'inline' | 'bare';

interface Props {
  sources?: SourceRef[];
  /** 前導文字。預設「來源：」；`inline` 版型也拿它當前置分隔符（如「 · 」「（」）。 */
  prefix?: string;
  variant: SourcesVariant;
}

const TAG: Record<SourcesVariant, unknown> = {
  footer: 'p', block: 'p', attached: 'div', inline: 'span', bare: Fragment,
};

// ⚠️ 本 repo 的 `Astro.props` 型別是 Record<string, any>（實測 astro check 不會驗呼叫端的 props），
// 所以「版型必須指定」靠下面那行 runtime 守——漏傳會在 build 當場炸掉，不會安靜掉樣式。
const { sources = [], prefix = '來源：', variant } = Astro.props as Props;
if (!variant || !(variant in TAG)) throw new Error(`<Sources> 必須指定 variant（${Object.keys(TAG).join('／')}），收到：${variant}`);
const parsed = sources.map(parseSourceRef);

const Wrapper = TAG[variant] as 'p' | 'div' | 'span';
// Fragment 不吃 class；其餘版型統一由本檔的 scoped style 上色與排版。
const wrapperProps = variant === 'bare' ? {} : { class: `src src-${variant}` };
---
{parsed.length > 0 && (
  <Wrapper {...wrapperProps}>
    {prefix}
    {parsed.map((p, i) => (
      /* 2026-08-08：每筆包一層 span 並 inline-block——廟宇頁的來源常有七八筆、
         原本是一整條會在任意位置換行的灰字流水句，一筆來源被切成兩行的中間、
         讀者根本看不出一筆到哪裡結束。包起來之後換行只會發生在「筆與筆之間」。
         文字內容與分隔符完全沒動（來源標示是授權條件，不動它）。 */
      <span class="s">
        {i > 0 ? '；' : ''}
        {p.url ? (
          /* 🔴 2026-08-20：同源連結不加 nofollow／target="_blank"。
             這裡原本**無條件**當外部來源處理，而 festivals.json 有 46 筆 type:'site'
             的自我引用（`https://folk.tw/practices/...`）——等於我們對自己的內部連結
             下了 nofollow，還把自家頁面開在新分頁。兩者都是白白的自傷，
             而且**不會有任何 gate 紅燈**（check:anchor-text 驗的是可見文字）。
             判準用網址本身而不是 `type` 欄位：type 是人填的，網址是機器可驗的。 */
          isSameOrigin(p.url)
            ? <a href={p.url}>{p.label}</a>
            : <a href={p.url} rel="nofollow noopener" target="_blank">{p.label}</a>
        ) : (
          p.label
        )}
      </span>
    ))}
    {/* 尾綴（收尾的括號、同一段裡的補充句）；來源為空時整段連同尾綴一起不出現。 */}
    <slot />
  </Wrapper>
)}

<style>
  .s { display: inline-block; }
  /* 全站來源標示的單一樣式來源（--gold ＝ variables.css 註明的「出處／註記」色）。 */
  .src { color: var(--gold); font-size: var(--text-xs); }
  /* 頁尾那段常有十幾筆、必然多行，行距放寬（原本只有廟宇頁這麼做，收斂時全站採用）。 */
  .src-footer { margin-top: 2.5rem; line-height: 1.9; }
  /* 貼著上一列，不要 p 的預設上下外距。 */
  .src-attached { margin: 0; }
</style>
