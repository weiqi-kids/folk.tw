---
import type { PoemLocaleView } from '../lib/poem-locales';

interface Props {
  entries: PoemLocaleView[];
}

const { entries } = Astro.props;
const tabId = `poem-locale-${entries[0]?.sourceId ?? 'empty'}`;
---

{entries.length > 0 && (
  <section class="poem-locale-tabs" data-locale-tabs id={tabId}>
    <div class="locale-picker" role="tablist" aria-label="選擇語言">
      {entries.map((entry, index) => (
        <button
          type="button"
          role="tab"
          class="locale-tab"
          data-locale-tab={entry.code}
          aria-controls={`${tabId}-${entry.code}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          <span aria-hidden="true">{entry.flag}</span>
          <span>{entry.label}</span>
        </button>
      ))}
    </div>

    {entries.map((entry, index) => (
      <div
        id={`${tabId}-${entry.code}`}
        class="locale-panel"
        data-locale-panel={entry.code}
        role="tabpanel"
        aria-label={entry.label}
        hidden={index !== 0}
      >
        <div class="locale-lines">
          {entry.lines.map((line) => <p>{line}</p>)}
        </div>
      </div>
    ))}
  </section>
)}

<style>
  .poem-locale-tabs {
    margin: 1.25rem 0 1.75rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--paper-2);
  }
  .locale-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.625rem;
  }
  .locale-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.4rem 0.65rem;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    font: inherit;
    font-size: var(--text-sm);
  }
  .locale-tab:hover,
  .locale-tab:focus-visible {
    border-color: var(--accent-soft);
    color: var(--accent);
    outline: none;
  }
  .locale-tab[aria-selected='true'] {
    border-color: var(--accent);
    background: var(--paper);
    color: var(--ink);
    font-weight: 700;
  }
  .locale-panel {
    padding-top: 1rem;
  }
  .locale-lines {
    text-align: center;
    font-size: var(--text-lg);
    line-height: 1.9;
  }
  .locale-lines p {
    margin: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-locale-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-locale-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-locale-panel]')];

    const select = (code: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.localeTab === code;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.localePanel !== code;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.localeTab ?? ''));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const next = event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
        tabs[next].focus();
        select(tabs[next].dataset.localeTab ?? '');
      });
    });
  });
</script>
