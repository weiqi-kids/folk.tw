---
// 只接既有資料關係算出的 festival slug；元件本身不猜內容是否相關。
// build 時先輸出當日狀態，前端依台灣日期更新，數日未部署也不會顯示過期 CTA。
import { activeSeasonalCampaign, seasonalCampaigns } from '../lib/seasonal-campaigns';
import { todayInTaipei } from '../lib/daily';

interface Props { festivalSlugs: string[] }

const related = new Set(Astro.props.festivalSlugs);
const campaigns = seasonalCampaigns.filter((x) => related.has(x.festivalSlug));
const active = activeSeasonalCampaign(todayInTaipei().iso, campaigns);
const initial = active ?? campaigns[0];
---

{campaigns.length > 0 && initial && (
  <aside class="related-seasonal card" data-related-seasonal hidden={!active}>
    <p class="kicker" data-related-campaign-date>{initial.dateLabel}・當期節慶</p>
    <h2><a href={initial.href} data-related-campaign-link
      data-growth-campaign={initial.festivalSlug} data-growth-placement="related_title">{initial.title}</a></h2>
    <p data-related-campaign-prompt>{initial.prompt}</p>
    <p class="cta"><a href={initial.href} data-related-campaign-cta
      data-growth-campaign={initial.festivalSlug} data-growth-placement="related_cta">{initial.cta}</a></p>
    <script
      is:inline
      type="application/json"
      data-related-campaign-source
      set:html={JSON.stringify(campaigns).replace(/</g, '\\u003c')}
    />
    <script is:inline>
      (() => {
        const runtime = document.currentScript;
        const root = runtime?.closest('[data-related-seasonal]');
        const source = root?.querySelector('[data-related-campaign-source]');
        if (!root || !source) return;
        const parts = new Intl.DateTimeFormat('en', {
          timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit',
        }).formatToParts(new Date());
        const value = (type) => parts.find((part) => part.type === type)?.value;
        const today = `${value('year')}-${value('month')}-${value('day')}`;
        const items = JSON.parse(source.textContent || '[]');
        const current = items.find((item) => item.start <= today && today <= item.end);
        root.hidden = !current;
        if (!current) return;
        root.querySelector('[data-related-campaign-date]').textContent = `${current.dateLabel}・當期節慶`;
        const titleLink = root.querySelector('[data-related-campaign-link]');
        titleLink.textContent = current.title;
        titleLink.setAttribute('href', current.href);
        titleLink.setAttribute('data-growth-campaign', current.festivalSlug);
        root.querySelector('[data-related-campaign-prompt]').textContent = current.prompt;
        const ctaLink = root.querySelector('[data-related-campaign-cta]');
        ctaLink.textContent = current.cta;
        ctaLink.setAttribute('href', current.href);
        ctaLink.setAttribute('data-growth-campaign', current.festivalSlug);
      })();
    </script>
  </aside>
)}

<style>
  .related-seasonal {
    margin: 1.25rem 0 1.75rem; padding: 1rem 1.25rem;
    border-left: 0.3rem solid var(--accent);
  }
  .related-seasonal[hidden] { display: none; }
  .kicker { margin: 0; color: var(--gold); font-size: var(--text-xs); font-weight: 700; }
  h2 { margin: 0.35rem 0; font-size: var(--text-lg); }
  .related-seasonal > p:not(.kicker, .cta) { margin: 0.35rem 0; color: var(--ink-soft); }
  .cta { margin: 0.5rem 0 0; font-weight: 700; }
</style>
