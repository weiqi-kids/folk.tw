---
// 全站共用版面。設計：考據領銜、克制；四句/典故/白話為主角，吉凶輔標小（§0.5）。
interface Props {
  title?: string;
  description?: string;
  ogTitle?: string; // 社群分享專用標題（不給則同 fullTitle）。廟宇頁傳「廟名・縣市鄉鎮」＝不帶站名。
  ogImage?: string; // 社群分享圖（相對路徑，如 '/og/temples/<id>.png'）；不給則用全站預設 og.png
  ogImageAlt?: string; // 分享圖替代文字；不給則用全站預設
  jsonLd?: object | object[]; // 每頁實體結構化資料（BreadcrumbList / Thing / CreativeWork…）
  noindex?: boolean; // 對搜尋引擎不索引（如農民曆滾動日期頁，避免視窗滾動後 404 與薄內容稀釋）
  ogType?: string; // Open Graph 類型；列表／首頁用 'website'，內容／詳情頁傳 'article'
  speakable?: string[]; // AEO：可朗讀／可被語音助理與 AI 答案引擎擷取為直接答案的元素 CSS 選擇器（如 ['h1', '.summary']）
  canonical?: string; // canonical override（相對路徑，如 '/almanac/'）；不給則以本頁路徑自我 canonical。用於鏡像頁指回正本。
}
import { GA4_ID } from '../consts';
import goodDaysData from '../data/good-days.json'; // nav「看日子」小段由資料驅動，勿硬編（見下方 nav 註解）
import concernsData from '../data/concerns.json'; // nav「線上求籤」小段（依 GA 流量排序，見下方 nav 註解）
import systemsData from '../data/divination-systems.json'; // nav「解籤」小段
import '../styles/global.css'; // 統一設計 token（OKLCH 配色＋字級階梯＋放大基準字）
// ogType 預設 'website'；內容／詳情頁（如籤詩、神明、農民曆日期頁）請傳 'article'
const { title, description, ogTitle, ogImage, ogImageAlt, jsonLd: pageJsonLd, noindex, ogType = 'website', speakable, canonical: canonicalOverride } = Astro.props;
const pageLd = pageJsonLd ? (Array.isArray(pageJsonLd) ? pageJsonLd : [pageJsonLd]) : [];
const siteName = '神酷';
// 瀏覽器標題（SEO）：首頁用品牌＋三大核心；內頁用「頁名｜神酷」
const fullTitle = title
  ? `${title}｜${siteName}`
  : '神酷｜台灣民俗信仰資料庫、籤詩解讀與神明關係圖譜';
const ogFullTitle = ogTitle ?? fullTitle; // OG 標題（社群分享）
const desc = description ?? '神酷（神庫）：台灣民俗信仰知識系統——籤詩解讀、神明關係圖譜、廟宇文化與農民曆，逐條掛來源、諸說並陳。';
const canonical = new URL(canonicalOverride ?? Astro.url.pathname, Astro.site ?? 'https://folk.tw').href;
// 社群分享圖：預設全站品牌卡；廟宇頁改傳自己那張（外撥把廟宇連結傳給廟方時，
// 主委看到的應是自己的廟名，而不是神酷的招牌——2026-07-30 用戶指示）。
const SITE_ORIGIN = 'https://folk.tw';
const ogImageUrl = ogImage ? `${SITE_ORIGIN}${ogImage}` : `${SITE_ORIGIN}/og.png`;
const ogImageAltText = ogImageAlt ?? '神酷（神庫）— 台灣民俗信仰知識系統';
// Schema.org：以「知識系統 / 資料庫」呈現（非單純 website），利 AI 理解與引用（GEO）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '神酷（神庫）— 台灣民俗信仰知識系統',
  alternateName: ['神酷', '神庫', 'Shenku (Taiwan Folk Knowledge Graph System)'],
  url: 'https://folk.tw',
  description:
    'A structured knowledge system for Taiwanese folk beliefs, including deity relationships, divination poems, temple culture, and ritual traditions.（台灣民俗信仰結構化知識系統：神明關係、籤詩解讀、廟宇文化、科儀傳統）',
  inLanguage: 'zh-Hant-TW',
  about: [
    'Taiwan folk religion',
    'divination poetry interpretation',
    'deity relationship graph',
    'temple culture knowledge base',
    'folk tradition archive',
  ],
  keywords: ['月老籤', '媽祖', '王爺', '籤詩', '台灣民俗', '農民曆'],
  creator: { '@type': 'Organization', name: '神酷', alternateName: '神庫' },
  license: 'https://github.com/weiqi-kids/folk.tw/blob/main/LICENSE',
};
// WebSite + SearchAction：宣告站內全文檢索端點，利 Google 顯示 sitelinks 搜尋框（搭配 /search?q=）。
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: ['神酷', '神庫'],
  url: 'https://folk.tw',
  inLanguage: 'zh-Hant-TW',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://folk.tw/search/?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
// speakable（AEO）：宣告頁面最適合被語音助理朗讀／AI 答案引擎擷取為直接答案的區塊（answer-first）。
// 僅內容詳情頁傳入；cssSelector 指向實際存在之標題與摘要元素（不存在則消費端自動略過，無害）。
const speakablePage =
  speakable && speakable.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': canonical,
        url: canonical,
        name: fullTitle,
        inLanguage: 'zh-Hant-TW',
        speakable: { '@type': 'SpeakableSpecification', cssSelector: speakable },
      }
    : null;
// ── nav ──
// href 一律用 canonical 尾斜線（對齊 build format:'directory' 的 canonical/sitemap）：
// 讓每頁 nav 直接連到 canonical、免經 301，避免內鏈權重卡在非 canonical 形式（/poems 曾因此孤兒化）。
//
// 2026-08-01 二次改版：**單一分類軸（主題）**，13 → 7 項。
// 7/31 首版雖然把 13 個扁平項目收成 7 組，但同時用了三條軸——時間（今日宜忌／節日／農民曆）、
// 意圖（我想…）、主題（神明・宮廟・解籤／習俗與典故）——使用者無法預測東西在哪一格；
// 更嚴重的是**同一批內容被切到兩組**：籤（求籤在「我想…」、解籤/籤系/藥籤在另一組）、
// 神明（拜哪尊/行業守護神/比一比 vs 神明/聖誕曆）。「我想…」因此變成 11 項的雜物櫃，
// 「搬家入厝看日子」在 min-width 的浮層裡折成兩行——**寬度不一致是結果不是原因**。
//
// 分類決策皆為 2026-08-01 用戶逐題裁示：
//   ① 籤全合一組「籤詩」（抽一支與查第 X 籤不分家）。
//   ② 拜哪尊／行業守護神／神明比一比 跟神明同一組（資料上就是 deities.json 的切片）。
//   ③ **日期類全合一組**：今日農民曆／沖煞/宜忌詞義/封存 ＋ 11 種擇日，用 sections 分兩小段。
//      ⚠️ 這是用戶明示的合併，別再拆回「農民曆」與「看日子」兩個頂層項。
//   ④ 節日與習俗典故合一組「節慶習俗」。
//   ⑤ 廟宇升頂層單頁：8,265 頁、佔全站曝光 91%，是唯一被驗證的成長引擎。
//
// 沿用 7/31 的命名裁示（勿改）：
//   - 不可寫「運勢」：首頁實際區塊是熱門神明／近期節日／近期神明聖誕／今日農民曆，
//     **站上沒有運勢內容**。nav 錨文字是全站 12,000 頁指向首頁的訊號。
//   - 求籤＝抽一支（工具）、解籤＝查第 X 籤（查詢）要在字面上分得出來；
//     GSC 實測籤詩頁查詢多為「第X籤」，人是來查的。兩者現在同組但各自標清楚。
//   - 錨文字用使用者搜的字，不用介面修飾詞（「近期節日」→「節日」）。
// 「今日宜忌」留頂層：它是全站 12,000 頁指向首頁的錨文字，降進下拉會弱化首頁訊號
//   （左上「神酷」是品牌字、不是關鍵詞）。
// 第 2 項頂層叫「農民曆」而非「看日子」：兩者都是有量的搜尋詞，但農民曆 3,264 頁／
//   GA4 近 7 日 18 次瀏覽 vs 擇日 12 頁，大的那邊當頂層錨文字，「看日子」降為面板內小標。
//
// ⚠️ 三條鐵則：
//   - href 一律帶尾斜線（/poems 曾因 nav 指非 canonical 而內鏈數＝0、從未被爬；
//     `check:canonical` 會擋）。
//   - 分組必須是**靜態 HTML**（<details>＋靜態小標，不可用巢狀 details、不可由 JS 注入）——
//     爬蟲看不到 JS 注入的連結，且會踩 Astro scoped style 套不到注入 DOM 的坑
//     （見記憶 astro-scoped-style-innerhtml-pitfall）。收闔行為是漸進增強，只切換 open 屬性。
//   - 擇日子項**只放目前真的推得出宜日的**，且**由 good-days.json 驅動、不硬編**——
//     硬編過一次就漂移成「資料 11 個、nav 只顯示 3 個」。清單與恆空理由見該檔 _policy。
//
// ⚠️ /qiugian/ 與 /jiaobei/ 是全站僅有的拼音 slug，其餘皆英文。/qiugian/ 已被 Google 收錄
//    且在 seo-ops trackUrls 內，改網址會斷收錄，故維持不動。
type NavItem = { href: string; label: string };
// cols＝桌機浮層裡該段排成幾欄（不給＝單欄直排）。行動版一律 2 欄，見 global.css。
// 用途是壓面板高度：農民曆 4 項排 2 欄、擇日 11 項排 4 欄，整個面板才不會變成一根長條。
type NavSection = { title?: string; items: NavItem[]; cols?: number; more?: NavItem };
type NavEntry = { href: string; label: string } | { label: string; sections: NavSection[] };

// 擇日子項用每筆的 name（結婚／搬家入厝／理髮…），不是 nav_label（結婚看日子）：
// 後者是 /good-days/[slug] 的 H1 與麵包屑用字，放進已叫「看日子」的小段會變成
// 「看日子 ＞ 結婚看日子」的重複，也正是浮層折行的元凶。
const goodDayItems: NavItem[] = (goodDaysData as { items: { slug: string; name: string }[] }).items.map((i) => ({
  href: `/good-days/${i.slug}/`,
  label: i.name,
}));

// 「線上求籤」子項＝七個情境。**順序依 GA 實際流量**（近 60 天瀏覽：工作 21／考試 11／
// 感情 8／運勢 8／財運 6／健康 5／求子 0），不是照資料檔的建置順序——
// 使用者打開選單要先看到最多人在問的那件事。日後流量變了就改這個陣列。
const CONCERN_ORDER = ['qiuzhi', 'kaoshi', 'ganqing', 'yunshi', 'caiyun', 'jiankang', 'qiuzi'];
const concernItems: NavItem[] = CONCERN_ORDER
  .map((id) => (concernsData as { id: string; label: string }[]).find((c) => c.id === id))
  .filter((c): c is { id: string; label: string } => !!c)
  .map((c) => ({ href: `/qiugian/${c.id}/`, label: `為${c.label}` }));

// 「解籤」子項＝五套籤系。href 走 hub（藥籤自有樞紐 /medicine-slips/），與 /systems/ 同一套規則。
const systemItems: NavItem[] = (systemsData as { id: string; name: string; count: number; hub?: string }[])
  .map((sy) => ({ href: sy.hub ?? `/systems/${sy.id}/`, label: sy.name }));

const nav: NavEntry[] = [
  { href: '/', label: '今日宜忌' },
  {
    label: '農民曆',
    sections: [
      {
        title: '農民曆',
        cols: 2,
        items: [
          { href: '/almanac/', label: '今日農民曆' },
          { href: '/almanac/chongsha/', label: '今日沖煞' },
          { href: '/almanac/yiji/', label: '宜忌事項解釋' },
          { href: '/almanac/archive/', label: '過去日期封存' },
        ],
      },
      {
        title: '看日子',
        items: goodDayItems,
        cols: 4,
        more: { href: '/good-days/', label: `全部 ${goodDayItems.length} 種看日子` },
      },
    ],
  },
  {
    // 比照「農民曆」分兩小段（2026-08-03 用戶指定）：原本五個子項混在一起沒有階層——
    // 「線上求籤」是抽一支（工具、依煩惱選），「解籤」是查第 X 籤（查詢、依籤系選），
    // 兩者是不同動作，混排使用者分不出該點哪個。
    label: '籤詩',
    sections: [
      { title: '線上求籤', cols: 2, items: concernItems, more: { href: '/qiugian/', label: '求籤首頁' } },
      {
        // ⚠️ /poems/ 是**所有籤系的總表**，不是與五套籤系並列的第六個選項——
        // 2026-08-03 用戶指出把它列在同一排等於把父層當兄弟，而且「查第 X 籤」這個標籤
        // 看不出是什麼。改放 more（總表入口），items 只留「你實際要挑的那一套」。
        title: '解籤',
        cols: 2,
        items: [...systemItems, { href: '/jiaobei/', label: '擲筊怎麼看' }],
        more: { href: '/poems/', label: `全部籤詩總表（${systemItems.length} 套）` },
      },
    ],
  },
  {
    label: '神明',
    sections: [
      {
        items: [
          { href: '/deities/', label: '神明' },
          { href: '/deities/birthdays/', label: '神明聖誕曆' },
          { href: '/scenarios/', label: '拜哪尊' },
          { href: '/trades/', label: '行業守護神' },
          { href: '/compare/', label: '神明比一比' },
        ],
      },
    ],
  },
  { href: '/temples/', label: '廟宇' },
  {
    label: '節慶習俗',
    sections: [
      {
        items: [
          { href: '/festivals/', label: '節日' },
          { href: '/practices/', label: '拜拜習俗' },
          { href: '/events/', label: '民俗活動' },
          { href: '/allusions/', label: '典故' },
          { href: '/vocabulary/', label: '詞彙' },
        ],
      },
    ],
  },
  { href: '/search/', label: '搜尋' },
];
const path = Astro.url.pathname;
// active 判斷正規化尾斜線（trailingSlash:'ignore' 下 pathname 可能有無斜線兩態），不因 href 改斜線而失準。
const trimSlash = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const normPath = trimSlash(path);
const isActive = (href: string) =>
  href === '/' ? normPath === '/' : normPath === trimSlash(href) || normPath.startsWith(trimSlash(href) + '/');
// 群組是否含當前頁 → 該組 <summary> 標紅（.active）。
// ⚠️ 刻意**不**用它去設 <details open>：桌機 .nav-sub 是 position:absolute 浮層，
//    預設展開等於一進站就有白底浮層壓在正文上（例如進 /poems/ 時「籤詩」組自動彈開）。
//    所在區用紅字表示即可，展開與否交給使用者。
const groupActive = (sections: NavSection[]) =>
  sections.some((s) => s.items.some((i) => isActive(i.href)) || (s.more ? isActive(s.more.href) : false));
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {/* 圖示：SVG（現代瀏覽器）＋ PNG/ICO 後備（Safari/iOS、Google 搜尋結果需點陣）＋ PWA manifest */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Open Graph / Twitter */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogFullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#8a2b2b" />
    {/* Schema.org 知識系統標註（GEO：利 AI 理解為 knowledge system 而非單純網站） */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webSite)} />
    {speakablePage && <script type="application/ld+json" is:inline set:html={JSON.stringify(speakablePage)} />}
    {pageLd.map((ld) => <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />)}
    {/* Google Analytics 4（GA4_ID 留空則不載入；見 src/consts.ts）
        延後載入 gtag.js：指令先入 dataLayer 佇列（不漏 page_view），實際下載等
        瀏覽器閒置或首次互動，避免載入期佔用主執行緒（壓低 TBT）。 */}
    {
      GA4_ID && (
        <script is:inline define:vars={{ GA4_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          // 必須掛上 window：Astro define:vars 會把本段包進 IIFE，function gtag 只存在於閉包，
          // 站上其他 script 的 window.gtag 會是 undefined → 自訂事件（qiugian/qifu/baoxi）永遠送不出。
          // （2026-07-18 無頭瀏覽器實測抓到：page_view 有、自訂事件全 0 的病灶就在這。）
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA4_ID, { anonymize_ip: true });
          var loadGA = function () {
            if (window.__gaLoaded) return;
            window.__gaLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
            document.head.appendChild(s);
          };
          if ('requestIdleCallback' in window) requestIdleCallback(loadGA, { timeout: 4000 });
          else window.addEventListener('load', function () { setTimeout(loadGA, 1500); });
          ['scroll', 'click', 'keydown', 'touchstart', 'pointerdown'].forEach(function (e) {
            window.addEventListener(e, loadGA, { once: true, passive: true });
          });
        </script>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">神酷</a>
      <nav>
        {
          nav.map((n) =>
            'sections' in n ? (
              // 靜態 <details>：無 JS 也能展開、爬蟲讀得到全部子連結、鍵盤與螢幕閱讀器原生可用。
              // 小標題是靜態 markup 而非巢狀 <details>——一次點開就要看到整組，不做二層點擊。
              <details class="nav-group">
                <summary class:list={[{ active: groupActive(n.sections) }]}>{n.label}</summary>
                <div class="nav-sub">
                  {n.sections.map((s) => (
                    <div class="nav-sub-section">
                      {s.title && <p class="nav-sub-title">{s.title}</p>}
                      <div class:list={['nav-sub-links', { grid: !!s.cols }]} style={s.cols ? `--nav-cols:${s.cols}` : undefined}>
                        {s.items.map((c) => (
                          <a href={c.href} class:list={[{ active: isActive(c.href) }]}>{c.label}</a>
                        ))}
                      </div>
                      {s.more && (
                        <a class="nav-sub-more" href={s.more.href} class:list={[{ active: isActive(s.more.href) }]}>
                          {s.more.label} →
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              </details>
            ) : (
              <a href={n.href} class:list={[{ active: isActive(n.href) }]}>{n.label}</a>
            ),
          )
        }
      </nav>
      {/* 收闔行為（漸進增強）：只切換既有 <details> 的 open 屬性，**不注入任何 DOM**——
          所以爬蟲看到的仍是同一份靜態 HTML，也不踩 scoped style 套不到注入 DOM 的坑。
          沒有 JS 時退回原生行為（能開、但不會自動關）。 */}
      <script is:inline>
        (function () {
          var navEl = document.querySelector('.site-header nav');
          if (!navEl) return;
          var groups = Array.prototype.slice.call(navEl.querySelectorAll('details.nav-group'));
          groups.forEach(function (d) {
            d.addEventListener('toggle', function () {
              if (!d.open) return;
              groups.forEach(function (o) {
                if (o !== d) o.open = false;
              });
            });
          });
          document.addEventListener('click', function (e) {
            if (navEl.contains(e.target)) return;
            groups.forEach(function (d) {
              d.open = false;
            });
          });
          document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            groups.forEach(function (d) {
              if (!d.open) return;
              d.open = false;
              var s = d.querySelector('summary');
              if (s && d.contains(document.activeElement)) s.focus();
            });
          });
        })();
      </script>
    </header>
    <main class="site-main" data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="meta">
        免責聲明、涵蓋範圍、版權授權與資料原則 — <a href="/about/">關於與勘誤 →</a>
      </p>
    </footer>
  </body>
</html>
