[
  {
    "sourceId": "zizhusi_guanyin-1",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Laut teduh berkilau terang",
      "Pohon rindang menaungi desa",
      "Berkah datang membawa tenang",
      "Pertolongan mulia menjaga bahagia"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-2",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Cermin bundar memantulkan pagi",
      "Kecapi tua berdenting di taman",
      "Dua hati berpadu harmoni",
      "Usaha dan cinta menumbuhkan harapan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-3",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Burung kecil hinggap di batu",
      "Jarum patah tersangkut di kain",
      "Kata dan tujuan belum menyatu",
      "Bersabar lebih baik daripada memaksa diri"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-4",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Harimau belang turun ke rawa",
      "Jaring tua tersangkut di dahan",
      "Niat mencelakai kembali ke jiwa",
      "Jangan menebar marah dan ancaman"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-5",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Melati putih gugur ke kali",
      "Nelayan menanti di tepi pantai",
      "Malam sunyi mengajar rendah hati",
      "Sabar menuntun pulang membawa damai"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-6",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Padi emas menguning di ladang",
      "Gendang tua bertalu di desa",
      "Kemakmuran tumbuh lewat kerja tenang",
      "Syukur menjadikan rumah bahagia"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-7",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Ikan mas berenang pagi",
      "Awan berarak menuju muara",
      "Bakat terpendam menanti hari",
      "Sekali tersingkap, langkah berjaya"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-8",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Bintang ungu berkilau pagi",
      "Bendera tua berkibar di halaman",
      "Keadilan menepis dengki",
      "Pemimpin jernih menenteramkan negeri aman"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-9",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Pintu batu menghadap sunyi",
      "Kapal besi membelah gelombang",
      "Hutang batin jangan dipendam sendiri",
      "Waspada agar langkah tetap terang"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-10",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Pendeta berjalan menuju kali",
      "Kuda putih berhenti di jalan",
      "Teman setia menemani sepi",
      "Bersama menembus ujian dan keraguan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-11",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Delapan burung terbang ke taman",
      "Mutiara biru jatuh ke muara",
      "Beda suara dapat dipertemukan",
      "Belas kasih mendamaikan saudara"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-12",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Dua bunga mekar di pagi",
      "Benang merah terbentang di beranda",
      "Jodoh baik bersemi di hati",
      "Yang serasi tak perlu dipaksa"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-13",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Papan tua disapu pagi",
      "Batu kecil berjejer di jalan",
      "Ingat hukum sebab dalam diri",
      "Nurani menuntun setiap perbuatan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-14",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Busur kayu mengarah ke langit",
      "Tiang lapuk retak di beranda",
      "Amarah tak menyelesaikan sulit",
      "Niat lurus akhirnya berbuah nyata"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-15",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Belalang melompat ke dahan",
      "Burung kuning mengintai di rawa",
      "Jangan terlena pujian sembarangan",
      "Selidiki niat di balik kata"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-16",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Bintang jauh berkelip malam",
      "Jembatan perak membelah lautan",
      "Rindu terjaga oleh kesabaran",
      "Gemerlap dunia hanyalah khayalan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-17",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Petir berkilat di balik bukit",
      "Awan hitam turun ke halaman",
      "Kebaikan tumbuh sedikit demi sedikit",
      "Kejahatan kembali menjadi beban"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-18",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Angin lembut menyisir pantai",
      "Layar putih melaju ke dermaga",
      "Hidup tenteram membawa damai",
      "Berbagi tawa menambah bahagia"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-19",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Matahari terbit pagi",
      "Kabut tipis lenyap di taman",
      "Cahaya tumbuh di dalam diri",
      "Damai menyuburkan segala harapan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-20",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Pelita kecil menyala malam",
      "Tetes minyak jatuh perlahan",
      "Keberanian mengusir kelam",
      "Saling menjaga membawa keamanan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-21",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Kail tua terayun di kali",
      "Gunung biru tampak di kejauhan",
      "Sabar panjang menjemput rezeki",
      "Rakyat tenteram berkat kebijaksanaan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-22",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Koin kusam menggelinding ke batu",
      "Pintu kayu tertutup di halaman",
      "Jangan mengejar harta dengan takut",
      "Kunci rumah, peliharalah ketenangan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-23",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Ikan kecil melintas di kali",
      "Batu dangkal membelah arus",
      "Pilih tempat yang menenteramkan diri",
      "Teguhkan langkah, jangan bimbang terus"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-24",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Pintu besi terbuka pagi",
      "Guci anggur berdiri di taman",
      "Lepaskan beban dengan rendah hati",
      "Tahan amarah, jauhi pertengkaran"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-25",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Tiga burung mematuk biji",
      "Batu permata berkilau di taman",
      "Persatuan membuat susah jadi berarti",
      "Kepercayaan meneguhkan kawan"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-26",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Kuda batu berdiri gagah",
      "Kain putih terlipat di beranda",
      "Anugerah besar membawa amanah",
      "Kasih dirawat lewat tindakan nyata"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-27",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Daun gugur kembali ke tanah",
      "Pucuk hijau tumbuh setiap hari",
      "Rintangan surut, jangan lengah",
      "Rezeki berkumpul pada waktunya nanti"
    ],
    "status": "draft"
  },
  {
    "sourceId": "zizhusi_guanyin-28",
    "system": "zizhusi_guanyin",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Pelita kecil menyala pagi",
      "Bunga teratai mekar di taman",
      "Keyakinan menumbuhkan damai diri",
      "Budi baik mengantar keselamatan"
    ],
    "status": "draft"
  }
]
