    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Dua burung berbagi halaman",
      "Kain batik terbentang di pagi",
      "Pasangan setara saling tekanan",
      "Bahagia tak diukur lagi"
    ],
    "status": "draft"
  },
