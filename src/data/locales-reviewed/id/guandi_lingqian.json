    "system": "guandi_lingqian",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Buku hukum berdebu di sumbang",
      "Lilin kecil menyala di kali",
      "Setiap pilihan kembali ke berkembang",
      "Rawat budi agar hidup sekali"
    ],
    "status": "draft"
