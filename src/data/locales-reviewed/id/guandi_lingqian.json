    "system": "guandi_lingqian",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Lumbung penuh di tepi pagi",
      "Padi kering tersusun di halaman",
      "Kaya tak berarti tanpa lagi",
      "Berkah dan bencana tumbuh dari kehidupan"
    ],
    "status": "draft"
  },
