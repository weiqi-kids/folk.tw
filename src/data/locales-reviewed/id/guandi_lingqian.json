    "system": "guandi_lingqian",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Akar pohon menyusur wangi",
      "Mata air berkilau di telaga",
      "Cari sebab sebelum tinggi",
      "Hindari sengketa, pilih keluarga"
