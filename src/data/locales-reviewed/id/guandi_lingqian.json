    "system": "guandi_lingqian",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Sampan menepi di bukit",
      "Jalan tanah mengarah ke dahan",
      "Pilih sahabat dengan sulit",
      "Canda semalam jangan berubah ramalan"
