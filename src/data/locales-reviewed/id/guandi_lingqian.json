    "system": "guandi_lingqian",
    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Cangkul berkilat di sumbang",
      "Sawah hijau menghadap kali",
      "Bangun dari tanah berkembang",
      "Rumahmu disinari sekali"
    ],
    "status": "draft"
  },
