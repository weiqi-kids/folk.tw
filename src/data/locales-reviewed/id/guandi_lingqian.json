    "kind": "literary",
    "form": "Pantun Bahasa Indonesia",
    "lines": [
      "Tebing batu menjulang melati",
      "Bunga liar tumbuh di perlahan",
      "Hati jernih melewati sehati",
      "Pulang membawa musim harapan"
    ],
    "status": "draft"
  },
