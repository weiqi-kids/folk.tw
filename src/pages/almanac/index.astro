---
import Base from '../../layouts/Base.astro';
import AlmanacDay from '../../components/AlmanacDay.astro';
import { todayInTaipei } from '../../lib/daily';
import { releasedItems } from '../../lib/release-schedule';
import { computeDayRecord } from '../../lib/almanac';
import { BRANCHES, ZODIACS } from '../../lib/almanac/ganzhi';
import { lunarProvider } from '../../lib/almanac/provider';
import { faqPage } from '../../lib/seo';
import { almanacCrumbs } from '../../lib/breadcrumbs';
import festivalsData from '../../data/festivals.json';
import { festivalNextSolar } from '../../lib/lunar-date';
import LineCta from '../../components/LineCta.astro';

// 今日農民曆（UTC+8）。可前後翻頁或直接挑日期瀏覽（見 /almanac/[date]）。
const { iso } = todayInTaipei();
const publicFestivals = releasedItems(festivalsData, iso);

// 結構化資料（P0-1）：與 AlmanacDay 共用同一引擎計算，不重造曆算。
const [y, m, dd] = iso.split('-').map(Number);
const rec = computeDayRecord(y, m, dd, { astro: lunarProvider });

// ── 樞紐獨有：接下來七天 ────────────────────────────────────────────────
// 🔴 為什麼加（2026-08-19）：`/almanac/` 在 GSC 被判成與當日日頁重複——實測樞紐與
//    `/almanac/<今天>/` 的 <main> 內文重疊 94.8%，因為樞紐渲染的就是同一個
//    <AlmanacDay>（`hub` 參數只改樣式與「回今天」按鈕，內容一模一樣）。
//    根因是「樞紐＝今日頁的複本」，光調 canonical 宣告只是搬移症狀：
//    `[date].astro` 的 `canonical={date === today ? '/almanac/' : undefined}` 會隨 build
//    日期變動，Google 記到的關聯不會自己散掉（2026-08-07 被折進樞紐後 12 天仍未回復）。
// 🔴 零新增事實：全部由同一個 computeDayRecord 引擎算出，與日頁同源，不引入任何新資料。
const nextSeven = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(`${iso}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + i + 1);
  const s = d.toISOString().slice(0, 10);
  const [ny, nm, nd] = s.split('-').map(Number);
  const r = computeDayRecord(ny, nm, nd, { astro: lunarProvider });
  const lu = r.lunar.value;
  const dayGz = r.pillars.day.value;
  // 沖生肖＝日支對沖（相隔六位）。欄位名是 stem/branch，不是 gan/zhi（型別在 lib/almanac/types.ts）。
  const chongIdx = dayGz
    ? (BRANCHES.indexOf(dayGz.branch as (typeof BRANCHES)[number]) + 6) % 12
    : -1;
  return {
    iso: s,
    md: `${nm}/${nd}`,
    lunarLabel: lu ? `農曆${lu.isLeap ? '閏' : ''}${lu.month}月${lu.day}日` : '',
    ganzhi: dayGz ? `${dayGz.stem}${dayGz.branch}日` : '',
    chong: chongIdx >= 0 ? `沖${ZODIACS[chongIdx]}` : '',
    term: r.solarTerm.value?.name ?? '',
  };
});
const lunar = rec.lunar.value;
// /festivals/ 節日模組與本日的對映，與 AlmanacDay.astro 同一寫法：有對映時取代泛用節日清單，
// 讓 FAQPage 的答案與畫面上「節日」那一列一致（同一份 festivals.json，零新增事實）。
const lunarKeyForFaq = lunar
  ? `${String(lunar.month).padStart(2, '0')}-${String(lunar.day).padStart(2, '0')}`
  : '';
const ownFestivalNames = lunarKeyForFaq
  ? publicFestivals.filter((f) => f.lunar_date === lunarKeyForFaq).map((f) => f.name)
  : [];
const gz = (p: { value: { stem: string; branch: string } | null }) =>
  p.value ? `${p.value.stem}${p.value.branch}` : '';
const lunarText = lunar ? `${lunar.isLeap ? '閏' : ''}農曆 ${lunar.month} 月 ${lunar.day} 日` : '';
const yiV = rec.yi.filter((v) => v.verified).map((v) => v.affair);
const jiV = rec.ji.filter((v) => v.verified).map((v) => v.affair);
const chong = rec.chongSha.value;
const chongDirection = chong?.direction?.replace(/^煞/, '') ?? '';
const yearBranch = rec.pillars.year.value?.branch;
const yearZodiac = yearBranch ? ZODIACS[BRANCHES.indexOf(yearBranch as (typeof BRANCHES)[number])] : '';

// FAQ（P1-4）：問答均出自實算欄位；空者交由 faqPage 過濾，不杜撰。
// /almanac/ 是「今天」的正本（今日日期頁 canonical 指回這裡），麵包屑只到農民曆本身。
const crumbs = almanacCrumbs(iso, true);
// 近期節日：與首頁、/festivals/ 共用同一份資料與同一個換算函式，本頁不自行換算農曆。
const upcomingFestivals = publicFestivals
  .map((f) => {
    const { iso: solarIso, label } = festivalNextSolar(f, iso);
    return solarIso ? { slug: f.slug, name: f.name, iso: solarIso, lunarLabel: label } : null;
  })
  .filter((x) => x !== null)
  .sort((a, b) => a.iso.localeCompare(b.iso));

const faq = faqPage([
  {
    q: `${iso} 是農曆幾月幾日？`,
    a: lunar
      ? `${iso}（國曆）為${lunarText}，干支${gz(rec.pillars.year)}年${yearZodiac ? `（生肖${yearZodiac}）` : ''}，日柱${gz(rec.pillars.day)}。`
      : '',
  },
  { q: `${iso} 宜做什麼？`, a: yiV.length ? `${iso} 宜：${yiV.join('、')}。` : '' },
  { q: `${iso} 忌做什麼？`, a: jiV.length ? `${iso} 忌：${jiV.join('、')}。` : '' },
  {
    q: `${iso} 沖煞什麼生肖、方位？`,
    a: chong?.zodiac && chongDirection && chongDirection !== '—' ? `${iso} 沖${chong.zodiac}，煞${chongDirection}。` : '',
  },
  {
    q: `${iso} 是什麼節氣、節日？`,
    a: [rec.solarTerm.value?.name, ...(ownFestivalNames.length ? ownFestivalNames : (rec.festivals ?? []))].filter(Boolean).length
      ? `${iso} 為${[rec.solarTerm.value?.name, ...(ownFestivalNames.length ? ownFestivalNames : (rec.festivals ?? []))].filter(Boolean).join('、')}。`
      : '',
  },
]);
---

<Base
  title="農民曆"
  description="每日農曆、節氣、干支、建除、廿八宿、沖煞與神明聖誕，可瀏覽任一日期。"
  faq={faq}
  crumbs={crumbs}
>
  <AlmanacDay iso={iso} today={iso} hub />
  <LineCta
    placement="almanac_today"
    title="下次直接在 LINE 打日期"
    description="打「8/15」或「2026-08-15」，就能查那一天的農曆、干支與宜忌。"
  />

  <!-- 分享用固定連結：/almanac 網址不帶日期，社群卡片的 og 無法免重部署保持當日；
       故導向今日的 dated 鏡像頁（網址帶日期→卡片帶當日宜忌且永不過期）。 -->
  <p class="almanac-share"><a href={`/almanac/${iso}/`}>分享今日黃道吉日（固定連結）→</a></p>

  <section class="next7">
    <h2>接下來七天</h2>
    <ul>
      {
        nextSeven.map((d) => (
          <li>
            <a href={`/almanac/${d.iso}/`}>
              <span class="n7-md">{d.md}</span>
              <span class="n7-lunar">{d.lunarLabel}</span>
            </a>
            <span class="n7-gz">{d.ganzhi}</span>
            {d.chong && <span class="n7-chong">{d.chong}</span>}
            {d.term && <span class="n7-term">{d.term}</span>}
          </li>
        ))
      }
    </ul>
    <p class="muted small">干支、沖生肖與節氣由本站曆算引擎計算，與各日頁同一份結果。</p>
  </section>

  {/* 2026-08-03：農曆七月四頁（鬼門開 8/13、七夕 8/19、放水燈 8/26、中元 8/27）在 GSC
      仍是「已發現／已檢索－未建立索引」、曝光 0，而搜尋尖峰就在那幾天。
      /almanac/ 是本站 priority 僅次於首頁的樞紐（0.8）且主題相鄰，從這裡再給一條高權重內鏈。
      ⚠️ 日期一律由 festivalNextSolar() 於 build 時算，**勿在本頁自行換算農曆**。 */}
  {/* 2026-08-08：這底下原本是三組沒有標題、只用細線隔開的連結，讀起來是一團連結湯
      （分享固定連結／近期節日／宜忌·沖煞·封存 各自一段，看不出哪組是什麼）。
      補上小標並收成同一個區塊，連結本身與 href 都沒動——只是讓人看得出這是三類東西。 */}
  {upcomingFestivals.length > 0 && (
    <nav class="almanac-more" aria-label="近期節日">
      <p class="more-title">近期節日</p>
      <div class="more-links">
        {upcomingFestivals.slice(0, 4).map((f) => (
          <a href={`/festivals/${f.slug}/`}>{f.name}（{Number(f.iso.slice(5, 7))}/{Number(f.iso.slice(8, 10))}，{f.lunarLabel}）→</a>
        ))}
        <a href="/festivals/">完整節日曆 →</a>
      </div>
    </nav>
  )}

  <!-- P0-3：自已索引之 /almanac hub 顯式內鏈封存＋長尾樞紐（宜忌詞義／沖煞），提升可發現性。 -->
  <nav class="almanac-more" aria-label="更多農民曆">
    <p class="more-title">再查下去</p>
    <div class="more-links">
      <a href="/almanac/yiji/">宜忌事項是什麼？用事白話解釋 →</a>
      <a href="/almanac/chongsha/">今日沖什麼生肖？沖煞查詢 →</a>
      <a href="/almanac/archive/">歷代農民曆封存（依年月瀏覽）→</a>
    </div>
  </nav>
</Base>

<style>
  .next7 { margin-top: 1.5rem; }
  .next7 ul { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .next7 li {
    display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline;
    padding: 0.4rem 0; border-bottom: 1px dashed var(--line);
  }
  .n7-md { font-weight: 700; color: var(--accent); }
  .n7-lunar { font-size: var(--text-sm); }
  .n7-gz, .n7-chong { font-size: var(--text-sm); color: var(--ink-soft); }
  .n7-term { font-size: var(--text-xs); color: var(--gold); }

  .almanac-more {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .more-title {
    margin: 0 0 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }
  .more-links { display: flex; flex-direction: column; gap: 0.625rem; }
  .almanac-more a { color: var(--accent); }
  .almanac-share {
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }
  .almanac-share a { color: var(--accent); }
</style>
