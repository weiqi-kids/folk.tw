---
import Base from '../../../layouts/Base.astro';
import { todayInTaipei } from '../../../lib/daily';
import { almanacMonths, almanacMonthDays } from '../../../lib/almanac/dates';
import { verifiedYiDays, affairNameOf } from '../../../lib/almanac/select';
import { getTrades } from '../../../lib/queries';

// 月份樞紐：列出該月每日連結，銜接封存索引與日期頁（降低爬取深度）。
export function getStaticPaths() {
  const { iso } = todayInTaipei();
  return almanacMonths(iso).map((ym) => ({ params: { ym }, props: { today: iso } }));
}

const { ym } = Astro.params;
const { today } = Astro.props as { today: string };
const y = Number(ym!.slice(0, 4));
const m = Number(ym!.slice(5, 7));
const days = almanacMonthDays(ym!, today);

const months = almanacMonths(today);
const idx = months.indexOf(ym!);
const prevYm = idx > 0 ? months[idx - 1] : null;
const nextYm = idx >= 0 && idx < months.length - 1 ? months[idx + 1] : null;
const label = (s: string) => `${Number(s.slice(0, 4))}年${Number(s.slice(5))}月`;

// 行業視角：本月各行業的 verified 宜日（M3 篩選經 select.ts 唯一入口；零新頁）。
const trades = await getTrades();
const allYiAffairs = [...new Set(trades.flatMap((t) => t.data.affairs_yi))];
const yiDays = verifiedYiDays(days.map((d) => d.iso), allYiAffairs);
const hasAnyYi = allYiAffairs.some((a) => (yiDays.get(a) ?? []).length > 0);
---

<Base
  title={`農民曆 · ${y}年${m}月`}
  description={`${y}年${m}月 每日農曆、節氣、干支、建除、廿八宿、沖煞、宜忌、七十二候與神明聖誕一覽。`}
>
  <nav class="month-nav" aria-label="月份導覽">
    {prevYm ? <a class="nav-btn" href={`/almanac/month/${prevYm}/`} rel="prev">‹ {label(prevYm)}</a> : <span class="nav-btn disabled">‹ 上個月</span>}
    <a class="nav-btn" href="/almanac/archive/">封存索引</a>
    {nextYm ? <a class="nav-btn" href={`/almanac/month/${nextYm}/`} rel="next">{label(nextYm)} ›</a> : <span class="nav-btn disabled">下個月 ›</span>}
  </nav>

  <h1>{y}年{m}月 農民曆</h1>
  <ul class="days" data-pagefind-ignore>
    {
      days.map((d) => (
        <li><a href={d.href}>{d.day} 日{d.isToday && <span class="today">（今日）</span>}</a></li>
      ))
    }
  </ul>

  <section class="trade-days" data-pagefind-ignore>
    <h2>本月各行業吉日</h2>
    {/* 2026-08-08 改版：原本每個行業是一整段「宜祭祀：2、3、4、5、10、12、13…；宜祈福：…」
        的紅字流水句，十三段疊起來是全站最難讀的一塊——數字全是連結、全同色、沒有欄位邊界，
        眼睛沒有著力點。改成「行業＝一列，每個用事一行，日期做成方塊」，資料與連結完全沒動。 */}
    {
      hasAnyYi ? (
        <div class="trade-rows">
          {trades.map((t) => {
            const rows = t.data.affairs_yi
              .map((a) => ({ a, list: yiDays.get(a) ?? [] }))
              .filter((r) => r.list.length > 0);
            if (!rows.length) return null;
            return (
              <div class="trade-row">
                <a class="trade-name" href={`/trades/${t.id}/`}>{t.data.name}</a>
                <div class="trade-affairs">
                  {rows.map((r) => (
                    <div class="affair">
                      <span class="affair-name">宜{affairNameOf(r.a)}</span>
                      <span class="dates">
                        {r.list.map((iso) => (
                          <a class="d" href={days.find((d) => d.iso === iso)!.href}>{Number(iso.slice(8))}</a>
                        ))}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="muted">本月暫無各行業吉日資料。</p>
      )
    }
    <p class="muted small">
      各行業守護神與近期吉日見 <a href="/trades/">行業守護神</a>。
    </p>
  </section>

  <style>
    .month-nav { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-bottom: 1.75rem; }
    .nav-btn {
      padding: 0.375rem 1rem; border: 1px solid var(--line); border-radius: 0.5rem;
      background: var(--paper-2); color: var(--ink); font-size: var(--text-sm);
    }
    .nav-btn:hover { text-decoration: none; border-color: var(--accent-soft); }
    .nav-btn.disabled { color: var(--ink-soft); opacity: 0.45; pointer-events: none; }
    .days { display: grid; grid-template-columns: repeat(auto-fill, minmax(6.875rem, 1fr)); gap: 0.5rem; list-style: none; padding-left: 0; }
    .days a {
      display: block; text-align: center; padding: 0.5rem 0; border: 1px solid var(--line);
      border-radius: 0.5rem; background: var(--paper-2);
    }
    .days a:hover { text-decoration: none; border-color: var(--accent-soft); }
    .days .today { color: var(--accent); font-size: var(--text-xs); }
    .trade-days { margin-top: 2.25rem; }
    .trade-days h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; }
    .trade-days p { margin: 0.5rem 0; }
    .small { font-size: var(--text-sm); }
    .trade-rows { margin: 1.25rem 0; }
    .trade-row {
      display: grid; grid-template-columns: 11rem 1fr; gap: 0.75rem 1.25rem;
      padding: 0.875rem 0; border-bottom: 1px dashed var(--line);
    }
    .trade-name { font-weight: 700; color: var(--ink); }
    .trade-name:hover { color: var(--accent); text-decoration: none; }
    .trade-affairs { display: flex; flex-direction: column; gap: 0.625rem; }
    .affair { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 0.75rem; }
    .affair-name { font-size: var(--text-sm); color: var(--ink-soft); min-width: 5rem; }
    .dates { display: flex; flex-wrap: wrap; gap: 0.3125rem; }
    .dates .d {
      display: inline-block; min-width: 2.25rem; text-align: center;
      padding: 0.125rem 0.375rem; border: 1px solid var(--line); border-radius: 0.375rem;
      background: var(--paper-2); font-size: var(--text-sm);
      font-variant-numeric: tabular-nums;
    }
    .dates .d:hover { text-decoration: none; border-color: var(--accent-soft); }
    @media (max-width: 40rem) {
      .trade-row { grid-template-columns: 1fr; gap: 0.5rem; }
    }
  </style>
</Base>
