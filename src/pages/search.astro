---
import Base from '../layouts/Base.astro';
import LeadVisual from '../components/LeadVisual.astro';
// 全文檢索（§8）：Pagefind 於 postbuild 對 dist 建索引（package.json）。
// 索引檔在 build 後才產生，故開發伺服器（pnpm dev）看不到結果，需 pnpm build && pnpm preview。
---

<!--
  noindex（2026-07-28）：站內搜尋結果頁不該進索引——它沒有自己的內容，只是別頁的入口，
  Google 也明文建議別讓搜尋結果頁被收錄。實證：GSC「已檢索－目前尚未建立索引」的 310 頁裡，
  就有 `/search?q={search_term_string}`——**首頁 SearchAction 的 urlTemplate 被當成真網址去抓了**，
  抓回來是一個查詢字面值為 `{search_term_string}` 的空結果頁。加 noindex 並移出 sitemap 斷掉這條。
  follow 保留：頁上的連結仍可被爬。
-->
<Base title="搜尋" description="全站搜尋：籤詩、典故、神明、農民曆、民俗活動、拜拜習俗。" noindex>
  <h1>搜尋</h1>
  <p class="muted">手上有籤？直接貼上整段籤詩四句就能查解，也可搜尋典故、神明、活動與習俗。</p>
  <LeadVisual src="/og.png" alt="神酷台灣民俗信仰知識系統" />
  <div id="search" class="search-box"></div>
  {/* 2026-08-08：這裡原本放的是「若在開發模式看不到結果，請以 pnpm build && pnpm preview 檢視」——
      那是寫給我們自己看的指令，卻一直印在線上給使用者看。換成真的幫得上忙的東西：
      這頁除了輸入框以外沒有任何引導，空得像沒做完。
      🔴 範例做成 <button> 而不是 /search/?q=… 連結：那種網址會被爬，
      正是 2026-07-28 加 noindex 要斷掉的那條（見上方註解）。按鈕只填輸入框、不產生新網址。
      ⚠️ 只設既有 input 的 value 並派發 input 事件，**不注入任何 DOM**
      （Astro scoped style 套不到注入的節點，見記憶 astro-scoped-style-innerhtml-pitfall）。 */}
  <p class="hint muted">試試看：</p>
  <div class="examples">
    <button type="button" class="ex" data-q="日出便見風雲散">日出便見風雲散</button>
    <button type="button" class="ex" data-q="月老">月老</button>
    <button type="button" class="ex" data-q="安太歲">安太歲</button>
    <button type="button" class="ex" data-q="中元普渡">中元普渡</button>
    <button type="button" class="ex" data-q="擲筊">擲筊</button>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: '輸入關鍵字…',
            zero_results: '找不到「[SEARCH_TERM]」相關內容',
            many_results: '找到 [COUNT] 筆「[SEARCH_TERM]」結果',
            one_result: '找到 [COUNT] 筆「[SEARCH_TERM]」結果',
            searching: '搜尋「[SEARCH_TERM]」中…',
            clear_search: '清除',
            load_more: '載入更多',
          },
        });
        const fill = (q) => {
          const input = document.querySelector('#search input');
          if (!input) return;
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.focus();
        };
        // 支援 /search?q=… 深連結（WebSite SearchAction 端點）：帶入查詢字串並觸發 Pagefind。
        const q = new URLSearchParams(location.search).get('q');
        if (q) fill(q);
        // 範例查詢：走同一條路徑，不改網址、不注入 DOM。
        for (const b of document.querySelectorAll('.ex')) {
          b.addEventListener('click', () => fill(b.dataset.q));
        }

        // 站內需求探勘：只把明確屬於公開民俗領域、且不含常見個資格式的查詢字面送到 GA4。
        // 其他自由文字一律只送分類與長度區間，避免人名、電話、email 或網址進分析系統。
        const root = document.getElementById('search');
        const input = root?.querySelector('input');
        const domainTerm = /(廟|宮|寺|堂|壇|祠|神|佛|菩薩|帝君|王爺|媽祖|籤|農民曆|農曆|宜忌|祭|普渡|聖誕|生日|擲筊|拜拜|遶境|進香|典故|故事)/;
        const sensitive = /(@|https?:|www\.|\b(?:09\d{8}|\d{7,})\b)/i;
        const topicOf = (term) => {
          if (/(廟|宮|寺|堂|壇|祠)/.test(term)) return 'temple';
          if (/(籤|擲筊)/.test(term)) return 'qian';
          if (/(農民曆|農曆|宜忌|沖煞|吉日)/.test(term)) return 'almanac';
          if (/(節|祭|普渡|遶境|進香|拜拜)/.test(term)) return 'festival_practice';
          if (/(神|佛|菩薩|帝君|王爺|媽祖|聖誕)/.test(term)) return 'deity';
          return 'other';
        };
        const analyticsTerm = (term) => domainTerm.test(term) && !sensitive.test(term) && term.length <= 60
          ? term
          : `[redacted:${topicOf(term)}]`;
        const lengthBucket = (term) => term.length <= 5 ? '2-5' : term.length <= 12 ? '6-12' : term.length <= 30 ? '13-30' : '31+';
        let timer = 0;
        let lastReport = '';
        const report = () => {
          if (!root || !input) return;
          const term = input.value.trim().replace(/\s+/g, ' ');
          const message = root.querySelector('.pagefind-ui__message')?.textContent?.trim() || '';
          if (term.length < 2 || !message || /搜尋.+中/.test(message)) return;
          const zero = /找不到/.test(message);
          const countMatch = message.match(/找到\s*([\d,]+)\s*筆/);
          if (!zero && !countMatch) return;
          const resultCount = zero ? 0 : Number(countMatch[1].replace(/,/g, ''));
          const key = `${term}\u0000${resultCount}`;
          if (key === lastReport) return;
          lastReport = key;
          if (typeof window.gtag === 'function') {
            window.gtag('event', zero ? 'search_zero_results' : 'view_search_results', {
              search_term: analyticsTerm(term),
              search_topic: topicOf(term),
              search_length: lengthBucket(term),
              result_count: resultCount,
            });
          }
        };
        const scheduleReport = () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(report, 900);
        };
        if (root && input) {
          input.addEventListener('input', scheduleReport);
          new MutationObserver(scheduleReport).observe(root, { childList: true, subtree: true, characterData: true });
          root.addEventListener('click', (event) => {
            const link = event.target.closest?.('.pagefind-ui__result-link');
            if (!link || typeof window.gtag !== 'function') return;
            const links = [...root.querySelectorAll('.pagefind-ui__result-link')];
            window.gtag('event', 'search_result_click', {
              search_term: analyticsTerm(input.value.trim().replace(/\s+/g, ' ')),
              result_position: links.indexOf(link) + 1,
              link_url: new URL(link.href, location.href).pathname,
            });
          });
        }
      }
    });
  </script>

  <style>
    .search-box { margin: 1.5rem 0; }
    .hint { margin: 1.875rem 0 0.75rem; font-size: var(--text-sm); }
    .examples { display: flex; flex-wrap: wrap; gap: 0.625rem; }
    .ex {
      font-family: inherit; font-size: var(--text-sm); cursor: pointer;
      padding: 0.4375rem 1rem; border-radius: 999px;
      border: 1px solid var(--line); background: var(--paper-2); color: var(--ink);
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .ex:hover { border-color: var(--accent-soft); color: var(--accent); }
    :global(.pagefind-ui) {
      --pagefind-ui-primary: var(--accent);
      --pagefind-ui-text: var(--ink);
      --pagefind-ui-background: var(--paper-2);
      --pagefind-ui-border: var(--line);
      --pagefind-ui-font: inherit;
    }
  </style>
</Base>
