---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import { getDeities, getScenarios } from '../../lib/queries';
import { faqPage } from '../../lib/seo';
import { HUB } from '../../lib/breadcrumbs';
import comparisons from '../../data/comparisons.json';
import LeadVisual from '../../components/LeadVisual.astro';

export const getStaticPaths = (async () => {
  const deities = await getDeities();
  const deityById = new Map(deities.map((d) => [d.id, d]));
  const scenarios = await getScenarios();
  const scenName = new Map(scenarios.map((s) => [s.id, s.data.name]));
  return comparisons
    .filter((c) => deityById.get(c.a) && deityById.get(c.b))
    .map((c) => ({
      params: { slug: c.slug },
      props: { cmp: c, a: deityById.get(c.a)!, b: deityById.get(c.b)!, scenName },
    }));
}) satisfies GetStaticPaths;

const { cmp, a, b, scenName } = Astro.props;
const A = a.data;
const B = b.data;
const leadImage = A.image ?? B.image;

// 聖誕（農曆）：僅實際日期，同神明頁規則
const bdays = (d: typeof A) =>
  d.birthday_lunar
    .filter((x) => x.kind === '聖誕' && x.date && !['無定', '待查', '未定'].includes(x.date))
    .map((x) => `農曆${x.date}`)
    .join('、') || '—';

// 對照列（衍生自逐條掛源的神明資料，無新增事實）
const rows: { label: string; a: string; b: string }[] = [
  { label: '別稱', a: (A.aliases ?? []).slice(0, 4).join('、') || '—', b: (B.aliases ?? []).slice(0, 4).join('、') || '—' },
  { label: '信仰類別', a: A.category ?? '—', b: B.category ?? '—' },
  { label: '主要職司', a: (A.office ?? []).join('、') || '—', b: (B.office ?? []).join('、') || '—' },
  { label: '主要面向', a: cmp.a_focus, b: cmp.b_focus },
  { label: '聖誕', a: bdays(A), b: bdays(B) },
];

// 來源：合併兩神既有掛源（去重）
const mergedSources = [...(A.sources ?? []), ...(B.sources ?? [])];
const seen = new Set<string>();
const sources = mergedSources.filter((s) => (seen.has(s.ref) ? false : (seen.add(s.ref), true)));

const faqItems = [
  { q: cmp.question, a: cmp.contrast },
  {
    q: `${A.name}的主要職司是什麼？`,
    a: `${A.name}為${A.category ?? ''}，主要職司：${(A.office ?? []).join('、')}。`,
  },
  {
    q: `${B.name}的主要職司是什麼？`,
    a: `${B.name}為${B.category ?? ''}，主要職司：${(B.office ?? []).join('、')}。`,
  },
];
const faq = faqPage(faqItems);
const jsonLd = [
  ...(faq ? [faq] : []),
];
const relScen = (cmp.related_scenarios ?? []).filter((id) => scenName.get(id));
---

<Base
  title={cmp.question}
  description={cmp.contrast}
  ogType="article"
  ogImage="/og/discover/prayer-light.webp"
  ogImageWidth={1200}
  ogImageHeight={675}
  jsonLd={jsonLd}
  speakable={['h1', '.lead']}
  crumbs={[HUB.compare, { name: `${A.name}與${B.name}`, path: `/compare/${cmp.slug}/` }]}
>

  <header class="dh">
    <h1>{cmp.question}</h1>
  </header>

  {leadImage && <LeadVisual image={leadImage} />}
  <p class="lead">{cmp.contrast}</p>

  <section>
    <h2>逐項對照</h2>
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr>
            <th>項目</th>
            <th><a href={`/deities/${cmp.a}/`}>{A.name}</a></th>
            <th><a href={`/deities/${cmp.b}/`}>{B.name}</a></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>{r.a}</td>
              <td>{r.b}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="summaries">
    <div>
      <h3><a href={`/deities/${cmp.a}/`}>{A.name}</a></h3>
      {A.summary && <p>{A.summary}</p>}
    </div>
    <div>
      <h3><a href={`/deities/${cmp.b}/`}>{B.name}</a></h3>
      {B.summary && <p>{B.summary}</p>}
    </div>
  </section>

  {
    relScen.length > 0 && (
      <p class="muted small">
        相關情境：
        {relScen.map((id, i) => (
          <>
            {i > 0 && '、'}
            <a href={`/scenarios/${id}/`}>{scenName.get(id)}要拜什麼神</a>
          </>
        ))}
      </p>
    )
  }

  <p class="muted small extend">
    延伸：<a href="/compare/">其他比較</a>｜<a href="/scenarios/">拜什麼神</a>｜<a href="/deities/">神明圖譜</a>
  </p>

  <Sources sources={sources} variant="footer" />

  <style>
    .dh h1 { margin: 0.25rem 0 0.5rem; }
    .lead { font-size: var(--text-base); }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; margin-top: 2rem; }
    /* 🔴 min-width 不可省（2026-08-08 修）：只有 overflow-x:auto、table 又是 width:100% 的話，
       表格永遠等於容器寬、根本不會產生水平捲軸，只會被壓扁——390px 實測三欄各剩約 90px，
       「土地公、伯公、后土、福德爺」被斷成一行一個字。給一個大於手機寬度的 min-width，
       捲軸才真的會出來。 */
    .tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    table { border-collapse: collapse; width: 100%; min-width: 34rem; }
    th, td { border: 1px solid var(--line); padding: 0.625rem 0.875rem; text-align: left; vertical-align: top; }
    thead th { background: var(--paper-2); }
    tbody th[scope='row'] { background: var(--paper-2); white-space: nowrap; color: var(--ink-soft); }
    .summaries { display: grid; gap: 1.25rem; grid-template-columns: 1fr 1fr; margin-top: 1.75rem; }
    .summaries h3 { margin: 0 0 0.375rem; }
    @media (max-width: 560px) { .summaries { grid-template-columns: 1fr; } }
    .small { font-size: var(--text-sm); }
    .extend { margin-top: 1.875rem; }
  </style>
</Base>
