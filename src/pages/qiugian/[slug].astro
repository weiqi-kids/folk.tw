---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import LeadVisual from '../../components/LeadVisual.astro';
import LineCta from '../../components/LineCta.astro';
import { getPoems, getSystems, getDeities, interpretationById } from '../../lib/queries';
import { breadcrumb, faqPage } from '../../lib/seo';
import concerns from '../../data/concerns.json';
import stats from '../../data/qiugian-stats.json';
// 籤詩人格（2026-08-15）：結果卡帶一行人格標籤，完整內容在籤詩頁
import personas from '../../data/poem-personas.json';
const personaLabel = new Map(
  Object.entries(personas.poems as Record<string, { type: string }>).map(([pid, a]) => {
    const t = personas.types.find((x) => x.id === a.type);
    return [pid, t ? `${t.name}・${t.tagline}` : ''] as const;
  }),
);

export const getStaticPaths = (async () => {
  return concerns.map((c) => ({ params: { slug: c.id }, props: { concern: c } }));
}) satisfies GetStaticPaths;

const { concern } = Astro.props;

const systems = await getSystems();
const systemName = new Map(systems.map((s) => [s.id, s.data.name]));
const deities = await getDeities();
const deityById = new Map(deities.map((d) => [d.id, d.data]));

// 抽籤資料集：本情境對映籤系的每一籤 → 四句 + 對映面向（既有籤解，零杜撰）。
const poems = await getPoems();
const interps = await interpretationById();
// slip_prefix＝此情境靠**籤版原印的分項解**作答（月老籤），不是本站自撰的白話解籤。
// 取法是照抄籤版該項的原文（如「婚姻好」），不改寫、不重新歸類——選哪一項給哪個情境是「挑選」，
// 把籤版的話改寫成我們的句子才是「詮釋」，後者不做。
const slipPrefix: string | undefined = (concern as { slip_prefix?: string }).slip_prefix;
const rows = poems
  .filter((p) => p.data.system.id === concern.system)
  .sort((a, b) => a.data.no - b.data.no)
  .map((p) => ({
    no: p.data.no,
    id: p.id,
    label: p.data.title ?? p.data.ganzhi ?? '',
    jiaobei: p.data.jiaobei ?? '',
    fortune: p.data.fortune ?? '',
    lines: p.data.lines,
    aspect: ((interps.get(p.id)?.data ?? {}) as Record<string, string | undefined>)[concern.aspect] ?? '',
    persona: personaLabel.get(p.id) ?? '',
    slip: slipPrefix ? (p.data.official_interpretation ?? []).filter((t) => t.startsWith(slipPrefix)).join('、') : '',
  }));
// 🔴 籤版作答的籤系**不濾掉沒有該項的籤**：月老籤第九首的籤版原本就沒有「婚姻」項
//    （已回頭核對掃描件確認，不是謄錄漏抄）。照舊濾掉會讓它永遠抽不到＝1/27 的靜默偏差，
//    而且抽籤本來就該是每一支都有機會。改成保留，由畫面如實說明該籤版沒列這一項。
//    其餘籤系維持原本行為（濾掉缺解的籤，防資料缺口）。
const qianData = slipPrefix ? rows : rows.filter((q) => q.aspect);

type Agg = { week_draws: number; baoxi: number; top: Record<string, number>; joys: { text: string; meta: string }[] };
const st: Agg = (stats as unknown as Record<string, Agg>)[concern.id] ?? { week_draws: 0, baoxi: 0, top: {}, joys: [] };

const sysLabel = systemName.get(concern.system) ?? concern.system;
// 帶上職司（2026-08-08）：這幾張卡原本只有神名、其他全是留白，滿版高度配兩個字，
// 看起來像壞掉或還沒載入。職司是 deities.json 既有且已掛源的欄位（同 /deities/ 索引的呈現），
// 零新增事實，只是把卡片裡本來就該有的東西放進去。
const patronDeities = concern.deities
  .map((id) => ({ id, name: deityById.get(id)?.name ?? id, office: (deityById.get(id)?.office ?? []).slice(0, 3) }))
  .filter((d) => deityById.has(d.id));

// 求籤（抽一支籤）↔ 情境（怎麼拜/拜哪尊）互連，見 src/pages/scenarios/[slug].astro 反向對照。
const SCENARIO_BY_CONCERN: Record<string, { id: string; label: string }> = {
  kaoshi: { id: 'kaoshi-gongming', label: '考試求功名' },
  caiyun: { id: 'kaidian-qiucai', label: '開店求財' },
  ganqing: { id: 'qiu-yinyuan', label: '求姻緣' },
};
const scenario = SCENARIO_BY_CONCERN[concern.id];

const answerKind = slipPrefix ? '籤版原印分項解' : '白話解籤';
const pageDesc = `為${concern.label}（${concern.intent}）求一支${sysLabel}，看「${concern.aspect}」面向的${answerKind}。`;

const faq = faqPage([
  { q: `為${concern.label}求籤，該拜哪位神？`, a: patronDeities.length ? `${patronDeities.map((d) => d.name).join('、')}——都是台灣人為${concern.label}求籤時會拜的神。` : '' },
  { q: `為${concern.label}適合求哪種籤？`, a: `可求${sysLabel}，就「${concern.aspect}」面向看解籤。` },
]);

const jsonLd = [
  breadcrumb([
    { name: '求籤', path: '/qiugian/' },
    { name: concern.h1, path: `/qiugian/${concern.id}/` },
  ]),
  ...(faq ? [faq] : []),
];
---

<Base
  title={concern.h1}
  description={pageDesc}
  ogType="article"
  ogImage="/og/discover/qian-slips.webp"
  ogImageWidth={1200}
  ogImageHeight={675}
  jsonLd={jsonLd}
  speakable={['h1', '.lead']}
>
  <nav class="crumb"><a href="/">神酷</a> ／ 求籤</nav>
  <p class="eyebrow">求籤 · 為心裡的那件事</p>
  <h1>{concern.h1}</h1>

  {st.week_draws > 0 ? (
    <p class="lead">在為{concern.label}煩惱的，不只你。本週有 <b>{st.week_draws}</b> 個人，在這裡為{concern.intent}求了籤。</p>
  ) : (
    <p class="lead">在為{concern.label}煩惱的，不只你。這裡才剛開張——你可能是最早來為{concern.label}求籤的人之一。</p>
  )}
  <p class="muted small blurb">{concern.blurb}</p>
  <LeadVisual src="/visuals/qian-slips.svg" alt={`為${concern.label}求籤的站內通用插圖`} />

  <div class="actions">
    <button class="btn btn-primary" id="drawBtn" type="button">求一支籤<small>靜下心，想著這件事</small></button>
    <button class="btn btn-ghost" id="qifuBtn" type="button">為{concern.label}集氣<small>給同樣在拚的人</small></button>
  </div>

  <div id="qifuAltar" class="altar" hidden aria-live="polite">
    <span class="altar-glow" aria-hidden="true"></span>
    <span class="altar-lamp" aria-hidden="true">🕯️</span>
    <p class="altar-msg" id="altarMsg"></p>
  </div>

  <div class="draw-alt small">
    {/* 月老籤不抽籤支、是連擲三次筊定出第幾首，寫「抽到了」對不上現場動作 */}
    <span>{slipPrefix ? '在廟裡擲筊得到第幾首？' : '在廟裡抽到了？直接查籤號'}</span>
    <span class="draw-alt-field">
      <input id="noInput" type="number" min="1" max={qianData.length} inputmode="numeric" placeholder={slipPrefix ? '第幾首' : '籤號'} aria-label={slipPrefix ? '第幾首' : '籤號'} />
      <button class="btn-num" id="noBtn" type="button">看這支</button>
    </span>
  </div>
  <p id="topNote" class="note small"></p>

  <div id="result" hidden></div>
  <div id="lineAfterDraw" hidden>
    <LineCta
      placement={`qiugian_${concern.id}`}
      title="明天想再求一支？放進 LINE"
      description="在 LINE 打「求籤」，每天固定一支六十甲子籤；也能加進群組一起抽。"
    />
  </div>

  <div class="divider">別人後來怎麼了</div>
  <div class="joys" id="joys">
    {st.joys.length ? st.joys.map((j) => (
      <div class="joy card"><span class="k">{j.text}</span><span class="m">{j.meta}</span></div>
    )) : (
      <p class="muted small" id="joysEmpty">這個情境還沒有人回報結果。</p>
    )}
  </div>

  <div class="baoxi">
    <p class="small">在這裡為{concern.label}求過籤、事情有結果了嗎？點一下回報，會計入下面的統計。</p>
    <button class="btn btn-ghost bx-open" id="bxOpen" type="button">🎋 我也回來報喜</button>
    <div id="bxChips" hidden>
      <p class="q small">後來怎麼了？</p>
      <div class="chips">
        {concern.outcomes.map((o) => (
          <button class="chip" type="button" data-outcome={o.value}>{o.label}</button>
        ))}
      </div>
    </div>
    <p id="bxDone" class="note small"></p>
  </div>

  <div class="divider">為{concern.label}，常拜這幾位</div>
  <div class="gods">
    {patronDeities.map((d) => (
      <a class="god card" href={`/deities/${d.id}/`}>
        <div class="n">{d.name}</div>
        {d.office.length > 0 && <div class="o">{d.office.join('・')}</div>}
      </a>
    ))}
  </div>

  {scenario && (
    <p class="scenario-cta small muted">
      想知道這幾尊「怎麼拜、擇哪天」？看 <a href={`/scenarios/${scenario.id}/`}>{scenario.label}</a>。
    </p>
  )}

  <script type="application/json" id="qiandata" set:html={JSON.stringify(qianData)} />
  <script type="application/json" id="statsdata" set:html={JSON.stringify(st)} />
  <div id="cfg" data-concern={concern.id} data-label={concern.label} data-aspect={concern.aspect} data-system={sysLabel} hidden></div>

  <style>
    .crumb { color: var(--ink-soft); font-size: var(--text-sm); margin-bottom: 0.75rem; }
    .eyebrow { font-size: var(--text-xs); letter-spacing: 0.2em; color: var(--accent); font-weight: 700; margin: 0 0 0.375rem; }
    .lead { font-size: var(--text-base); margin: 0 0 0.375rem; }
    .lead b { color: var(--accent); font-variant-numeric: tabular-nums; }
    .blurb { margin: 0.375rem 0 0; }

    .actions { display: flex; gap: 0.875rem; margin: 1.75rem 0 0.625rem; }
    .btn { font-family: inherit; font-size: var(--text-base); font-weight: 700; cursor: pointer;
      border-radius: 0.75rem; padding: 1.0625rem 1.25rem; flex: 1; text-align: center; border: 1px solid transparent; }
    .btn:focus-visible { outline: 2.5px solid var(--accent-soft); outline-offset: 2px; }
    .btn small { display: block; font-weight: 400; font-size: var(--text-xs); opacity: 0.85; margin-top: 0.1875rem; }
    .btn-primary { background: var(--accent); color: var(--paper); }
    .btn-ghost { background: var(--paper-2); color: var(--ink); border-color: var(--line); }
    .btn-ghost:hover { border-color: var(--accent-soft); }
    .btn.done { background: var(--accent); color: var(--paper); border-color: var(--accent); cursor: default; }
    .bx-open { flex: 0 0 auto; align-self: flex-start; }

    /* 集氣儀式：點一盞燈的畫面感（暖光暈＋燭火搖曳），非純文字 */
    .altar { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center;
      gap: 0.4375rem; margin: 1.125rem 0 0; padding: 1.625rem 1.25rem 1.375rem; border-radius: 1.125rem;
      border: 1px solid var(--line);
      background: radial-gradient(120% 100% at 50% 0%, oklch(0.63 0.10 45 / 0.16), transparent 62%), var(--paper-2); }
    .altar[hidden] { display: none; }
    .altar-glow { position: absolute; top: -3.125rem; left: 50%; width: 11.25rem; height: 11.25rem; transform: translateX(-50%);
      background: radial-gradient(circle, var(--accent-soft), transparent 65%); opacity: 0.3; pointer-events: none;
      animation: altar-glow 2.6s ease-in-out infinite; }
    .altar-lamp { font-size: var(--text-2xl); line-height: 1; transform-origin: 50% 85%;
      filter: drop-shadow(0 0 0.6875rem var(--accent-soft)); animation: altar-flicker 1.7s ease-in-out infinite; }
    .altar-msg { position: relative; margin: 0; text-align: center; font-size: var(--text-base); color: var(--ink); }
    .altar.lighting .altar-lamp { animation: altar-rise 0.7s ease-out, altar-flicker 1.7s ease-in-out 0.7s infinite; }
    @keyframes altar-flicker { 0%, 100% { transform: scale(1) rotate(-1deg); } 50% { transform: scale(1.07) rotate(1.5deg); } }
    @keyframes altar-rise { from { opacity: 0; transform: translateY(0.625rem) scale(0.55); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @keyframes altar-glow { 0%, 100% { opacity: 0.22; transform: translateX(-50%) scale(0.9); } 50% { opacity: 0.42; transform: translateX(-50%) scale(1.06); } }
    @media (prefers-reduced-motion: reduce) { .altar-lamp, .altar-glow, .altar.lighting .altar-lamp { animation: none; } }

    .draw-alt { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.875rem; color: var(--ink-soft); margin: 0.875rem 0 0; }
    .draw-alt-field { display: inline-flex; align-items: center; gap: 0.5rem; }
    .draw-alt input { width: 5.625rem; font-family: inherit; font-size: var(--text-sm); padding: 0.4375rem 0.625rem; text-align: center;
      border: 1px solid var(--line); border-radius: 0.5rem; background: var(--paper-2); color: var(--ink); }
    .draw-alt input::placeholder { color: var(--ink-soft); }
    .btn-num { font-family: inherit; font-size: var(--text-sm); font-weight: 700; cursor: pointer; color: var(--accent);
      background: transparent; border: 1px solid var(--accent-soft); border-radius: 0.5rem; padding: 0.4375rem 1.0625rem; }
    .btn-num:hover { background: var(--accent); color: var(--paper); border-color: var(--accent); }
    .btn-num:focus-visible { outline: 2.5px solid var(--accent-soft); outline-offset: 2px; }
    .note { color: var(--ink-soft); min-height: 1.375rem; }

    .divider { display: flex; align-items: center; gap: 1rem; color: var(--ink-soft); font-size: var(--text-xs);
      letter-spacing: 0.1em; margin: 2.5rem 0 1.25rem; }
    .divider::before, .divider::after { content: ""; height: 1px; background: var(--line); flex: 1; }

    .joys { display: flex; flex-direction: column; gap: 0.6875rem; }

    .baoxi { display: flex; flex-direction: column; gap: 0.875rem; margin-top: 1.25rem; }
    .baoxi .q { color: var(--ink); margin: 0; }
    .chips { display: flex; flex-wrap: wrap; gap: 0.625rem; }
    .chip { font-family: inherit; font-size: var(--text-sm); cursor: pointer; color: var(--ink); background: var(--paper-2);
      border: 1px solid var(--line); border-radius: 1.25rem; padding: 0.5625rem 1.125rem; }
    .chip:hover { border-color: var(--accent-soft); }
    .chip:focus-visible { outline: 2.5px solid var(--accent-soft); outline-offset: 2px; }

    .gods { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .god { flex: 1 1 14rem; padding: 1rem 1.125rem; text-decoration: none; color: var(--ink); }
    .god .n { font-size: var(--text-lg); }
    .god .o { margin-top: 0.25rem; font-size: var(--text-sm); color: var(--accent); }
    .scenario-cta { margin-top: 1.25rem; }

  </style>

  <!-- 求籤結果由 client JS 以 innerHTML 注入 #result，注入的元素不帶 Astro scope
       (data-astro-cid) 屬性，若用一般 scoped <style> 這批規則會全部落空（籤詩四句
       擠成一橫行、爐火區失樣）。故改 is:global，並一律以 #result 命名空間收斂避免外洩。
       所有色彩/字級沿用 global.css 的 OKLCH token 與 --text-*，未自編 hex/px。 -->
  <style is:global>
    /* 報喜喜訊：靜態由 build 產出、動態由 JS 注入 #joys，兩者統一走 #joys 命名空間 */
    #joys .joy { display: flex; align-items: baseline; gap: 0.75rem; padding: 0.75rem 1.0625rem; border-left: 3px solid var(--ok-green); }
    #joys .joy .k { font-size: var(--text-base); }
    #joys .joy .m { font-size: var(--text-sm); color: var(--ink-soft); margin-left: auto; white-space: nowrap; font-variant-numeric: tabular-nums; }

    #result { margin-top: 1.75rem; }
    #result .note { color: var(--ink-soft); } /* 注入結尾說明句（.note 靜態版在 scoped 區塊，注入版需這條才有灰色） */
    #result .rslip-row { display: flex; gap: 1.375rem; align-items: stretch; }
    #result .rslip { border-top: 4px solid var(--accent); padding: 1.25rem; display: flex; flex-direction: column; align-items: center; gap: 0.875rem; min-width: 11.25rem; }
    #result .rslip .rno { font-size: var(--text-sm); color: var(--accent); letter-spacing: 0.05em; text-align: center; }
    #result .rpoem { display: flex; flex-direction: row-reverse; gap: 0.4375rem; justify-content: center; }
    #result .rpoem .pl { writing-mode: vertical-rl; text-orientation: upright; font-size: var(--text-lg); letter-spacing: 0.12em; line-height: 1.5; color: var(--ink); }
    #result .rslip .rfortune { font-size: var(--text-sm); color: var(--gold); letter-spacing: 0.1em; }
    #result .reading { flex: 1; padding-top: 0.25rem; }
    #result .reading .rtag { font-size: var(--text-sm); letter-spacing: 0.08em; color: var(--accent); font-weight: 700; }
    #result .reading h2 { font-size: var(--text-lg); margin: 0.375rem 0 0.625rem; }
    #result .reading p { font-size: var(--text-base); margin: 0 0 0.75rem; }
    #result .reading .more { font-size: var(--text-sm); color: var(--ink-soft); text-decoration: underline; text-underline-offset: 3px; }
    /* 籤版原印的分項解（月老籤）：答案很短（「婚姻好」三個字），放大並標明出處，
       不要看起來像本站寫的白話解籤。#result 命名空間內，注入 DOM 也套得到。 */
    #result .reading .slip { font-size: var(--text-lg); color: var(--ink); display: flex; align-items: baseline; gap: 0.625rem; flex-wrap: wrap; }
    #result .reading .slip .slip-tag { font-size: var(--text-sm); color: var(--ink-soft); border: 1px solid var(--line); border-radius: 0.25rem; padding: 0.125rem 0.5rem; }
    #result .reading .slip-none { color: var(--ink-soft); }
    #result .reading .rpersona { font-size: var(--text-sm); color: var(--ink-soft); margin: 0.625rem 0 0; }
    #result .reading .rpersona b { color: var(--accent); }

    #result .hearth { margin-top: 1.75rem; border-radius: 1.125rem; padding: 1.375rem 1.375rem 0.625rem;
      background: radial-gradient(120% 90% at 50% -10%, oklch(0.63 0.10 45 / 0.14), transparent 60%), var(--paper-2); border: 1px solid var(--line); }
    #result .hearth-h { display: flex; align-items: center; gap: 0.6875rem; font-size: var(--text-base); font-weight: 700; margin-bottom: 0.25rem; }
    #result .flame { width: 0.6875rem; height: 0.6875rem; border-radius: 50%; background: var(--accent-soft);
      box-shadow: 0 0 0.75rem 0.125rem var(--accent-soft); }
    #result .estat { display: flex; align-items: baseline; gap: 0.625rem; padding: 0.6875rem 0; border-bottom: 1px solid var(--line); }
    #result .estat:last-of-type { border-bottom: none; }
    #result .estat .big { font-size: var(--text-xl); color: var(--accent); font-variant-numeric: tabular-nums; }
    #result .estat.j .big { color: var(--ok-green); }
    #result .qi { width: 100%; margin: 1.125rem 0 0.75rem; font-family: inherit; font-size: var(--text-base); font-weight: 700; cursor: pointer;
      border: 1px solid var(--accent); color: var(--accent); background: transparent; border-radius: 0.75rem; padding: 0.9375rem; }
    #result .qi:hover { background: var(--accent); color: var(--paper); }
    #result .qi.done { background: var(--accent); color: var(--paper); cursor: default; box-shadow: 0 0 1.0625rem 0.0625rem var(--accent-soft); }

    /* 祈福籤詩圖入口（2026-08-15：從結果卡直達，不用先跳籤詩頁） */
    #result .cardcta { display: block; width: 100%; margin-top: 1.125rem; text-align: center; font-size: var(--text-base); font-weight: 700;
      color: var(--paper); background: var(--accent); border-radius: 0.75rem; padding: 0.9375rem; }
    #result .cardcta:hover { text-decoration: none; background: var(--accent-soft); color: var(--ink); }
    /* 籤後選擇題：非強制的第二層互動 */
    #result .choice { margin-top: 1.125rem; border: 1px dashed var(--line); border-radius: 0.75rem; padding: 0.9375rem 1rem; }
    #result .choice-q { margin: 0 0 0.625rem; font-weight: 700; }
    #result .choice-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
    #result .choice-opts button { font: inherit; font-size: var(--text-sm); font-weight: 700; cursor: pointer;
      color: var(--ink); background: var(--paper-2); border: 1px solid var(--line); border-radius: 0.5rem; padding: 0.625rem; }
    #result .choice-opts button:hover { border-color: var(--accent-soft); color: var(--accent); }
    #result .choice-done { margin: 0; color: var(--ink-soft); }
    @media (max-width: 37.5rem) { #result .rslip-row { flex-direction: column; } #result .choice-opts { grid-template-columns: 1fr; } }
  </style>

  <script>
    import { rememberPoem } from '../../lib/poem-shelf';

    const cfg = document.getElementById('cfg')!.dataset;
    const QIAN = JSON.parse(document.getElementById('qiandata')!.textContent || '[]');
    const STAT = JSON.parse(document.getElementById('statsdata')!.textContent || '{}');
    // 宮廟歸因（2026-08-14，P0）：廟方專屬連結（NFC／QR／印刷品）帶 ?temple=<temples.json 的 id>，
    // 本頁所有事件（qiugian/qifu/baoxi）多帶一個 temple 維度（GA4 自訂維度已於同日以 Admin API 註冊，
    // EVENT scope、非追溯）。值走白名單字元＋限長，防任意查詢字串進 GA；無參數時行為完全不變。
    // 聚合（按廟分組）在 scripts/qiugian-aggregate.mjs；連結慣例見 docs/temple-partner-links.md。
    const templeRef = (() => {
      try {
        const v = new URLSearchParams(location.search).get('temple') || '';
        return /^[a-z0-9_一-鿿-]{1,80}$/.test(v) ? v : '';
      } catch { return ''; }
    })();
    // 帶 temple 進來的，籤詩詳情連結也帶著走（P1：籤詩頁讀同一參數換合作主題＋送 poem_open）
    const tqs = templeRef ? `?temple=${encodeURIComponent(templeRef)}` : '';
    const g = (name: string, params: Record<string, unknown>) => {
      if (templeRef) params = { ...params, temple: templeRef };
      // @ts-ignore
      if (typeof window.gtag === 'function') window.gtag('event', name, params);
    };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    function render(item: any) {
      const week = STAT.week_draws || 0;
      const per = (STAT.top && STAT.top[item.no]) || 0;
      const baoxi = STAT.baoxi || 0;
      const e1 = week > 0 ? `<b class="big">${week}</b><span>人，本週也為「${esc(cfg.label!)}」求了籤</span>`
        : `<span>你是最近少數為「${esc(cfg.label!)}」求籤的人之一。</span>`;
      const e2 = per > 0 ? `<div class="estat"><b class="big">${per}</b><span>人，和你抽到同一支</span></div>` : '';
      const e3 = baoxi > 0 ? `<div class="estat j"><b class="big">${baoxi}</b><span>人，求了籤後回來報喜 ✨</span></div>`
        : `<div class="estat j"><span>還沒有人回報結果。</span></div>`;
      const lines = item.lines.map((l: string) => `<span class="pl">${esc(l)}</span>`).join('');
      document.getElementById('result')!.innerHTML = `
        <p class="draw-head small muted">你為 <b>${esc(cfg.label!)} · ${esc(cfg.aspect!)}</b> 求得——</p>
        <div class="rslip-row">
          <div class="rslip card">
            <div class="rno">${esc(cfg.system!)} · 第 ${item.no} 籤${item.label ? ' · ' + esc(item.label) : ''}${item.jiaobei ? ' · 擲筊 ' + esc(item.jiaobei) : ''}</div>
            <div class="rpoem">${lines}</div>
            ${item.fortune ? `<div class="rfortune">${esc(item.fortune)}</div>` : ''}
          </div>
          <div class="reading">
            <p class="rtag">就你問的「${esc(cfg.label!)}」而言</p>
            <h2>${esc(cfg.aspect!)}</h2>
            ${item.aspect
              ? `<p>${esc(item.aspect)}</p>`
              : item.slip
                ? `<p class="slip">${esc(item.slip)}<span class="slip-tag">籤版原印</span></p>`
                : `<p class="slip-none">這張籤版沒有列這一項。四句與其他項目見完整籤解。</p>`}
            ${item.persona ? `<p class="rpersona">這支籤的人格：<b>${esc(item.persona)}</b>　<a href="/poems/${esc(item.id)}/${tqs}#persona">為什麼 →</a></p>` : ''}
            <a class="more" href="/poems/${esc(item.id)}/${tqs}">看完整籤解與其他面向 →</a>
          </div>
        </div>
        <a class="cardcta" href="/poems/${esc(item.id)}/${tqs}#qiancard">🎴 把這支籤做成祈福籤詩圖</a>
        <div class="choice" id="choiceBlock">
          <p class="choice-q">解籤看完了——如果是你，接下來會？</p>
          <div class="choice-opts">
            <button type="button" data-c="push">繼續向前衝</button>
            <button type="button" data-c="pause">暫時放一放</button>
            <button type="button" data-c="ask">找人商量</button>
            <button type="button" data-c="wait">再等等看</button>
          </div>
          <p class="choice-done" hidden></p>
        </div>
        <div class="hearth">
          <div class="hearth-h"><span class="flame" aria-hidden="true"></span>和你一起的人</div>
          <div class="estat">${e1}</div>
          ${e2}
          ${e3}
          <button class="qi" id="qiInline" type="button">🙏 為自己的${esc(cfg.label!)}集氣</button>
        </div>
        <p class="note small caption-time">為明天的事求的？把這頁存起來，有結果再回來回報。</p>`;
      document.getElementById('result')!.hidden = false;
      document.getElementById('lineAfterDraw')!.hidden = false;
      document.getElementById('qiInline')!.addEventListener('click', qifuInline);
      // 籤後選擇題（2026-08-15，顧問方案③⑨的合體）：非強制、放在解籤之後——
      // 第一層求籤流程保持完整極簡，想互動的人才點（互動深度分層，不做人群分流）。
      // 選項是中性的行動傾向，不涉籤意詮釋（紅線 1：不替神明加話）。
      const cb = document.getElementById('choiceBlock');
      cb?.querySelectorAll<HTMLButtonElement>('.choice-opts button').forEach((b) =>
        b.addEventListener('click', () => {
          g('qian_choice', { concern: cfg.concern, poem_no: item.no, choice: b.dataset.c });
          const done = cb.querySelector<HTMLElement>('.choice-done')!;
          const opts = (STAT as { choices?: Record<string, number> }).choices ?? {};
          const total = Object.values(opts).reduce((a, n) => a + n, 0);
          const same = opts[b.dataset.c!] ?? 0;
          // 統計句只在量夠時出現（門檻 10，比照祈福頁「數字為真、少算不灌水」）
          done.textContent = total >= 10 && same > 0
            ? `你選了「${b.textContent}」——最近有 ${same} 個人，做了一樣的選擇。`
            : `你選了「${b.textContent}」。`;
          done.hidden = false;
          (cb.querySelector('.choice-opts') as HTMLElement).hidden = true;
        }),
      );
      rememberPoem({
        id: item.id,
        title: `${cfg.system}第 ${item.no} 籤${item.label ? `「${item.label}」` : ''}`,
        system: cfg.system!,
        href: `/poems/${item.id}/`,
      });
      // 不自動捲動：求籤/輸入籤號後就地展開結果，強制捲動反而打斷使用者視線（2026-07-17 用戶回報）。
    }

    // 同一件事，一天求一支：23 小時內再求同一情境＝同一支籤（求籤是問神、不是刷結果）。
    // 用 localStorage 記 {no, ts}／情境；GA 只在「新抽出」時送一次，重看不重複計數。
    const DRAW_KEY = 'folk_qg_draw_v1';
    const DRAW_WINDOW = 23 * 60 * 60 * 1000;
    function readDrawStore(): Record<string, { no: number; ts: number }> {
      try { return JSON.parse(localStorage.getItem(DRAW_KEY) || '{}'); } catch { return {}; }
    }
    function draw() {
      if (!QIAN.length) return;
      const store = readDrawStore();
      const prev = store[cfg.concern!];
      const now = Date.now();
      let item = prev && now - prev.ts < DRAW_WINDOW ? QIAN.find((q: any) => q.no === prev.no) : null;
      const note = document.getElementById('topNote')!;
      if (item) {
        note.textContent = '一天求一支就好——這是你今天為' + cfg.label + '求的，明天再來。';
      } else {
        item = QIAN[Math.floor(Math.random() * QIAN.length)];
        store[cfg.concern!] = { no: item.no, ts: now };
        try { localStorage.setItem(DRAW_KEY, JSON.stringify(store)); } catch {}
        g('qiugian', { concern: cfg.concern, poem_no: item.no });
        note.textContent = '';
      }
      render(item);
    }
    function drawByNo() {
      const v = parseInt((document.getElementById('noInput') as HTMLInputElement).value, 10);
      const item = QIAN.find((q: any) => q.no === v);
      const note = document.getElementById('topNote')!;
      if (!item) { note.textContent = `這個籤系沒有第 ${v || '?'} 籤，或該籤暫無解。試試「求一支籤」。`; return; }
      note.textContent = '';
      g('qiugian', { concern: cfg.concern, poem_no: item.no, by_no: true });
      render(item);
    }

    let qifuDone = false;
    function qifuInline() {
      const b = document.getElementById('qiInline')!;
      if (qifuDone) return; qifuDone = true;
      g('qifu', { concern: cfg.concern });
      b.classList.add('done'); b.textContent = '🕯 已為自己的' + cfg.label + '集氣';
    }
    let qifuTopDone = false;
    document.getElementById('qifuBtn')!.addEventListener('click', () => {
      const btn = document.getElementById('qifuBtn')!;
      const altar = document.getElementById('qifuAltar')!;
      const msg = document.getElementById('altarMsg')!;
      if (!qifuTopDone) {
        qifuTopDone = true;
        g('qifu', { concern: cfg.concern });
        btn.classList.add('done');
        btn.textContent = '🕯 已為' + cfg.label + '集氣';
      }
      msg.textContent = '也幫還在拚' + cfg.label + '的人一起集了氣。';
      altar.hidden = false;
      // 重觸發燭火點燃動畫（remove→reflow→add）
      altar.classList.remove('lighting');
      void (altar as HTMLElement).offsetWidth;
      altar.classList.add('lighting');
    });

    document.getElementById('drawBtn')!.addEventListener('click', draw);
    document.getElementById('noBtn')!.addEventListener('click', drawByNo);

    // 報喜（還願）：按類別、不打字 → 送 GA 事件，當場加進喜訊牆
    document.getElementById('bxOpen')!.addEventListener('click', () => {
      document.getElementById('bxChips')!.hidden = false;
      (document.getElementById('bxOpen') as HTMLElement).style.display = 'none';
    });
    for (const chip of document.querySelectorAll('.chip')) {
      chip.addEventListener('click', () => {
        const outcome = (chip as HTMLElement).dataset.outcome!;
        g('baoxi', { concern: cfg.concern, outcome });
        document.getElementById('bxChips')!.hidden = true;
        document.getElementById('bxDone')!.textContent = '收到，已經加進統計了。🕯';
        const joys = document.getElementById('joys')!;
        const empty = document.getElementById('joysEmpty'); if (empty) empty.remove();
        const el = document.createElement('div'); el.className = 'joy card';
        const k = document.createElement('span'); k.className = 'k'; k.textContent = (chip as HTMLElement).textContent!.trim();
        const m = document.createElement('span'); m.className = 'm'; m.textContent = '剛剛 · 你';
        el.append(k, m); joys.insertBefore(el, joys.firstChild);
      });
    }
  </script>
</Base>
