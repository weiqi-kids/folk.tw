---
// 民俗文物分類頁（2026-08-20 開）。
//
// 資料是國史館臺灣文獻館《臺灣民俗文物辭典》的文物辭條，逐條**逐字節錄**首句並掛回
// 該辭條的公開網址。🔴 那個連結是授權條件的一部分，不是排版裝飾——拿掉就是違反授權。
// 驗收在不變量 artifact/source-link（逐頁驗每一條的連結都渲染在同一頁）。
//
// 🔴 為什麼另立頁型、不塞進 /vocabulary/：受控詞彙是**全站共用的定義表**（活動類型、
//    陣頭、金紙、供品那些會被其他頁引用的詞），而文物辭條是**辭書內容的呈現**，
//    兩者用途不同；而且 /vocabulary/ 已近六百詞，再加兩千條會變成單頁十萬字。
import Base from '../../layouts/Base.astro';
import LeadVisual from '../../components/LeadVisual.astro';
import Sources from '../../components/Sources.astro';
import { HUB } from '../../lib/breadcrumbs';
import data from '../../data/artifacts.json';
import ledger from '../../data/artifact-pages.json';

export function getStaticPaths() {
  return data.categories.map((c) => ({ params: { id: c.id }, props: { cat: c } }));
}
const { cat } = Astro.props as { cat: (typeof data.categories)[number] };
const others = data.categories.filter((c) => c.id !== cat.id);
// 本類中已有獨立頁的辭條（台帳＝src/data/artifact-pages.json，是試點清單不是全量）。
const pageLinks = ledger.entries.filter((e) => e.category === cat.id);
---

<Base
  title={`${cat.title}｜臺灣民俗文物`}
  description={`臺灣民俗文物中的${cat.title}共 ${cat.items.length} 條，逐條節錄國史館臺灣文獻館《臺灣民俗文物辭典》的辭條定義並掛回原辭條網址。`}
  answer="lead"
  crumbs={[HUB.artifacts]}
>
  <h1>{cat.title}</h1>
  <p class="lead">
    這一類收錄 {cat.items.length} 條文物辭條。每一條的定義都逐字節錄自國史館臺灣文獻館
    《臺灣民俗文物辭典》，並附上該辭條的原始網址。
  </p>

  {/* 有合授權的分類示意圖就掛它、逐張標作者與授權（授權條件）；沒有的退回站台識別圖，
      並在圖說寫明那不是文物照片——不可讓讀者以為那張圖是這一類的文物。 */}
  {
    cat.image ? (
      <figure class="cat-photo">
        <img src={cat.image.src} alt={cat.image.alt} loading="lazy" decoding="async" width="1200" height="800" />
        <figcaption class="muted small">
          本類示意圖，非特定辭條的文物照片。
          {'　'}
          <a href={cat.image.source} target="_blank" rel="noopener nofollow">{cat.image.alt.replace(/^.*：/, '')}</a>
          {' — '}{cat.image.author}{'，'}
          {cat.image.license_url
            ? <a href={cat.image.license_url} target="_blank" rel="noopener nofollow">{cat.image.license}</a>
            : cat.image.license}
        </figcaption>
      </figure>
    ) : (
      <>
        <LeadVisual src="/og.png" alt="神酷台灣民俗信仰知識系統" />
        <p class="muted small">這一類尚無合授權的示意圖，圖為本站識別圖，非文物照片。</p>
      </>
    )
  }

  <dl class="terms">
    {
      cat.items.map((t) => (
        <div class="term">
          {/* 錨點：文物詳情頁的交叉連結會指到這裡（尚未單獨成頁的辭條只能連錨點）。
              🔴 id 用辭條原文，別改成流水號——連結是別頁寫死的，改了就是製造 404 錨點。 */}
          <dt id={t.term}>{t.term}</dt>
          <dd>
            {t.def}
            {/* 這裡原本自己寫一條正規式抽網址、錨文字寫死「來源」，2026-08-20 收斂回 <Sources>。
                🔴 兩件事一起修好：① href 改由 parseSourceRef 抽（本頁 1,983 條實測 href 與舊式
                   逐條相同，授權要的那個連結一個都沒變）；② 錨文字從「來源」變成辭條全名
                   「國史館臺灣文獻館《臺灣民俗文物辭典》〈瓜皮帽〉」——授權條件要的是標示來源，
                   說出是誰的辭書才算標示，「來源」兩個字誰都可以是。 */}
            <Sources sources={[t.source]} prefix="　" variant="inline" />
          </dd>
        </div>
      ))
    }
  </dl>

  {pageLinks.length > 0 && (
    <nav class="more">
      <h2>這一類已單獨成頁的文物</h2>
      <ul>
        {pageLinks.map((e) => <li><a href={`/artifacts/${cat.id}/${e.slug}/`}>{e.term}</a></li>)}
      </ul>
    </nav>
  )}

  <nav class="more">
    <h2>其他分類</h2>
    <ul>
      {others.map((c) => <li><a href={`/artifacts/${c.id}/`}>{c.title}</a><span class="muted small">　{c.items.length}</span></li>)}
    </ul>
  </nav>

  <style>
    .cat-photo { margin: 1.25rem 0; }
    .cat-photo img { display: block; width: min(100%, 40rem); height: auto; border-radius: 0.5rem; }
    .cat-photo figcaption { margin-top: 0.375rem; }
    .terms { margin: 1.5rem 0; }
    .term { padding: 0.625rem 0; border-bottom: 1px dashed var(--line); }
    .term dt { font-weight: 700; color: var(--accent); }
    .term dd { margin: 0.25rem 0 0; line-height: 1.9; }
    .more ul { list-style: none; padding: 0; display: grid; gap: 0.375rem;
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); }
    .small { font-size: var(--text-sm); }
  </style>
</Base>
