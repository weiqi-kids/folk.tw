---
// 節日樞紐：把站內既有的「日期錨定」資料（practices 的 festival_ref、events、神明聖誕）
// 聚合成一個節日模組。日期一律由 lunarToNextSolar 在 build 時算，倒數由前端即時算。
import Base from '../../layouts/Base.astro';
import FestivalCountdown from '../../components/FestivalCountdown.astro';
import { faqPage } from '../../lib/seo';
import { HUB } from '../../lib/breadcrumbs';
import { festivalNextSolar, solarMd } from '../../lib/lunar-date';
import { todayInTaipei } from '../../lib/daily';
import { releasedItems } from '../../lib/release-schedule';
import festivals from '../../data/festivals.json';
import localCelebrations from '../../data/local-celebrations.json';

const { iso: today } = todayInTaipei();
const currentYear = today.slice(0, 4);
const publicFestivals = releasedItems(festivals, today);
// 地方宗教慶典（縣市層級登錄）的入口。數量與縣市數一律由資料算，不寫死。
const localCounties = new Set(localCelebrations.items.map((x) => x.county)).size;

// 每個節日算「自今日起的下一次國曆日期」，依日期排序。
// festivalNextSolar 同時處理農曆月日與節氣（清明）兩種，頁面不自行判斷型別。
const items = publicFestivals
  .map((f) => {
    const { iso, label } = festivalNextSolar(f, today);
    return iso
      ? {
          slug: f.slug,
          name: f.name,
          iso,
          lunarLabel: label,
          dateNote: f.date_note,
          season: f.season,
          question: f.question,
        }
      : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .sort((a, b) => a.iso.localeCompare(b.iso));

const undatedItems = publicFestivals
  .map((f) => ({ f, next: festivalNextSolar(f, today) }))
  .filter((x) => x.next.iso === null)
  .map(({ f }) => ({
    slug: f.slug,
    name: f.name,
    dateNote: f.date_note,
    season: f.season,
    question: f.question,
  }));

// 依季節分組（目前只有「農曆七月」一組；日後加清明/正月自動成組）
const seasons = [...new Set(items.map((i) => i.season))];

const nextOne = items[0];
const faq = faqPage([
  ...(nextOne
    ? [
        {
          q: '下一個民俗節日是什麼時候？',
          a: `${nextOne.name}，國曆 ${nextOne.iso.slice(0, 4)} 年 ${solarMd(nextOne.iso)}（${nextOne.lunarLabel}）。`,
        },
      ]
    : []),
  {
    q: '農曆七月有哪些節日？',
    a: items
      .filter((i) => i.season === '農曆七月')
      .map((i) => `${i.name}（${i.lunarLabel}，國曆 ${solarMd(i.iso)}）`)
      .join('；'),
  },
  {
    q: `${currentYear} 年九月有哪些民俗節日？`,
    a: items
      .filter((i) => i.iso.startsWith(`${currentYear}-09`))
      .map((i) => `${i.name}（國曆 ${solarMd(i.iso)}）`)
      .join('；'),
  },
]);

---

<Base
  title="民俗節日曆—農曆節日、節氣與祭典日期"
  description="中元節、中秋節、教師節祭孔、白露秋分與金門博餅——換算今年國曆日期，整理祭拜、供品、儀式與地方節俗，資料逐條掛來源。"
  faq={faq}
  crumbs={[HUB.festivals]}
  answer="lead"
>
  <h1>民俗節日曆</h1>
  <p class="lead">
    農曆節日每年的國曆日期都不一樣，固定國曆紀念日與節氣又有各自的算法。本頁統一換算成下一次國曆日期並即時倒數，
    各節日內頁列出祭拜順序、供品與金紙，內容衍生自逐條掛來源的<a href="/practices/">拜拜習俗</a>與<a
      href="/events/">民俗活動</a
    >。
  </p>

  <section>
    <h2>近期節日</h2>
    <FestivalCountdown items={items} />
  </section>

  {/* 依節日數排序，多的在前（2026-08-08）：農曆七月有八個節日，正月與節氣各只有一個，
      原本一視同仁排成三欄格線，只有一張卡的那兩段右邊各空兩格、看起來像漏掉東西。
      少於三個的那幾段改用不撐滿的橫排（.few），版面節奏才對得起內容量。 */}
  {
    seasons
      .map((s) => ({ s, list: items.filter((i) => i.season === s) }))
      .sort((a, b) => b.list.length - a.list.length)
      .map(({ s, list }) => (
        <section class:list={['season', { few: list.length < 3 }]}>
          <h2>{s}<span class="count muted">（{list.length}）</span></h2>
          <div class="grid cols fest-grid">
            {list.map((i) => (
              <a class="card fest-cell" href={`/festivals/${i.slug}/`}>
                <img
                  src={`/og/festivals/${i.slug}.png`}
                  alt={`${i.name}日期與節俗主視覺`}
                  width="1200"
                  height="630"
                  loading="lazy"
                  decoding="async"
                />
                <strong>{i.name}</strong>
                <span class="muted small">
                  {i.lunarLabel}　·　國曆 {solarMd(i.iso)}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
  }

  {undatedItems.length > 0 && (
    <section class="undated">
      <h2>全年／年度公告主題<span class="count muted">（{undatedItems.length}）</span></h2>
      <p class="muted small">
        這些頁面整理全年信仰、詞彙或地方活動脈絡；固定日期、活動檔期與服務時間需依當年度官方來源核對。
      </p>
      <div class="grid cols fest-grid">
        {undatedItems.map((i) => (
          <a class="card fest-cell" href={'/festivals/' + i.slug + '/'}>
            <img
              src={'/og/festivals/' + i.slug + '.png'}
              alt={i.name + '節俗主視覺'}
              width="1200"
              height="630"
              loading="lazy"
              decoding="async"
            />
            <strong>{i.name}</strong>
            <span class="muted small">{i.dateNote ?? '年度日期待官方公告'}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <h2>各地的地方宗教慶典</h2>
    <p>
      上面是全台性的節俗。內政部另有一份由縣市登錄的<a href="/festivals/local/">地方宗教慶典</a>清單，
      共 {localCelebrations.items.length} 項、涵蓋 {localCounties} 個縣市——鹽水蜂炮、大甲媽祖遶境進香、
      頭城搶孤、鷄籠中元祭都在裡面，農曆日期同樣換算成下一次的國曆日。
    </p>
  </section>

  <p class="muted small">
    相關：<a href="/deities/birthdays/">神明聖誕曆</a>｜<a href="/practices/">拜拜習俗</a>｜<a href="/events/"
      >民俗活動</a
    >｜<a href="/almanac/">農民曆</a>｜<a href="/qiugian/">線上求籤</a>
  </p>

  <style>
    .lead { font-size: var(--text-base); }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; margin-top: 2rem; }
    .count { font-size: var(--text-sm); font-weight: 400; }
    /* 少於三個節日的季段：卡片橫排、不撐滿三欄，段落間距也收窄一級。 */
    .season.few .fest-grid { display: flex; flex-wrap: wrap; }
    .season.few .fest-cell { flex: 0 1 20rem; }
    .season.few h2 { margin-top: 1.5rem; }
    .fest-cell { display: flex; flex-direction: column; gap: 0.25rem; }
    .fest-cell img { display: block; width: 100%; height: auto; margin-bottom: 0.5rem; border: 1px solid var(--line); }
    .fest-cell strong { color: var(--ink); }
    .fest-cell .muted { color: oklch(0.37 0.02 72); }
    .small { font-size: var(--text-sm); }
  </style>
</Base>
