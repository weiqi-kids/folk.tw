---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import ShareRow from '../../components/ShareRow.astro';
import LineCta from '../../components/LineCta.astro';
import { getDeities, getEvents, getPractices, getTemples } from '../../lib/queries';
import { breadcrumb, faqPage, ORG } from '../../lib/seo';
import { festivalNextSolar, lunarDateLabel, solarMd } from '../../lib/lunar-date';
import { googleCalendarUrl } from '../../lib/festival-calendar';
import { templeCounty } from '../../lib/temple-region';
import { festivalOwnerByLunarDate } from '../../lib/temple-festival.ts';
import { todayInTaipei } from '../../lib/daily';
import { num } from '../../lib/format';
import { excerptAtBoundary } from '../../lib/text';
import festivals from '../../data/festivals.json';
import vocab from '../../data/vocabulary.json';
import localCelebrations from '../../data/local-celebrations.json';

export const getStaticPaths = (async () => {
  const [deities, practices, events, temples] = await Promise.all([
    getDeities(),
    getPractices(),
    getEvents(),
    getTemples(),
  ]);
  const deityById = new Map(deities.map((d) => [d.id, d]));
  const practiceById = new Map(practices.map((p) => [p.id, p]));
  const eventById = new Map(events.map((e) => [e.id, e]));
  const templeById = new Map(temples.map((t) => [t.id, t]));
  const vocabByTerm = new Map(
    Object.values(vocab)
      .flat()
      .map((t) => [t.term, t as { term: string; def: string; alias?: string[]; sources?: unknown[] }]),
  );
  const { iso: today } = todayInTaipei();

  // 當天有登記祭典的宮廟（2026-07-31，內政部慶(祭)典資料匯入後才有可能）。
  // 🔴 判定＝該廟 `festivals[]` 有一筆**農曆日期與本節日完全相同**者，措辭也僅止於此：
  //    「當天有登記祭典」是資料直述，**不是**「這些廟在過中元節」——後者是我們沒有的事實。
  //    每間廟旁一律列出**該廟自己登記的祭典名稱**，讀者看得到我們憑什麼把它列在這裡。
  // 節氣型節日（清明）無 lunar_date，自然不產生名單，不必特判。
  // ⚠️ 同一個農曆日期只能有一個節日頁掛這份名單：`festivals.json` 中
  //    07-15 有中元節與搶孤兩筆、07-01 有鬼門開與雞籠中元祭兩筆。若兩邊都渲染，
  //    就會有兩頁各自帶著**一模一樣的 105 筆／15 筆清單**＝我們自己製造重複內容，
  //    正好稀釋掉這批資料本來要強化的那一頁。
  //    歸屬規則＝`festivals.json` 中**先出現者**（現行順序下為鬼門開、中元節，
  //    正是該日期的主查詢頁；搶孤／雞籠中元祭是同日的特定儀式，不重複列全台名單）。
  //    調整 festivals.json 的排序會改變歸屬——要改順序時記得回頭看這裡。
  //    2026-08-02：此分派規則抽到 `temple-festival.ts` 的 `festivalOwnerByLunarDate()`，
  //    因為廟宇頁新增的正向連結（該廟登記祭典→本節日頁）必須用同一份歸屬，否則兩邊會矛盾。
  const listOwner = festivalOwnerByLunarDate(festivals); // lunar_date → 擁有名單的 slug

  const templesOnDate = new Map<string, { id: string; name: string; county: string; festival: string }[]>();
  for (const f of festivals) {
    const lunar = (f as { lunar_date?: string }).lunar_date;
    if (!lunar || listOwner.get(lunar) !== f.slug) continue;
    const hits = [];
    for (const t of temples) {
      const hit = (t.data.festivals ?? []).find((x) => x.calendar === 'lunar' && x.date === lunar);
      if (!hit) continue;
      const c = templeCounty(t.data.district);
      hits.push({ id: t.id, name: t.data.name, county: c?.name ?? '', festival: hit.name });
    }
    // 固定排序（縣市→廟名）＝每次 build 結果一致，不是隨機挑。
    hits.sort((a, b) => a.county.localeCompare(b.county, 'zh-Hant') || a.name.localeCompare(b.name, 'zh-Hant'));
    templesOnDate.set(f.slug, hits);
  }

  // 同一天的地方宗教慶典（2026-08-06）：內政部「地方宗教慶典」是**縣市層級**登錄的活動，
  // 與上面那份「廟方自己登記的祭典」是兩份不同的資料，故獨立成一段、措辭也不同。
  // 🔴 只陳述「這份清單裡有一項登錄在同一天」，不說「這個節日當天各地在辦這些活動」——
  //    我們沒有任何一年的實際舉辦紀錄，後者是替縣市政府宣稱（同 temples.md 的措辭界線）。
  // 歸屬沿用同一支 festivalOwnerByLunarDate：同一農曆日期只有一個節日頁掛名單，
  // 否則 07-15 的中元節與搶孤會各帶一份一模一樣的清單＝自製重複內容。
  const localByFestival = new Map<string, { name: string; county: string }[]>();
  for (const x of localCelebrations.items) {
    if (x.calendar !== 'lunar') continue;
    const slug = listOwner.get(x.date);
    if (!slug) continue;
    if (!localByFestival.has(slug)) localByFestival.set(slug, []);
    localByFestival.get(slug)!.push({ name: x.name, county: x.county });
  }
  // 固定排序（縣市→名稱）＝每次 build 結果一致。
  for (const list of localByFestival.values()) {
    list.sort((a, b) => a.county.localeCompare(b.county, 'zh-Hant') || a.name.localeCompare(b.name, 'zh-Hant'));
  }

  return festivals
    .map((f) => ({ f, ...festivalNextSolar(f, today) }))
    .filter((x): x is { f: (typeof festivals)[number]; iso: string; label: string } => x.iso !== null)
    .map(({ f, iso, label }) => ({
      params: { slug: f.slug },
      props: {
        f,
        iso,
        dateLabel: label,
        deityById,
        practiceById,
        eventById,
        templeById,
        vocabByTerm,
        templesOnDate: templesOnDate.get(f.slug) ?? [],
        localOnDate: localByFestival.get(f.slug) ?? [],
        // 主場節日的顯示名（本頁不是主場時，要連過去且寫得出名字）。
        // 在這裡查是因為頁面本體拿不到 festivals 全集；查不到就給 null，模板退回只連 /practices/。
        festivalNameBySlug: Object.fromEntries(festivals.map((x) => [x.slug, x.name])),
      },
    }));
}) satisfies GetStaticPaths;

const {
  f, iso, dateLabel, deityById, practiceById, eventById, templeById, vocabByTerm, templesOnDate, localOnDate,
  festivalNameBySlug,
} = Astro.props;

const year = iso.slice(0, 4);
// 農曆節日＝「農曆七月十五」；節氣節日＝「節氣清明」。由 lib 統一產出，頁面不自行判斷型別。
const lunarLabel = dateLabel;
// 跨多日的節日（目前只有雞籠中元祭，橫跨整個農曆七月）用「起於」。
// ⚠️ 判定用明確的 multi_day 欄位，**不可用 `Boolean(date_note)` 推斷**——
// date_note 也用來寫純說明（如地藏王聖誕的短月順延、搶孤的頭城/恆春異地異日），
// 初版誤把它當跨多日旗標，產生「地藏王菩薩聖誕｜農曆七月三十起・儀式順序」這種與事實不符的標題。
const multiDay = f.multi_day === true;
const nominalLunarLabel = f.lunar_date ? lunarDateLabel(f.lunar_date) : '';
const shiftedFromShortMonth = Boolean(nominalLunarLabel && nominalLunarLabel !== lunarLabel);
// answer-first 第一句：直接回答「今年是哪一天」——這是這類查詢唯一想要的答案。
const dateSentence = multiDay
  ? `${f.name}起於${lunarLabel}，${year} 年為國曆 ${solarMd(iso)}。`
  : shiftedFromShortMonth
    ? `${f.name}傳統日期為${nominalLunarLabel}；${year} 年該農曆月只有廿九日，因此落在${lunarLabel}，國曆 ${solarMd(iso)}。`
    : `${f.name}是${lunarLabel}，${year} 年落在國曆 ${solarMd(iso)}。`;
const defaultPageTitle = multiDay
  ? `${f.name}${year}｜${lunarLabel}起・儀式順序與日期`
  : `${f.name}${year}是哪一天？${lunarLabel}・國曆${solarMd(iso)}`;

const linkedPractices = (f.practice_refs ?? []).map((id) => practiceById.get(id)).filter(Boolean);
const linkedEvents = (f.event_refs ?? []).map((id) => eventById.get(id)).filter(Boolean);
const linkedDeities = (f.deity_refs ?? []).map((id) => deityById.get(id)).filter(Boolean);
const linkedTemples = (f.temple_refs ?? []).map((id) => templeById.get(id)).filter(Boolean);
const linkedVocab = (f.vocab_refs ?? []).map((t) => vocabByTerm.get(t)).filter(Boolean);

// 同季節的其他節日（2026-08-03）：原本節日詳情頁彼此**完全不相連**，只各自連回 /festivals/ 樞紐，
// 十頁等於十個並排的葉子。農曆七月那批（鬼門開／雞籠中元祭／七夕／放水燈／中元／搶孤／義民／地藏）
// 在使用者眼中本來就是同一件事的不同天，互連才成一個叢集。
// 直接效果：`qianggu` 原本零廟頁內鏈、GSC 實查「URL is unknown to Google」＝形同孤兒，
// 這一段讓它從同月份的其他 7 頁被連到。純用既有 `season` 欄位分組，不新增事實。
// ⚠️ 起算日用「今天（台北）」而非本頁的 `iso`——`iso` 是本節日的下一次國曆日，
// 拿它當起算點會把同月份、日期比它早的節日推到明年。排序用 `lunar_date` 字串（"07-01" < "07-15"），
// 不可用農曆中文標籤 localeCompare（「初一」「十五」「廿」排不出正確順序）。
const nowIso = todayInTaipei().iso;
const siblingFestivals = f.season
  ? festivals
      .filter((x) => x.slug !== f.slug && x.season === f.season)
      .slice()
      .sort((a, b) => (a.lunar_date ?? '').localeCompare(b.lunar_date ?? ''))
      .map((x) => {
        const { iso: solarIso, label } = festivalNextSolar(x, nowIso);
        return solarIso ? { slug: x.slug, name: x.name, iso: solarIso, lunarLabel: label } : null;
      })
      .filter((x): x is NonNullable<typeof x> => x !== null)
  : [];

// 主要儀式（取第一個 practice）的步驟／供品／金紙／禁忌——全部既有掛源欄位，不新增事實。
// 在 frontmatter 先收斂成明確的陣列，模板才不必到處 `mp?.x?.length > 0`（該寫法在 ts 下為 possibly undefined）。
const mainPractice = linkedPractices[0];
const mp = mainPractice?.data;

// 🔴 **同一套儀式只在「主場節日」攤開**（2026-08-09，用戶裁示要打頭部詞後查出來的根因）。
// 背景：`pudu` 被 7 個節日頁 practice_refs 指到（中元節／鬼門開／放水燈／雞籠中元祭／搶孤／義民／地藏），
// 而本頁原本一律把它的完整步驟＋供品＋金紙＋禁忌＋地區差異整組渲染出來
// → 那 7 頁彼此高度重複。實測（8 字片段與 /festivals/zhongyuan/ 的重疊率）：
//   搶孤 84.4%、雞籠中元祭 71.6%、鬼門開 70.3%、清明 29.9%（清明用 saomu，故低）。
// 而重疊最高的兩頁，正是 Google **不收錄**的那兩頁
//   （搶孤＝`Discovered - currently not indexed`、雞籠中元祭＝`URL is unknown to Google`，2026-08-09 逐頁 URL Inspection），
//   義民與地藏則是收錄了但 7 天 0 曝光。
// ⚠️ 先前（2026-08-03，commit a030482）對這批頁下的藥是「補內鏈」，5 天後這幾頁狀態沒變——
//   `jilong-zhongyuan` 現在有 191 頁連過去仍是 unknown。**別再重做補內鏈那一輪**，問題不在入口。
// 非主場頁改成一句摘要＋連到 /practices/<id>/（那才是這套儀式的正主頁）與主場節日。
const isPracticeHome = !mp?.home_festival || f.slug === mp.home_festival;
const homeFestivalName = mp?.home_festival ? (festivalNameBySlug?.[mp.home_festival] ?? null) : null;

const steps = isPracticeHome ? (mp?.steps ?? []) : [];
const offerings = isPracticeHome ? (mp?.offerings ?? []) : [];
const jossPaper = isPracticeHome ? (mp?.joss_paper ?? []) : [];
const taboos = isPracticeHome ? (mp?.taboo ?? []) : [];
const regionals = isPracticeHome ? (mp?.regional ?? []) : [];

// 文資登錄（層級＋公告文號）：既有 events 欄位，此前節日頁完全沒渲染。
// 這是各節日**真正獨有**的事實（雞籠中元祭＝國家重要民俗、頭城／恆春搶孤＝縣市定民俗，各有文號），
// 正好補上非主場頁去重後少掉的份量。🔴 只陳述「被登錄為什麼、文號是什麼」，不推論活動內容。
const HERITAGE_LABEL: Record<string, string> = {
  national_important: '國家重要民俗',
  national: '國定民俗',
  county: '縣（市）定民俗',
};
// ⚠️ `home_festival` 沒設＝在每個指到它的節日頁都攤開（舊行為）；設了就只在主場頁攤開。
//    不加這道閘的話，`jilong` 的登錄明細會同時印在中元節頁與雞籠中元祭頁上。
const heritages = linkedEvents
  .map((e) => ({ name: e!.data.name, h: e!.data.heritage }))
  .filter((x) => x.h?.verified && x.h?.level && HERITAGE_LABEL[x.h.level])
  .filter((x) => !x.h!.home_festival || x.h!.home_festival === f.slug);

// 儀式順序（名稱＋農曆時程）。目前只有雞籠中元祭有 13 段，正好回答它自己的提問
// 「在哪幾天？儀式順序是什麼？」。⚠️ 只印名稱與時程，敘述不取（授權理由見 content.config.ts）。
const ceremonyStages = linkedEvents
  .filter((e) => !e!.data.heritage?.home_festival || e!.data.heritage.home_festival === f.slug)
  .map((e) => ({ name: e!.data.name, stages: e!.data.ceremony_stages ?? [] }))
  .filter((x) => x.stages.length > 0);

// 逐句掛源的補充事實（2026-08-09 加）。給「有權威源可寫、但不屬於任何既有欄位」的內容用，
// 目前只有清明（節氣的天文定義）。🔴 一句一源，不合併、不外推——寫不出源的句子就不要寫。
const facts = (f as { facts?: { text: string; sources: { type: string; ref: string; note?: string }[] }[] }).facts ?? [];

// 來源：節日自身來源 ＋ 所連 practice/event 的來源（去重）
const allSources = [
  ...(f.sources ?? []),
  ...linkedPractices.flatMap((p) => p!.data.sources ?? []),
  ...linkedEvents.flatMap((e) => e!.data.sources ?? []),
];
const seen = new Set<string>();
const sources = allSources.filter((s: { ref: string }) => (seen.has(s.ref) ? false : (seen.add(s.ref), true)));

const faq = faqPage([
  { q: multiDay ? `${f.name}從哪一天開始？` : `${f.name}是哪一天？`, a: dateSentence },
  { q: f.question, a: f.lead },
  ...(steps.length > 0 && mp
    ? [
        {
          q: `${f.name}怎麼拜？步驟是什麼？`,
          a: `${mp.title}的步驟為：${steps.map((s, i) => `${i + 1}. ${s.action}`).join('；')}。`,
        },
      ]
    : []),
  ...(offerings.length > 0 || jossPaper.length > 0
    ? [
        {
          q: `${f.name}要準備什麼供品和金紙？`,
          a:
            [
              offerings.length > 0 ? `供品：${offerings.join('、')}` : '',
              jossPaper.length > 0 ? `金紙：${jossPaper.join('、')}` : '',
            ]
              .filter(Boolean)
              .join('；') + '。',
        },
      ]
    : []),
  ...(taboos.length > 0 ? [{ q: `${f.name}有什麼禁忌？`, a: `${taboos.join('；')}。` }] : []),
]);

// meta description（2026-08-03）：原本是「日期句 ＋ lead 前 90 字」，
// 但日期已經在 title 裡（「中元節2026是哪一天？」），description 再講一次等於浪費半句。
// GSC 實測農曆七月的釘選字裡，「中元普渡」「普渡 供品」「七夕 拜什麼」「農曆七月 禁忌」全是 0 曝光——
// 而這些內容**頁面上本來就有**（普渡怎麼拜／供品與金紙／禁忌／地區差異四個區塊），
// 只是 title 與 description 都沒把它們露出來。
// 這裡只列**該頁真的渲染得出來**的區塊（依 steps/offerings/taboos/regionals 是否有資料），
// 零新增事實；沒有那些區塊的節日就退回原本的 lead。
// ⚠️ 非主場頁的 steps/offerings/taboos/regionals 已被清空，covers 自然為空、退回 lead——
//    這是對的：description 不該再宣稱本頁「說明供品與金紙」，那些內容已經移到主場頁了。
//    改列本頁真正獨有的東西（文資登錄），沒有就退回 lead。
const covers = [
  steps.length > 0 ? `${mainPractice?.data.title ?? f.name}怎麼拜` : '',
  offerings.length > 0 || jossPaper.length > 0 ? '供品與金紙' : '',
  taboos.length > 0 ? '禁忌' : '',
  regionals.length > 0 ? '地區差異' : '',
  heritages.length > 0 ? '文化資產登錄層級與公告文號' : '',
].filter(Boolean);
const defaultPageDesc = covers.length
  ? `${dateSentence}本頁說明${covers.join('、')}，逐條掛出處。${excerptAtBoundary(f.lead, 40)}`
  : `${dateSentence}${excerptAtBoundary(f.lead, 90)}`;

// 2026-08-09 起的農曆七月搜尋戰役：只重組本頁已掛源、也確實渲染的資料，
// 把「日期＋這頁真正回答的問題」放進 title/description。其他節日仍走通用模板。
// ⚠️ 不在這裡補新事實；下列字詞均來自 festivals.json 的 lead/question 或已渲染區塊。
const campaignSeo: Record<string, { title: string; description: string }> = {
  guimenkai: {
    title: `${year} 鬼門開是 ${solarMd(iso)}｜開龕門與起燈腳`,
    description: `${year} 鬼門開為國曆 ${solarMd(iso)}（${lunarLabel}）。整理基隆老大公廟開龕門、起燈腳與門口掛燈等現有掛源資料。`,
  },
  zhongyuan: {
    title: `${year} 中元節是 ${solarMd(iso)}｜普渡供品、金紙與祭拜順序`,
    description: `${year} 中元節為國曆 ${solarMd(iso)}（${lunarLabel}）。整理中元普渡的祭拜順序、供品、金紙、禁忌與地區差異，逐條掛出處。`,
  },
  qixi: {
    title: `${year} 七夕是 ${solarMd(iso)}｜七娘媽生、做十六歲與祭拜`,
    description: `${year} 七夕為國曆 ${solarMd(iso)}（${lunarLabel}）。台灣七夕也是七娘媽生，本頁整理七娘媽、做十六歲、七娘媽亭與台南開隆宮的現有掛源資料。`,
  },
  fangshuideng: {
    title: `${year} 放水燈是 ${solarMd(iso)}｜由來、對象與基隆中元祭`,
    description: `${year} 放水燈為國曆 ${solarMd(iso)}（${lunarLabel}）。說明「普照陰光」的用意、海上罹難者的祭祀對象，以及放水燈與基隆海港、雞籠中元祭的關係。`,
  },
  'jilong-zhongyuan': {
    title: `${year} 雞籠中元祭｜開龕門、放水燈與字姓輪值`,
    description: `${year} 雞籠中元祭自${lunarLabel}起，橫跨整個農曆七月。整理開龕門、豎燈篙、放水燈、公普、關龕門的儀式順序，以及字姓輪值與文化資產登錄。`,
  },
  qianggu: {
    title: `${year} 搶孤｜頭城、恆春日期與文化資產`,
    description: `${year} 搶孤日期不只一天：恆春於農曆七月十五，頭城於七月底關鬼門前。本頁整理兩地的現有掛源資料與文化資產登錄。`,
  },
  dizang: {
    title: `${year} 地藏王菩薩聖誕是 ${solarMd(iso)}｜短月日期與鬼門關`,
    description: `${f.name}傳統日期為${nominalLunarLabel}；${year} 農曆七月只有廿九日，因此落在國曆 ${solarMd(iso)}（${lunarLabel}）。本頁整理地藏信仰與鬼門關的現有掛源資料。`,
  },
};
const pageTitle = campaignSeo[f.slug]?.title ?? defaultPageTitle;
const pageDesc = campaignSeo[f.slug]?.description ?? defaultPageDesc;
const festivalOgSlugs = new Set([
  'baitiangong', 'qingming', 'guimenkai', 'jilong-zhongyuan', 'qixi',
  'fangshuideng', 'zhongyuan', 'qianggu', 'yimin', 'dizang',
]);
const festivalOgImage = festivalOgSlugs.has(f.slug) ? `/og/festivals/${f.slug}.png` : undefined;
const canonicalUrl = `https://folk.tw/festivals/${f.slug}/`;
const addToGoogleCalendar = googleCalendarUrl(f, iso, lunarLabel);
const festivalIcsUrl = `/festivals/${f.slug}.ics`;

// 節日頁是對節日與節俗的知識整理，不是本站主辦的線下活動。
// 因此用 Article，不宣稱 EventScheduled、OfflineEventAttendanceMode 或 folk.tw organizer。
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `https://folk.tw/festivals/${f.slug}/#article`,
  url: `https://folk.tw/festivals/${f.slug}/`,
  headline: pageTitle,
  description: pageDesc,
  inLanguage: 'zh-Hant-TW',
  about: { '@type': 'Thing', name: f.name },
  publisher: ORG,
  mainEntityOfPage: `https://folk.tw/festivals/${f.slug}/`,
};
const jsonLd = [
  breadcrumb([
    { name: '節日', path: '/festivals' },
    { name: f.name, path: `/festivals/${f.slug}` },
  ]),
  article,
  ...(faq ? [faq] : []),
].filter(Boolean);

---

<Base
  title={pageTitle}
  description={pageDesc}
  ogType="article"
  ogImage={festivalOgImage}
  ogImageAlt={festivalOgImage ? `${f.name}｜${year} 日期與節俗整理` : undefined}
  jsonLd={jsonLd}
  speakable={['h1', '.lead']}
  share={false}
>
  <nav class="crumb"><a href="/festivals/">節日</a> ／ {f.name}</nav>

  <header class="dh">
    <h1>{f.name}</h1>
    <p class="when">
      <strong>{year} 年國曆 {solarMd(iso)}</strong>
      <span class="muted">（{lunarLabel}）</span>
      <span class="cd" data-fest-date={iso}></span>
    </p>
    {f.date_note && <p class="muted small">{f.date_note}</p>}
    {
      f.aliases?.length > 0 && (
        <p class="muted small">別稱：{f.aliases.join('、')}</p>
      )
    }
  </header>

  <p class="lead">{dateSentence}{f.lead}</p>
  <ShareRow title={pageTitle} url={canonicalUrl} />
  <section class="calendar-reminder" aria-labelledby="calendar-reminder-title">
    <div>
      <h2 id="calendar-reminder-title">提醒我</h2>
      <p>把 {year} 年國曆 {solarMd(iso)} 加入行事曆；多日或異地日期差異請以本頁說明為準。</p>
    </div>
    <div class="calendar-actions">
      <a class="btn btn-primary" href={addToGoogleCalendar} target="_blank" rel="noreferrer"
        data-calendar-add data-calendar-id={f.slug} data-calendar-method="google">加入 Google Calendar</a>
      <a class="btn" href={festivalIcsUrl} download={`folk-tw-${f.slug}-${iso}.ics`}
        data-calendar-add data-calendar-id={f.slug} data-calendar-method="ics">下載 Apple／通用 .ics</a>
    </div>
  </section>
  <LineCta
    placement={`festival_${f.slug}`}
    title="下次直接在 LINE 查節日"
    description="在 LINE 打「節日」，就能看到接下來最近五個節日、國曆日期與還有幾天。"
  />
  {
    festivalOgImage && (
      <figure class="festival-visual">
        <img
          src={festivalOgImage}
          alt={`${f.name}：${year} 日期與節俗主視覺`}
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )
  }

  {/* 文資登錄：各節日真正獨有的事實（層級＋公告文號），此前完全沒渲染。
      🔴 措辭界線：只說「被登錄為什麼、文號是什麼」，不推論「所以當天有辦什麼」。 */}
  {
    heritages.length > 0 && (
      <section class="heritage">
        <h2>文化資產登錄</h2>
        {heritages.map((x) => (
          <div class="heritage-case">
            <p class="heritage-head"><strong>{x.name}</strong>　{HERITAGE_LABEL[x.h!.level!]}</p>
            <dl>
              {x.h!.authority && <><dt>主管機關</dt><dd>{x.h!.authority}</dd></>}
              {x.h!.venue && <><dt>登錄地點</dt><dd>{x.h!.venue}</dd></>}
              {(x.h!.preservers ?? []).length > 0 && (
                <><dt>保存者</dt><dd>{(x.h!.preservers ?? []).map((p) => `${p.name}${p.type ? `（${p.type}）` : ''}`).join('、')}</dd></>
              )}
              {(x.h!.criteria ?? []).length > 0 && (
                <><dt>登錄基準</dt><dd><ul class="criteria">{(x.h!.criteria ?? []).map((c) => <li>{c}</li>)}</ul></dd></>
              )}
              {x.h!.laws && <><dt>法令依據</dt><dd>{x.h!.laws}</dd></>}
              {(x.h!.announcements ?? []).length > 0 && (
                <><dt>公告沿革</dt><dd><ul class="announces">{(x.h!.announcements ?? []).map((a) => (
                  <li>{a.date}　{a.doc}{a.note && <span class="muted small">（{a.note}）</span>}</li>
                ))}</ul></dd></>
              )}
            </dl>
            {/* 🔴 逐字引用、未改寫（2026-08-09 取得文化部授權，條件＝標示資料來源連結）。
                明寫「引自」有兩個理由，與觀光署簡介那段同源：①授權條件要求標示出處
                ②這段文字的語氣與站上其他文案不同，要讓讀者知道那是官方原文、不是我們寫的。 */}
            {x.h!.register_reason && (
              <div class="quoted">
                <h3>登錄理由</h3>
                {x.h!.register_reason.split('\n').filter(Boolean).map((para) => <p>{para}</p>)}
              </div>
            )}
            {x.h!.history && (
              <div class="quoted">
                <h3>歷史沿革</h3>
                {x.h!.history.split('\n').filter(Boolean).map((para) => <p>{para}</p>)}
              </div>
            )}
            {(x.h!.notices ?? []).length > 0 && (
              <div class="quoted">
                <h3>參觀注意事項</h3>
                {(x.h!.notices ?? []).flatMap((n) => n.split('\n')).filter(Boolean).map((para) => <p>{para}</p>)}
              </div>
            )}
            {x.h!.case_id && (
              <p class="muted small">
                以上引自 <a href={`https://nchdb.boch.gov.tw/assets/overview/folklore/${x.h!.case_id}`} rel="nofollow">文化部國家文化資產網個案 {x.h!.case_id}</a>，逐字未改寫。
              </p>
            )}
          </div>
        ))}
      </section>
    )
  }

  {/* 儀式順序：名稱＋農曆時程。放在指路區塊之前——對雞籠中元祭這種頁，
      「哪幾天、什麼順序」正是使用者查的東西，比普渡通則更該先出現。 */}
  {
    ceremonyStages.length > 0 && (
      <section class="stages">
        <h2>儀式順序</h2>
        {ceremonyStages.map((x) => (
          <>
            {ceremonyStages.length > 1 && <h3>{x.name}</h3>}
            <ol class="stage-list">
              {x.stages.map((s) => (
                <li>
                  <strong>{s.name}</strong>
                  {s.schedule && <span class="muted small">　{s.schedule}</span>}
                  {s.lunar && s.lunar !== s.schedule && <span class="muted small">（{s.lunar}）</span>}
                  {s.description && <p class="stage-desc">{s.description}</p>}
                </li>
              ))}
            </ol>
          </>
        ))}
      </section>
    )
  }

  {/* 逐句掛源的補充事實。每一句自己帶來源，讀者看得到我們憑什麼這樣寫。 */}
  {
    facts.length > 0 && (
      <section class="facts">
        <h2>關於{f.name}的日期</h2>
        <ul>
          {facts.map((x) => (
            <li>
              {x.text}
              {x.sources.length > 0 && (
                <span class="muted small">
                  　—
                  {x.sources.map((s, i) => (
                    <>
                      {i > 0 && '、'}
                      <a href={s.ref.slice(s.ref.indexOf('http'))} rel="nofollow">
                        {s.ref.slice(0, s.ref.indexOf(' http') > 0 ? s.ref.indexOf(' http') : undefined)}
                      </a>
                    </>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* 非主場頁：不重刻一次普渡流程，指到正主頁。理由見 frontmatter 的 isPracticeHome 註解。 */}
  {
    !isPracticeHome && mainPractice && (
      <section class="practice-pointer">
        <h2>{mainPractice.data.title}怎麼拜</h2>
        <p>
          {f.name}沿用{mainPractice.data.title}的儀式流程，本站不在這裡重複一次：
          完整步驟、供品與金紙、禁忌與地區差異見
          <a href={`/practices/${mainPractice.id}/`}>{mainPractice.data.title}</a>
          {homeFestivalName && mp?.home_festival && (
            <>
              ，或<a href={`/festivals/${mp.home_festival}/`}>{homeFestivalName}</a>
            </>
          )}
          。
        </p>
      </section>
    )
  }

  {
    steps.length > 0 && mainPractice && (
      <section>
        <h2>{mainPractice.data.title}怎麼拜</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li>
              {s.action}
              {s.note && <span class="muted small"> — {s.note}</span>}
              {(s.taboo ?? []).length > 0 && <span class="taboo"> ⚠ {(s.taboo ?? []).join('；')}</span>}
            </li>
          ))}
        </ol>
        <p class="muted small">
          完整儀式流程與地區差異見 <a href={`/practices/${mainPractice.id}/`}>{mainPractice.data.title}</a>。
        </p>
      </section>
    )
  }

  {
    (offerings.length > 0 || jossPaper.length > 0) && (
      <section>
        <h2>供品與金紙</h2>
        {offerings.length > 0 && (
          <p><strong>供品：</strong>{offerings.join('、')}</p>
        )}
        {jossPaper.length > 0 && (
          <p><strong>金紙：</strong>{jossPaper.join('、')}</p>
        )}
      </section>
    )
  }

  {
    taboos.length > 0 && (
      <section>
        <h2>禁忌</h2>
        <ul>{taboos.map((t) => <li>{t}</li>)}</ul>
      </section>
    )
  }

  {
    regionals.length > 0 && (
      <section>
        <h2>地區差異</h2>
        <dl class="regional">
          {regionals.map((r) => (
            <>
              <dt>{r.area}</dt>
              <dd>{r.note}</dd>
            </>
          ))}
        </dl>
      </section>
    )
  }

  {
    linkedVocab.length > 0 && (
      <section>
        <h2>相關詞彙</h2>
        <dl class="regional">
          {linkedVocab.map((t) => (
            <>
              <dt><a href={`/vocabulary/#${t!.term}`}>{t!.term}</a></dt>
              <dd>{t!.def}</dd>
            </>
          ))}
        </dl>
      </section>
    )
  }

  {
    linkedDeities.length > 0 && (
      <section>
        <h2>相關神明</h2>
        <ul>
          {linkedDeities.map((d) => (
            <li>
              <a href={`/deities/${d!.id}/`}>{d!.data.name}</a>
              {d!.data.summary && <span class="muted small"> — {d!.data.summary}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    linkedEvents.length > 0 && (
      <section>
        <h2>相關民俗活動</h2>
        <ul>
          {linkedEvents.map((e) => (
            <li>
              <a href={`/events/${e!.id}/`}>{e!.data.name}</a>
              {e!.data.date_note && <span class="muted small"> — {e!.data.date_note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    linkedTemples.length > 0 && (
      <section>
        <h2>相關宮廟</h2>
        <ul>
          {linkedTemples.map((t) => (
            <li>
              <a href={`/temples/${t!.id}/`}>{t!.data.name}</a>
              <span class="muted small"> — {t!.data.district}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    templesOnDate.length > 0 && (
      <section class="on-date">
        <h2>{lunarLabel}當天有登記祭典的宮廟</h2>
        <p class="muted small">
          全台共 {num(templesOnDate.length)} 間宮廟向內政部登記了{lunarLabel}的慶(祭)典。
          廟名後為該廟自己登記的祭典名稱。資料源自內政部全國宗教資訊網「慶(祭)典查詢」。
        </p>
        {/* 前 60 間直接列出，其餘收進 <details>（2026-08-08）：中元節那頁光這一段就好幾千 px，
            整頁 7,700px 有大半是這份清單，後面的「其他節日」實際上沒人捲得到。
            ⚠️ 收合用原生 <details>＋靜態 markup，**全部宮廟仍然在 HTML 裡**——
            爬蟲讀得到、內鏈一條都沒少（同 nav 的理由，不用 JS 分頁）。 */}
        <ul class="on-date-list">
          {templesOnDate.slice(0, 60).map((t) => (
            <li>
              <a href={`/temples/${t.id}/`}>{t.name}</a>
              {t.county && <span class="muted small"> {t.county}</span>}
              <span class="fname small"> — {t.festival}</span>
            </li>
          ))}
        </ul>
        {templesOnDate.length > 60 && (
          <details class="disclosure more-temples">
            <summary>展開其餘 {templesOnDate.length - 60} 間</summary>
            <ul class="on-date-list">
              {templesOnDate.slice(60).map((t) => (
                <li>
                  <a href={`/temples/${t.id}/`}>{t.name}</a>
                  {t.county && <span class="muted small"> {t.county}</span>}
                  <span class="fname small"> — {t.festival}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    )
  }

  {
    localOnDate.length > 0 && (
      <section class="local-on-date">
        <h2>{lunarLabel}登錄的地方宗教慶典</h2>
        <p class="muted small">
          內政部全國宗教資訊網「地方宗教慶典」中，登錄日期為{lunarLabel}的共 {localOnDate.length} 項。
          這是縣市層級登錄的慶典清單，與上面各宮廟自己登記的祭典是兩份不同的資料。
        </p>
        <ul class="local-list">
          {localOnDate.map((x) => (
            <li>
              <span class="lname">{x.name}</span>
              <span class="muted small">{x.county}</span>
            </li>
          ))}
        </ul>
        <p class="muted small">
          全部 {localCelebrations.items.length} 項見 <a href="/festivals/local/">全台地方宗教慶典</a>。
        </p>
      </section>
    )
  }

  {
    siblingFestivals.length > 0 && (
      <section class="sibling-festivals">
        <h2>{f.season}的其他節日</h2>
        <ul class="sibling-list">
          {siblingFestivals.map((s) => (
            <li>
              <a href={`/festivals/${s.slug}/`}>{s.name}</a>
              <span class="sfdate">{s.lunarLabel}（國曆 {Number(s.iso.slice(5, 7))}/{Number(s.iso.slice(8, 10))}）</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="muted small extend">
    延伸：<a href="/festivals/">其他節日</a>｜<a href="/deities/birthdays/">神明聖誕曆</a>｜<a href="/practices/"
      >拜拜習俗</a
    >｜<a href="/qiugian/">線上求籤</a>｜<a href="/almanac/">農民曆</a>
  </p>

  {sources.length > 0 && <p class="src footer-src"><Sources sources={sources} /></p>}

  <script is:inline>
    (function () {
      const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Taipei' }).format(new Date());
      const toUTC = (s) => { const [y, m, d] = s.split('-').map(Number); return Date.UTC(y, m - 1, d); };
      document.querySelectorAll('[data-fest-date]').forEach((el) => {
        const days = Math.round((toUTC(el.getAttribute('data-fest-date')) - toUTC(today)) / 86400000);
        if (days < 0) return;
        el.textContent = days === 0 ? '就是今天' : days === 1 ? '明天' : days + ' 天後';
      });
    })();
  </script>

  <style>
    .crumb { color: var(--ink-soft); font-size: var(--text-sm); margin-bottom: 0.625rem; }
    .dh h1 { margin: 0.25rem 0 0.5rem; }
    .when { margin: 0 0 0.375rem; }
    .when strong { color: var(--accent); font-size: var(--text-lg); }
    .cd { color: var(--gold); font-size: var(--text-sm); margin-left: 0.5rem; }
    .lead { font-size: var(--text-base); }
    .calendar-reminder { margin: 1rem 0 1.5rem; padding: 1rem; border: 1px solid var(--line);
      display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .calendar-reminder h2 { margin: 0 0 0.25rem; padding: 0; border: 0; font-size: var(--text-lg); }
    .calendar-reminder p { margin: 0; color: var(--ink-soft); font-size: var(--text-sm); }
    .calendar-actions { display: flex; flex-wrap: wrap; gap: 0.625rem; flex: none; }
    .festival-visual { margin: 1rem 0 1.5rem; }
    .festival-visual img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; margin-top: 2rem; }
    .steps { padding-left: 1.5rem; }
    .steps li { margin-bottom: 0.625rem; }
    .taboo { color: var(--accent); font-size: var(--text-sm); }
    .heritage-case { margin-bottom: 1.25rem; }
    .heritage-case dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1rem; margin: 0.5rem 0; }
    .heritage-case dt { color: var(--gold); font-size: var(--text-sm); }
    .heritage-case dd { margin: 0; }
    .heritage-case ul.criteria, .heritage-case ul.announces { margin: 0; padding-left: 1.1rem; }
    .stages .stage-list { line-height: 1.9; }
    .stages .stage-desc { margin: 0.25rem 0 0.75rem; line-height: 1.8; }
    .quoted { margin-top: 1rem; }
    .quoted h3 { color: var(--gold); font-size: var(--text-sm); margin-bottom: 0.35rem; }
    .quoted p { line-height: 1.8; margin: 0 0 0.5rem; }
    .facts li { line-height: 1.9; margin-bottom: 0.4rem; }
    .regional dt { font-weight: 700; margin-top: 0.75rem; }
    .regional dd { margin: 0.25rem 0 0; color: var(--ink-soft); }
    .small { font-size: var(--text-sm); }
    .src { color: var(--gold); font-size: var(--text-xs); }
    .on-date-list { list-style: none; padding: 0; margin: 0.75rem 0 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 0.5rem 1rem; }
    .on-date-list li { padding-bottom: 0.375rem; border-bottom: 1px dashed var(--line); }
    .on-date-list .fname { color: var(--ink-soft); }
    .more-temples { margin-top: 1rem; }
    .local-on-date { margin-top: 1.5rem; }
    .local-list { list-style: none; padding: 0; margin: 0.75rem 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 0.5rem 1rem; }
    .local-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.625rem;
