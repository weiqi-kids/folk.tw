---
// 全台地方宗教慶典年曆（2026-08-06 上線；slug `/festivals/local/` ＝永久承諾勿改）。
//
// 資料是內政部「地方宗教慶典」＝**縣市層級**政府登錄的慶典，與站上另外兩種慶典事實不同：
//   · `temples.json` 的 `festivals[]`＝廟方自己登記的年度祭典（主體是廟）
//   · `festivals.json` 的節日頁＝全台性節俗（主體是節日）
//   · 本頁＝縣市登錄的地方慶典（主體是縣市）
// 三者不可互相推論。本頁只陳述「這份官方清單裡有這一項」，不說「某廟在辦」。
//
// 🔴 每筆能用的只有四個欄位（縣市／曆別／月日／名稱）——詳情頁的簡介與照片是
//    語文／攝影著作，授權不允許取用，所以本頁不會有任何介紹文字。**別替它們補寫簡介**，
//    那就是杜撰（總紅線第 1 條）。授權脈絡見 docs/taiwan-intake-status.md §二。
//
// 日期換算：一律走 lib/calendar-date.ts 的 nextOccurrence()，在 build 時算；
// 倒數由頁尾同一套前端腳本依台灣時區即時算，故 [skip ci] 的日子也不會過期。
// ⚠️ **回曆 2 筆（開齋節）刻意不換算**：伊斯蘭曆與國曆的對應每年前移約 11 天，
//    我們沒有可信的換算來源，硬算就是杜撰。這兩筆只照抄來源寫法並明說不換算。
//    2026-08-20 起這件事由型別保證：`nextOccurrence()` 對 `cal:'hijri'` 回 null，
//    本檔沒有辦法「不小心」把它送進國曆或農曆那一支（見該檔檔頭）。
// ⚠️ **數年一科的慶典也不換算**（2026-08-19 加，同一條原則的第二個應用）：來源只給月日、
//    沒給舉辦週期，照算就會替主辦廟宣稱一個不會發生的日期（線上實測蕭壟香／土城香／
//    西港香三筆全錯，蕭壟香 2027 年根本不辦）。判定唯一入口＝lib/local-celebration-cycle.ts，
//    權威依據是國家文化資產網的 holdPeriod。**別把那個判定搬進本檔或另寫一份。**
//
// 兩種分組（依縣市／依月份）**都在 build 時渲染好**，切換只切 CSS class。
// 刻意不用 JS 注入 DOM——那會踩到 scoped <style> 套不到注入節點的坑（見 check:scoped-styles）。
import Base from '../../../layouts/Base.astro';
import Sources from '../../../components/Sources.astro';
import LeadVisual from '../../../components/LeadVisual.astro';
import { faqPage } from '../../../lib/seo';
import { HUB } from '../../../lib/breadcrumbs';
import { calendarDateLabelShort, nextOccurrence, parseCalendarDate, solarMd } from '../../../lib/calendar-date';
import { celebrationCycle, celebrationDateDisowned, celebrationDateOverride } from '../../../lib/local-celebration-cycle';
import { hasTimeline, timelineItems } from '../../../lib/celebration-occurrences';
import OccurrenceTimeline from '../../../components/OccurrenceTimeline.astro';
import { todayInTaipei } from '../../../lib/daily';
import { getEvents, getTemples } from '../../../lib/queries';
import lc from '../../../data/local-celebrations.json';

const { iso: today } = todayInTaipei();
const temples = await getTemples();
const templeById = new Map(temples.map((t) => [t.id, t.data]));
// 清單頁只用一張已掛身分與授權的活動照片作「資料示例」，不暗示它代表全部地方慶典。
const localVisual = (await getEvents()).find((e) => e.id === 'jilong')?.data.image;

// 每筆算「下一次國曆日期」。回曆無法換算 → iso 為 null，仍然要列出（資料本身是事實），
// 只是不進「近期」排序、也不顯示國曆。
const items = lc.items.map((raw) => {
  // 🔴 來源的月日被權威資料證實有誤時，用對帳檔裡的修正值（附依據）。沒有修正值就照來源。
  //    直接改 local-celebrations.json 會被下次匯入蓋回去，所以修正住在對帳檔。
  const ov = celebrationDateOverride(raw.id);
  const x = ov ? { ...raw, calendar: ov.calendar, date: ov.date } : raw;
  // 曆別＋月日先進型別世界（唯一關口）。認不得的曆別回 null＝什麼都不陳述；
  // 改動前這裡是 `x.calendar === 'lunar' ? … : x.calendar === 'solar' ? … : …`，
  // 認不得的曆別會掉進最後一個分支被當成回曆印出去。schema 已擋，型別再擋一次。
  const cd = parseCalendarDate(x.calendar, x.date);
  // 舉辦週期先問 lib：非每年的一律不算國曆日（理由見檔頭）。
  const cycle = celebrationCycle(x.id);
  // 🔴 有歷年紀錄＝我們已經查到它的日期**逐年不同**（數年一科、擲筊定日、或來源
  //    彼此矛盾），那就不要再算一個年度日期出來，改把讀者帶去下方的歷年紀錄。
  //    這比原本那句「以主辦單位公告為準」有用：免責換成內容（2026-08-19 站主裁示）。
  const tl = hasTimeline(x.id);
  // 回曆：nextOccurrence() 回 null（不換算），與「算得出來但那年沒有這一天」
  // （回 `{iso:null}`）是兩件事，見 calendar-date.ts 檔頭。這裡兩者都不顯示國曆日。
  const iso = !cycle.annual || tl || !cd ? null : (nextOccurrence(cd, today)?.iso ?? null);
  const m = Number(x.date.slice(0, 2));
  const d = Number(x.date.slice(3));
  // 🔴 月日的**歸屬**錯了（來源把另一件事的日期掛在這一筆上）就整個不陳述——
  //    沒有正確值可以換，印出來等於替主辦方宣稱一個它沒公告過的日期。
  //    判定在 lib（date_disown），本檔不自己認定。實例＝lc_59 市府版鞦韆節。
  const disowned = celebrationDateDisowned(x.id) !== null;
  const dateLabel = disowned || !cd ? null : calendarDateLabelShort(cd);
  const temple = x.temple_ref ? templeById.get(x.temple_ref) : undefined;
  // 有時間軸就用短版：長版那句「以主辦單位公告為準」的用途是把讀者導去主辦方，
  // 但我們自己就列了歷年紀錄，留著只會讓同一行擠兩個訊息。
  const note = tl ? (cycle.shortNote ?? '日期逐年不同') : cycle.note;
  return { ...x, iso, dateLabel, disowned, month: m, temple, cycle, tl, note };
});

// 依縣市分組：縣市內用「曆別→月日」排，與資料檔的排序一致。
const counties = [...new Set(items.map((i) => i.county))].sort((a, b) => a.localeCompare(b, 'zh-Hant'));
const byCounty = counties.map((c) => ({ county: c, list: items.filter((i) => i.county === c) }));

// 依月份分組：只分農曆月（多數），國曆與回曆各自成組——把三種曆別混在同一個「一月」底下
// 會讓讀者以為它們是同一天，那是我們自己製造的誤導。
// 🔴 月日歸屬錯誤的（disowned）不進任何月份組——把它排進農曆三月，就是拿那個不屬於它的
//    日期做了一次分類陳述，跟印在名稱旁邊是同一個錯誤。另立一組收容。
const datedItems = items.filter((i) => !i.disowned);
const lunarMonths = [...new Set(datedItems.filter((i) => i.calendar === 'lunar').map((i) => i.month))].sort(
  (a, b) => a - b,
);
const byMonth = [
  ...lunarMonths.map((m) => ({
    label: `農曆${['', '正', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一', '十二'][m]}月`,
    list: datedItems.filter((i) => i.calendar === 'lunar' && i.month === m),
  })),
  { label: '國曆日期', list: datedItems.filter((i) => i.calendar === 'solar') },
  { label: '回曆日期', list: datedItems.filter((i) => i.calendar === 'hijri') },
  { label: '日期逐年不同', list: items.filter((i) => i.disowned) },
].filter((g) => g.list.length > 0);

// 近期：只有算得出國曆日的（農曆＋國曆）進榜，取最近 8 筆。
const upcoming = items
  .filter((i): i is typeof i & { iso: string } => i.iso !== null)
  .sort((a, b) => a.iso.localeCompare(b.iso))
  .slice(0, 8);

const linked = items.filter((i) => i.temple);

const faq = faqPage([
  {
    q: '全台有哪些地方宗教慶典？',
    a: `內政部全國宗教資訊網登錄的地方宗教慶典共 ${items.length} 項，分布於 ${counties.length} 個縣市，其中 ${
      datedItems.filter((i) => i.calendar === 'lunar').length
    } 項採農曆日期。`,
  },
  ...(upcoming[0]
    ? [
        {
          q: '下一個地方宗教慶典是什麼時候？',
          a: `${upcoming[0].county}的${upcoming[0].name}，${upcoming[0].dateLabel}，${upcoming[0].iso.slice(0, 4)} 年為國曆 ${solarMd(upcoming[0].iso)}。`,
        },
      ]
    : []),
  {
    q: '地方宗教慶典和廟方登記的年度祭典有什麼不同？',
    a: '地方宗教慶典是縣市政府層級登錄的慶典活動，主體是縣市；廟方登記的年度慶(祭)典則是各宮廟自己向內政部登記的，主體是宮廟。兩者資料來源不同，不能互相推論。',
  },
]);

---

<Base
  title={`全台地方宗教慶典一覽｜${counties.length} 縣市的登錄慶典與日期`}
  description={`內政部登錄的地方宗教慶典完整清單：鹽水蜂炮、大甲媽祖遶境進香、頭城搶孤、東港迎王、鷄籠中元祭等 ${items.length} 項，含所在縣市與農曆／國曆日期。每年舉辦的已換算成下一次的國曆日，數年一科的不換算。`}
  og={{ family: 'visual', stem: 'prayer-light' }}
  faq={faq}
  answer="lead"
  crumbs={[HUB.festivals, HUB.festivalsLocal]}
>

  <h1>全台地方宗教慶典</h1>
  <p class="lead">
    內政部全國宗教資訊網登錄的地方宗教慶典共 {items.length} 項，分布在 {counties.length} 個縣市。
    每年舉辦的慶典，農曆日期已換算成下一次的國曆日期；<strong>數年一科的不換算</strong>——
    那類慶典的日期由主辦廟逐科公告，算出一個年度日期會是錯的。可依縣市或依月份查看。
    這份清單記的是<strong>縣市登錄了哪些慶典</strong>，與各宮廟自己登記的<a href="/festivals/">年度祭典</a>是兩份不同的資料。
  </p>

  {
    localVisual && (
      <>
        <LeadVisual image={localVisual} />
        <p class="muted small visual-note">圖片為地方宗教慶典資料示例：雞籠中元祭；不代表清單中的全部慶典。</p>
      </>
    )
  }

  <section>
    <h2>近期</h2>
    <ul class="upcoming">
      {
        upcoming.map((i) => (
          <li>
            <span class="u-date">{solarMd(i.iso)}</span>
            <span class="u-name">{i.name}</span>
            <span class="muted small">{i.county}　·　{i.dateLabel}</span>
            <span class="cd" data-fest-date={i.iso}></span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <div class="tabs" role="group" aria-label="分組方式">
      <button type="button" class="tab on" data-view="county" aria-pressed="true">依縣市</button>
      <button type="button" class="tab" data-view="month" aria-pressed="false">依月份</button>
    </div>

    <div id="lc-county" class="view on">
      {
        byCounty.map((g) => (
          <section class="grp">
            <h2>{g.county}<span class="cnt">{g.list.length}</span></h2>
            <ul class="lc-list">
              {g.list.map((i) => (
                <li>
                  {i.dateLabel && <span class="ldate">{i.dateLabel}</span>}
                  <span class="lname">{i.name}</span>
                  {i.iso && <span class="lsolar">國曆 {solarMd(i.iso)}</span>}
                  {i.note && <span class="lsolar">{i.note}</span>}
                  {i.tl && <a class="lsolar ltl" href={`#tl-${i.id}`}>歷年舉辦紀錄</a>}
                  {i.calendar === 'hijri' && <span class="lsolar">國曆日期逐年不同，本站不換算</span>}
                  {i.temple && (
                    <a class="ltemple" href={`/temples/${i.temple_ref}/`}>{i.temple.name}</a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div id="lc-month" class="view">
      {
        byMonth.map((g) => (
          <section class="grp">
            <h2>{g.label}<span class="cnt">{g.list.length}</span></h2>
            <ul class="lc-list">
              {g.list.map((i) => (
                <li>
                  {i.dateLabel && <span class="ldate">{i.dateLabel}</span>}
                  <span class="lname">{i.name}</span>
                  <span class="muted small">{i.county}</span>
                  {i.iso && <span class="lsolar">國曆 {solarMd(i.iso)}</span>}
                  {i.note && <span class="lsolar">{i.note}</span>}
                  {i.tl && <a class="lsolar ltl" href={`#tl-${i.id}`}>歷年舉辦紀錄</a>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  {
    linked.length > 0 && (
      <section>
        <h2>清單中以宮廟為名的項目</h2>
        <p class="muted small">
          以下 {linked.length} 項的慶典名稱裡有本站收錄的宮廟名，且該廟名在所在縣市可唯一辨識，
          因此連得到廟宇頁。同名而無法唯一辨識者不連。
        </p>
        <ul class="lc-list">
          {linked.map((i) => (
            <li>
              {i.dateLabel && <span class="ldate">{i.dateLabel}</span>}
              <span class="lname">{i.name}</span>
              <a class="ltemple" href={`/temples/${i.temple_ref}/`}>{i.temple!.name}</a>
              <span class="muted small">{i.temple!.district}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    timelineItems().length > 0 && (
      <section class="tlsec">
        <h2>歷年舉辦紀錄</h2>
        <p>
          下面這些慶典的日期<strong>不是每年固定</strong>——有的數年一科，有的由主辦廟擲筊決定當年日期，
          有的登錄資料與活動慣例記載不同。算一個年度日期出來會是錯的，所以這裡改列實際辦過哪幾次，
          每一筆都連回它自己的來源。
        </p>
        {timelineItems().map((row) => (
          <section class="tlone" id={`tl-${row.lc_id}`}>
            <h3>{row.name}</h3>
            <OccurrenceTimeline
              occurrences={row.occurrences}
              nextAnnounced={row.next_announced}
              pendingLabel="下一次日期尚未公告"
            />
          </section>
        ))}
      </section>
    )
  }

  <p class="muted small extend">
    延伸：<a href="/festivals/">民俗節日曆</a>｜<a href="/events/">民俗活動</a>｜<a href="/temples/">宮廟</a>｜<a
      href="/almanac/">農民曆</a
    >｜<a href="/qiugian/">線上求籤</a>
  </p>

  <Sources sources={[lc.source]} variant="footer" />

  <script is:inline>
    (function () {
      const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Taipei' }).format(new Date());
      const toUTC = (s) => { const [y, m, d] = s.split('-').map(Number); return Date.UTC(y, m - 1, d); };
      document.querySelectorAll('[data-fest-date]').forEach((el) => {
        const days = Math.round((toUTC(el.getAttribute('data-fest-date')) - toUTC(today)) / 86400000);
        if (days < 0) return;
        el.textContent = days === 0 ? '就是今天' : days === 1 ? '明天' : days + ' 天後';
      });
      // 兩份清單都是 build 時就渲染好的，這裡只切 class，不動 DOM 結構。
      document.querySelectorAll('.tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          const view = btn.getAttribute('data-view');
          document.querySelectorAll('.tab').forEach((b) => {
            const on = b === btn;
            b.classList.toggle('on', on);
            b.setAttribute('aria-pressed', String(on));
          });
          document.getElementById('lc-county').classList.toggle('on', view === 'county');
          document.getElementById('lc-month').classList.toggle('on', view === 'month');
        });
      });
    })();
  </script>

  <style>
  .tlsec { margin-top: 2rem; }
  .tlone { margin-top: 1.25rem; }
  .tlone h3 { margin-bottom: 0.25rem; }
  .ltl { color: var(--accent); }

    .lead { font-size: var(--text-base); }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; margin-top: 2rem; }
    .cnt { color: var(--ink-soft); font-size: var(--text-sm); margin-left: 0.5rem; font-weight: 400; }
    .small { font-size: var(--text-sm); }
    .cd { color: var(--gold); font-size: var(--text-sm); }
    .upcoming { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .upcoming li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem;
      padding-bottom: 0.375rem; border-bottom: 1px dashed var(--line); }
    .u-date { color: var(--accent); font-weight: 700; }
    .u-name { color: var(--ink); }
    .tabs { display: flex; gap: 0.5rem; margin-top: 1.5rem; }
    .tab { font: inherit; font-size: var(--text-sm); padding: 0.375rem 0.875rem; cursor: pointer;
      color: var(--ink-soft); background: transparent; border: 1px solid var(--line); border-radius: 999px; }
    .tab.on { color: var(--ink); border-color: var(--accent); }
    .view { display: none; }
    .view.on { display: block; }
    .grp h2 { margin-top: 1.75rem; }
    .lc-list { list-style: none; padding: 0; margin: 0.75rem 0 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 0.5rem 1.5rem; }
    /* 2026-08-08：原本「農曆日期／慶典名／國曆／廟名」四個東西同一行、同字級、同基線，
       主角是誰看不出來，六十幾筆疊起來就是一片密密麻麻的小字。
       改成慶典名獨佔第一行、其餘降一級排第二行——資料與順序都沒動，只用 order 換視覺層次。 */
    .lc-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.125rem 0.625rem;
      padding-bottom: 0.5rem; border-bottom: 1px dashed var(--line); }
    .ldate { color: var(--accent); font-size: var(--text-xs); }
    .lname { order: -1; flex: 1 1 100%; color: var(--ink); font-size: var(--text-base); }
    .lsolar { color: var(--ink-soft); font-size: var(--text-xs); }
    .ltemple { font-size: var(--text-xs); }
    .extend { margin-top: 1.875rem; }
    .visual-note { margin-top: -1rem; }
  </style>
</Base>
