---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import RelatedSeasonalCampaign from '../../components/RelatedSeasonalCampaign.astro';
import { getEvents, getDeities, templeNameById } from '../../lib/queries';
import { faqPage, eventThing } from '../../lib/seo';
import { HUB } from '../../lib/breadcrumbs';
import { releasedItems } from '../../lib/release-schedule';
import festivalsData from '../../data/festivals.json';

export const getStaticPaths = (async () => {
  const events = await getEvents();
  return events.map((e) => ({ params: { id: e.id }, props: { event: e } }));
}) satisfies GetStaticPaths;

const { event } = Astro.props;
const e = event.data;
const deities = await getDeities();
const deityName = new Map(deities.map((d) => [d.id, d.data.name]));
const deityById = new Map(deities.map((d) => [d.id, d.data]));
const isNode = (id: string) => deityName.has(id);
// 廟宇對映：host/destination 若為有效 temple id 則連 /temples（否則維持純文字佔位）。
const templeName = await templeNameById();
const hostIsTemple = e.host_temple ? templeName.has(e.host_temple) : false;
const destIsTemple = e.destination_temple ? templeName.has(e.destination_temple) : false;
// 節日頁 festivals.json 的 event_refs 早已單向連到本頁（/festivals/[slug] → /events/[id]），
// 這裡補反向連結（/events/[id] → /festivals/[slug]），零新增事實，純衍生自既有欄位。
// ⚠️ 型別標註不可省：festivals.json 有些條目的 event_refs 是空陣列字面量，TS 推成 never[]，
// union 後 .includes(string) 會報 ts(2345)。deploy.yml 的「型別檢查」step 會跑 astro check，
// 但 `pnpm build:release` 不含它——2026-08-03 的 reflect commit 194e665 因此推上一個 CI 擋門的錯，
// 從 08:24 起所有部署失敗。改動 JSON 衍生欄位時一律顯式標型別（同 temples/[id].astro 的 deity_refs）。
const linkedFestivals = releasedItems(festivalsData).filter((f) =>
  ((f as { event_refs?: string[] }).event_refs ?? []).includes(event.id),
);

const HERITAGE: Record<string, string> = {
  national_important: '國家重要民俗',
  municipal: '直轄市定民俗',
  county: '縣市定民俗',
  none: '未登錄',
};
const CYCLE: Record<string, string> = { annual: '年度', n_year_ke: '數年一科', irregular: '不定' };
const ROUTE: Record<string, string> = {
  fixed: '固定路線', yearly_versioned: '逐年版本化', undetermined: '不定（臨場決定）',
};
const HERITAGE_D: Record<string, string> = { national_important: '國家重要民俗', municipal: '直轄市定民俗', county: '縣市定民俗', none: '' };
const pageDesc =
  `${e.name}：${e.type.join('、')}${e.main_deity && deityName.has(e.main_deity) ? `，主神${deityName.get(e.main_deity)}` : ''}` +
  `${e.heritage ? `，${HERITAGE_D[e.heritage.level]}` : ''}${e.region.length ? `，${e.region.join('、')}` : ''}。${e.date_note ?? ''}`;

type EventFact = {
  text: string;
  sources: { type: string; ref: string; note?: string }[];
};
const facts = (e as { facts?: EventFact[] }).facts ?? [];
const heritageCaseUrl = e.heritage?.case_id
  ? `https://nchdb.boch.gov.tw/assets/overview/folklore/${e.heritage.case_id}`
  : '';

// 正文代表圖優先用本活動自己的 Wikimedia Commons 紀實照（資料內含作者／授權／來源）。
// 僅兩個尚無活動照的頁面退到其主神既有授權圖，且圖說明確寫「非本活動現場紀實」，
// 避免把神像照片冒充特定活動的影像紀錄。若連主神圖也沒有，才用站內品牌通用視覺。
const deityFallbackImage = e.main_deity ? deityById.get(e.main_deity)?.image : undefined;
const pageImage = e.image
  ? { ...e.image, genericNote: '' }
  : deityFallbackImage
    ? { ...deityFallbackImage, genericNote: `${deityName.get(e.main_deity) ?? '相關神明'}通用神像視覺，非${e.name}現場紀實。` }
    : {
        src: '/og.png', alt: '神酷站內通用視覺', author: '神酷', license: '', source: '',
        genericNote: `站內通用視覺，非${e.name}現場紀實。`,
      };
const pageImageWidth = pageImage.src === '/og.png' ? 1200 : 240;
const pageImageHeight = pageImage.src === '/og.png' ? 630 : 240;

// P1-4 AEO：FAQ 由真實資料生成，缺資料的問答自動略過。
const eDeity = e.main_deity && deityName.has(e.main_deity) ? deityName.get(e.main_deity) : '';
const faq = faqPage([
  {
    q: `${e.name}是什麼活動？`,
    a: `${e.name}是${e.type.join('、')}類民俗活動${eDeity ? `，主神為${eDeity}` : ''}${e.region.length ? `，流傳於${e.region.join('、')}` : ''}。`,
  },
  {
    q: `${e.name}什麼時候舉行？`,
    a: e.date_note
      ? `${e.name}約於${e.date_note}舉行${e.cycle === 'n_year_ke' ? `，${e.ke_rule ? `${e.ke_rule}年` : '數年'}一科` : e.cycle === 'annual' ? '，每年一次' : ''}${e.date_resolution === 'divined' ? '；確切日期由廟方擲筊擇定' : ''}。`
      : '',
  },
  {
    q: `${e.name}屬於哪種民俗活動類型？`,
    a: e.type.length ? `${e.name}屬於${e.type.join('、')}。` : '',
  },
  {
    q: `${e.name}是文化資產嗎？`,
    a:
      e.heritage && e.heritage.verified && e.heritage.level !== 'none'
        ? `${e.name}已登錄為${HERITAGE[e.heritage.level]}。`
        : '',
  },
]);

// Event（民俗活動）：地點優先取主辦廟／目的廟，否則首個路線節點，再否則地域首筆；
// 經緯度僅取首個 lat/lng 俱全的路線節點。
const firstGeoStop = e.route?.stops.find((s) => s.lat != null && s.lng != null);
const eventLocation =
  (e.host_temple ? templeName.get(e.host_temple) ?? e.host_temple : undefined) ??
  (e.destination_temple ? templeName.get(e.destination_temple) ?? e.destination_temple : undefined) ??
  e.route?.stops[0]?.name ?? e.region[0];
// startDate 一律省略：本站活動多為 fixed_lunar／divined／undetermined，無真實國曆 ISO 日期，
// 避免杜撰國曆日期（日期資訊已由頁面內文與 FAQ 承載）。
const eventLd = eventThing({
  name: e.name,
  description: pageDesc,
  url: `https://folk.tw/events/${event.id}/`,
  location: eventLocation,
  locationLat: firstGeoStop?.lat,
  locationLng: firstGeoStop?.lng,
  eventType: e.type[0],
  startDate: undefined,
});

const jsonLd: object[] = [
  ...(faq ? [faq] : []),
  eventLd,
];
---

<Base
  title={e.name}
  description={pageDesc}
  ogType="article"
  ogImage="/og/discover/prayer-light.webp"
  ogImageWidth={1200}
  ogImageHeight={675}
  jsonLd={jsonLd}
  speakable={['h1', '.summary']}
  crumbs={[HUB.events, { name: e.name, path: `/events/${event.id}/` }]}
>
  <h1>{e.name}</h1>
  <p class="summary">{pageDesc}</p>
  <RelatedSeasonalCampaign festivalSlugs={linkedFestivals.map((f) => f.slug)} />
  <figure class="entry-photo">
    <img src={pageImage.src} alt={pageImage.alt} width={pageImageWidth} height={pageImageHeight} loading="lazy" decoding="async" />
    <figcaption class="muted small">
      {pageImage.genericNote && <span>{pageImage.genericNote} </span>}
      {
        pageImage.source ? (
          <>
            圖：<a href={pageImage.source} target="_blank" rel="noopener nofollow">{pageImage.author}</a>
            {pageImage.license && (
              <>
                ・{pageImage.license_url
                  ? <a href={pageImage.license_url} target="_blank" rel="noopener nofollow">{pageImage.license}</a>
                  : pageImage.license}
              </>
            )}
          </>
        ) : '圖：神酷站內素材'
      }
    </figcaption>
  </figure>
  <p>{e.type.map((t) => <span class="tag">{t}</span>)}</p>

  <dl class="rec">
    <div>
      <dt>主神</dt>
      <dd>
        {isNode(e.main_deity)
          ? <a href={`/deities/${e.main_deity}/`}>{deityName.get(e.main_deity)}</a>
          : <span>{e.main_deity} <span class="tag">節點待建</span></span>}
      </dd>
    </div>
    <div>
      <dt>主辦廟</dt>
      <dd>
        {hostIsTemple
          ? <a href={`/temples/${e.host_temple}/`}>{templeName.get(e.host_temple!)}</a>
          : (e.host_temple ?? '—')}
      </dd>
    </div>
    {e.destination_temple && (
      <div>
        <dt>目的廟</dt>
        <dd>
          {destIsTemple
            ? <a href={`/temples/${e.destination_temple}/`}>{templeName.get(e.destination_temple!)}</a>
            : e.destination_temple}
        </dd>
      </div>
    )}
    <div><dt>週期</dt><dd>{CYCLE[e.cycle]}{e.ke_rule && `（${e.ke_rule}）`}</dd></div>
    <div><dt>日期</dt><dd>{e.date_note ?? '—'}</dd></div>
    <div><dt>路線型態</dt><dd>{ROUTE[e.route_mode]}</dd></div>
    {e.region.length > 0 && <div><dt>地域</dt><dd>{e.region.join('、')}</dd></div>}
    {e.chen_tou.length > 0 && <div><dt>陣頭</dt><dd>{e.chen_tou.map((c) => <span class="tag">{c}</span>)}</dd></div>}
    {
      e.heritage && (
        <div>
          <dt>文資身分</dt>
          <dd>
            {HERITAGE[e.heritage.level]}
            {e.heritage.verified
              ? <span class="muted small">　已核</span>
              : <span class="warn small">　待文資網核對</span>}
            {e.heritage.authority_ref && <span class="muted small">　{e.heritage.authority_ref}</span>}
          </dd>
        </div>
      )
    }
  </dl>

  {
    facts.length > 0 && (
      <section class="facts">
        <h2>活動特色與查證資料</h2>
        <ul>
          {facts.map((fact) => (
            <li>
              {fact.text}
              {fact.sources.length > 0 && (
                <span class="muted small">　— <Sources sources={fact.sources} prefix="" /></span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    e.ceremony_stages.length > 0 && (
      <section class="stages">
        <h2>儀式順序</h2>
        {e.ceremony_stages.map((stage) => (
          <div class="stage">
            <h3>{stage.name}</h3>
            {(stage.schedule || stage.lunar) && (
              <p class="muted small">
                {stage.schedule}
                {stage.lunar && stage.lunar !== stage.schedule && `（${stage.lunar}）`}
              </p>
            )}
            {stage.description && <p>{stage.description}</p>}
          </div>
        ))}
      </section>
    )
  }

  {
    e.heritage && (
      <section class="heritage-details">
        <h2>文化資產登錄資料</h2>
        <dl>
          {e.heritage.authority && <><dt>主管機關</dt><dd>{e.heritage.authority}</dd></>}
          {e.heritage.venue && <><dt>登錄地點</dt><dd>{e.heritage.venue}</dd></>}
          {(e.heritage.preservers ?? []).length > 0 && (
            <><dt>保存者</dt><dd>{e.heritage.preservers.map((p) => `${p.name}${p.type ? `（${p.type}）` : ''}`).join('、')}</dd></>
          )}
          {(e.heritage.criteria ?? []).length > 0 && (
            <><dt>登錄基準</dt><dd><ul>{e.heritage.criteria.map((criterion) => <li>{criterion}</li>)}</ul></dd></>
          )}
          {e.heritage.laws && <><dt>法令依據</dt><dd>{e.heritage.laws}</dd></>}
          {(e.heritage.announcements ?? []).length > 0 && (
            <><dt>公告沿革</dt><dd><ul>{e.heritage.announcements.map((a) => <li>{a.date}　{a.doc}{a.note && <span class="muted small">（{a.note}）</span>}</li>)}</ul></dd></>
          )}
          {e.heritage.authority_ref && <><dt>公告／文號</dt><dd>{e.heritage.authority_ref}</dd></>}
        </dl>
        {e.heritage.register_reason && (
          <div class="quoted">
            <h3>登錄理由</h3>
            {e.heritage.register_reason.split('\n').filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}
        {e.heritage.history && (
          <div class="quoted">
            <h3>歷史沿革</h3>
            {e.heritage.history.split('\n').filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}
        {(e.heritage.notices ?? []).length > 0 && (
          <div class="quoted">
            <h3>參觀注意事項</h3>
            {e.heritage.notices.flatMap((notice) => notice.split('\n')).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}
        {heritageCaseUrl && (
          <p class="muted small">
            登錄資料：<a href={heritageCaseUrl} rel="nofollow noopener" target="_blank">文化部國家文化資產網個案 {e.heritage.case_id}</a>
          </p>
        )}
      </section>
    )
  }

  {
    e.route_mode === 'undetermined' && (
      <p class="pending">本活動無固定路線（如白沙屯）；僅存事後實走軌跡，不以預測路線冒充官方路線。</p>
    )
  }

  {
    e.route && e.route.stops.length > 0 && (
      <section>
        <h2>路線・駐駕停駕節點</h2>
        {e.route.note && <p class="muted small">{e.route.note}</p>}
        <ol class="stops">
          {e.route.stops.map((s) => (
            <li>
              <strong>{s.name}</strong>
              {s.role && <span class="tag">{s.role}</span>}
              {s.district && <span class="muted small">　{s.district}</span>}
              {s.lat != null && s.lng != null && (
                <a class="map" href={`https://www.openstreetmap.org/?mlat=${s.lat}&mlon=${s.lng}#map=15/${s.lat}/${s.lng}/`} target="_blank" rel="noopener">地圖 ↗</a>
              )}
            </li>
          ))}
        </ol>
        {
          e.route.polyline_source && (
            <p class="muted small">
              {/* ⚠️ 原本 href 與錨文字都直接吃整個 polyline_source 欄位，而該欄位是
                  「網址（中文說明）」——href 因此含中文說明＝**連結點不開**（2026-08-04 線上實測
                  三個活動頁皆然），錨文字也是裸網址。一律走 parseSourceRef 拆成 href + 名稱。 */}
              即時軌跡（進香期間）：<Sources sources={[{ ref: e.route.polyline_source }]} prefix="" />
              　·　第三方來源、非官方，僅供參考。
            </p>
          )
        }
        {e.route.sources.length > 0 && <p class="src small"><Sources sources={e.route.sources} prefix="座標來源：" /></p>}
      </section>
    )
  }

  {
    linkedFestivals.length > 0 && (
      <section>
        <h2>相關節日</h2>
        <ul class="festival-links">
          {linkedFestivals.map((f) => (
            <li><a href={`/festivals/${f.slug}/`}>{f.name}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  {e.sources.length > 0 && <p class="src"><Sources sources={e.sources} /></p>}

  <style>
    .summary { font-size: var(--text-base); }
    .entry-photo { margin: 1.25rem 0; }
    .entry-photo img { display: block; width: min(100%, 30rem); height: auto; border-radius: 0.5rem; }
    .entry-photo figcaption { margin-top: 0.375rem; }
    .rec { display: grid; gap: 0.5rem; margin: 1.25rem 0; }
    .rec > div { display: grid; grid-template-columns: 8.75rem 1fr; gap: 0.625rem; padding: 0.375rem 0; border-bottom: 1px dashed var(--line); }
    .rec dt { font-weight: 700; color: var(--accent); }
    .rec dd { margin: 0; }
    .warn { color: var(--gold); }
    .small { font-size: var(--text-sm); }
    .facts ul, .heritage-details ul { padding-left: 1.25rem; }
    .facts li { line-height: 1.85; margin-bottom: 0.5rem; }
    .stages .stage { margin: 0 0 1.25rem; }
    .stages h3 { font-size: var(--text-base); margin: 0 0 0.25rem; }
    .stages p { line-height: 1.85; }
    .heritage-details dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.4rem 1rem; }
    .heritage-details dt { color: var(--gold); font-size: var(--text-sm); }
    .heritage-details dd { margin: 0; }
    .heritage-details .quoted { margin-top: 1rem; }
    .heritage-details .quoted h3 { color: var(--gold); font-size: var(--text-sm); margin-bottom: 0.35rem; }
    .heritage-details .quoted p { line-height: 1.85; margin: 0 0 0.6rem; }
    .src { color: var(--gold); font-size: var(--text-xs); margin-top: 1.875rem; }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; margin-top: 2.25rem; }
    .stops { margin: 0.75rem 0; padding-left: 1.75rem; }
    .stops li { padding: 0.375rem 0; }
    .map { margin-left: 0.625rem; font-size: var(--text-xs); }
    .festival-links { list-style: none; padding: 0; margin: 0.75rem 0; display: flex; flex-wrap: wrap; gap: 0.625rem; }
    .festival-links li { padding: 0; }
  </style>
</Base>
