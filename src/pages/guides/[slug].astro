---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LeadVisual from '../../components/LeadVisual.astro';
import Sources from '../../components/Sources.astro';
import { articleThing, faqPage } from '../../lib/seo';
import { HUB } from '../../lib/breadcrumbs';

export const getStaticPaths = (async () => {
  const articles = await getCollection('seoArticles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { Content } = await render(article);
const a = article.data;
const faq = faqPage(a.faq);
const ld: object[] = [
  articleThing({
    slug: article.id,
    title: a.title,
    description: a.description,
    datePublished: a.datePublished,
    dateModified: a.dateModified,
    sources: a.sources,
  }),
];
// 本頁的通用視覺：正文主視覺（LeadVisual）與分享圖（og）同源，只宣告一次。
const visual = 'qian-slips';
---

<Base
  title={a.title}
  description={a.description}
  jsonLd={ld}
  faq={faq}
  kind="detail"
  og={{ family: 'visual', stem: visual }}
  answer="articleSummary"
  crumbs={[HUB.festivals, HUB.guides, { name: a.title, path: `/guides/${article.id}/` }]}
>
  <article>
    <h1>{a.title}</h1>
    <p class="article-summary lead">{a.description}</p>
    <p class="muted small">發布於 {a.datePublished} · 更新於 {a.dateModified}</p>
    <LeadVisual visual={visual} alt={`${a.title}的民俗主題文章通用插圖`} />

    <div class="prose"><Content /></div>

    <section class="sources">
      <h2>資料來源</h2>
      {/* 連結原本在下面手寫（rel 還漏了 target，與全站 nofollow noopener _blank 不一致），
          2026-08-20 收斂回 <Sources>：錨文字改走 parseSourceRef（維基網址會補成「維基百科〈條目〉」）。
          版位用 bare＝只出文字，<li> 仍由本頁決定；（type）與「：note」刻意留在呼叫端，
          那是本頁特有的欄位，<Sources> 的契約裡沒有它們，硬塞進去等於改變元件語意。 */}
      <ul>
        {a.sources.map((source) => (
          <li>
            <Sources sources={[source]} prefix="" variant="bare" />
            <span class="muted">（{source.type}）</span>
            {source.note && <span>：{source.note}</span>}
          </li>
        ))}
      </ul>
    </section>

    {a.related.length > 0 && (
      <section>
        <h2>延伸閱讀</h2>
        <ul>
          {a.related.map((path) => <li><a href={path}>{path}</a></li>)}
        </ul>
      </section>
    )}
  </article>

  <style>
    .article-summary { margin: 1rem 0 0.5rem; }
    .small { font-size: var(--text-sm); }
    article > .prose { margin-top: 1.5rem; }
    .sources { border-top: 1px solid var(--line); margin-top: 2rem; padding-top: 1rem; }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; }
  </style>
</Base>
