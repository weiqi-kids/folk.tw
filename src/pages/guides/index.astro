---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LeadVisual from '../../components/LeadVisual.astro';
import { HUB } from '../../lib/breadcrumbs';

const articles = (await getCollection('seoArticles', ({ data }) => !data.draft)).sort((a, b) => {
  const dateOrder = b.data.dateModified.localeCompare(a.data.dateModified);
  return dateOrder || a.data.title.localeCompare(b.data.title, 'zh-Hant');
});
---

<Base
  title="民俗主題文章"
  description="以可查來源整理台灣民俗信仰、節慶習俗與籤詩文化的主題文章；每篇標示更新日期與延伸閱讀。"
  crumbs={[HUB.festivals, HUB.guides]}
>
  <h1>主題文章</h1>
  <p class="muted">
    文章從公開搜尋訊號發現題目，再以可回查資料整理；搜尋熱度本身不是民俗事實，來源與日期才是。
  </p>
  <LeadVisual visual="qian-slips" alt="竹籤、紙卷與印記構成的民俗主題文章通用插圖" />

  {
    articles.length ? (
      <div class="article-list">
        {articles.map((article) => (
          <article class="article-card card">
            <p class="muted small">更新於 {article.data.dateModified}</p>
            <h2><a href={`/guides/${article.id}/`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
            <a class="small" href={`/guides/${article.id}/`}>閱讀文章 →</a>
          </article>
        ))}
      </div>
    ) : (
      <p class="pending">目前沒有已發佈的主題文章。</p>
    )
  }

  <style>
    .article-list { display: grid; gap: 1rem; margin-top: 1.5rem; }
    .article-card h2 { margin: 0.25rem 0 0.5rem; }
    .article-card p { margin: 0.5rem 0; }
    .small { font-size: var(--text-sm); }
  </style>
</Base>
