---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import LeadVisual from '../../components/LeadVisual.astro';
import RelatedSeasonalCampaign from '../../components/RelatedSeasonalCampaign.astro';
import { getDeities, getSystems, relationsOf, templesByDeity, poemsBySystem, practicesByDeity, eventsByDeity, tradesByDeity, systemHref } from '../../lib/queries';
import { deityThing, faqPage } from '../../lib/seo';
import { HUB } from '../../lib/breadcrumbs';
import { lunarDateLabel, lunarToNextOccurrence, solarMd } from '../../lib/lunar-date';
import { todayInTaipei } from '../../lib/daily';
import { releasedItems } from '../../lib/release-schedule';
import festivals from '../../data/festivals.json';
import { imageCredit } from '../../lib/image-credit';
import { num } from '../../lib/format';
import { stripOuterParens } from '../../lib/text';

export const getStaticPaths = (async () => {
  const deities = await getDeities();
  const nameById = new Map(deities.map((d) => [d.id, d.data.name]));
  const tByDeity = await templesByDeity();
  // 聖誕的「下一次國曆日期」。
  // ⚠️ 9 尊神有**多筆聖誕**（如七爺八爺 04-26／04-27／10-01、三官大帝 01-15／07-15／10-15）。
  // 初版用 upcomingDeityBirthdays 取「最近一次」、卻用陣列第一筆做農曆標籤，兩者是不同筆 →
  // 出現「聖誕農曆四月廿六（國曆 11/9）」這種農曆與國曆對不上的假事實（被 check:rendered 的往返驗證抓到）。
  // 正解：逐筆算下一次國曆，挑最近的那一筆，**標籤與國曆同出一筆**。
  const { iso: today } = todayInTaipei();
  const pickShengdan = (d: (typeof deities)[number]) => {
    const cands = d.data.birthday_lunar
      .filter((b) => b.kind === '聖誕' && /^\d{2}-\d{2}$/.test(b.date))
      .map((b) => {
        const occurrence = lunarToNextOccurrence(b.date, today);
        return occurrence ? { date: b.date, ...occurrence } : null;
      })
      .filter((x): x is NonNullable<typeof x> => x !== null)
      .sort((a, b) => a.iso.localeCompare(b.iso));
    return cands[0] ?? null;
  };
  return Promise.all(
    deities.map(async (d) => ({
      params: { id: d.id },
      props: {
        deity: d,
        rels: await relationsOf(d.id),
        nameById,
        temples: tByDeity.get(d.id) ?? [],
        shengdanPick: pickShengdan(d),
      },
    })),
  );
}) satisfies GetStaticPaths;

const { deity, rels, nameById, temples, shengdanPick } = Astro.props;
const d = deity.data;
const systems = await getSystems();
const systemName = new Map(systems.map((s) => [s.id, s.data.name]));
// 籤系連結走唯一入口（自有樞紐的籤系如藥籤要指 /medicine-slips/，不是 /systems/<id>/）
const systemHrefOf = await systemHref();

// 接通「神明↔籤詩」子圖：本神採用之系統的全部籤（直連籤，避免子圖斷開）。
const poemsBySys = await poemsBySystem();
const relatedPoems = d.divination_systems.flatMap((s) => poemsBySys.get(s.id) ?? []);
// 反向：對應拜拜習俗（M5）、以本神為主神之民俗活動（M4）、守護行業（trades 反連）。
const relatedPractices = (await practicesByDeity()).get(deity.id) ?? [];
const relatedEvents = (await eventsByDeity()).get(deity.id) ?? [];
const relatedTrades = (await tradesByDeity()).get(deity.id) ?? [];
const relatedFestivals = releasedItems(festivals).filter((f) => (f.deity_refs as readonly string[] | undefined)?.includes(deity.id));

const label = (id: string) => nameById.get(id) ?? id; // 未成節點則顯示原字串（佔位）
const isNode = (id: string) => nameById.has(id);

// FAQPage（AEO，P1-4）：僅就既有資料生成，無源不杜撰（§5）。
const faqItems: { q: string; a: string }[] = [];

// 聖誕（農曆）：排除「無定／待查」等非實際日期者。
const realBdays = d.birthday_lunar.filter(
  (b) => b.date && !['無定', '待查', '未定'].includes(b.date),
);
// 標題／描述／FAQ 一律用同一組聖誕字串，且**只取 kind==='聖誕'**。
// 2026-07-30 修三個病灶（GSC 實測「朱府千歲生日」曝 139 點 0、「七爺八爺生日」曝 79 點 0）：
//   (1) 原本只有農曆、沒有國曆——但使用者搜「○○生日 2026」要的正是國曆，農曆是他想換算的來源；
//   (2) 原本用阿拉伯數字「農曆3月23日」，而查詢與全站其他頁用的是「農曆三月廿三」，標題從未命中該形式；
//   (3) 原本 `find(kind==='聖誕') ?? realBdays[0]` 會讓只有飛昇/得道者的標題出現「・飛昇農曆9月9日」。
// 國曆日期於 build 時算，且 deploy.yml 有每日 16:00 UTC 重建，故「下一次」永不過期。
// shengdanPick 由 getStaticPaths 逐筆算過、挑最近一次，故 date 與 iso 必為同一筆（勿在此另挑）。
const shengdanLunarLabel = shengdanPick?.label ?? '';
const solarPart = shengdanPick ? `（國曆 ${solarMd(shengdanPick.iso)}）` : '';

if (realBdays.length > 0) {
  const parts = realBdays
    .map((b) => `${lunarDateLabel(b.date) || `農曆${b.date}`}（${b.kind}）`)
    .join('、');
  faqItems.push({
    q: `${d.name}的聖誕（生日）是哪一天？`,
    a: shengdanPick
      ? `${d.name}的聖誕為${shengdanLunarLabel}，下一次落在國曆 ${shengdanPick.iso.slice(0, 4)} 年 ${solarMd(shengdanPick.iso)}。${realBdays.length > 1 ? `本站收錄的日期共：${parts}。` : ''}`
      : `${d.name}的聖誕日為${parts}。`,
  });
}
// 描述用：帶農曆中文標籤＋國曆。
const birthdayLabel = shengdanLunarLabel ? `，聖誕${shengdanLunarLabel}${solarPart}` : '';
// 標題 cohort：有確切聖誕者同時自然命中使用者常搜的「○○生日」與資料用語「聖誕」。
// 只用主名、不再塞首別名：別名仍完整留在 description／頁面，避免長神名加別名後把日期截掉。
// shengdanPick 仍是同一筆農曆／國曆資料；無聖誕者維持既有「主名（首別名）」標題，不硬加生日。
const baseTitle = d.aliases.length > 0 && d.aliases[0] !== d.name ? `${d.name}（${d.aliases[0]}）` : d.name;
const deityTitle = shengdanLunarLabel
  ? `${d.name}生日｜聖誕${shengdanLunarLabel}${solarPart}`
  : baseTitle;

// 職司／是什麼神：以 category＋office＋summary 答覆（answer-first）。
{
  const officePart = d.office.length ? `主要職司為${d.office.join('、')}` : '';
  const segs = [
    `${d.name}屬${d.category}`,
    officePart,
  ].filter(Boolean);
  let a = segs.join('，') + '。';
  if (d.summary) a += d.summary;
  if (officePart || d.summary) {
    faqItems.push({ q: `${d.name}是什麼神？職司是什麼？`, a });
  }
}

// 別名／封號。
if (d.aliases.length > 0) {
  faqItems.push({
    q: `${d.name}有哪些別名或封號？`,
    a: `${d.name}的別名與封號包括：${d.aliases.join('、')}。`,
  });
}

// 信仰類別（is_category）底下的具名實例。
if (d.is_category && d.instances.length > 0) {
  const names = d.instances.map((id) => label(id)).join('、');
  faqItems.push({
    q: `${d.name}底下有哪些具名神明？`,
    a: `${d.name}為信仰類別，底下具名神明包括：${names}。`,
  });
}

const faq = faqPage(faqItems);
const jsonLd = [
  deityThing({
    id: deity.id,
    name: d.name,
    aliases: d.aliases,
    category: d.category,
    office: d.office,
    summary: d.summary,
    sameAs: d.sameAs,
  }),
  ...(faq ? [faq] : []),
];
const aliasesForMeta = d.aliases.map(stripOuterParens).filter(Boolean);
---

<Base
  title={deityTitle}
  description={`${d.name}${aliasesForMeta.length ? `（${aliasesForMeta.join('·')}）` : ''}—${d.category}${birthdayLabel}。${d.summary ?? `職司：${d.office.join('·')}`}`}
  ogType="article"
  ogImage={d.image ? `/og/deities/${deity.id}.png` : '/og/discover/prayer-light.webp'}
  ogImageWidth={1200}
  ogImageHeight={d.image ? 630 : 675}
  ogImageAlt={`${d.name}—${d.category}${d.office.length ? `，職司${d.office.join('、')}` : ''}`}
  jsonLd={jsonLd}
  speakable={['h1', '.summary']}
  crumbs={[HUB.deities, { name: d.name, path: `/deities/${deity.id}/` }]}
>

  <header class="dh">
    <h1>{d.name}</h1>
    <p class="aliases">
      <a class="tag" href="/deities/">{d.category}</a>
      {d.is_category && <span class="tag">信仰類別（非單神）</span>}
      {d.groups.map((g) => <span class="tag">{g}</span>)}
    </p>
    {d.aliases.length > 0 && <p class="muted">別名／封號：{d.aliases.join('、')}</p>}
  </header>

  {d.summary && <p class="summary">{d.summary}</p>}
  <RelatedSeasonalCampaign festivalSlugs={relatedFestivals.map((f) => f.slug)} />

  <div class="cols2">
    <section>
      <h2>職司</h2>
      {d.office.length ? <p>{d.office.map((o) => <span class="tag">{o}</span>)}</p> : <p class="pending">待補</p>}
    </section>

    <section>
      <h2>聖誕（農曆）</h2>
      {
        d.birthday_lunar.length === 0 ? (
          <p class="pending">聖誕待查（無源不顯示）。</p>
        ) : (
          <ul class="bdays">
            {d.birthday_lunar.map((b) => (
              <li>
                <strong>{b.date}</strong> <span class="muted">{b.kind}</span>
                {b.note && <span class="muted small">　{b.note}</span>}
                {b.sources.length > 0 && <div class="src"><Sources sources={b.sources} prefix="" /></div>}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>

  {/* 造型・法器（2026-08-06 開始渲染）：`iconography` 早就在 schema 裡（content.config.ts:72）、
      也有資料，但**全站沒有任何一處顯示它**＝死資料。這裡把它接出來。
      ⚠️ 沒有資料的神明**不渲染這個區塊**（不是印「待補」）——造型是「有就是有」的事實，
      留個空欄位只會讓幾十頁各多一句沒有資訊量的話（同 no-meta-disclaimers 的道理）。
      刻意放在 .cols2 外：它是不定長的標籤列，塞進兩欄格線會變成半寬的孤兒塊。 */}
  {
    d.iconography.length > 0 && (
      <section class="iconography">
        <h2>造型・法器</h2>
        <p>{d.iconography.map((x) => <span class="tag">{x}</span>)}</p>
      </section>
    )
  }

  {/* 代表圖（2026-08-06 起在詳情頁也顯示；原本只有 /deities/ 索引頁的卡片用得到）。
      出處標示走 `imageCredit()` 唯一入口——內政部的照片**必須給可點的來源連結**（授權條件）。 */}
  {
    d.image ? (
      <figure class="deity-photo">
        <img src={d.image.src} alt={d.image.alt} loading="lazy" decoding="async" />
        <figcaption class="muted small">
          {imageCredit(d.image).href ? (
            <a href={imageCredit(d.image).href!} rel="noopener">{imageCredit(d.image).text}</a>
          ) : (
            imageCredit(d.image).text
          )}
        </figcaption>
      </figure>
    ) : (
      // 查無可授權神像照的神明，使用由本尊既有名稱／類別／職司／聖誕資料產生的文字卡。
      // 卡片不描繪神像、不猜身分；postbuild 與 og:image 會產生同一路徑的檔案。
      <LeadVisual
        src={`/og/deities/${deity.id}.png`}
        alt={`${d.name}資料卡：${d.category}${d.office.length ? `，職司${d.office.join('、')}` : ''}`}
      />
    )
  }

  {/* 內政部「宗教知識+」條目引文（2026-08-06）：**逐字引用**，一個字都不改寫。
      授權條件就是「標示資料來源連結」，所以來源連結是這一段的必要組成，不是後設警語——
      拿掉它就違反授權（別把它當成 no-meta-disclaimers 那類可省的句子）。
      🔴 不要把這段改寫成自己的話塞進 `summary`：summary 的規則是「自行改寫不得逐字抄」，
      這一段的規則正好相反，兩者是不同東西，不可互相搬。 */}
  {
    d.moi_knowledge && (
      <section class="moi-knowledge">
        <h2>{d.name}是什麼神？</h2>
        <blockquote class="moi-quote">
          {d.moi_knowledge.excerpt.map((p) => <p>{p}</p>)}
        </blockquote>
        <p class="muted small moi-src">
          引自內政部全國宗教資訊網「宗教知識+」<a href={d.moi_knowledge.url} rel="noopener">{d.moi_knowledge.title}</a>
        </p>
      </section>
    )
  }

  {
    d.is_category && (
      <section>
        <h2>具名實例</h2>
        <p class="muted small">
          「{d.name}」為信仰類別；底下具名實例各有聖誕與廟宇對應（依實例而非類別）。
        </p>
        {d.instances.length > 0 ? (
          <ul class="rels">
            {d.instances.map((id) => (
              <li>
                {isNode(id) ? <a href={`/deities/${id}/`}>{label(id)}</a> : <span>{label(id)}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="pending">具名實例節點建置中。</p>
        )}
      </section>
    )
  }

  <section>
    <h2>採用之籤詩系統</h2>
    {
      d.divination_systems.length ? (
        <ul>
          {d.divination_systems.map((s) => (
            <li><a href={systemHrefOf(s.id)}>{systemName.get(s.id) ?? s.id}</a></li>
          ))}
        </ul>
      ) : (
        <p class="muted">尚未標註常用籤詩系統。</p>
      )
    }
  </section>

  {
    relatedPoems.length > 0 && (
      <section>
        <h2>相關籤詩</h2>
        {d.divination_systems.map((s) => {
          const list = poemsBySys.get(s.id) ?? [];
          if (!list.length) return null;
          return (
            <div class="poem-group">
              <p class="muted small">
                <a href={systemHrefOf(s.id)}>{systemName.get(s.id) ?? s.id}</a>　共 {list.length} 籤
              </p>
              <ul class="poem-links">
                {list.slice(0, 12).map((p) => (
                  <li>
                    <a href={`/poems/${p.id}/`}>第 {p.data.no} 籤{(p.data.ganzhi || p.data.title) && ` · ${p.data.ganzhi ?? p.data.title}`}</a>
                  </li>
                ))}
              </ul>
              {list.length > 12 && <p class="muted small"><a href={systemHrefOf(s.id)}>看全部 {list.length} 籤 →</a></p>}
            </div>
          );
        })}
      </section>
    )
  }

  <section>
    <h2>關係網</h2>
    {
      rels.out.length === 0 && rels.in.length === 0 ? (
        <p class="muted">尚無已發佈關係邊。</p>
      ) : (
        <ul class="rels">
          {rels.out.map((r) => (
            <li>
              {d.name} <span class="reltype">— {r.data.type} →</span>{' '}
              {isNode(r.data.to) ? <a href={`/deities/${r.data.to}/`}>{label(r.data.to)}</a> : <span class="placeholder">{label(r.data.to)}<span class="tag">待建</span></span>}
              {r.data.note && <span class="muted small">　{r.data.note}</span>}
            </li>
          ))}
          {rels.in.map((r) => (
            <li>
              {isNode(r.data.from) ? <a href={`/deities/${r.data.from}/`}>{label(r.data.from)}</a> : <span class="placeholder">{label(r.data.from)}</span>}{' '}
              <span class="reltype">— {r.data.type} →</span> {d.name}
              {r.data.note && <span class="muted small">　{r.data.note}</span>}
            </li>
          ))}
        </ul>
      )
    }
    <p class="muted small">v1 關係以列表呈現；圖視覺化列發佈後增補。</p>
  </section>

  {
    temples.length > 0 && (
      <section>
        <h2>主祀此神之廟宇{temples.length > 30 && <span class="muted small">　共 {num(temples.length)} 間，列出 30 間</span>}</h2>
        {/* 分欄（2026-08-08）：三十間排成單欄一路往下，媽祖那頁光這一段就好幾個螢幕高，
            而每一列其實只有「廟名＋鄉鎮」兩個短欄位。清單內容與筆數都沒動，只是排版。 */}
        <ul class="temple-refs">
          {temples.slice(0, 30).map((t) => (
            <li>
              <a href={`/temples/${t.id}/`}>{t.data.name}</a>
              {t.data.district && <span class="muted small">　{t.data.district}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    relatedTrades.length > 0 && (
      <p class="muted">
        守護行業：
        {relatedTrades.map((t, i) => (
          <>
            {i > 0 && '、'}
            <a href={`/trades/${t.id}/`}>{t.data.name}</a>
          </>
        ))}
      </p>
    )
  }

  {
    relatedFestivals.length > 0 && (
      <p class="muted">
        相關節日：
        {relatedFestivals.map((f, i) => (
          <>
            {i > 0 && '、'}
            <a href={`/festivals/${f.slug}/`}>{f.name}</a>
          </>
        ))}
      </p>
    )
  }

  {
    relatedPractices.length > 0 && (
      <section>
        <h2>相關拜拜習俗</h2>
        <ul class="rels">
          {relatedPractices.map((p) => (
            <li>
              <a href={`/practices/${p.id}/`}>{p.data.title}</a>
              {p.data.summary && <span class="muted small">　{p.data.summary}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    relatedEvents.length > 0 && (
      <section>
        <h2>相關民俗活動</h2>
        <ul class="rels">
          {relatedEvents.map((e) => (
            <li>
              <a href={`/events/${e.id}/`}>{e.data.name}</a>
              {e.data.region.length > 0 && <span class="muted small">　{e.data.region.join('、')}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {d.sources.length > 0 && <p class="src footer-src"><Sources sources={d.sources} /></p>}

  <style>
    .dh h1 { margin: 0.25rem 0 0.5rem; }
    .summary { font-size: var(--text-base); }
    /* 神像照片限高（同廟宇頁）：直式神像原本 width:100%/height:auto，桌機約 1000px 高，
       第一屏之後整個視野都是那張圖，職司與聖誕全被推到看不見的地方。
       object-position 偏上是為了保住頭臉（同 .card-photo 的理由）。 */
    .deity-photo { margin: 1rem 0 1.5rem; }
    .deity-photo img {
      width: 100%; max-height: 30rem; height: auto;
      object-fit: cover; object-position: center top;
      border-radius: 0.25rem; display: block;
    }
    .deity-photo figcaption { margin-top: 0.375rem; }
    .temple-refs {
      list-style: none; padding-left: 0; margin: 0.75rem 0;
      display: grid; gap: 0.25rem 1.5rem;
      grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    }
    .temple-refs li { padding: 0.25rem 0; }
    .moi-quote { margin: 0.75rem 0 0.5rem; padding: 0 0 0 1rem;
      border-left: 3px solid var(--line); color: var(--ink); }
    .moi-quote p { margin: 0 0 0.75rem; }
    .moi-quote p:last-child { margin-bottom: 0; }
    .moi-src { margin: 0; }
    .cols2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2.5rem; }
    @media (max-width: 50rem) { .cols2 { grid-template-columns: 1fr; } }
