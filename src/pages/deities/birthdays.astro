---
import Base from '../../layouts/Base.astro';
import UpcomingBirthdays from '../../components/UpcomingBirthdays.astro';
import LeadVisual from '../../components/LeadVisual.astro';
import { upcomingDeityBirthdays } from '../../lib/birthdays';
import { todayInTaipei } from '../../lib/daily';
import { faqPage } from '../../lib/seo';
import { HUB } from '../../lib/breadcrumbs';

const { iso } = todayInTaipei();
// 全年聖誕曆：自今日起 400 天＋每尊去重＝60 尊各出現一次（下一次聖誕），依國曆日序。
const all = await upcomingDeityBirthdays(iso, 400, { uniqueDeity: true });
const totalDeities = new Set(all.flatMap((e) => e.deities.map((d) => d.deityId))).size;

// FAQ（AEO）：僅就既有掛源資料生成，日期為站上農民曆引擎推算之國曆（無源不杜撰）。
// ⚠️ 取前 3 **尊**，不是前 3 個**日期**——同一天常有多尊聖誕（農曆六月廿四就有三尊），
// 用日期切會讓答案句爆成六七個名字，answer-first 就失去「一句話回答」的作用。
const soon = all
  .flatMap((e) => e.deities.map((d) => ({ name: d.name, lunar: e.lunarLabel, iso: e.iso })))
  .slice(0, 3);
const faqItems = [
  {
    q: '神明聖誕（神明生日）怎麼看？',
    a: '神明聖誕以農曆日期為準（如媽祖農曆三月廿三、關聖帝君農曆六月廿四），每年對應的國曆日期不同。以下用農民曆引擎推算今年起各神明聖誕的國曆日期，依序排列。',
  },
  ...(soon.length
    ? [{
        q: `最近有哪些神明聖誕？`,
        a: soon.map((s) => `${s.name}聖誕為${s.lunar}（國曆 ${Number(s.iso.slice(5, 7))}/${Number(s.iso.slice(8, 10))}）`).join('；') + '。',
      }]
    : []),
];
const faq = faqPage(faqItems);
---

<Base
  title="神明生日一覽—台灣神明聖誕曆（農曆對國曆）"
  description={`台灣 ${totalDeities} 尊神明的聖誕（農曆生日）與今年國曆對照，依日期排序、逐尊掛來源。媽祖、關聖帝君、月老、土地公等聖誕是哪一天，一頁查。`}
  kind="detail"
  og={{ family: 'visual', stem: 'calendar-compass' }}
  ogImageAlt="神明聖誕曆與農曆國曆日期對照"
  faq={faq}
  answer="bdAnswer"
  crumbs={[HUB.deities, { name: '神明聖誕曆', path: '/deities/birthdays/' }]}
>

  <header class="dh">
    <h1>神明聖誕曆</h1>
  </header>

  {/* answer-first（2026-08-03）：GSC 實測「神明生日」排第 83 名、「農曆8月神明生日」第 69 名——
      頁面原本開頭是「這一頁是什麼」的描述，不是那個問題的答案。改成先把最近三尊講出來。
      ⚠️ 日期由 build 算，但「最近」會過期；`.bd-answer` 的內容由 UpcomingBirthdays 的
      client script 依台灣時區即時重算（同 FestivalCountdown 機制），所以沒重新部署也不會過期。 */}
  <p class="lead bd-answer">
    最近的神明聖誕是{soon.length ? soon.map((s, i) => (
      <>{i > 0 ? '、' : ''}<strong>{s.name}</strong>（{s.lunar}，國曆 {Number(s.iso.slice(5, 7))}/{Number(s.iso.slice(8, 10))}）</>
    )) : '—'}。
  </p>
  <p class="lead">
    台灣 {totalDeities} 尊神明的聖誕（農曆生日）與今年國曆對照，依即將到來的日期排序。
    聖誕以農曆為準、每年國曆不同，日期由農民曆引擎推算；各神明資料逐條掛來源。
  </p>

  <LeadVisual
    src="/og/deities/mazu.png"
    alt="媽祖神明資料卡，示例呈現神名、職司與聖誕日期"
  />
  <p class="muted small visual-note">
    神明聖誕資料卡示例；下方依日期列出全部神明，逐尊可查看自己的掛源資料。
  </p>

  <section>
    <UpcomingBirthdays items={all} />
  </section>

  <p class="muted small extend">
    延伸：<a href="/deities/">神明圖譜</a>｜<a href="/almanac/">今日農民曆</a>｜
    <a href="/scenarios/">拜什麼神</a>｜<a href="/trades/">行業守護神</a>
  </p>

  <style>
    .dh h1 { margin: 0.25rem 0 0.5rem; }
    .lead { font-size: var(--text-base); }
    .small { font-size: var(--text-sm); }
    .extend { margin-top: 1.875rem; }
    .visual-note { margin-top: -1rem; }
  </style>
</Base>
