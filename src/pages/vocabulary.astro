---
import Base from '../layouts/Base.astro';
import Sources from '../components/Sources.astro';
import LeadVisual from '../components/LeadVisual.astro';
import vocab from '../data/vocabulary.json';

const groups: { key: keyof typeof vocab; label: string }[] = [
  { key: 'event_types', label: '民俗活動類型' },
  { key: 'chen_tou', label: '陣頭' },
  { key: 'joss_paper', label: '金紙／紙錢' },
  { key: 'offerings', label: '供品' },
  // 2026-08-20 加：求籤問筊與廟宇工藝兩群。來源是國史館臺灣文獻館《臺灣民俗文物辭典》，
  // 逐詞掛回該辭條的公開網址——那是授權條件，不是裝飾。
  { key: 'divination', label: '求籤、問筊與擇日' },
  { key: 'temple_craft', label: '廟宇工藝與陳設' },
  { key: 'ritual_items', label: '祭典與節俗用品' },
  { key: 'talisman', label: '符咒與平安符' },
  { key: 'ancestral', label: '祖先牌位與喪葬' },
  { key: 'religious_specialists', label: '道士、法師與乩童' },
  { key: 'wedding', label: '婚俗與幼兒禮俗用品' },
  { key: 'auspicious', label: '吉祥圖紋與口彩' },
  { key: 'scriptures', label: '經書與科儀文獻' },
];
type Term = { term: string; def: string; alias?: string[]; sources?: { ref: string }[] };
---

<Base title="受控詞彙" description="民俗活動類型、陣頭、金紙、供品之受控詞彙定義表，地方變體以別名收，逐詞掛來源。">
  <h1>受控詞彙</h1>
  <p class="muted">
    全站活動類型、陣頭、金紙、供品採受控詞彙：每詞一句定義、地方變體以別名收、逐詞掛來源；
    避免同義詞各自新增。
  </p>
  <LeadVisual src="/og.png" alt="神酷台灣民俗信仰知識系統" />
  <p class="muted small visual-note">這是神酷資料庫共用的民俗詞彙定義表。</p>
  {/* 分類跳轉（2026-08-08）：四大段、上百個詞條一次全開共 6,300px，
      想看「金紙／紙錢」得先捲過前兩段。錨點指向下方既有的 <section>。 */}
  <nav class="group-jumps" aria-label="跳到分類">
    {groups
      .filter((g) => ((vocab[g.key] as Term[]) ?? []).length > 0)
      .map((g) => (
        <a class="group-jump" href={`#g-${g.key}`}>
          {g.label}<span class="n">{(vocab[g.key] as Term[]).length}</span>
        </a>
      ))}
  </nav>
  {
    groups.map((g) => {
      const terms = (vocab[g.key] as Term[]) ?? [];
      if (terms.length === 0) return null;
      return (
        <section id={`g-${g.key}`}>
          <h2>{g.label}<span class="count muted">（{terms.length}）</span></h2>
          <dl class="vocab">
            {terms.map((t) => (
              <div class="row">
                <dt id={t.term}>{t.term}</dt>
                <dd>
                  {t.def}
                  {t.alias && t.alias.length > 0 && <span class="alias muted"> · 別名：{t.alias.join('、')}</span>}
                  <Sources sources={t.sources ?? []} prefix=" · " variant="inline" />
                </dd>
              </div>
            ))}
          </dl>
        </section>
      );
    })
  }
  <style>
    h2 { border-bottom: 1px solid var(--accent-soft); padding-bottom: 0.375rem; margin-top: 2.25rem; }
    section { scroll-margin-top: 1rem; }
    .count { font-size: var(--text-sm); font-weight: 400; }
    .group-jumps { display: flex; flex-wrap: wrap; gap: 0.625rem; margin: 1.25rem 0 0.5rem; }
    .group-jump {
      display: inline-flex; align-items: baseline; gap: 0.5rem;
      padding: 0.4375rem 1rem; border-radius: 999px;
      border: 1px solid var(--line); background: var(--paper-2);
      color: var(--ink); font-size: var(--text-sm);
    }
    .group-jump:hover { border-color: var(--accent-soft); color: var(--accent); text-decoration: none; }
    .group-jump .n { color: var(--ink-soft); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
    .vocab .row { display: grid; grid-template-columns: 8.75rem 1fr; gap: 0.75rem; padding: 0.5rem 0; border-bottom: 1px dashed var(--line); }
    .vocab dt { font-weight: 700; color: var(--accent); }
    .vocab dd { margin: 0; }
    .alias { font-size: var(--text-sm); }
    .visual-note { margin-top: -1rem; font-size: var(--text-xs); }
  </style>
</Base>
