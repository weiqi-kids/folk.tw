---
import Base from '../layouts/Base.astro';
import LeadVisual from '../components/LeadVisual.astro';
import { breadcrumb } from '../lib/seo';
import { getEvents, getDeities, getTemples, getPractices } from '../lib/queries';

// 🔴 隱私段**不可再寫「本站不販售亦不用於廣告投放」這類商業模式承諾**（2026-08-12 用戶裁示移除）。
//    那句是建站時的誤解，站主的實際立場是：**不接受業配文，但不排除廣告投放**，
//    且本站本來就規劃了 NFC 抽籤這類產品——寫「不用於廣告投放」等於對外做了一個站主沒同意的承諾。
//    ⚠️ 這條**不影響**祈福頁的「不變現」紅線：那是災難頁專屬的鐵則（見 docs/topical-blessing.md §0.1），
//    兩者是不同層次的事，不要因為這裡放寬就去動那條。
//    未來若真的上廣告，這段要補的是**廣告／Cookie 的據實說明**，不是反向再寫一次承諾。
//
// 🔴 「資料與統計」段是**站上實際送出什麼的據實清單**，不是安撫性文案（2026-08-13 重寫）。
//    原文只寫「本身不蒐集個人資料＋GA4 匿名統計」，但實際上 cookie、求籤的 concern／poem_no、
//    報喜的 outcome、**以及搜尋字詞**都會進 GA4——搜尋那條尤其嚴重，因為它跟上一句
//    「全文檢索在瀏覽器端運作」擺在一起會被讀成「什麼都不外送」。
//    ⚠️ **改動任何 gtag 事件的 payload，同一回合要回來改這段**；來源分別是
//    Base.astro（campaign_click／intent_click／calendar_add／line_add_click）、
//    qiugian/[slug].astro（qiugian／qifu／baoxi）、qiugian/blessing/[slug].astro（qifu）、
//    search.astro（view_search_results／search_zero_results／search_result_click，字詞經 analyticsTerm 過濾）、
//    ShareRow.astro（share）、PuduChecklist.astro。座標不外送由 check-rendered 不變量 13 守著。
//    🔴 移除了「以上免責、責任限制與使用條款均已定稿」——那是寫給自己看的編輯備註，
//    對讀者零資訊，且頁面上根本沒有「使用條款」這個段落（後設警語，記憶 no-meta-disclaimers-on-pages）。
//
// 圖片來源彙整：逐張標作者·授權·出處。
// ⚠️ 來源是**複合的**（Wikimedia Commons ＋ 內政部全國宗教資訊網），不要再寫成單一來源——
//    下方那段引言是清單的全稱斷言，清單多一種授權它就得多提一種（check-rendered 不變量 5 硬擋）。
const creditOf = (items: { data: Record<string, any> }[], nameKey = 'name') =>
  items
    .filter((e) => e.data.image)
    .map((e) => ({ name: e.data[nameKey] as string, ...(e.data.image as any) }));
const creditGroups = [
  { label: '神明', items: creditOf(await getDeities()) },
  { label: '廟宇', items: creditOf(await getTemples()) },
  { label: '民俗活動', items: creditOf(await getEvents()) },
  { label: '拜拜習俗', items: creditOf(await getPractices(), 'title') },
].filter((g) => g.items.length > 0);

// 常見問答（AEO：問答友善＋FAQPage schema）
const faqs = [
  { q: '神酷（神庫）是什麼？', a: '神酷是台灣漢人民間信仰的結構化考據知識系統，涵蓋籤詩解讀、神明關係圖譜、廟宇文化、農民曆與拜拜習俗，資料逐條掛來源、諸說並陳。' },
  { q: '籤詩的分項解準不準？', a: '神酷的分項解與白話賞析是本站原創的文化解讀，以「文化呈現」框架呈現，不對個人預言吉凶、不構成命理建議；現代解籤文字有著作權，本站不抄錄。' },
  { q: '農民曆的宜忌依據是什麼？', a: '宜忌依《欽定協紀辨方書》（四庫全書本）逐條考據化，每條附推導（由哪些神煞、依何規則）與卷數出處；未經原文核校者不對外顯示。' },
  { q: '資料來源可靠嗎？', a: '每筆事實掛來源、無源不發佈；爭議處諸說並陳、不裁定正統；公有領域本文可收錄並標版本。' },
  { q: '涵蓋哪些範圍？', a: '以漢人民間信仰為主（海神／開拓神／族群神／行業神／愛情婦幼／動物神／自然神 七大類），非窮盡台灣所有宗教信仰。' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="關於與勘誤"
  description="神酷（神庫）的定位、使用邊界與免責、範圍身分聲明、版權授權、勘誤回報與常見問答。"
  jsonLd={[faqLd, breadcrumb([{ name: '關於與勘誤', path: '/about' }])]}
>
  <h1>關於神酷（神庫）</h1>
  <p class="lead">
    本站是<strong>台灣民俗信仰的考據工具</strong>：把籤詩、神明、農民曆、民俗活動與拜拜習俗，
    做成逐條掛來源、諸說並陳的結構化知識。我們賣「看懂文化」，不賣「預言吉凶」。
  </p>

  <LeadVisual src="/og.png" alt="神酷：神庫・台灣民俗信仰知識系統" />

  {/* 目錄（2026-08-08）：整頁 10,000px、八個主題一路往下，最後還接一份數百筆的圖片來源清單，
      要找「版權與授權」得先捲過全部。錨點指向下方既有的 <section>，沒有新增內容。 */}
  <nav class="toc" aria-label="本頁目錄">
    <a href="#faq">常見問答</a>
    <a href="#disclaimer">使用邊界與免責</a>
    <a href="#negative">負面結果的呈現</a>
    <a href="#respect">編輯尊重與廟際敏感</a>
    <a href="#scope">範圍與身分聲明</a>
    <a href="#license">版權與授權</a>
    <a href="#credits">圖片來源</a>
    <a href="#errata">可信度與勘誤</a>
  </nav>

  <section id="faq">
    <h2>常見問答</h2>
    {
      faqs.map((f) => (
        <details class="faq disclosure">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </section>

  <section id="disclaimer">
    <h2>使用邊界與免責</h2>
    <p>
      本站為民俗文化考據與教育呈現，<strong>不構成醫療、法律、投資、命理或宗教指導建議</strong>。
      涉宜忌、籤詩分項（疾病／訴訟／求財）、改運／收驚／安太歲、神煞吉凶等，皆以「文化呈現」框，不以「建議」語氣。
    </p>
    <p>凡內容涉健康、法律、財務、心理，請洽專業人士。本站不勸阻、不背書、不替代專業判斷。</p>
    <h3>責任限制</h3>
    <p>
      本站內容（含籤詩白話、宜忌、神明與民俗資料）僅供文化教育與學術參考，
      <strong>依現況「按其原樣」提供，不就正確性、完整性或特定用途之適用性作任何明示或默示擔保</strong>。
      使用者就其依本站內容所為之決定與行動<strong>自負全部風險</strong>；於法律許可範圍內，本站及編作者
      對任何直接或間接損害不負賠償責任。資料若有錯誤或爭議，歡迎透過勘誤管道回報更正。
    </p>
    <h3>資料與統計</h3>
    <p>
      本站主體是純靜態網站，沒有帳號、沒有會收個人資料的表單；全站搜尋在你的瀏覽器裡跑。
      唯一的例外是下一段的「祈福籤詩圖」。
      為了解流量與改善內容，本站使用 <strong>Google Analytics 4</strong>：它會在你的瀏覽器放 cookie、
      記錄你看了哪些頁，本站的設定要求 Google 匿名化 IP。
    </p>
    <p>
      合作宮廟的籤詩頁提供「<strong>祈福籤詩圖</strong>」：你自行選擇上傳的照片，會經本站伺服器傳送給
      OpenAI 以生成圖片，生成完成即刪除，本站與伺服器都<strong>不儲存你的照片</strong>、
      也不會把它用在生成以外的任何用途；留下的只有「哪間廟、哪支籤生成了一張」這樣的計數統計。
      不使用這個功能，就不會有任何照片離開你的裝置。
    </p>
    <p>
      除了瀏覽頁面，這些互動也會送出統計事件：求籤、集氣祈福與報喜會送出<strong>你選的是哪一類煩惱</strong>、
      抽到第幾支籤與報喜結果；從宮廟專屬連結（廟方 QR／NFC）進站時，這些事件會多帶該宮廟的代碼。
      站內搜尋會送出<strong>查詢字詞</strong>，但只有明確屬於民俗領域的詞
      （廟名、神明、籤、農民曆這類）才照字面送，其餘一律換成分類代碼，看起來像 email、網址或電話的也一樣。
      「附近的廟」用到的定位座標只在你的裝置上算距離，不會送出。
    </p>
    <p>
      這些資料由 Google 依其隱私政策處理，你可以透過瀏覽器設定或 Google 的停用工具拒絕。
    </p>
  </section>

  <section id="negative">
    <h2>負面結果的呈現</h2>
    <p>
      凶籤、凶宜忌、疾病／訴訟分項，以文化脈絡與解讀呈現，避免命令式斷言；
      不對個人處境預言禍福、不臆測使用者真實狀況。內容涉困境處，提供中性、非引導的求助方向。
    </p>
  </section>

  <section id="respect">
    <h2>編輯尊重與廟際敏感</h2>
    <p>
      面向信眾語氣莊重，不褻瀆、不戲謔、不以神明與儀俗為哏。
      廟際爭議（分靈、位階、信仰圈、正統之爭）一律諸說並陳、不選邊、不裁定正統。
      神格位階不建模、不排高低，只記分類與關係。
    </p>
  </section>

  <section id="scope">
    <h2>範圍與身分聲明</h2>
    <p>
      本站涵蓋以<strong>漢人民間信仰</strong>為主（海神／開拓神／族群神／行業神／愛情婦幼／動物神／自然神 七大類），
      <strong>非窮盡台灣所有宗教信仰</strong>；未涵蓋原住民族傳統信仰、佛教各宗、一貫道、新興宗教等。
    </p>
    <p class="muted small">
      民俗活動之文資身分以<strong>文化部國家文化資產網</strong>現況為準，未經核定者標「待核」；
      進香即時軌跡等第三方即時資料屬發佈範圍外之可選增補、非官方，僅供參考。
    </p>
  </section>

  <section id="license">
    <h2>版權與授權</h2>
    <ul>
      <li>籤詩四句本文：多屬公有領域，直接收錄並標明系統／版本。</li>
      <li>現代「解籤」文字：常有著作權，<strong>本站不抄錄</strong>；分項解自行撰寫。</li>
      <li>典故故事：取公有領域題材（史記、演義等）自行敘述，不抄特定改寫本。</li>
      <li>神明事實（聖誕、職司）：事實不受著作權保護，但逐條引來源佐證。</li>
      <li>內政部寺廟開放資料：依政府資料開放授權條款使用、標示來源。</li>
      <li>
        <strong>內政部全國宗教資訊網的網站內容</strong>（宗教知識+ 條目、寺廟歷史沿革、建築特色、
        參拜流程與所附照片）：2026 年 8 月經內政部同意使用，<strong>條件為標示資料來源連結</strong>。
        本站的作法是逐筆掛回該筆自己的原始網址，文字<strong>逐字引用、不改寫</strong>；
        照片另標示原圖說所載的攝影者姓名。
      </li>
    </ul>

    <h3>各籤系的版本依據</h3>
    <p class="muted small">
      同一支籤在不同廟的籤版文字並不相同，所以本站每一套籤都標明依據哪個版本。
      籤詩四句屬公有領域；<strong>廟方另附的白話解說屬廟方著作，本站僅掛源、不轉載</strong>。
    </p>
    <ul>
      <li><strong>六十甲子籤</strong>（60 首）：通行版，卦頭故事採泰安宮媽祖聖籤版校對。</li>
      <li><strong>關聖帝君靈籤</strong>（100 首）：雷雨師百首通行本。</li>
      <li>
        <strong>月下老人靈籤</strong>（27 首）：臺南祀典大天后宮廟方官網公布之籤版，逐首自掃描件謄錄。
        取籤方式為連擲三次筊，以三次杯象對應一首。
        <a href="https://www.gtainanmazu.org.tw/?act=menuinfo&amp;ml_id=20220121003" rel="nofollow noopener" target="_blank">廟方頁面</a>
      </li>
      <li>
        <strong>內門紫竹寺觀音籤</strong>（28 首）：高雄內門紫竹寺（主祀觀音佛祖）廟方官網「解籤園地」
        逐首公布，自 HTML 謄錄。此為該寺自有的二十八首，並非坊間所稱的「觀音一百籤」。
        <a href="https://www.nmzizhusi.org.tw/?act=jieqianyuandi&amp;cmd=list" rel="nofollow noopener" target="_blank">廟方頁面</a>
      </li>
      <li>
        <strong>保生大帝藥籤</strong>（330 首）：臺南興濟宮版，衛生福利部國家中醫藥研究所數位典藏，
        藥方為公眾領域標章（PDM）、藥材說明授權 OGDL 1.0。
      </li>
    </ul>
    <h3>解籤文字的撰寫原則</h3>
    <ul>
      <li><strong>白話賞析與八項分項解為本站原創撰寫</strong>，依公有領域題材、該籤四句與卦頭典故而作，非引現代解籤本。</li>
      <li>現代解籤本的文字有著作權，本站不抄錄。</li>
      <li>部分籤系（月老籤、紫竹寺觀音籤）的<strong>籤版本身就印有分項判語</strong>，頁面上標「籤版原印」照錄不改寫，與本站撰寫的部分分開陳列。</li>
    </ul>

    <p class="muted small">
      籤頁上只留一行短標示，完整依據與原則列在這裡，避免每一頁都重複整段聲明。
    </p>
    <p class="muted small">程式碼採開源授權（見原始碼庫 LICENSE）；資料來源逐條標註於各條目。</p>
  </section>

  <section id="credits">
    <h2>圖片來源</h2>
    {/* 🔴 這段話是**清單的全稱斷言**，不是裝飾——下方逐張列出的每一種授權都必須在這裡被提到。
        2026-08-07 踩過：原句寫「代表圖皆取自 Wikimedia Commons」，但當天匯入 19 張內政部照片後，
        清單裡就有兩種授權，那句「皆取自」變成錯的陳述（單張的標示各自都對，錯的是這句總結）。
        已做成 gate（check-rendered 不變量 5：清單出現幾種授權，這段就必須提到幾種）。 */}
    <p class="muted small">
      代表圖有兩個來源：<strong>Wikimedia Commons</strong>（CC 授權或公有領域），
      以及<strong>內政部</strong>全國宗教資訊網（2026-08-06 經同意使用，條件為標示資料來源連結）。
      兩者都依授權標示原作者與條款；找不到合授權圖片者一律留空、不使用未授權圖。
      圖片經縮圖處理、自存於本站（非熱連）。以下為逐張出處：
    </p>
    {
      creditGroups.map((g) => (
        <>
          <h3>{g.label}（{g.items.length}）</h3>
          <ul class="credits">
            {g.items.map((c) => (
              <li>
                <a href={c.source} target="_blank" rel="noopener nofollow">
                  {c.name}
                </a>
                {' — '}
                {c.author}
                {'，'}
                {c.license_url ? (
                  <a href={c.license_url} target="_blank" rel="noopener nofollow">
                    {c.license}
                  </a>
                ) : (
                  c.license
                )}
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </section>

  <section id="errata">
    <h2>可信度與勘誤</h2>
    <p>
      本站每條目具來源標註。發現錯誤（事實、來源或判讀）歡迎回報；
      查證後更正並記版本／更新日，重大爭議內容標「諸說並陳／待考」。
    </p>
    <p class="errata">
      <strong>勘誤回報：</strong>
      <a href="https://github.com/weiqi-kids/folk.tw/issues/new" target="_blank" rel="noopener">於 GitHub 開 Issue 回報 →</a>
      （亦歡迎廟方、研究者指正；請附條目與來源依據。）
    </p>
  </section>

  <style>
    .lead { font-size: var(--text-base); }
    h2 { border-bottom: 1px solid var(--accent-soft); padding-bottom: 0.375rem; margin-top: 2.25rem; }
    .small { font-size: var(--text-sm); }
    li { margin: 0.375rem 0; }
    section { scroll-margin-top: 1rem; }
    .toc {
      display: flex; flex-wrap: wrap; gap: 0.5rem 0.625rem;
      margin: 1.75rem 0 0.5rem; padding: 1.125rem 1.25rem;
      border: 1px solid var(--line); border-radius: 0.625rem; background: var(--paper-2);
    }
    .toc a {
      padding: 0.25rem 0.75rem; border-radius: 999px; border: 1px solid var(--line);
      color: var(--ink-soft); font-size: var(--text-xs);
    }
    .toc a:hover { border-color: var(--accent-soft); color: var(--accent); text-decoration: none; }
    .faq { border-bottom: 1px dashed var(--line); padding: 0.625rem 0; }
    /* .disclosure 已在 global.css 統一 summary 外觀，這裡只覆寫「問句要重一點」。 */
    .faq > summary { font-weight: 700; color: var(--ink); font-size: var(--text-base); }
    .faq p { margin: 0.625rem 0 0; color: var(--ink-soft); }
    /* 圖片來源逐張列出是授權條件，不能收起來；但單欄一路往下有好幾百筆。
       改成多欄密排，每一筆仍完整可見（含作者與授權連結），只是版面壓縮。 */
    .credits {
      font-size: var(--text-xs); color: var(--ink-soft);
      list-style: none; padding-left: 0;
      display: grid; gap: 0.125rem 1.5rem;
      grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    }
    .credits li { margin: 0.1875rem 0; }
  </style>
</Base>
