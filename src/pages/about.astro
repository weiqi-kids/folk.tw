---
import Base from '../layouts/Base.astro';
import LeadVisual from '../components/LeadVisual.astro';
import { HUB } from '../lib/breadcrumbs';
import { getEvents, getDeities, getTemples, getPractices } from '../lib/queries';
import artifacts from '../data/artifacts.json';

// 🔴 隱私段**不可再寫「本站不販售亦不用於廣告投放」這類商業模式承諾**（2026-08-12 用戶裁示移除）。
//    那句是建站時的誤解，站主的實際立場是：**不接受業配文，但不排除廣告投放**，
//    且這個站本來就規劃了 NFC 抽籤這類產品——寫「不用於廣告投放」等於對外做了一個站主沒同意的承諾。
//    ⚠️ 這條**不影響**祈福頁的「不變現」紅線：那是災難頁專屬的鐵則（見 docs/topical-blessing.md §0.1），
//    兩者是不同層次的事，不要因為這裡放寬就去動那條。
//    未來若真的上廣告，這段要補的是**廣告／Cookie 的據實說明**，不是反向再寫一次承諾。
//
// 🔴 「資料與統計」段是**站上實際送出什麼的據實清單**，不是安撫性文案（2026-08-13 重寫）。
//    原文只寫「本身不蒐集個人資料＋GA4 匿名統計」，但實際上 cookie、求籤的 concern／poem_no、
//    報喜的 outcome、**以及搜尋字詞**都會進 GA4——搜尋那條尤其嚴重，因為它跟上一句
//    「全文檢索在瀏覽器端運作」擺在一起會被讀成「什麼都不外送」。
//    ⚠️ **改動任何 gtag 事件的 payload，同一回合要回來改這段**；來源分別是
//    Base.astro（campaign_click／intent_click／calendar_add／line_add_click）、
//    qiugian/[slug].astro（qiugian／qifu／baoxi）、qiugian/blessing/[slug].astro（qifu）、
//    search.astro（view_search_results／search_zero_results／search_result_click，字詞經 analyticsTerm 過濾）、
//    ShareRow.astro（share）、PuduChecklist.astro。座標不外送由 check-rendered 不變量 13 守著。
//    🔴 移除了「以上免責、責任限制與使用條款均已定稿」——那是寫給自己看的編輯備註，
//    對讀者零資訊，且頁面上根本沒有「使用條款」這個段落（後設警語，記憶 no-meta-disclaimers-on-pages）。
//
// 圖片來源彙整：逐張標作者·授權·出處。
// ⚠️ 來源是**複合的**（Wikimedia Commons ＋ 內政部全國宗教資訊網），不要再寫成單一來源——
//    下方那段引言是清單的全稱斷言，清單多一種授權它就得多提一種（check-rendered 不變量 5 硬擋）。
const creditOf = (items: { data: Record<string, any> }[], nameKey = 'name') =>
  items
    .filter((e) => e.data.image)
    .map((e) => ({ name: e.data[nameKey] as string, ...(e.data.image as any) }));
const creditGroups = [
  { label: '神明', items: creditOf(await getDeities()) },
  { label: '廟宇', items: creditOf(await getTemples()) },
  { label: '民俗活動', items: creditOf(await getEvents()) },
  { label: '拜拜習俗', items: creditOf(await getPractices(), 'title') },
  // 民俗文物分類頁的示意圖（2026-08-20）。不是 content collection，故直接讀資料檔。
  {
    label: '民俗文物',
    items: artifacts.categories.filter((c) => c.image).map((c) => ({ name: c.title, ...(c.image as any) })),
  },
].filter((g) => g.items.length > 0);

// 常見問答（AEO：問答友善＋FAQPage schema）
const faqs = [
  {
    q: '神酷（神庫）是什麼？',
    a: '一個查台灣民俗的地方。籤詩、神明、廟宇、農民曆、拜拜的規矩，都整理成可以一條一條查的資料，每一條都標了出處。碰到說法不一致的地方，各家說法一起列出來，不挑一個當標準答案。',
  },
  {
    q: '籤詩的分項解準不準？',
    a: '這裡的白話賞析跟分項解是我們自己寫的，講的是這首籤在傳統裡怎麼被理解，不是替你算命。坊間解籤本的文字有著作權，我們沒有抄。',
  },
  {
    q: '農民曆的宜忌依據是什麼？',
    a: '依《欽定協紀辨方書》四庫全書本。每一條都寫得出是哪幾個神煞、照哪條規則推出來的，並附上卷數。沒有跟原文核對過的，不會顯示出來。',
  },
  {
    q: '資料來源可靠嗎？',
    a: '每一條事實都掛來源，查不到來源的就留空、不猜。有爭議的地方並陳各家說法，不判定誰才正統。公有領域的原文直接收錄，並標明是哪一個版本。',
  },
  {
    q: '涵蓋哪些範圍？',
    a: '以漢人民間信仰為主，包括海神、開拓神、族群神、行業神、愛情婦幼、動物神、自然神這七類。台灣的宗教信仰不只這些，沒收進來的還很多。',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="關於神酷"
  description="神酷（神庫）是什麼、收了哪些不收哪些、資料從哪來、隱私怎麼處理，以及發現錯誤要怎麼告訴我們。"
  faq={faqLd}
  crumbs={[HUB.about]}
>
  <h1>關於神酷（神庫）</h1>
  <p class="lead">
    這個站在做的事很單純：把台灣民俗信仰的知識整理成<strong>可以一條一條查、每一條都找得到出處</strong>的資料。
    籤詩、神明、廟宇、農民曆、民俗活動、拜拜的規矩都在裡面。
    我們想幫你看懂這些文化怎麼運作，<strong>不替你預言吉凶</strong>。
  </p>

  <LeadVisual src="/og.png" alt="神酷：神庫・台灣民俗信仰知識系統" />

  {/* 目錄（2026-08-08）：整頁 10,000px、八個主題一路往下，最後還接一份數百筆的圖片來源清單，
      要找「版權與授權」得先捲過全部。錨點指向下方既有的 <section>，沒有新增內容。 */}
  <nav class="toc" aria-label="本頁目錄">
    <a href="#faq">常見問答</a>
    <a href="#disclaimer">這裡不做什麼</a>
    <a href="#negative">凶籤與凶宜忌怎麼寫</a>
    <a href="#respect">對神明與廟方的分寸</a>
    <a href="#scope">收了哪些、沒收哪些</a>
    <a href="#license">版權與授權</a>
    <a href="#credits">圖片來源</a>
    <a href="#errata">發現錯誤怎麼辦</a>
  </nav>

  <section id="faq">
    <h2>常見問答</h2>
    {
      faqs.map((f) => (
        <details class="faq disclosure">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </section>

  <section id="disclaimer">
    <h2>這裡不做什麼</h2>
    <p>
      這裡寫的是民俗文化怎麼回事，<strong>不是醫療、法律、投資、命理或宗教上的建議</strong>。
      宜忌、籤詩裡談疾病訴訟求財的那幾項、改運收驚安太歲、神煞吉凶，
      講的都是「傳統上怎麼看」，不是「你應該怎麼做」。
    </p>
    <p>
      內容碰到健康、法律、財務或心理的問題，請找專業的人談。
      我們不勸你去、也不勸你別去，更不能代替專業判斷。
    </p>
    <h3>責任限制</h3>
    <p>
      站上的內容（籤詩白話、宜忌、神明與民俗資料都算）供文化教育與學術參考，
      <strong>依現況提供，不對正確性、完整性或是否適合你的用途作任何擔保</strong>，明示或默示都沒有。
      你依據這些內容做的決定與行動，<strong>風險由你自己承擔</strong>；
      在法律許可的範圍內，我們對任何直接或間接的損害不負賠償責任。
      看到錯的或有爭議的地方，歡迎照最後一段的方式回報，我們會查證更正。
    </p>
    <h3>資料與統計</h3>
    <p>
      這是一個靜態網站，沒有帳號，也沒有會跟你要個人資料的表單。全站搜尋是在你的瀏覽器裡跑的。
      為了知道哪些內容有人看、該往哪裡補，站上裝了 <strong>Google Analytics 4</strong>：
      它會在你的瀏覽器放 cookie，記錄你看過哪些頁，設定上要求 Google 把 IP 匿名化。
    </p>
    <p>
      合作宮廟的籤詩頁有個「<strong>祈福籤詩圖</strong>」的功能。
      你自己選要不要上傳照片；上傳的話，照片會經過我們的伺服器交給 OpenAI 生成圖片，
      生成完就刪掉。<strong>照片不會被留下來</strong>，也不會拿去做生成以外的任何事，
      留下的只有「哪間廟、哪支籤生成過一張」這種計數。不用這個功能，照片就不會離開你的裝置。
    </p>
    <p>
      籤詩頁的「<strong>同籤的人留下的話</strong>」是人工逐則看過才刊出的，刊出時匿名。
      我們不收姓名，為了防灌水只留一段還原不回去的連線識別雜湊。
      那些話都是留言的人自己的經驗，不是神明的指示，也不是解籤。
    </p>
    <p>
      除了「你看了哪一頁」，下面這些互動也會送出統計事件：求籤、集氣祈福跟報喜會送出
      <strong>你點的是哪一類煩惱</strong>、抽到第幾支籤、報喜的結果；
      如果你是從廟方的 QR 或 NFC 連結進來的，這些事件會多帶一組那間廟的代碼。
    </p>
    <p>
      站內搜尋會送出<strong>你打的字</strong>，但有過濾：只有明確是民俗領域的詞
      （廟名、神明、籤、農民曆這類）才照字面送，其他一律換成分類代碼，
      看起來像 email、網址或電話號碼的也一樣換掉。
    </p>
    <p>
      用到你位置的地方有兩個，兩個都不會把座標交出來：「附近的廟」是在你的裝置上算完距離才顯示；
      好日子頁那種「在地圖上找店家」的連結，是把搜尋丟給地圖服務、由你的裝置決定位置，
      我們這邊不經手，站上也沒有任何店家資料。
    </p>
    <p>
      上面送出去的統計資料由 Google 依它自己的隱私政策處理。
      你可以在瀏覽器設定裡擋掉，或用 Google 提供的停用工具。
    </p>
  </section>

  <section id="negative">
    <h2>凶籤與凶宜忌怎麼寫</h2>
    <p>
      凶籤、凶的宜忌、籤詩裡談疾病跟訴訟的那幾項，我們照文化脈絡講它在傳統裡怎麼被解讀，
      不寫成命令句。不會去猜你現在遇到什麼事，也不替你斷禍福。
      內容碰到困境的時候，會給中性的求助方向，不引導你往哪個方向想。
    </p>
  </section>

  <section id="respect">
    <h2>對神明與廟方的分寸</h2>
    <p>
      寫給信眾看的東西語氣要莊重，不拿神明跟儀俗開玩笑、不當哏用。
      廟與廟之間的爭議，像分靈的先後、位階高低、信仰圈範圍、誰才是正統，
      一律各家說法並列，不選邊，也不裁定誰對。
      神格的高低我們不建模、不排序，只記錄分類跟彼此的關係。
    </p>
  </section>

  <section id="scope">
    <h2>收了哪些、沒收哪些</h2>
    <p>
      收的以<strong>漢人民間信仰</strong>為主，分成海神、開拓神、族群神、行業神、愛情婦幼、動物神、自然神七類。
      <strong>台灣的宗教信仰遠不只這些</strong>：原住民族的傳統信仰、佛教各宗、一貫道、新興宗教，這裡都沒有收。
    </p>
    <p class="muted small">
      民俗活動算不算文化資產，以<strong>文化部國家文化資產網</strong>當下的登錄狀態為準，還沒核定的標「待核」。
      進香即時軌跡那類連結來自第三方，不是官方發佈的資料，站上只是把連結附上。
    </p>
  </section>

  <section id="license">
    <h2>版權與授權</h2>
    <ul>
      <li>籤詩的四句本文多半屬於公有領域，直接收錄，並標明是哪一套籤、哪一個版本。</li>
      <li>坊間「解籤」的文字通常有著作權，<strong>我們沒有抄</strong>，分項解都是自己寫的。</li>
      <li>典故故事取自公有領域的題材（史記、演義那些），自己敘述，不抄特定的改寫本。</li>
      <li>神明的聖誕、職司這類事實不受著作權保護，但還是逐條引來源佐證。</li>
      <li>內政部的寺廟開放資料，依政府資料開放授權條款使用並標示來源。</li>
      <li>
        <strong>內政部全國宗教資訊網的網站內容</strong>，包括宗教知識+ 的條目、寺廟的歷史沿革、
        建築特色、參拜流程，以及所附的照片。2026 年 8 月經內政部同意使用，
        <strong>條件是標示資料來源連結</strong>。我們的作法是每一筆都掛回它自己的原始網址，
        文字<strong>逐字引用、不改寫</strong>；照片另外標上原圖說裡寫的攝影者姓名。
      </li>
      <li>
        <strong>文化部國家文化資產網</strong>裡民俗登錄個案的登錄理由、歷史沿革與參觀注意事項。
        2026 年 8 月經文化部同意使用，<strong>條件是掛回該個案的公開網址</strong>，
        文字同樣<strong>逐字引用、不改寫</strong>。
      </li>
      <li>
        <strong>內政部臺灣宗教文化地圖</strong>（taiwangods.moi.gov.tw）。
        它跟上面那條是兩個不同的網站，2026 年 8 月另外經內政部確認同意使用，
        <strong>條件一樣是標示資料來源連結</strong>。
      </li>
      <li>
        {/* 2026-08-19 站主確認此站亦已授權（追認 taiwangods 的同一輪）。條件比照前述三條＝
            標示資料來源連結。⚠️ 授權事實只寫在這一段，各條目頁不另掛授權說明——
            那會變成警語牆（見記憶 no-meta-disclaimers-on-pages），逐筆的來源連結本身就是履行條件。 */}
        <strong>國史館臺灣文獻館</strong>（th.gov.tw）的館藏文獻與研究文章，用來考據民俗的源流。
        2026 年 8 月經同意使用，<strong>條件一樣是標示資料來源連結</strong>。
      </li>
    </ul>

    <h3>各籤系的版本依據</h3>
    <p class="muted small">
      同一支籤，不同廟的籤版文字不見得一樣，所以每一套籤都標明是依哪個版本。
      四句本文屬於公有領域；<strong>廟方自己另外附的白話解說是廟方的著作，我們只掛連結、不轉載</strong>。
    </p>
    <ul>
      <li><strong>六十甲子籤</strong>（60 首）用通行版，卦頭故事拿泰安宮媽祖聖籤版校對過。</li>
      <li><strong>關聖帝君靈籤</strong>（100 首）用雷雨師百首通行本。</li>
      <li>
        <strong>月下老人靈籤</strong>（27 首）用臺南祀典大天后宮官網公布的籤版，逐首從掃描件謄錄。
        這套的取籤方式是連擲三次筊，用三次的杯象對應一首。
        <a href="https://www.gtainanmazu.org.tw/?act=menuinfo&amp;ml_id=20220121003" rel="nofollow noopener" target="_blank">廟方頁面</a>
      </li>
      <li>
        <strong>內門紫竹寺觀音籤</strong>（28 首）來自高雄內門紫竹寺官網的「解籤園地」，逐首從 HTML 謄錄。
        這是該寺自有的二十八首，不是坊間常說的「觀音一百籤」。
        <a href="https://www.nmzizhusi.org.tw/?act=jieqianyuandi&amp;cmd=list" rel="nofollow noopener" target="_blank">廟方頁面</a>
      </li>
      <li>
        <strong>保生大帝藥籤</strong>（330 首）是臺南興濟宮版，出自衛生福利部國家中醫藥研究所的數位典藏。
        藥方掛公眾領域標章（PDM），藥材說明的授權是 OGDL 1.0。
      </li>
    </ul>
    <h3>解籤文字的撰寫原則</h3>
    <ul>
      <li><strong>白話賞析跟八項分項解都是我們自己寫的</strong>，依據是公有領域的題材、那首籤的四句跟卦頭典故，不是抄現代的解籤本。</li>
      <li>現代解籤本的文字有著作權，我們不抄。</li>
      <li>月老籤跟紫竹寺觀音籤這兩套，<strong>籤版上本來就印了分項判語</strong>。那部分標「籤版原印」照錄不改寫，跟我們自己寫的分開放。</li>
    </ul>

    <p class="muted small">程式碼採開源授權，見原始碼庫的 LICENSE。</p>
  </section>

  <section id="credits">
    <h2>圖片來源</h2>
    {/* 🔴 這段話是**清單的全稱斷言**，不是裝飾——下方逐張列出的每一種授權都必須在這裡被提到。
        2026-08-07 踩過：原句寫「代表圖皆取自 Wikimedia Commons」，但當天匯入 19 張內政部照片後，
        清單裡就有兩種授權，那句「皆取自」變成錯的陳述（單張的標示各自都對，錯的是這句總結）。
        已做成 gate（check-rendered 不變量 5：清單出現幾種授權，這段就必須提到幾種）。 */}
    <p class="muted small">
      代表圖來自兩個地方：<strong>Wikimedia Commons</strong>（CC 授權或公有領域），
      還有<strong>內政部</strong>全國宗教資訊網（2026 年 8 月經同意使用，條件是標示資料來源連結）。
      兩邊都照授權標出原作者跟條款。找不到授權清楚的圖就留空，寧可沒有圖，也不掛來路不明的別人的作品。
      圖檔都縮過圖、存在自己這裡，不去熱連別人的伺服器。下面是逐張的出處：
    </p>
    {
      creditGroups.map((g) => (
        <>
          <h3>{g.label}（{g.items.length}）</h3>
          <ul class="credits">
            {g.items.map((c) => (
              <li>
                <a href={c.source} target="_blank" rel="noopener nofollow">
                  {c.name}
                </a>
                {' — '}
                {c.author}
                {'，'}
                {c.license_url ? (
                  <a href={c.license_url} target="_blank" rel="noopener nofollow">
                    {c.license}
                  </a>
                ) : (
                  c.license
                )}
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </section>

  <section id="errata">
    <h2>發現錯誤怎麼辦</h2>
    <p>
      每一個條目都標了來源。看到錯的地方，不管是事實、來源還是判讀，都歡迎告訴我們。
      查證之後會更正，並記下版本跟更新日期；真的有爭議、一時定不下來的，會標成「諸說並陳」或「待考」。
    </p>
    <p class="errata">
      <strong>回報管道：</strong>
      <a href="https://github.com/weiqi-kids/folk.tw/issues/new" target="_blank" rel="noopener">到 GitHub 開一則 Issue →</a>
      　廟方跟研究者的指正特別歡迎，麻煩附上是哪個條目、依據是什麼。
    </p>
  </section>

  <style>
    .lead { font-size: var(--text-base); }
    h2 { border-bottom: 1px solid var(--accent-soft); padding-bottom: 0.375rem; margin-top: 2.25rem; }
    .small { font-size: var(--text-sm); }
    li { margin: 0.375rem 0; }
    section { scroll-margin-top: 1rem; }
    .toc {
      display: flex; flex-wrap: wrap; gap: 0.5rem 0.625rem;
      margin: 1.75rem 0 0.5rem; padding: 1.125rem 1.25rem;
      border: 1px solid var(--line); border-radius: 0.625rem; background: var(--paper-2);
    }
    .toc a {
      padding: 0.25rem 0.75rem; border-radius: 999px; border: 1px solid var(--line);
      color: var(--ink-soft); font-size: var(--text-xs);
    }
    .toc a:hover { border-color: var(--accent-soft); color: var(--accent); text-decoration: none; }
    .faq { border-bottom: 1px dashed var(--line); padding: 0.625rem 0; }
    /* .disclosure 已在 global.css 統一 summary 外觀，這裡只覆寫「問句要重一點」。 */
    .faq > summary { font-weight: 700; color: var(--ink); font-size: var(--text-base); }
    .faq p { margin: 0.625rem 0 0; color: var(--ink-soft); }
    /* 圖片來源逐張列出是授權條件，不能收起來；但單欄一路往下有好幾百筆。
       改成多欄密排，每一筆仍完整可見（含作者與授權連結），只是版面壓縮。 */
    .credits {
      font-size: var(--text-xs); color: var(--ink-soft);
      list-style: none; padding-left: 0;
      display: grid; gap: 0.125rem 1.5rem;
      grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    }
    .credits li { margin: 0.1875rem 0; }
  </style>
</Base>
