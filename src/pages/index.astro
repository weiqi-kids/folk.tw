---
import Base from '../layouts/Base.astro';
import { getPoems, getAllusions } from '../lib/queries';
import { todayInTaipei, pickDailyIndex } from '../lib/daily';
import { upcomingDeityBirthdays } from '../lib/birthdays';
import UpcomingBirthdays from '../components/UpcomingBirthdays.astro';
import FestivalCountdown from '../components/FestivalCountdown.astro';
import { festivalNextSolar } from '../lib/lunar-date';
import festivals from '../data/festivals.json';
import { orgNode } from '../lib/seo';
import { activeSeasonalCampaign as pickSeasonalCampaign, seasonalCampaigns } from '../lib/seasonal-campaigns';

// 今日中樞（§0.5）：每日一籤領銜（情感主角），模組入口平等可達。
// 不把運勢吉凶當頭條；吉凶若有也僅作輔標（本系統籤詩多無吉凶定級）。
// 每日一籤固定取六十甲子籤（旗艦系統），維持「今日選讀」策展的一致性（§0.5）
const poems = (await getPoems())
  .filter((p) => p.data.system.id === 'liushi_jiazi')
  .sort((a, b) => a.data.no - b.data.no);
const allPoemIds = (await getPoems()).map((p) => p.id); // 擲一支隨機瀏覽用（§0.5）
const allusions = await getAllusions();
const allusionById = new Map(allusions.map((a) => [a.id, a]));

const { iso, epochDay } = todayInTaipei();
// 近期神明聖誕：build 算未來 60 天國曆日期（多抓些供前端過濾已過者後仍有 6 筆可顯示）
const upcomingBirthdays = await upcomingDeityBirthdays(iso, 60);
// 近期節日：同一套「build 算日期、前端即時倒數」機制，與 /festivals/ 樞紐共用同一份資料與函式。
const upcomingFestivals = festivals
  .map((f) => {
    const { iso: solarIso, label } = festivalNextSolar(f, iso);
    return solarIso ? { slug: f.slug, name: f.name, iso: solarIso, lunarLabel: label, dateNote: f.date_note } : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .sort((a, b) => a.iso.localeCompare(b.iso));
const idx = pickDailyIndex(epochDay, poems.length);
const todayPoem = poems[idx];
const firstAllusion = todayPoem?.data.allusions[0];
const allusion = firstAllusion ? allusionById.get(firstAllusion.ref.id) : undefined;

// 卡序依 GSC 近 28 天實測需求（廟宇 ≫ 籤詩 > 神明 > 農民曆 > 習俗 > 活動）；
// 廟宇原缺卡、實為最大需求模組故補上並置首；行業守護神為新模組（乙案強入口）。
const modules = [
  { href: '/temples/', label: '廟宇資料庫', desc: '主祀神明、縣市鄉鎮瀏覽、名廟沿革' },
  { href: '/poems/', label: '籤詩解碼', desc: '六十甲子籤，四句＋典故＋分項解' },
  { href: '/allusions/', label: '卦頭典故', desc: '籤詩背後的公有領域故事，反查出現於哪支籤' },
  { href: '/qiugian/', label: '求籤解惑', desc: '為考試、工作、感情求一支籤，看白話解籤' },
  { href: '/deities/', label: '神明圖譜', desc: '七大類、職司、聖誕、關係網' },
  { href: '/almanac/', label: '農民曆', desc: '干支建除、宜忌考據化（建置中）' },
  { href: '/trades/', label: '行業守護神', desc: '考生拜文昌、商家拜關公、行業吉日' },
  { href: '/practices/', label: '拜拜習俗', desc: '科儀步驟、金紙供品' },
  { href: '/events/', label: '民俗活動', desc: '遶境進香、文資身分' },
];

// 熱門神明：直連旗艦獨特頁，把離首頁的跳數壓到 1，
// 引導爬蟲與權重流向真正有搜尋需求的內容頁（依 GSC 實測曝光查詢挑選）。
const featuredDeities = [
  { id: 'mazu', name: '媽祖' },
  { id: 'yuelao', name: '月老' },
  { id: 'guangong', name: '關聖帝君' },
  { id: 'guangze', name: '廣澤尊王' },
  { id: 'nazha', name: '中壇元帥' },
  { id: 'baosheng', name: '保生大帝' },
  { id: 'chenghuang', name: '城隍爺' },
];

// 2026 農曆七月站內戰役主卡：排程與相關頁 CTA 共用 seasonal-campaigns 唯一資料源。
const activeSeasonalCampaign = pickSeasonalCampaign(iso);
---

<Base
  description="神酷（神庫）：台灣民俗信仰知識系統——籤詩解讀、神明關係圖譜、廟宇文化與農民曆，逐條掛來源、諸說並陳。"
  ogTitle="神酷｜查月老籤、媽祖信仰與台灣民俗百科"
  jsonLd={orgNode()}
>
  <header class="brand-hero">
    <h1>神酷<span class="alt">（神庫）</span></h1>
    <p class="tagline">查籤詩、看神明、懂台灣民俗</p>
  </header>
  <section class="intent-actions" aria-labelledby="intent-actions-title">
    <h2 id="intent-actions-title">現在想做什麼？</h2>
    <div class="intent-grid">
      <a class="intent-card card" href="/almanac/" data-intent-action="today" data-intent-placement="home_quick_action">
        <strong>看今天適合做什麼</strong>
        <span class="muted">查今日宜忌、沖煞與農民曆</span>
      </a>
      <a class="intent-card card" href="/qiugian/" data-intent-action="qiugian" data-intent-placement="home_quick_action">
        <strong>為目前的事求一支籤</strong>
        <span class="muted">從工作、感情、考試等情境開始</span>
      </a>
      <a class="intent-card card" href="/temples/nearby/" data-intent-action="nearby_temples" data-intent-placement="home_quick_action">
        <strong>找附近適合參拜的廟</strong>
        <span class="muted">座標只在瀏覽器計算，不會外送</span>
      </a>
    </div>
  </section>
  {
    activeSeasonalCampaign && (
      <section class="seasonal" data-seasonal-campaign>
        <p class="campaign-kicker" data-campaign-eyebrow>{activeSeasonalCampaign.eyebrow}</p>
        <article class="campaign-card card">
          <a href={activeSeasonalCampaign.href} class="campaign-visual-link" data-campaign-image-link
            data-growth-campaign data-growth-placement="home_image">
            <img
              src={activeSeasonalCampaign.image}
              alt={activeSeasonalCampaign.imageAlt}
              width="1200"
              height="630"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              data-campaign-image
            />
          </a>
          <p class="campaign-date">
            <strong data-campaign-date>{activeSeasonalCampaign.dateLabel}</strong>
            <span class="muted" data-campaign-countdown></span>
          </p>
          <h2><a href={activeSeasonalCampaign.href} data-campaign-link
            data-growth-campaign data-growth-placement="home_title">{activeSeasonalCampaign.title}</a></h2>
          <p data-campaign-prompt>{activeSeasonalCampaign.prompt}</p>
          <p class="campaign-cta"><a href={activeSeasonalCampaign.href} data-campaign-cta
            data-growth-campaign data-growth-placement="home_cta">{activeSeasonalCampaign.cta}</a></p>
        </article>
        <script is:inline type="application/json" id="seasonal-campaigns" set:html={JSON.stringify(seasonalCampaigns).replace(/</g, '\\u003c')} />
        <script is:inline>
          (() => {
            const root = document.querySelector('[data-seasonal-campaign]');
            const source = document.getElementById('seasonal-campaigns');
            if (!root || !source) return;
            const parts = new Intl.DateTimeFormat('en', {
              timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit',
            }).formatToParts(new Date());
            const value = (type) => parts.find((part) => part.type === type)?.value;
            const today = `${value('year')}-${value('month')}-${value('day')}`;
            const campaigns = JSON.parse(source.textContent || '[]');
            const active = campaigns.find((item) => item.start <= today && today <= item.end);
            if (!active) { root.hidden = true; return; }
            root.querySelector('[data-campaign-eyebrow]').textContent = active.eyebrow;
            root.querySelector('[data-campaign-date]').textContent = active.dateLabel;
            root.querySelector('[data-campaign-link]').textContent = active.title;
            root.querySelector('[data-campaign-link]').setAttribute('href', active.href);
            root.querySelector('[data-campaign-image-link]').setAttribute('href', active.href);
            root.querySelector('[data-campaign-image]').setAttribute('src', active.image);
            root.querySelector('[data-campaign-image]').setAttribute('alt', active.imageAlt);
            root.querySelector('[data-campaign-prompt]').textContent = active.prompt;
            root.querySelector('[data-campaign-cta]').textContent = active.cta;
            root.querySelector('[data-campaign-cta]').setAttribute('href', active.href);
            const [y, m, d] = active.target.split('-').map(Number);
            const [ty, tm, td] = today.split('-').map(Number);
            const days = Math.round((Date.UTC(y, m - 1, d) - Date.UTC(ty, tm - 1, td)) / 86400000);
            root.querySelector('[data-campaign-countdown]').textContent = days === 0 ? '　今天' : `　還有 ${days} 天`;
          })();
        </script>
      </section>
    )
  }
  <section class="hero">
    <p class="kicker">今日選讀 · {iso}（全站同一支）</p>
    {
      todayPoem && (
        <article class="daily card">
          <header class="daily-head">
            <h2>
              <a href={`/poems/${todayPoem.id}/`}>
                第 {todayPoem.data.no} 籤 · {todayPoem.data.ganzhi}
              </a>
            </h2>
            <span class="gua">{todayPoem.data.gua && `${todayPoem.data.gua}卦`}</span>
          </header>
          <p class="lines-vertical daily-lines">
            {todayPoem.data.lines.map((l) => <span class="line">{l}</span>)}
          </p>
          {allusion && (
            <p class="allusion-hint">
              卦頭故事：<a href={`/allusions/${allusion.id}/`}>{allusion.data.name}</a>
              {allusion.data.source && <span class="muted">（{allusion.data.source}）</span>}
            </p>
          )}
          <p class="daily-cta">
            <a href={`/poems/${todayPoem.id}/`}>讀解碼：四句賞析 · 典故 · 分項解 →</a>
          </p>
        </article>
      )
    }
    <p class="lookup">
      <a href="/search/">手上有籤？貼上整段籤詩文字，馬上查解 →</a>
    </p>
    {/* 2026-08-08 調序：原本是「查籤入口 → 策展說明 → 瀏覽入口」，一段說明夾在兩個動作中間，
        首屏看起來是四組互相競爭的 CTA。兩個動作先併在一起，說明降到最後——內容一字沒改。 */}
    <p class="explore">
      <a href="/poems/">自由查號／瀏覽全部籤詩 →</a>
      <button id="cast" type="button" class="cast-btn" data-ids={allPoemIds.join(',')}>擲一支</button>
      <span class="muted small">（隨機瀏覽探索，非問事）</span>
    </p>
    <p class="note muted">
      每日一籤為策展（像每日一詩），同日全站一致、不因人隨機、不標個人運勢。
    </p>
    <script is:inline>
      document.getElementById('cast')?.addEventListener('click', (e) => {
        const ids = e.currentTarget.dataset.ids.split(',');
        location.href = '/poems/' + ids[Math.floor(Math.random() * ids.length)] + '/';
      });
    </script>
  </section>

  <section class="modules">
    <h2>由此深掘</h2>
    <div class="grid cols">
      {
        modules.map((m) => (
          <a class="module card" href={m.href}>
            <strong>{m.label}</strong>
            <span class="muted">{m.desc}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="featured">
    <h2>熱門神明</h2>
    <p class="featured-links">
      {
        featuredDeities.map((d) => (
          <a href={`/deities/${d.id}/`}>{d.name}</a>
        ))
      }
      <a class="more" href="/deities/">看全部神明 →</a>
    </p>
  </section>

  {
    upcomingFestivals.length > 0 && (
      <section class="featured">
        <h2>近期節日</h2>
        <FestivalCountdown items={upcomingFestivals} limit={4} />
        <p class="featured-links">
          <a class="more" href="/festivals/">完整節日曆 →</a>
          <a class="more" href="/festivals/local/">各地方宗教慶典 →</a>
        </p>
      </section>
    )
  }

  {
    upcomingBirthdays.length > 0 && (
      <section class="featured">
        <h2>近期神明聖誕</h2>
        <UpcomingBirthdays items={upcomingBirthdays} limit={6} />
        <p class="featured-links">
          <a class="more" href="/deities/birthdays/">完整神明聖誕曆 →</a>
        </p>
      </section>
    )
  }

  <style>
    .brand-hero { margin: 0.625rem 0 1.875rem; }
    .brand-hero h1 { margin: 0; font-size: var(--text-2xl); letter-spacing: 0.1em; color: var(--accent); }
    .brand-hero h1 .alt { color: var(--ink-soft); font-size: var(--text-lg); font-weight: 400; }
    .brand-hero .tagline { margin: 0.25rem 0 0; color: var(--ink-soft); letter-spacing: 0.08em; }
    .intent-actions { margin: 0 0 2.25rem; }
    .intent-actions h2 { margin: 0 0 0.75rem; font-size: var(--text-lg); }
    .intent-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
    .intent-card { display: flex; flex-direction: column; gap: 0.3125rem; }
    .intent-card strong { color: var(--ink); }
    @media (max-width: 46rem) { .intent-grid { grid-template-columns: 1fr; } }
    .seasonal { margin: 0 0 2.25rem; }
    .campaign-kicker { color: var(--accent); letter-spacing: 0.1em; font-size: var(--text-sm); margin: 0 0 0.625rem; }
    .campaign-card { border-color: var(--gold); background: var(--paper-2); }
    .campaign-visual-link { display: block; margin-bottom: 1rem; }
    .campaign-visual-link img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
    .campaign-card h2 { margin: 0.5rem 0 0.75rem; font-size: var(--text-xl); }
    .campaign-card h2 a { color: var(--ink); }
    .campaign-date { margin: 0; color: var(--accent); }
    .campaign-cta { margin: 1rem 0 0; font-weight: 700; }
    .kicker { color: var(--gold); letter-spacing: 0.1em; font-size: var(--text-sm); margin: 0 0 0.625rem; }
    .daily { border-color: var(--accent-soft); }
    .daily-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1.25rem; }
    .daily-head h2 { margin: 0; font-size: var(--text-xl); }
    .daily-head h2 a { color: var(--ink); }
    /* 手機 390px 實測：「第 34 籤 · 己未」折兩行的同時「未濟卦」也被擠成兩行，
       兩邊各自斷行、對不齊。卦名不准折，窄螢幕直接把它放到標題下面自成一行。 */
    .gua { color: var(--accent); font-weight: 700; white-space: nowrap; }
    @media (max-width: 30rem) {
      .daily-head { flex-wrap: wrap; gap: 0.25rem; }
      .daily-head h2 { flex: 1 1 100%; }
    }
    .daily-lines { margin: 1.5rem 0; }
    .daily-lines .line { display: block; }
    .allusion-hint { margin: 0.75rem 0 0.25rem; }
    .daily-cta { margin: 1rem 0 0; font-weight: 700; }
    .lookup {
      margin: 1.25rem 0 0;
      padding: 0.75rem 1.125rem;
      border: 1px solid var(--accent-soft);
      border-radius: 0.5rem;
      background: var(--paper-2);
    }
    .lookup a { font-weight: 700; color: var(--accent); }
    .note { font-size: var(--text-xs); margin-top: 1.5rem; }
    .explore { display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem 1.125rem; margin: 1.25rem 0 0; }
    .cast-btn {
      font-family: inherit; font-size: var(--text-sm); cursor: pointer;
      color: var(--paper-2); background: var(--accent); border: none;
      padding: 0.3125rem 1.125rem; border-radius: 1.25rem;
    }
    .cast-btn:hover { background: var(--accent-soft); }
    .small { font-size: var(--text-sm); }
    .modules { margin-top: 3.125rem; }
    .module { display: flex; flex-direction: column; gap: 0.3125rem; }
    .module strong { color: var(--ink); }
    .featured { margin-top: 2.5rem; }
    .featured-links { display: flex; flex-wrap: wrap; gap: 0.625rem 1.25rem; align-items: baseline; }
    .featured-links a { font-weight: 700; }
    .featured-links .more { font-weight: 400; color: var(--ink-soft); }
  </style>
</Base>
