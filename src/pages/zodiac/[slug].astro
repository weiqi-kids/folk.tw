---
// 生肖頁：某生肖「今年與太歲的地支關係」＋「今日／近 30 天沖不沖你」。
//
// 🔴 這頁只陳述曆法關係與有源的習俗，**不做吉凶預測**。
//    「屬鼠今年沖太歲」＝子午相沖（C.2 S10 同一套地支關係，verified）；
//    「所以今年會不順」查無權威源，一個字都不寫。措辭界線見 src/lib/zodiac.ts 檔頭。
// 🔴 判定不在本檔做，一律走 src/lib/zodiac.ts（唯一入口），與 /almanac/chongsha/ 共用同一個引擎。
// ⚠️ 出生年份用**立春**分年，不是元旦也不是農曆初一。年初出生者可能屬前一個生肖，
//    這句 caveat 必須留在頁面上——拿掉就等於給了會出錯的答案。
import Base from '../../layouts/Base.astro';
import { todayInTaipei } from '../../lib/daily';
import { faqPage } from '../../lib/seo';
import { HUB } from '../../lib/breadcrumbs';
import { getTemples } from '../../lib/queries';
import { templeCounty } from '../../lib/temple-region';
import { num } from '../../lib/format';
import {
  ZODIAC_LIST, bySlug, yearPillarOf, taisuiRelation, taisuiZodiacs,
  RELATION_LABEL, birthYears, chongDays, antaisuiTemples, taisuiShrineTemples,
} from '../../lib/zodiac';
import LeadVisual from '../../components/LeadVisual.astro';

export function getStaticPaths() {
  return ZODIAC_LIST.map((z) => ({ params: { slug: z.slug } }));
}

const { slug } = Astro.params;
const z = bySlug.get(slug as never)!;

const { iso: todayIso } = todayInTaipei();
const yp = yearPillarOf(todayIso);
const yearGanzhi = `${yp.stem}${yp.branch}`;
const solarYear = Number(todayIso.slice(0, 4));
const rel = taisuiRelation(z.branch, yp.branch);
const { zhi: zhiZodiac, chong: chongZodiacName } = taisuiZodiacs(yp.branch);

const rows = chongDays(todayIso, 30);
const mine = rows.filter((r) => r.zodiac === z.name);
const heroDay = rows[0];

const years = birthYears(z.branch).filter((y) => y <= solarYear + 6);

// 有登記安太歲的宮廟。判定在 lib（唯一入口），本檔不自行比對字串。
// 🔴 措辭：這是**廟方向內政部登記的年度祭典**裡列有安太歲，不是「本廟提供安太歲服務」。
//    無值沖關係的生肖不顯示這一段——沒有這個需求就不該推服務。
const allTemples = await getTemples();
const antaisui = rel === 'none' ? [] : antaisuiTemples(allTemples);
// 有太歲殿／供奉太歲星君的廟（2026-08-08 加）。
// 🔴 這是**比上面那批弱**的事實，兩塊必須分開呈現、各自帶自己的 caveat：
//    上面是「登記的年度祭典列有安太歲」＝有在辦；這裡只是「有這個殿／這尊神」。
//    原訂計畫是等參拜流程到齊後抽「安太歲」關鍵字，實測 0 筆——假設是錯的（見 lib 檔頭）。
// ⚠️ 去掉與上面那批重複的，免得同一間廟在同一頁出現兩次。
const antaisuiIds = new Set(antaisui.map((x) => x.id));
const taisuiShrine = rel === 'none' ? [] : taisuiShrineTemples(allTemples).filter((x) => !antaisuiIds.has(x.id));
// 按縣市分組：139 間平鋪成一串沒人看得完，分組後才找得到「我家附近」。
const shrineByCounty = (() => {
  const m = new Map<string, { id: string; name: string; district: string }[]>();
  for (const x of taisuiShrine) {
    const c = templeCounty(x.district)?.name ?? '其他';
    if (!m.has(c)) m.set(c, []);
    m.get(c)!.push(x);
  }
  return [...m.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
})();

const faq = faqPage([
  {
    q: `屬${z.name}的人${solarYear}年犯太歲嗎？`,
    a: rel === 'none'
      ? `${solarYear}年為${yearGanzhi}年，年支「${yp.branch}」。屬${z.name}者地支為「${z.branch}」，與年支既不相同也不對沖，沒有值太歲或沖太歲的關係。今年值太歲者屬${zhiZodiac}、沖太歲者屬${chongZodiacName}。`
      : `${solarYear}年為${yearGanzhi}年，年支「${yp.branch}」。屬${z.name}者地支為「${z.branch}」，${rel === 'zhi' ? '與年支相同，即「值太歲」，也就是俗稱的本命年' : `與年支相沖（${z.branch}${yp.branch}相沖），即「沖太歲」`}。這是地支關係的推算，不是吉凶預測。`,
  },
  {
    q: `今天沖不沖屬${z.name}的人？`,
    a: `農民曆每日有一相沖生肖，由當日地支對沖推得。${todayIso}（台灣）沖${heroDay.zodiac}。以下列出近 30 天沖${z.name}的日期。`,
  },
]);

const relSentence =
  rel === 'zhi'
    ? `與年支相同，是「值太歲」，也就是一般說的本命年。`
    : rel === 'chong'
      ? `與年支相沖（${z.branch}${yp.branch}相沖），是「沖太歲」。`
      : `與年支既不相同、也不對沖。`;
// 本頁的通用視覺：正文主視覺（LeadVisual）與分享圖（og）同源，只宣告一次。
const visual = 'zodiac-wheel';
---

<Base
  title={`屬${z.name}｜${solarYear}年太歲關係與今日沖煞`}
  description={`屬${z.name}（${z.branch}）在${solarYear}年（${yearGanzhi}年）是否值太歲、沖太歲，以及近 30 天哪幾天沖${z.name}。純干支曆算，非吉凶預測。`}
  og={{ family: 'visual', stem: visual }}
  faq={faq}
  kind="detail"
  answer="heroAnswer"
  crumbs={[HUB.almanac, HUB.zodiac, { name: `屬${z.name}`, path: `/zodiac/${z.slug}/` }]}
>

  <h1>屬{z.name}（{z.branch}）：{solarYear}年太歲關係與今日沖煞</h1>

  <LeadVisual visual={visual} alt={`屬${z.name}的生肖、地支與太歲關係輪盤`} />

  <section class="hero">
    <p class="hero-answer">
      {solarYear}年是<strong>{yearGanzhi}年</strong>，屬{z.name}者<strong>{RELATION_LABEL[rel]}</strong>。
      今日（<span data-role="date">{todayIso}</span>）沖<strong data-role="zodiac">{heroDay.zodiac}</strong>。
    </p>
    <p class="muted small">
      沖煞與年支關係皆為干支曆算，逐日／逐年推定，非吉凶預測。年柱以立春分年。
    </p>
  </section>

  <section>
    <h2>{solarYear}年與屬{z.name}的關係</h2>
    <p>
      {solarYear}年年柱為「{yearGanzhi}」，年支是「{yp.branch}」。屬{z.name}者地支為「{z.branch}」，{relSentence}
    </p>
    <p>
      今年<strong>值太歲</strong>的是屬{zhiZodiac}者（地支與年支相同），<strong>沖太歲</strong>的是屬{chongZodiacName}者（地支與年支對沖）。
    </p>
    <p class="muted small">
      年柱依立春分年（{yp.sources.join('；')}）。
      這裡只列地支的值、沖兩種關係。刑、害、破等說法各家寫法不一，不列。
    </p>
  </section>

  <section>
    <h2>哪些年次屬{z.name}</h2>
    <p class="years">{years.join('、')}</p>
    {/* 用左側色條標示「這句要看一下」，不用 ⚠️ emoji 當項目符號：
        emoji 在沒有 emoji 字型的環境會變成豆腐方框，而且它在版面上是裝飾、不是資訊。 */}
    <p class="muted small caveat">
      生肖以<strong>立春</strong>分年，不是元旦、也不是農曆正月初一。
      在立春之前出生的人，生肖算前一年——年初出生者請以實際立春時刻為準。
    </p>
  </section>

  <section class="table-wrap">
    <h2>近 30 天，哪幾天沖{z.name}</h2>
    {
      mine.length === 0 ? (
        <p>未來 30 天沒有沖{z.name}的日子。</p>
      ) : (
        <p>未來 30 天有 {mine.length} 天沖{z.name}：{mine.map((r) => r.md).join('、')}。</p>
      )
    }
    <table class="chong" data-chong>
      <thead>
        <tr><th>日期</th><th>沖生肖</th><th>煞方</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr data-date={r.iso} data-zodiac={r.zodiac} class={r.zodiac === z.name ? 'is-mine' : undefined}>
              <td><a href={`/almanac/${r.iso}/`}>{r.md}</a></td>
              <td>{r.zodiac}{r.zodiac === z.name ? '（就是你）' : ''}</td>
              <td>{r.dir}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="muted small">
      被沖到生肖的人，遇嫁娶、出殯等場合習俗上會暫避。點日期看該日完整農民曆。
    </p>
  </section>

  {
    rel !== 'none' && (
      <section>
        <h2>值太歲、沖太歲的人做什麼</h2>
        <p>
          民間的做法是「安太歲」：到廟裡登記姓名、農曆生日與住址，由廟方點太歲燈、掛牌入太歲殿；
          年底農曆十二月廿四日前回廟「謝太歲」、換新符牌。
        </p>
        <p>
          時間上，全台通例是農曆正月初一至元宵之間辦理，最遲到二月，立春後最宜。
        </p>
        <p>
          <a href="/practices/antaisui/">安太歲的完整流程、供品與禁忌 →</a>
        </p>

        {antaisui.length > 0 && (
          <>
            <h3>登記的年度祭典中列有安太歲的宮廟</h3>
            <p class="muted small">
              以下 {num(antaisui.length)} 間宮廟向內政部登記的年度慶(祭)典中列有安太歲。
              這是登記內容，實際辦理時間與方式以廟方公告為準。
            </p>
            <ul class="temple-list">
              {antaisui.map((x) => (
                <li>
                  <a href={`/temples/${x.id}/`}>{x.name}</a>
                  <span class="muted small">{x.district.replace(/^(..[縣市].{1,4}?[鄉鎮市區]).*$/, '$1')}</span>
                </li>
              ))}
            </ul>
          </>
        )}

        {taisuiShrine.length > 0 && (
          <>
            <h3>登記資料提到太歲殿或太歲星君的宮廟</h3>
            <p class="muted small">
              另有 {num(taisuiShrine.length)} 間宮廟，在向內政部登記的沿革、建築特色或參拜流程裡
              提到太歲殿、或供奉太歲星君。
              <strong>這是廟方登記資料裡的記載，不代表該廟目前有提供安太歲服務</strong>——
              要不要辦、怎麼辦，以廟方公告為準。
            </p>
            {shrineByCounty.map(([county, list]) => (
              <details class="county-group disclosure">
                <summary>{county}（{list.length}）</summary>
                <ul class="temple-list">
                  {list.map((x) => (
                    <li>
                      <a href={`/temples/${x.id}/`}>{x.name}</a>
                      <span class="muted small">{x.district.replace(/^(..[縣市].{1,4}?[鄉鎮市區]).*$/, '$1')}</span>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </>
        )}
      </section>
    )
  }

  <nav class="more" aria-label="更多">
    <a href="/zodiac/">十二生肖一覽 →</a>
    <a href="/almanac/chongsha/">今日沖煞查詢 →</a>
    <a href="/deities/taisui/">太歲星君 →</a>
    <a href="/almanac/">今日農民曆 →</a>
  </nav>
</Base>

<!-- 依台灣當下日期改寫「今日」、標今日列、隱藏已過日期，故 build 不新鮮時也永遠準（同 /almanac/chongsha/）。 -->
<script is:inline>
  (function () {
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Taipei' }).format(new Date());
    const toUTC = (s) => { const [y, m, d] = s.split('-').map(Number); return Date.UTC(y, m - 1, d); };
    const t0 = toUTC(today);
    const table = document.querySelector('[data-chong]');
    let hit = null;
    if (table) {
      table.querySelectorAll('tr[data-date]').forEach((tr) => {
        const days = Math.round((toUTC(tr.getAttribute('data-date')) - t0) / 86400000);
        if (days < 0) { tr.style.display = 'none'; return; }
        if (days === 0) { tr.classList.add('is-today'); hit = tr; }
      });
    }
    if (hit) {
      const d = document.querySelector('[data-role=date]');
      const zdc = document.querySelector('[data-role=zodiac]');
      if (d) d.textContent = today;
      if (zdc) zdc.textContent = hit.getAttribute('data-zodiac');
    }
  })();
</script>

<style>
  /* 縣市分組：139 間平鋪沒人看得完，收合後才找得到「我家附近」。
     用原生 <details>（同 nav 的理由：靜態 markup，爬蟲看得到，不靠 JS）。 */
  .county-group { border-top: 1px solid var(--line); padding: 0.5rem 0; }
  .county-group > summary {
    cursor: pointer;
    font-size: var(--text-base);
    color: var(--ink-soft);
    padding: 0.25rem 0;
  }
  .county-group > summary:hover { color: var(--accent); }
  .county-group[open] > summary { color: var(--ink); font-weight: 700; }

  .caveat { border-left: 3px solid var(--accent-soft); padding-left: 0.875rem; margin-top: 0.75rem; }

  .hero { margin: 1.5rem 0 2rem; }
  .hero-answer { font-size: var(--text-lg); line-height: 1.7; }
  .muted { color: var(--ink-soft); }
  .small { font-size: var(--text-sm); }
  .years { font-size: var(--text-lg); line-height: 1.9; }
  section { margin-block: 2rem; }
  .table-wrap { overflow-x: auto; }
  table.chong { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  table.chong th, table.chong td { padding: 0.4rem 0.6rem; text-align: left; border-bottom: 1px solid var(--line); }
  table.chong tr.is-mine td { background: var(--paper-2); font-weight: 600; }
  /* 「今日」要看起來是**一整列**被標起來。原本在每個 td 上畫 outline，
     結果是三個各自帶框的格子，像三個獨立的東西（2026-08-08 截圖確認）。
     改用 inset box-shadow：上下邊由每格畫、左右邊只由頭尾兩格畫，接起來就是一整列的框。 */
  table.chong tr.is-today td {
    background: var(--paper-2);
    box-shadow: inset 0 2px 0 0 var(--accent), inset 0 -2px 0 0 var(--accent);
  }
  table.chong tr.is-today td:first-child { box-shadow: inset 0 2px 0 0 var(--accent), inset 0 -2px 0 0 var(--accent), inset 2px 0 0 0 var(--accent); }
  table.chong tr.is-today td:last-child { box-shadow: inset 0 2px 0 0 var(--accent), inset 0 -2px 0 0 var(--accent), inset -2px 0 0 0 var(--accent); }
  .temple-list { list-style: none; padding: 0; display: grid; gap: 0.4rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .temple-list li { display: flex; gap: 0.5rem; align-items: baseline; }
  .temple-list a { color: var(--accent); }
  .more { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.5rem; }
  .more a { color: var(--accent); }
</style>
