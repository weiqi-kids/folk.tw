---
import Base from '../layouts/Base.astro';
---

{/* share={false}：404 沒有可分享的內容，掛分享列只是噪音 */}
<Base title="找不到頁面" description="404 — 此頁不存在。" share={false}>
  <section class="nf">
    <h1>籤落空處</h1>
    <p class="muted">您要找的頁面不存在，或內容尚在撰寫、標源中。</p>
    {/* 廟宇是站上最大的一區、也是唯一被驗證的流量來源，2026-08-08 之前卻不在 404 的出口裡；
        農民曆同理（3,000+ 頁）。走錯路的人最可能是要找這兩個。 */}
    <ul>
      <li><a href="/">回今日中樞</a></li>
      <li><a href="/temples/">廟宇</a></li>
      <li><a href="/almanac/">農民曆</a></li>
      <li><a href="/poems/">籤詩解碼</a></li>
      <li><a href="/deities/">神明圖譜</a></li>
      <li><a href="/search/">全站搜尋</a></li>
    </ul>
  </section>
  <style>
    .nf { padding: 1.25rem 0 3.75rem; }
    .nf ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 1.5rem; }
  </style>
</Base>
