---
import type { GetStaticPaths } from 'astro';
import Base from '../../../../layouts/Base.astro';
import { getTemples, getDeities } from '../../../../lib/queries';
import { breadcrumb } from '../../../../lib/seo';
import { ALL_COUNTIES, countyName, templeCounty, templeTownship } from '../../../../lib/temple-region';

// 縣市二級：各鄉鎮市區一頁，化解單一縣市頁過大（台南/高雄/屏東逾 700-1076 間）。
//
// 2026-07-28 內容深化：原本整頁只有「共 N 間」＋一長串廟名清單，屬薄列表頁——GSC 實測
// 收錄率僅 23/40（57%），是全站最低的一類（廟宇頁 88%、農民曆過去日期頁 8/8）。
// 補的內容**全部從既有資料衍生，零杜撰**：主祀神分布、在全縣的位置、有沿革／官網的廟。
// 每個鄉鎮的統計天然不同 → 頁面之間不再是同一套模板句。
export const getStaticPaths = (async () => {
  const [temples, deities] = await Promise.all([getTemples(), getDeities()]);
  const deityName = new Map(deities.map((d) => [d.id, d.data.name]));

  const paths = [];
  for (const [, slug] of ALL_COUNTIES) {
    const inCounty = temples.filter((t) => templeCounty(t.data.district)?.slug === slug);
    const byTown = new Map<string, typeof temples>();
    for (const t of inCounty) {
      const tw = templeTownship(t.data.district);
      if (!tw) continue;
      (byTown.get(tw.name) ?? byTown.set(tw.name, []).get(tw.name)!).push(t);
    }
    // 全縣各鄉鎮的間數排名（供「在本縣排第幾多」——這是該頁獨有、且純由資料算出的事實）。
    const ranked = [...byTown.entries()].sort((a, b) => b[1].length - a[1].length).map(([name]) => name);

    for (const [town, list] of byTown) {
      // 主祀神分布。分組鍵**優先用已對映的 deity.id**，不用原始文字——MOI 原始資料同一尊神
      // 有多種寫法（「天上聖母」11 間、「媽祖」1 間、「池府千歲」2 間、「池王」1 間），
      // 依原文分組會把同一尊神拆成好幾列。有對映就顯示神明節點的正式名稱並連過去；
      // 查無對映者才退回原文分組、只顯示文字不硬連（原文照留，不改寫、不猜它是誰）。
      const byDeity = new Map<string, { count: number; name: string; ref?: string }>();
      for (const t of list) {
        const ref = t.data.main_deity_ref;
        const mapped = ref && deityName.has(ref) ? ref : undefined;
        const raw = t.data.main_deity_raw?.trim();
        if (!mapped && !raw) continue;
        const key = mapped ?? raw!;
        const cur = byDeity.get(key) ?? { count: 0, name: mapped ? deityName.get(mapped)! : raw!, ref: mapped };
        cur.count += 1;
        byDeity.set(key, cur);
      }
      const deityStats = [...byDeity.values()]
        .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

      paths.push({
        params: { county: slug, town },
        props: {
          slug, town, temples: list,
          deityStats,
          rank: ranked.indexOf(town) + 1,
          townCount: ranked.length,
          countyTotal: inCounty.length,
          // 有沿革／創建年代／官網的廟＝本鎮少數已逐間查證過的，值得單獨帶出；沒有就留空不硬湊。
          documented: list.filter((t) => t.data.history || t.data.founded || t.data.website),
        },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { slug, town, temples, deityStats, rank, townCount, countyTotal, documented } = Astro.props;
const cName = countyName(slug) ?? slug;

// answer-first 摘要：整句由統計組成，每個鄉鎮都不一樣。
const top = deityStats.slice(0, 3);
const topPhrase = top.length
  ? `主祀神以${top.map((d) => `${d.name}（${d.count} 間）`).join('、')}最多`
  : '';
const share = countyTotal ? Math.round((temples.length / countyTotal) * 100) : 0;
// 直轄市／省轄市要說「全市」，不能一律「全縣」（台南市、台北市…）。
const whole = cName.endsWith('市') ? '全市' : '全縣';
const lead = [
  `${cName}${town}收錄 ${temples.length} 間廟宇`,
  topPhrase,
  `在${cName} ${townCount} 個鄉鎮市區中排第 ${rank} 多，佔${whole} ${share}%`,
].filter(Boolean).join('，') + '。';
---

<Base
  title={`${cName}${town}廟宇`}
  description={`${cName}${town}共 ${temples.length} 間廟宇${topPhrase ? `，${topPhrase}` : ''}。資料來自內政部全國宗教資訊網。`}
  jsonLd={breadcrumb([
    { name: '廟宇', path: '/temples/' },
    { name: cName, path: `/temples/region/${slug}/` },
    { name: town, path: `/temples/region/${slug}/${town}/` },
  ])}
>
  <nav class="crumb">
    <a href="/temples/">廟宇</a> ／ <a href={`/temples/region/${slug}/`}>{cName}</a> ／ {town}
  </nav>
  <h1>{cName}{town}廟宇</h1>
  <p class="lead">{lead}</p>

  {
    deityStats.length > 0 && (
      <section class="deity-stats">
        <h2>{town}的主祀神分布</h2>
        <ul class="stats">
          {deityStats.slice(0, 12).map((d) => (
            <li>
              {d.ref ? <a href={`/deities/${d.ref}/`}>{d.name}</a> : <span>{d.name}</span>}
              <b>{d.count}</b>
            </li>
          ))}
        </ul>
        {deityStats.length > 12 && (
          <p class="muted small">另有 {deityStats.length - 12} 種主祀神各見於少數宮廟，詳見下方清單。</p>
        )}
      </section>
    )
  }

  {
    documented.length > 0 && (
      <section class="documented">
        <h2>已查證沿革或官網的宮廟</h2>
        <ul class="doc-list">
          {documented.map((t) => (
            <li>
              <a href={`/temples/${t.id}/`}>{t.data.name}</a>
              {t.data.founded && <span class="muted small">　創建：{t.data.founded}</span>}
              {t.data.main_festival && <span class="muted small">　{t.data.main_festival}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <h2>全部宮廟</h2>
  <p class="muted small">點主祀神可連到神明圖譜。</p>
  <div class="grid cols">
    {
      temples.map((t) => (
        <a class="card temple" href={`/temples/${t.id}/`}>
          <strong>{t.data.name}</strong>
          <span class="muted small">
            {t.data.district}
            {t.data.main_deity_raw && `　·　主祀 ${t.data.main_deity_raw}`}
          </span>
        </a>
      ))
    }
  </div>
  <style>
    .crumb { color: var(--ink-soft); font-size: var(--text-sm); margin-bottom: 0.625rem; }
    .lead { color: var(--ink); margin-bottom: 1.5rem; }
    .deity-stats, .documented { margin-bottom: 1.875rem; }
    .stats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; }
    .stats li { display: flex; align-items: baseline; gap: 0.375rem;
      padding: 0.3125rem 0.75rem; border-radius: 999px; background: var(--paper-2); }
    .stats b { color: var(--gold); }
    .doc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .temple { display: flex; flex-direction: column; gap: 0.3125rem; }
    .temple strong { color: var(--ink); }
    .small { font-size: var(--text-sm); }
    .src { margin-top: 1.875rem; color: var(--gold); }
  </style>
</Base>
