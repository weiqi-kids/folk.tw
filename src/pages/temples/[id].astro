---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import TempleMap from '../../components/TempleMap.astro';
import RelatedSeasonalCampaign from '../../components/RelatedSeasonalCampaign.astro';
import { getTemples, getDeities, getEvents, getSystems, getScenarios, systemHref } from '../../lib/queries';
import concernsData from '../../data/concerns.json';
import { faqPage, templePlace } from '../../lib/seo';
import { templeCrumbs } from '../../lib/breadcrumbs';
import { templeCounty, templeTownship } from '../../lib/temple-region';
import { commonTempleName } from '../../lib/temple-name';
import { imageCredit } from '../../lib/image-credit';
import { lunarDateLabel } from '../../lib/birthdays';
import { festivalNextSolar } from '../../lib/lunar-date';
import {
  pickMainFestival,
  sortFestivals,
  festivalDateLabel,
  festivalSentence,
  isGenericFestivalName,
  festivalOwnerByLunarDate,
} from '../../lib/temple-festival.ts';
import { releasedItems } from '../../lib/release-schedule';
import { fullWidth, SERP_TITLE_MAX_WIDTH, TEMPLE_TITLE_DEITY_MAX_WIDTH } from '../../lib/text-width.ts';
import festivalsData from '../../data/festivals.json';
import localCelebrations from '../../data/local-celebrations.json';
import imagePriority from '../../data/image-priority.json';

export const getStaticPaths = (async () => {
  const temples = await getTemples();
  // 廟名頻率表：名稱在全站唯一者才用「廟名」嵌入 Google 地圖（顯示含星等的商家卡片，
  // 且不會解析到別間同名廟）；同名廟改用座標嵌入，精準釘位不指錯。見 TempleMap.astro。
  const nameCount = new Map<string, number>();
  for (const t of temples) nameCount.set(t.data.name, (nameCount.get(t.data.name) ?? 0) + 1);

  // 在地脈絡（2026-07-28）：GSC 抽驗顯示廟宇頁約 12% 未索引（推估 810 頁），落在最單薄那批——
  // 一頁只有名稱/地址/主祀神，內鏈 4 條，且 7891 頁彼此高度相似。這裡補的兩樣都**每頁不同**
  // 且**純由既有資料衍生**：①該鄉鎮的宮廟總數與同主祀神間數 ②同鄉鎮的鄰近宮廟連結。
  // 刻意不引用神明節點的 summary——那會讓數百間同主祀的廟出現一模一樣的段落，反而加重重複內容。
  const byTown = new Map<string, typeof temples>();
  for (const t of temples) {
    const c = templeCounty(t.data.district), tw = templeTownship(t.data.district);
    if (!c || !tw) continue;
    const key = `${c.slug}/${tw.name}`;
    (byTown.get(key) ?? byTown.set(key, []).get(key)!).push(t);
  }

  // SERP 消歧（2026-08-10）：同鄉鎮內若有同名、同主祀宮廟，原本的
  // 「廟名・縣市鄉鎮・主祀○○」仍會完全相同。只替這些碰撞頁加入地址中能唯一辨識的
  // 最短完整片段（村／里／路／街／巷／弄／號），其餘一萬多頁維持既有 title。
  // 地址是內政部既有欄位；不猜俗名、不新增地理事實，也不截斷在任意字元中間。
  const seoCollisionGroups = new Map<string, typeof temples>();
  for (const t of temples) {
    const c = templeCounty(t.data.district), tw = templeTownship(t.data.district);
    const place = c && tw ? `${c.slug}/${tw.name}` : t.data.district;
    // 不把 deity_ref 放進鍵：兩筆原始主祀字串可能對映到不同節點，清洗後 title 卻仍取到
    // 同一個首位神名（實例：勸善社志德堂），以神明分組會漏掉最終產物的碰撞。
    const key = `${t.data.name}\u0000${place}`;
    (seoCollisionGroups.get(key) ?? seoCollisionGroups.set(key, []).get(key)!).push(t);
  }
  const seoQualifier = new Map<string, string>();
  for (const group of seoCollisionGroups.values()) {
    if (group.length < 2) continue;
    const details = new Map(group.map((t) => {
      const address = t.data.district ?? '';
      const tw = templeTownship(address);
      const at = tw ? address.indexOf(tw.name) : -1;
      const detail = at >= 0 ? address.slice(at + tw!.name.length).trim() : address;
      return [t.id, detail || address];
    }));
    for (const t of group) {
      const detail = details.get(t.id)!;
      const candidates = [...detail]
        .map((ch, i) => ('村里路街道段巷弄號'.includes(ch) ? detail.slice(0, i + 1) : ''))
        .filter(Boolean);
      candidates.push(detail);
      const unique = candidates.find((candidate) =>
        group.every((other) => other.id === t.id || !details.get(other.id)!.startsWith(candidate)),
      );
      seoQualifier.set(t.id, unique ?? detail);
    }
  }

  return temples.map((t) => {
    const c = templeCounty(t.data.district), tw = templeTownship(t.data.district);
    const inTown = c && tw ? (byTown.get(`${c.slug}/${tw.name}`) ?? []) : [];
    const deityKey = t.data.main_deity_ref ?? t.data.main_deity_raw;
    const sameDeityInTown = deityKey
      ? inTown.filter((x) => (x.data.main_deity_ref ?? x.data.main_deity_raw) === deityKey).length
      : 0;
    // 鄰近宮廟：同鄉鎮、排除自己，優先已查證沿革／官網者（那些頁最值得被爬到），
    // 其餘依廟名排序後取滿 5 間——排序固定＝每次 build 結果一致，不是隨機挑。
    const neighbors = inTown
      .filter((x) => x.id !== t.id)
      .sort((a, b) => {
        const w = (x: typeof a) => (x.data.history || x.data.website || x.data.founded ? 0 : 1);
        return w(a) - w(b) || a.data.name.localeCompare(b.data.name);
      })
      .slice(0, 5)
      .map((x) => ({ id: x.id, name: x.data.name, deity: x.data.main_deity_raw ?? '' }));

    return {
      params: { id: t.id },
      props: {
        temple: t,
        uniqueName: nameCount.get(t.data.name) === 1,
        townTotal: inTown.length,
        sameDeityInTown,
        neighbors,
        seoQualifier: seoQualifier.get(t.id) ?? '',
      },
    };
  });
}) satisfies GetStaticPaths;

const { temple, uniqueName, townTotal, sameDeityInTown, neighbors, seoQualifier } = Astro.props;
const t = temple.data;
const deities = await getDeities();
const deityName = new Map(deities.map((d) => [d.id, d.data.name]));
const deityData = new Map(deities.map((d) => [d.id, d.data]));
const systems = await getSystems();
const systemName = new Map(systems.map((s) => [s.id, s.data.name]));
const systemHrefOf = await systemHref();
const events = await getEvents();
// 此廟主辦之活動（host_temple 對映 temple.id）
const hostedEvents = events.filter((e) => e.data.host_temple === temple.id);
const refOk = t.main_deity_ref && deityName.has(t.main_deity_ref);
// 上行連結：縣市→鄉鎮二級樞紐（給爬蟲/讀者橫向出口，不建廟對廟密網）。
const county = templeCounty(t.district);
const township = templeTownship(t.district);
// 名廟沿革（#1 內容豐化）：有沿革才顯示沿革區塊。
const hasHistory = !!(t.founded || t.history || t.main_festival);

// P1-4 AEO：廟宇資料稀疏，僅就有資料者生問答。
const mainDeity = t.main_deity_raw ?? (refOk ? deityName.get(t.main_deity_ref!) : '');

// 求籤入口（主題集群邊）：把廟宇頁流量（全站曝光大宗）以 1 跳導入高 CTR 的籤詩集群。
// 廟宇層 divination_systems 覆寫優先（有登記＝該廟實際採用的籤版，非推論）；
// 其次才取主祀神既有的 deity↔籤系 對映（無對映或無籤系則不顯示），不補任何新事實。
const lingqianOverride = (t.divination_systems ?? []).length > 0;
const lingqianSystems = lingqianOverride
  ? t.divination_systems!
  : refOk ? (deityData.get(t.main_deity_ref!)?.divination_systems ?? []) : [];

// ── 地方宗教慶典（2026-08-06）───────────────────────────────────────────────
// 內政部「地方宗教慶典」＝**縣市層級**登錄的慶典清單，其中少數幾項的名稱裡有本站廟名
// 且在所在縣市可唯一辨識（消歧規則見 scripts/import-local-celebrations.mjs，對不上一律留空）。
// 🔴 措辭界線（同本檔上方年度祭典那條，也同 docs/decisions/temples.md）：
//    可以說「這份清單收錄了以本廟為名的項目」＝陳述那份官方清單的內容；
//    **不可以**說「本廟舉辦這個慶典」——我們手上沒有任何一年的實際舉辦紀錄，
//    而且這份清單的登錄者是縣市政府，不是廟方（與 `festivals[]` 那批的主體不同）。
const templeLocalCelebrations = localCelebrations.items.filter((x) => x.temple_ref === temple.id);

// ── 祈福動線（2026-08-05）：把廟宇頁做成祈福入口，不只是一頁資料 ────────────────────
// 為什麼要有這一段（GA4／GSC 近 30 天實測，數字是決策依據不是佐證）：
//   全站 5,831 sessions ／ 9,041 views → /qiugian/ 只拿到 125 views（1.4%）
//   → 時事集氣頁 13 頁合計 7 views → 集氣點擊 5 次。
// 而集氣鈕的轉化率是 **71%**（7 次瀏覽產生 5 次點擊）＝功能是有效的，缺的純粹是到達率。
// 同時實查廟宇頁的 HTML：`</nav>` 之後 `/qiugian/` 出現 **0 次**——8 次全在折疊的 nav 面板裡。
// 廟宇頁佔全站曝光 91%（185,140 曝光／3,484 點擊）卻對祈福動線零導流，這就是那 1.4% 的來源。
//
// 🔴 措辭界線（延續 2026-07-31 與 2026-08-03 立的那兩條）：**主詞是神明，不是廟**。
// 講的是「這位神明的職司包含什麼，因此可以為哪些事祈求」，逐項走既有掛源資料
// （deities.json 的 office／scenarios 的 patrons／concerns 的 deities），
// **不宣稱這間廟在辦任何活動**，也**不出現任何具體時事事件名稱**——那是 /qiugian/ 那一層的事。
// 兩段漏斗（廟宇頁 → /qiugian/ → 集氣頁）是刻意的：廟宇頁不提事件，就不可能被讀成「本廟在辦」。
//
// ⚠️ 已知的重複內容風險：職司句依主祀神而異，最多 76 種變體，土地公 1,384 間、媽祖 1,051 間
// 會共用同一句。站上明文避開過「引用神明 summary 讓數百間同主祀的廟出現一模一樣段落」
// （見本檔 getStaticPaths 的註解）。判斷差異：那次避開的是**整段 summary**，這裡是**一個短句
// ＋連結列**，且既有 temple-lingqian 已是同型態並重複 3,454 次、通過所有 gate。
// 若日後實測有害，退路是拿掉職司句只留連結列——導流效果不受影響。
const scenarios = await getScenarios();
// 反查：主祀神 → 該神明是哪些情境的 patron。zero-新增事實，patrons 逐筆自帶 sources。
const scenariosByDeity = new Map<string, { id: string; name: string; role?: string }[]>();
for (const s of scenarios) {
  for (const p of s.data.patrons ?? []) {
    const list = scenariosByDeity.get(p.deity_ref) ?? scenariosByDeity.set(p.deity_ref, []).get(p.deity_ref)!;
    list.push({ id: s.id, name: s.data.name, role: p.role });
  }
}
// 反查：主祀神 → 該神明對應的求籤煩惱（concerns.json 的 deities[]）。
const concernsByDeity = new Map<string, { id: string; label: string }[]>();
// ⚠️ 顯式標型別，不靠 TS 推斷（根 CLAUDE.md 2026-08-03 立：空陣列字面量會被推成 never[]，
// 之後的 .includes(string)／for-of 就報 ts(2345)，而型別檢查不在 pnpm build:release 裡＝自動化層看不到）。
for (const c of concernsData as { id: string; label: string; deities?: string[] }[]) {
  for (const d of c.deities ?? []) {
    (concernsByDeity.get(d) ?? concernsByDeity.set(d, []).get(d)!).push({ id: c.id, label: c.label });
  }
}
const deityOffice = refOk ? (deityData.get(t.main_deity_ref!)?.office ?? []) : [];
const deityNodeName = refOk ? (deityName.get(t.main_deity_ref!) ?? '') : '';
const qifuScenarios = refOk ? (scenariosByDeity.get(t.main_deity_ref!) ?? []) : [];
const qifuConcerns = refOk ? (concernsByDeity.get(t.main_deity_ref!) ?? []) : [];

// GA4 近 28 天流量優先宮廟（名單與擷取日見 image-priority.json）。沒有授權實景照者顯示本站資料卡，
// 並明確標示「非廟宇實景」，避免把生成式卡片誤認為現場照片。
const topTrafficTempleIds = new Set(imagePriority.top_temples.map((x) => x.id));
const showTrafficCard = topTrafficTempleIds.has(t.id) && !t.image;

// 主祀神聖誕（農曆）：僅取 deity 節點既有 birthday_lunar 中 kind==='聖誕' 者，轉中文標籤；無源不補。
const birthdayLunar = refOk
  ? ((deityData.get(t.main_deity_ref!)?.birthday_lunar ?? []).find((b: { kind?: string; date?: string }) => b.kind === '聖誕')?.date ?? '')
  : '';
const birthdayLabel = birthdayLunar ? lunarDateLabel(birthdayLunar) : '';

// 年度慶(祭)典（內政部全國宗教資訊網，2,498 間）。這是**該廟向政府登記的自家祭典**，
// 與「主祀神聖誕」（神明的生日）不同——故可以標「主要祭典」，不算替廟方斷言。
// 代表筆的挑選與句子生成一律走 lib，頁面不自行判斷（gate 與 OG 卡走同一支）。
// 🔴 台北日，勿改回 UTC（2026-08-15 修）：check-rendered 的 TODAY 是台北日，
// 這裡原本是 UTC——每天台北 00:00–08:00 兩邊差一天，祭典國曆換算撞上「昨天正是祭典日」
// 就紅（實例：run 31818156766，泉安府廟慶＝農曆七月初二＝國曆 8/14，CI 於台北 00:26 檢查）。
const todayIso = new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10);
const publicFestivals = releasedItems(festivalsData);
const festivalList = sortFestivals(t.festivals ?? []);
const mainFestival = pickMainFestival(t.festivals);
// 該廟登記祭典 → 全站 /festivals/ 節日頁的正向連結（2026-08-02）：純日期比對，不做語意判斷
// （同「AlmanacDay.astro」7/1 起的既有寫法），歸屬規則與節日頁的反向名單共用同一支
// festivalOwnerByLunarDate，兩邊必然一致，不會互相矛盾。
const festivalOwner = festivalOwnerByLunarDate(publicFestivals);
const festivalName = new Map(publicFestivals.map((f) => [f.slug, f.name]));
// 當期節慶 CTA 只沿既有關係出現：節日直接點名本廟、主祀神對應、主辦活動對應，
// 或本廟登記祭典日期由 festivalOwner 明確歸到該節日。沒有任一條就不渲染。
const hostedEventIds = new Set(hostedEvents.map((e) => e.id));
const registeredFestivalSlugs = new Set(
  festivalList
    .filter((f) => f.calendar === 'lunar')
    .map((f) => festivalOwner.get(f.date))
    .filter((slug): slug is string => !!slug),
);
const seasonalFestivalSlugs = publicFestivals
  .filter((f) =>
    ((f as { temple_refs?: string[] }).temple_refs ?? []).includes(temple.id) ||
    (!!t.main_deity_ref && ((f as { deity_refs?: string[] }).deity_refs ?? []).includes(t.main_deity_ref)) ||
    ((f as { event_refs?: string[] }).event_refs ?? []).some((id) => hostedEventIds.has(id)) ||
    registeredFestivalSlugs.has(f.slug),
  )
  .map((f) => f.slug);

// 主祀神 → /festivals/ 節日頁的內鏈（2026-08-03）。
// 為什麼要有這一段：`festivalOwnerByLunarDate` 只在「該廟登記的祭典**日期**與節日同天」時才連，
// 全站僅 238/7,891 間命中，而 /festivals/ 十頁 28 天曝光合計是 0——內容完整、也已收錄，
// 缺的是從「佔全站 92% 曝光」的廟宇頁流過去的內鏈。這裡用 festivals.json 既有的 `deity_refs`
// 反查主祀神，可再涵蓋約 440 間（玉皇 136／三官 123／地藏 93／義民 36／臨水 31…）。
//
// 🔴 措辭界線（延續 2026-07-31 立的那條）：陳述的是**神明**與節日的關係（節日資料自己的
// deity_refs，逐條掛源），**不是**「這間廟在辦這個節日」。故標題掛神明名、並明寫非本廟活動公告。
// 與 `fsame`（同天祭典）是兩件事，class 分開，check:rendered 的既有不變量不受影響。
const festivalsByDeity = new Map<string, { slug: string; name: string }[]>();
for (const f of publicFestivals) {
  for (const d of (f as { deity_refs?: string[] }).deity_refs ?? []) {
    (festivalsByDeity.get(d) ?? festivalsByDeity.set(d, []).get(d)!).push({ slug: f.slug, name: f.name });
  }
}
// 上限 2 條：避免主祀神掛多個節日時，長尾廟頁被一串連結蓋過本來就不多的自有內容。
const deityFestivals = (refOk && t.main_deity_ref ? (festivalsByDeity.get(t.main_deity_ref) ?? []) : [])
  .map((x) => {
    const src = publicFestivals.find((f) => f.slug === x.slug)!;
    const { iso: solarIso, label } = festivalNextSolar(src, todayIso);
    return solarIso ? { ...x, iso: solarIso, lunarLabel: label } : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .sort((a, b) => a.iso.localeCompare(b.iso))
  .slice(0, 2);
// 已查證的敘述句（21 間）優先於 MOI 短語；兩者皆無則空字串。
// ⚠️ 結尾標點守衛不可省（同 historyFirstSentence 的寫法）：已查證的 21 筆 `main_festival`
// 是完整敘述句、**全部自帶句號**，無條件再補一個「。」會產生「…國家重要民俗。。」——
// 2026-07-31 起 21 間名廟（大甲鎮瀾宮／北港朝天宮／艋舺龍山寺…）的 meta description
// 一直是這樣送進 SERP 的，2026-08-03 才由線上 curl 抓到。
const festivalLine = t.main_festival
  ? `${t.name}的主要祭典為${t.main_festival}${/[。！？]$/.test(t.main_festival) ? '' : '。'}`
  : mainFestival
    ? festivalSentence(t.name, mainFestival, todayIso)
    : '';

// answer-first 摘要（全體廟頁皆有）：純用既有欄位重組，緊扣「XX宮是什麼廟／在哪／拜誰」搜尋意圖，絕不補新事實。
const regionLabelForSummary = county ? `${county.name}${township?.name ?? ''}` : (t.district ?? '');
// ── 沿革首句 → meta description／摘要用的短句（2026-08-06 重寫）──────────────────
// 🔴 這支是**唯一入口**。同一段邏輯原本在本檔重複三次（summaryText／descTail／FAQ），
//    而 2026-07-31 那次「補句號」的修正只加在其中一支——重複就是漂移的來源。
//
// 三件事，每一件都是 2026-08-06 匯入 749 筆內政部沿革後**實測**出來的：
//  ① 空白壓平：413 筆含 CR/LF，其中 88 筆第一句裡就有換行 → 不壓平就是把 literal newline 送進 SERP。
//  ② 句末標點正規化：原本的守衛只擋「。。」，擋不住「，。」——
//     `moi_1154_永安寺` 的整段沿革**一個句號都沒有**、結尾是「，」，補上「。」就成了「，。」，
//     被 check:rendered 不變量 1e 擋下（CI 紅燈）。正解是**先把句尾的逗號類換成句號**，再判斷要不要補。
//  ③ 切句要認「．」與「.」：41 筆用它們當句號，原正則只認「。！？」→ 整段被當成「第一句」，
//     最長 599 字全部塞進 description。
//  ④ 長度上限：修完①②③之後仍有長句，故在**標點邊界**截斷並加「…」——
//     🔴 **絕不中途硬切**（那正是本檔其他地方反覆記著的病灶）；找不到邊界就整句不用。
const HISTORY_SNIPPET_MAX = 60; // 全形字。Google 中文摘要約 78 字截斷，留位置給祭典／聖誕／求籤句
function historySnippet(raw: string | undefined): string {
  if (!raw) return '';
  // ⑥ 句首的「．」是**項目符號不是句末標點**（2026-08-08 加）。來源有人拿它當條列記號
  //    （`．清咸豐十年…\n．清同治十三年…`），而切句正則認得「．」，於是**第一句切出來是
  //    一個孤零零的標點**，正規化後變成「。」，接在「主祀觀世音菩薩。」後面就是「。。」，
  //    被 check:rendered 擋下（CI 紅燈）。先剝掉開頭的標點與空白再切句。
  //    ⚠️ 這個字元集要**含全形逗號句號**：2026-08-08 先補了「．」那批（項目符號），
  //    同一天下一個匯入批次就被「，故齊心起義建廟…」咬——沿革開頭直接是全形逗號。
  //    逐字元補是錯的做法，來源是政府資料什麼都可能出現，故改成「任何開頭的標點都剝掉」。
  const body = String(raw).replace(/^[\s\p{P}\p{S}]+/u, '');
  const first = (body.split(/(?<=[。！？．.])/)[0] ?? '').replace(/\s+/g, ' ').trim();
  if (!first) return '';
  // ⑤ 連續標點壓成一個（2026-08-07 加）。原本只正規化**句尾**，中間的連續標點會原樣進 SERP——
  //    `moi_3524_順天宮` 的來源寫著「…以衛國安民，，宋建隆元年…」，被 check:rendered 擋下（CI 紅燈）。
  //    🔴 這裡刻意擋的是**整個類別**而不是「，，」那一種：解碼修正前實測有 7 種樣態
  //    （;、 ;， ;： ;。 、、 ，， ，,），修單一種下次換一種還是會紅。
  //    序列裡若含句末類就取「。」（「，。」→「。」），否則取第一個（「，，」→「，」）。
  const collapsed = first.replace(
    /[、，；：,;:。！？．.]{2,}/g,
    (m) => ([...m].some((c) => '。！？．.'.includes(c)) ? '。' : m[0]),
  );
  // 句尾正規化：逗號類 → 句號；「．」「.」→ 句號；已是句號類就不動。
  let s = collapsed.replace(/[、，；：,;:]+$/, '。').replace(/[．.]+$/, '。');
  if (!/[。！？]$/.test(s)) s += '。';
  // 🔴 只有標點、沒有實質內容的「句子」一律不用（上面剝過開頭仍可能出現，例如整段只有記號）。
  //    這是類別層的守衛：讓它落到下一個候選句（祭典／聖誕），而不是把一個孤立標點送進 SERP。
  if (!/[\u4e00-\u9fff\u3040-\u30ffA-Za-z0-9]/.test(s)) return '';
  if ([...s].length <= HISTORY_SNIPPET_MAX) return s;
  // 超長：在最後一個標點邊界切，切完再補句號；找不到邊界就不用這句（回空字串）。
  // ⚠️ 邊界要含**半形逗號與空白**：內政部的沿革有不少筆整段用 `,` 或空白斷句
  //    （2026-08-06 實測：只找全形標點時有 22 筆找不到邊界而整句被丟掉）。
  const head = [...s].slice(0, HISTORY_SNIPPET_MAX).join('');
  const cut = Math.max(
    ...['，', '、', '；', '。', ',', ';', ' '].map((c) => head.lastIndexOf(c)),
  );
  return cut > 10 ? `${head.slice(0, cut)}…` : '';
}
const historyFirstSentence = historySnippet(t.history);
const summaryText = [
  `${t.name}`,
  regionLabelForSummary ? `位於${regionLabelForSummary}` : '',
  mainDeity ? `，主祀${mainDeity}` : '',
  birthdayLabel ? `（聖誕${birthdayLabel}）` : '',
  lingqianSystems.length > 0 ? '，可線上求籤解籤' : '',
  '。',
  historyFirstSentence ? historyFirstSentence : '',
].join('');

// 在地脈絡句：每個「鄉鎮×主祀神」組合都不同，是這頁真正獨有的一句話（純由既有資料算出）。
// 資料不足（無鄉鎮、該鎮只有這一間、無主祀神）就整句不出現，不硬湊。
const townLabel = township?.name ?? '';
const townContext = townLabel && townTotal > 1
  ? `${townLabel}登記在案的宮廟共 ${townTotal} 間` +
    (mainDeity && sameDeityInTown > 1 ? `，其中主祀${mainDeity}者 ${sameDeityInTown} 間。` : '。')
  : '';

// speakable 對全體廟頁生效：以頁首 .summary 直答區塊為主（不再只限有沿革者）。
const speakable = ['h1', '.summary'];

// 廟宇頁 meta description（原本無此 prop、全站落回首頁通用文案，
// 與搜尋詞如「台南○○宮」不匹配）：僅用既有欄位（縣市鄉鎮／主祀／沿革）組成，不補新事實。
const regionLabel = county ? `${county.name}${township?.name ?? ''}` : '';
const introBits = [regionLabel && `位於${regionLabel}`, mainDeity && `主祀${mainDeity}`].filter(Boolean);
// 2026-07-30：原本的尾句是「神酷（folk.tw）廟宇資料庫收錄，資料源自內政部全國宗教資訊網。」——
// `history` 只有 22/7891 間有，其餘 ~7,869 間全落回這句**一字不差的樣板**，
// 對「台南○○宮」這類查詢毫無資訊量（GSC 實測廟宇頁 CTR 僅 1.76%）。
// 改為依序取「每頁天然不同」的既有衍生資料：沿革首句 → 主祀神聖誕 → 鄉鎮脈絡（間數/同主祀數）→ 可求籤。
// 全部來自既有欄位與 build 期聚合，**不新增任何事實**；真的都沒有才留最後那句通用語。
// 2026-07-31：慶(祭)典匯入後，2,498 間廟有了**該廟自己登記的年度祭典**。
// 它排在主祀神聖誕之前，因為那是這間廟獨有的事實，而聖誕是全台同主祀神數百間廟共用的日期；
// 且有祭典時就不再輸出聖誕句——兩者常是同一天（如「天上聖母聖誕」對農曆三月廿三），會重複。
// 2026-08-03：**求籤句與鄉鎮脈絡句對調**。前者原本排最後，實測起始位置中位 63、p90 84 全形字，
// 而 Google 中文摘要約 78 全形字就截斷 → **758 頁的求籤句根本顯示不出來**（全站 29.4%＝2,318 頁
// 描述超過 78 字）。排在它前面的「本鎮登記在案的宮廟共 N 間」是**我們自己的統計**，
// 對搜「靈武宮」的人零資訊量，卻佔著截斷點前的位置。
// 廟宇頁佔全站曝光 92%，排名 5–7 那段（47% 曝光）CTR 僅 2.06%＝產業基準的 1/3，
// 因為 SERP 上方被 Google 地圖包吃掉；「可線上求籤」是少數地圖包給不了、且構成點擊理由的東西，
// 必須排在截斷點之前。鄉鎮統計句仍保留（check:rendered 不變量 2b 要求 description 不得落回樣板），
// 只是降到最後——被截掉也不痛。
// 措辭同時由「本站提供主祀神靈籤的白話解籤」改為行動優先、且短 3 個全形字。
const descTail = [
  historyFirstSentence ? historyFirstSentence : '',
  festivalLine,
  !festivalLine && birthdayLabel && mainDeity ? `${mainDeity}聖誕為${birthdayLabel}。` : '',
  lingqianSystems.length > 0 ? '可線上求籤，附白話解籤。' : '',
  townContext,
]
  .filter(Boolean)
  .join('');
const templeDesc = `${t.name}${introBits.length ? introBits.join('，') + '。' : '。'}${
  descTail
}${seoQualifier ? `地址為${t.district}。` : ''}`;

// 廟宇頁 title：原本僅 t.name，導致大量同名廟（慶安宮／福德宮…）落回完全相同標題、無在地辨識度。
// 全站 7891 廟 100% 具 district，加上鄉鎮地名可消歧並強化在地搜尋匹配（僅用既有欄位，不補新事實）。
//
// 2026-07-31 再加「主祀○○」：GSC 實測廟宇頁佔全站曝光 91%，但前十名 CTR 只有產業基準的
// 0.17–0.42 倍，而第 11 名以後是正常的 0.99 倍——差別在於廟名查詢的 SERP 上方有 Google 地圖包
// 吃走點擊。在地圖包旁邊唯一能贏的是「地圖不提供的資訊」，且主祀神直接命中
// 「○○宮 主祀／拜什麼」這類**沒有地圖包**的修飾詞長尾。仍只用既有欄位，不補新事實。
//
// ⚠️ 兩道清洗規則不可省（`main_deity_raw` 是 MOI 原始欄位，很髒）：
//   ① 逗號分隔取首位——有廟登記了 7 尊（「虎爺將軍,韋馱佛祖,註生娘娘,關聖帝君…」），全塞進 title 無意義；
//      首位過長（>8 全形字）則回退到已對映的神明節點短名，再不行就整段不加。
//   ② 組出來超過 30 全形字就整段退回原樣，**不截字**——截字會把「｜神酷」切成半個詞。
// 實測：7,801/7,891（98.9%）加得上，中位數 20 全形字、p90 24、超過 30 字者 3 頁。
//
// 2026-08-09 再加「法人前綴移到括號裡」：348 間廟的登記全名以「財團法人／社團法人」開頭，
// 那群 CTR 1.37%、其餘 2.42%（GSC 7 天實測，完整數字與判準見 src/lib/temple-name.ts 檔頭）。
// 🔴 **這不是截字**——拿掉的是零搜尋需求的法人前綴，登記全名仍完整出現在 title 的括號裡
//    （放不下才退到只留一般稱呼），且 `<h1>`、meta description、內文一律仍是登記全名。
// 上限與全形寬度算法一律取 src/lib/text-width.ts（頁面與 check:rendered 共用同一支）。
// ⚠️ 這裡的 30 是**含站名「｜神酷」**一起算的（見下方候選階梯）；別在本檔重寫規則。
const TITLE_MAX = SERP_TITLE_MAX_WIDTH;
const TITLE_DEITY_MAX = TEMPLE_TITLE_DEITY_MAX_WIDTH;
const titleDeity = (() => {
  const first = (t.main_deity_raw ?? '').split(/[,，、;；]/)[0].trim();
  if (first && fullWidth(first) <= TITLE_DEITY_MAX) return first;
  const node = refOk ? deityName.get(t.main_deity_ref!) : '';
  return node && fullWidth(node) <= TITLE_DEITY_MAX ? node : '';
})();
const commonName = commonTempleName(t.name);
const legalParen = commonName === t.name ? '' : `（${t.name}）`;
const regionSuffix = regionLabel ? `・${regionLabel}` : (t.district ? `・${t.district}` : '');
const disambiguatedRegionSuffix = seoQualifier
  ? `${regionSuffix}・${seoQualifier}`
  : regionSuffix;
const deitySuffix = titleDeity ? `・主祀${titleDeity}` : '';
// 候選由「資訊最全」往「最精簡」排，取第一個裝得下的。
// ⚠️ 順序刻意讓「主祀○○」贏過「（登記全名）」——前者命中沒有地圖包的修飾詞長尾（2026-07-31 實測），
//    後者只是不想讓登記全名從 SERP 完全消失；兩者只能留一個時留前者。
// 站名「｜神酷」由 Base.astro 附加，長度判斷須把它算進去。
const templeTitle =
  [
    `${commonName}${legalParen}${disambiguatedRegionSuffix}${deitySuffix}`,
    `${commonName}${disambiguatedRegionSuffix}${deitySuffix}`,
    `${commonName}${legalParen}${disambiguatedRegionSuffix}`,
    `${commonName}${disambiguatedRegionSuffix}`,
  ].find((c) => fullWidth(`${c}｜神酷`) <= TITLE_MAX) ?? `${commonName}${disambiguatedRegionSuffix}`;

// FAQ（AEO）：全數就既有欄位出題，faqPage 會過濾空答；無資料的題目不生，絕不杜撰。
const lingqianNames = lingqianSystems.map((s) => systemName.get(s.id) ?? s.id);
const festivalOrHistory = festivalLine
  ? festivalLine
  : historyFirstSentence
    ? historyFirstSentence
    : '';
const faq = faqPage([
  {
    q: `${t.name}主祀哪位神明？`,
    a: mainDeity
      ? `${t.name}主祀${mainDeity}${birthdayLabel ? `，聖誕為${birthdayLabel}` : ''}。`
      : '',
  },
  {
    q: `${t.name}在哪裡？`,
    a: regionLabelForSummary ? `${t.name}位於${regionLabelForSummary}。` : (t.district ? `${t.name}位於${t.district}。` : ''),
  },
  {
    q: `${t.name}可以求籤嗎？`,
    a:
      lingqianNames.length > 0
        ? lingqianOverride
          ? `可以。${t.name}採用${lingqianNames.join('、')}，可線上查閱籤詩與白話解籤。`
          : `可以。${t.name}主祀${mainDeity}，可線上查閱${lingqianNames.join('、')}與白話解籤。`
        : '',
  },
  {
    // 「○○宮怎麼去」是廟名查詢裡少數**沒有地圖包壟斷答案框**的修飾詞（地圖包給的是導航按鈕，
    // 不是可被擷取的文字答案）。只用既有欄位：行政區／完整地址／有無座標，不補新事實。
    q: `${t.name}怎麼去？`,
    a: t.district
      ? `${t.name}的地址是${t.district}${t.lat && t.lng ? '，本頁下方附地圖位置' : ''}。`
      : '',
  },
  {
    // 泛稱名（「祭典」「祀慶」等 756 間）的答句是「年度祭典在<日期>」＝答的是時間，
    // 故問句也要問時間，否則「主要祭典是什麼？」配上一個日期＝答非所問。
    q: !festivalLine
      ? `${t.name}的沿革為何？`
      : !t.main_festival && mainFestival && isGenericFestivalName(mainFestival.name)
        ? `${t.name}的年度祭典在什麼時候？`
        : `${t.name}的主要祭典是什麼？`,
    a: festivalOrHistory,
  },
]);

const jsonLd = [
  templePlace({
    id: temple.id,
    name: t.name,
    deity: mainDeity || undefined,
    address: t.district,
    lat: t.lat,
    lng: t.lng,
    website: t.website,
  }),
  ...(faq ? [faq] : []),
];
---

<Base
  title={templeTitle}
  description={templeDesc}
  ogTitle={templeTitle}
  ogImage={`/og/temples/${encodeURIComponent(t.id)}.png`}
  ogImageAlt={`${t.name}${regionLabel ? `・${regionLabel}` : ''}`}
  ogType="article"
  jsonLd={jsonLd}
  speakable={speakable}
  crumbs={templeCrumbs(county, township, { id: temple.id, name: t.name })}
>
  <h1>{t.name}</h1>

  {showTrafficCard && (
    <figure class="temple-photo">
      <img
        src={`/og/temples/${encodeURIComponent(t.id)}.png`}
        alt={`${t.name}宮廟資料卡`}
        width="1200"
        height="630"
        loading="eager"
        decoding="async"
      />
    </figure>
  )}

  <p class="summary">{summaryText}</p>
  <RelatedSeasonalCampaign festivalSlugs={seasonalFestivalSlugs} />

  <dl class="rec">
    {t.district && <div><dt>行政區</dt><dd>{t.district}</dd></div>}
    <div>
      <dt>主祀神祇</dt>
      <dd>
        {t.main_deity_raw}
        {refOk ? (
          <span> · <a href={`/deities/${t.main_deity_ref}/`}>{deityName.get(t.main_deity_ref!)}（圖譜）</a></span>
        ) : (
          t.main_deity_raw && <span class="muted small"> · 未對映神明節點</span>
        )}
      </dd>
    </div>
    {/* 開放時間（觀光署景點資料庫，54 間）。純事實短句，來源標註走頁尾 Sources。
        GSC 實測「○○宮 開放時間」這類修飾詞查詢沒有 Google 地圖包壟斷答案框，是能贏的位置。 */}
    {t.open_time && <div><dt>開放時間</dt><dd>{t.open_time}</dd></div>}
    {
      t.lng != null && t.lat != null && (
        <div>
          <dt>座標</dt>
          <dd>
            {t.lat}, {t.lng}
            <a class="map" href={`https://www.openstreetmap.org/?mlat=${t.lat}&mlon=${t.lng}#map=17/${t.lat}/${t.lng}/`} target="_blank" rel="noopener">地圖 ↗</a>
          </dd>
        </div>
      )
    }
  </dl>

  {t.lng != null && t.lat != null && <TempleMap name={t.name} lat={t.lat} lng={t.lng} uniqueName={uniqueName} />}

  {
    lingqianSystems.length > 0 && (
      <section class="temple-lingqian">
        <h2>到{t.name}求籤</h2>
        {/* 覆寫廟不能寫「主祀神的靈籤」——籤版與主祀神對映不同正是覆寫存在的原因 */}
        <p class="muted small">{lingqianOverride ? `${t.name}採用的靈籤` : `${mainDeity}的靈籤`}，可線上查閱籤詩與白話解籤：</p>
        <ul>
          {lingqianSystems.map((s) => (
            <li><a href={systemHrefOf(s.id)}>{systemName.get(s.id) ?? s.id}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  {/* 祈福動線（全 7,891 頁皆有）。主詞是神明不是廟——見上方 frontmatter 的措辭界線註解。
      收尾那行連 /qiugian/ 是**無條件**的，因此本區塊不設任何顯示條件；
      職司句／情境／煩惱籤三個子項各自「查無對映就不渲染」，不硬湊。 */}
  <section class="temple-qifu">
    <h2>到{t.name}祈求</h2>
    {deityOffice.length > 0 && deityNodeName && (
      <p class="qifu-office">{deityNodeName}的職司是{deityOffice.join('、')}。</p>
    )}
    {(qifuScenarios.length > 0 || qifuConcerns.length > 0) && (
      <ul class="qifu-list">
        {qifuScenarios.map((s) => (
          <li>
            <a href={`/scenarios/${s.id}/`}>{s.name}</a>
            {s.role && <span class="qifu-role">{s.role}</span>}
          </li>
        ))}
        {qifuConcerns.map((c) => (
          <li><a href={`/qiugian/${c.id}/`}>為{c.label}求一支籤</a></li>
        ))}
      </ul>
    )}
    <p class="qifu-more"><a href="/qiugian/">也可以為此刻的平安集氣 →</a></p>
  </section>

  {/* 簡介（觀光署景點資料庫）。
      明寫「引自」有兩個理由：①OGDL 1.0 要求標示出處（頁尾 Sources 也有，這裡再標一次給讀者看）
      ②這段文字的語氣與站上其他文案不同，告訴讀者那是政府原文、不是我們寫的。
      ⚠️ **不改寫原文**——改寫就是杜撰風險；不合用的整筆不採用（規則見 scripts/lib/tourism-intro.mjs）。

      🔴 **2026-08-09：與「沿革」由互斥改為並存（用戶裁示）。**
      舊規則是「有 history 就不顯示 intro」，立法時 history 只有 22 間、是我們逐間查證的敘述句，
      「品質較高者勝出」講得通。但 2026-08-06 內政部沿革匯入後 history 變成 3,273 間的
      **政府登記原文**——那是逐年條列的建廟編年（「清康熙七年鄭成功部何積善等擴大興建…」），
      與觀光署那段白話導覽（「相傳明朝末年，麻豆一位信女…」）**是互補的兩種東西，不是同一件事的兩個版本**。
      互斥的實害在 2026-08-09 併頁時現形：鹽水武廟併入 MOI 沿革，白話簡介被 gate 逼著整段刪掉，
      頁面反而變薄。改為並存後兩段各自掛各自的來源，讀者先讀白話再讀編年。
      ⚠️ **並存不等於可以把兩段揉成一段**：合寫就要改寫，改寫就是杜撰風險（§2 紅線 1）。
      兩段各自逐字、各自標源，這是「介紹更詳細」唯一不踩紅線的做法。 */}
  {
    t.intro && (
      <section class="temple-intro">
        <h2>簡介</h2>
        <p class="intro-body">{t.intro}</p>
        <p class="intro-src">引自交通部觀光署觀光資訊資料庫</p>
      </section>
    )
  }

  {
    hasHistory && (
      <section class="temple-history">
        <h2>沿革</h2>
        {t.founded && <p class="founded"><strong>創建</strong>　{t.founded}</p>}
        {t.history && <p class="history-body">{t.history}</p>}
        {t.main_festival && <p class="festival"><strong>主要祭典</strong>　{t.main_festival}</p>}
      </section>
    )
  }

  {
    festivalList.length > 0 && (
      <section class="temple-festivals">
        <h2>年度祭典</h2>
        <p class="muted small">
          以下為{t.name}向內政部登記的年度慶(祭)典。農曆日期為廟方登記值，括號內國曆為下一次對應日期。
        </p>
        <ul class="festival-list">
          {festivalList.map((f) => {
            const ownerSlug = f.calendar === 'lunar' ? festivalOwner.get(f.date) : undefined;
            return (
              <li>
                <span class="fdate">{festivalDateLabel(f, todayIso)}</span>
                <span class="fname">{f.name}</span>
                {f.desc && <span class="fdesc">{f.desc}</span>}
                {ownerSlug && (
                  <a class="fsame" href={`/festivals/${ownerSlug}/`}>
                    同天：{festivalName.get(ownerSlug)}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {/* 代表圖（2026-08-06 起在詳情頁也顯示）。原本只有索引頁的卡片用得到，
      詳情頁完全不顯示——而詳情頁才是廟方與讀者真正會看的那一頁。
      🔴 出處標示走 `imageCredit()` 這支唯一入口：內政部的照片**必須給可點的來源連結**
      （那是授權條件，不是排版偏好），Commons 那批沿用既有作法（出處彙整在 /about）。
      別把這段的連結拿掉，也別把標註寫死成某個平台名——寫死正是 2026-08-06 修掉的病灶。 */}
  {
    t.image && (
      <figure class="temple-photo">
        <img src={t.image.src} alt={t.image.alt} loading="lazy" decoding="async" />
        <figcaption class="muted small">
          {imageCredit(t.image).href ? (
            <a href={imageCredit(t.image).href!} rel="noopener">{imageCredit(t.image).text}</a>
          ) : (
            imageCredit(t.image).text
          )}
        </figcaption>
      </figure>
    )
  }

  {/* 建築特色／參拜流程（2026-08-06 起，內政部 GetUploadFile）。
      🔴 逐字內容，授權條件是**標示資料來源連結**——來源標註由頁尾 <Sources> 統一輸出
      （每筆匯入時已把該筆的 GetUploadFile 網址寫進 t.sources），所以這裡不再各掛一次，
      但**別把頁尾那段拿掉**，拿掉就違反授權。 */}
  {
    (t.architecture || t.worship_flow) && (
      <section class="temple-moi-detail">
        {t.architecture && (
          <>
            <h2>建築特色</h2>
            <p class="moi-body">{t.architecture}</p>
          </>
        )}
        {t.worship_flow && (
          <>
            <h2>參拜流程</h2>
            <p class="moi-body">{t.worship_flow}</p>
          </>
        )}
      </section>
    )
  }

  {
    templeLocalCelebrations.length > 0 && (
      <section class="temple-local-celebrations">
        <h2>地方宗教慶典登錄</h2>
        <p class="muted small">
          {/* 這句只說「那份清單裡有以本廟為名的項目」＝陳述清單內容，不宣稱本廟辦了什麼。
              ⚠️ 別再往後補「不是本廟的活動公告」——同一頁下方的「相關節日」已經有那句，
              兩個區塊各掛一句就成了警語牆（見記憶 no-meta-disclaimers-on-pages）。 */}
          內政部全國宗教資訊網的「地方宗教慶典」是由縣市登錄的慶典清單，其中有以下項目以本廟為名。
        </p>
        <ul class="local-celebration-list">
          {templeLocalCelebrations.map((x) => (
            <li>
              <span class="lcdate">
                {/* date 是 "MM-DD"：月取 slice(0,2)、日取 slice(3)。
                    ⚠️ 別寫成 slice(0,3)——那會取到 "01-" → Number() 得 NaN，
                    而目前這幾筆全是農曆、走不到後兩支，錯了也不會有人發現。 */}
                {x.calendar === 'lunar'
                  ? lunarDateLabel(x.date)
                  : x.calendar === 'solar'
                    ? `國曆 ${Number(x.date.slice(0, 2))}/${Number(x.date.slice(3))}`
                    : `回曆 ${Number(x.date.slice(0, 2))} 月 ${Number(x.date.slice(3))} 日`}
              </span>
              <span class="lcname">{x.name}</span>
              <span class="muted small">{x.county}</span>
            </li>
          ))}
        </ul>
        <p class="muted small">
          全台登錄的地方宗教慶典見 <a href="/festivals/local/">地方宗教慶典一覽</a>。
        </p>
      </section>
    )
  }

  {
    deityFestivals.length > 0 && (
      <section class="temple-deity-festivals">
        <h2>{deityName.get(t.main_deity_ref!)}的相關節日</h2>
        <p class="muted small">
          以下節日與本廟主祀神有關，日期為神明或節日本身的日期，不是本廟的活動公告。
        </p>
        <ul class="deity-festival-list">
          {deityFestivals.map((f) => (
            <li>
              <a href={`/festivals/${f.slug}/`}>{f.name}</a>
              <span class="dfdate">{f.lunarLabel}（國曆 {Number(f.iso.slice(5, 7))}/{Number(f.iso.slice(8, 10))}）</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    hostedEvents.length > 0 && (
      <section>
        <h2>主辦民俗活動</h2>
        <ul>
          {hostedEvents.map((e) => (
            <li><a href={`/events/${e.id}/`}>{e.data.name}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  {
    neighbors.length > 0 && county && township && (
      <section class="nearby">
        <h2>{township.name}的其他宮廟</h2>
        {townContext && <p class="muted small">{townContext}</p>}
        <ul class="nearby-list">
          {neighbors.map((n) => (
            <li>
              <a href={`/temples/${n.id}/`}>{n.name}</a>
              {n.deity && <span class="muted small">　主祀 {n.deity}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {county && township && (
    <p class="region-link"><a href={`/temples/region/${county.slug}/${township.name}/`}>查看{county.name}{township.name}其他廟宇 →</a></p>
  )}
  {county && !township && (
    <p class="region-link"><a href={`/temples/region/${county.slug}/`}>查看{county.name}全部廟宇 →</a></p>
  )}

  {t.website && <p class="temple-site"><a href={t.website} target="_blank" rel="noopener">官方網站 →</a></p>}

  {t.sources.length > 0 && <p class="src"><Sources sources={t.sources} /></p>}

  <style>
    .summary { font-size: var(--text-base); line-height: 1.8; margin: 0.75rem 0 1.25rem; }
    .rec { display: grid; gap: 0.5rem; margin: 1.25rem 0; }
    .rec > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.625rem; padding: 0.375rem 0; border-bottom: 1px dashed var(--line); }
    .rec dt { font-weight: 700; color: var(--accent); }
    .rec dd { margin: 0; }
    .map { margin-left: 0.75rem; font-size: var(--text-sm); }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; }
    .small { font-size: var(--text-sm); }
    .temple-intro { margin-top: 1.5rem; }
    .temple-intro .intro-body { line-height: 1.8; }
    .temple-intro .intro-src { color: var(--gold); font-size: var(--text-xs); margin-top: 0.5rem; }
    .temple-history { margin-top: 1.5rem; }
    /* pre-line：內政部沿革有 413 筆帶換行（分段敘事），壓成一行會很難讀。
       已查證的那 22 筆是單句，不受影響。 */
    .temple-history .history-body { line-height: 1.8; white-space: pre-line; }
    .temple-history .founded, .temple-history .festival { margin: 0.5rem 0; }
    .temple-history strong { color: var(--accent); margin-right: 0.375rem; }
    .temple-festivals { margin-top: 1.5rem; }
    .temple-qifu { margin-top: 1.5rem; }
    .temple-qifu .qifu-office { color: var(--ink-soft); font-size: var(--text-sm); line-height: 1.7; margin: 0.5rem 0 0; }
    .qifu-list { list-style: none; padding: 0; margin: 0.75rem 0 0;
      display: flex; flex-direction: column; gap: 0.4375rem; }
    .qifu-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; }
    .qifu-list a { font-weight: 600; }
    .qifu-role { color: var(--ink-soft); font-size: var(--text-sm); }
    .qifu-more { margin-top: 0.75rem; font-size: var(--text-sm); }
    .qifu-more a { font-weight: 600; }
    /* 沿革照片限高（2026-08-08）：直式照片原本 width:100%/height:auto，桌機實測整張約 1000px 高，
       一張圖就吃掉整個視窗、把下面的內容全部推走。限一個最大高度、object-position 偏上
       （廟門與匾額在上半部，裁下緣不會裁掉主體），比例交給 object-fit。 */
    .temple-photo { margin: 1rem 0 1.5rem; }
    .temple-photo img {
      width: 100%; max-height: 32rem; height: auto;
      object-fit: cover; object-position: center 30%;
      border-radius: 0.25rem; display: block;
    }
    .temple-photo figcaption { margin-top: 0.375rem; }
    .temple-moi-detail { margin-top: 1.5rem; }
    .moi-body { white-space: pre-line; }
    .temple-local-celebrations { margin-top: 1.5rem; }
    .local-celebration-list { list-style: none; padding: 0; margin: 0.75rem 0;
      display: flex; flex-direction: column; gap: 0.5rem; }
    .local-celebration-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; }
    .local-celebration-list .lcdate { color: var(--accent); font-size: var(--text-sm); }
    .local-celebration-list .lcname { color: var(--ink); }
    .temple-deity-festivals { margin-top: 1.5rem; }
    .deity-festival-list { list-style: none; padding: 0; margin: 0.75rem 0 0;
      display: flex; flex-direction: column; gap: 0.5rem; }
    .deity-festival-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; }
    .deity-festival-list .dfdate { color: var(--ink-soft); font-size: var(--text-sm); }
    .festival-list { list-style: none; padding: 0; margin: 0.75rem 0 0;
      display: flex; flex-direction: column; gap: 0.625rem; }
    .festival-list li { display: grid; grid-template-columns: 11rem 1fr; gap: 0.25rem 0.75rem;
      padding-bottom: 0.5rem; border-bottom: 1px dashed var(--line); }
    .festival-list .fdate { color: var(--accent); font-weight: 600; font-size: var(--text-sm); }
    .festival-list .fname { font-weight: 600; }
    .festival-list .fdesc { grid-column: 2; color: var(--ink-soft); font-size: var(--text-sm); line-height: 1.7; }
    .festival-list .fsame { grid-column: 2; font-size: var(--text-sm); }
    @media (max-width: 32rem) {
      .festival-list li { grid-template-columns: 1fr; }
      .festival-list .fdesc { grid-column: 1; }
      .festival-list .fsame { grid-column: 1; }
    }
    .nearby { margin-top: 1.875rem; }
    .nearby-list { list-style: none; padding: 0; margin: 0.625rem 0 0;
      display: flex; flex-direction: column; gap: 0.4375rem; }
    .region-link { margin-top: 1.5rem; font-size: var(--text-sm); }
    .region-link a { font-weight: 600; }
    .temple-site { margin-top: 1.25rem; font-size: var(--text-sm); }
    .temple-site a { font-weight: 600; }
    .src { color: var(--gold); font-size: var(--text-xs); margin-top: 1.875rem; line-height: 1.9; }
  </style>
</Base>
