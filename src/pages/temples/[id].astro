---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import TempleMap from '../../components/TempleMap.astro';
import { getTemples, getDeities, getEvents, getSystems } from '../../lib/queries';
import { breadcrumb, faqPage, templePlace } from '../../lib/seo';
import { templeCounty, templeTownship } from '../../lib/temple-region';
import { lunarDateLabel } from '../../lib/birthdays';
import {
  pickMainFestival,
  sortFestivals,
  festivalDateLabel,
  festivalSentence,
  isGenericFestivalName,
} from '../../lib/temple-festival.ts';

export const getStaticPaths = (async () => {
  const temples = await getTemples();
  // 廟名頻率表：名稱在全站唯一者才用「廟名」嵌入 Google 地圖（顯示含星等的商家卡片，
  // 且不會解析到別間同名廟）；同名廟改用座標嵌入，精準釘位不指錯。見 TempleMap.astro。
  const nameCount = new Map<string, number>();
  for (const t of temples) nameCount.set(t.data.name, (nameCount.get(t.data.name) ?? 0) + 1);

  // 在地脈絡（2026-07-28）：GSC 抽驗顯示廟宇頁約 12% 未索引（推估 810 頁），落在最單薄那批——
  // 一頁只有名稱/地址/主祀神，內鏈 4 條，且 7891 頁彼此高度相似。這裡補的兩樣都**每頁不同**
  // 且**純由既有資料衍生**：①該鄉鎮的宮廟總數與同主祀神間數 ②同鄉鎮的鄰近宮廟連結。
  // 刻意不引用神明節點的 summary——那會讓數百間同主祀的廟出現一模一樣的段落，反而加重重複內容。
  const byTown = new Map<string, typeof temples>();
  for (const t of temples) {
    const c = templeCounty(t.data.district), tw = templeTownship(t.data.district);
    if (!c || !tw) continue;
    const key = `${c.slug}/${tw.name}`;
    (byTown.get(key) ?? byTown.set(key, []).get(key)!).push(t);
  }

  return temples.map((t) => {
    const c = templeCounty(t.data.district), tw = templeTownship(t.data.district);
    const inTown = c && tw ? (byTown.get(`${c.slug}/${tw.name}`) ?? []) : [];
    const deityKey = t.data.main_deity_ref ?? t.data.main_deity_raw;
    const sameDeityInTown = deityKey
      ? inTown.filter((x) => (x.data.main_deity_ref ?? x.data.main_deity_raw) === deityKey).length
      : 0;
    // 鄰近宮廟：同鄉鎮、排除自己，優先已查證沿革／官網者（那些頁最值得被爬到），
    // 其餘依廟名排序後取滿 5 間——排序固定＝每次 build 結果一致，不是隨機挑。
    const neighbors = inTown
      .filter((x) => x.id !== t.id)
      .sort((a, b) => {
        const w = (x: typeof a) => (x.data.history || x.data.website || x.data.founded ? 0 : 1);
        return w(a) - w(b) || a.data.name.localeCompare(b.data.name);
      })
      .slice(0, 5)
      .map((x) => ({ id: x.id, name: x.data.name, deity: x.data.main_deity_raw ?? '' }));

    return {
      params: { id: t.id },
      props: {
        temple: t,
        uniqueName: nameCount.get(t.data.name) === 1,
        townTotal: inTown.length,
        sameDeityInTown,
        neighbors,
      },
    };
  });
}) satisfies GetStaticPaths;

const { temple, uniqueName, townTotal, sameDeityInTown, neighbors } = Astro.props;
const t = temple.data;
const deities = await getDeities();
const deityName = new Map(deities.map((d) => [d.id, d.data.name]));
const deityData = new Map(deities.map((d) => [d.id, d.data]));
const systems = await getSystems();
const systemName = new Map(systems.map((s) => [s.id, s.data.name]));
const events = await getEvents();
// 此廟主辦之活動（host_temple 對映 temple.id）
const hostedEvents = events.filter((e) => e.data.host_temple === temple.id);
const refOk = t.main_deity_ref && deityName.has(t.main_deity_ref);
// 上行連結：縣市→鄉鎮二級樞紐（給爬蟲/讀者橫向出口，不建廟對廟密網）。
const county = templeCounty(t.district);
const township = templeTownship(t.district);
// 名廟沿革（#1 內容豐化）：有沿革才顯示沿革區塊。
const hasHistory = !!(t.founded || t.history || t.main_festival);

// P1-4 AEO：廟宇資料稀疏，僅就有資料者生問答。
const mainDeity = t.main_deity_raw ?? (refOk ? deityName.get(t.main_deity_ref!) : '');

// 求籤入口（主題集群邊）：把廟宇頁流量（全站曝光大宗）以 1 跳導入高 CTR 的籤詩集群。
// 僅取主祀神既有的 deity↔籤系 對映（無對映或無籤系則不顯示），不補任何新事實。
const lingqianSystems = refOk ? (deityData.get(t.main_deity_ref!)?.divination_systems ?? []) : [];

// 主祀神聖誕（農曆）：僅取 deity 節點既有 birthday_lunar 中 kind==='聖誕' 者，轉中文標籤；無源不補。
const birthdayLunar = refOk
  ? ((deityData.get(t.main_deity_ref!)?.birthday_lunar ?? []).find((b: { kind?: string; date?: string }) => b.kind === '聖誕')?.date ?? '')
  : '';
const birthdayLabel = birthdayLunar ? lunarDateLabel(birthdayLunar) : '';

// 年度慶(祭)典（內政部全國宗教資訊網，2,500 間）。這是**該廟向政府登記的自家祭典**，
// 與「主祀神聖誕」（神明的生日）不同——故可以標「主要祭典」，不算替廟方斷言。
// 代表筆的挑選與句子生成一律走 lib，頁面不自行判斷（gate 與 OG 卡走同一支）。
const todayIso = new Date().toISOString().slice(0, 10);
const festivalList = sortFestivals(t.festivals ?? []);
const mainFestival = pickMainFestival(t.festivals);
// 已查證的敘述句（21 間）優先於 MOI 短語；兩者皆無則空字串。
const festivalLine = t.main_festival
  ? `${t.name}的主要祭典為${t.main_festival}。`
  : mainFestival
    ? festivalSentence(t.name, mainFestival, todayIso)
    : '';

// answer-first 摘要（全體廟頁皆有）：純用既有欄位重組，緊扣「XX宮是什麼廟／在哪／拜誰」搜尋意圖，絕不補新事實。
const regionLabelForSummary = county ? `${county.name}${township?.name ?? ''}` : (t.district ?? '');
const historyFirstSentence = t.history ? (t.history.split(/(?<=[。！？])/)[0] ?? '').trim() : '';
const summaryText = [
  `${t.name}`,
  regionLabelForSummary ? `位於${regionLabelForSummary}` : '',
  mainDeity ? `，主祀${mainDeity}` : '',
  birthdayLabel ? `（聖誕${birthdayLabel}）` : '',
  lingqianSystems.length > 0 ? '，可線上求籤解籤' : '',
  '。',
  historyFirstSentence ? `${historyFirstSentence}${/[。！？]$/.test(historyFirstSentence) ? '' : '。'}` : '',
].join('');

// 在地脈絡句：每個「鄉鎮×主祀神」組合都不同，是這頁真正獨有的一句話（純由既有資料算出）。
// 資料不足（無鄉鎮、該鎮只有這一間、無主祀神）就整句不出現，不硬湊。
const townLabel = township?.name ?? '';
const townContext = townLabel && townTotal > 1
  ? `${townLabel}登記在案的宮廟共 ${townTotal} 間` +
    (mainDeity && sameDeityInTown > 1 ? `，其中主祀${mainDeity}者 ${sameDeityInTown} 間。` : '。')
  : '';

// speakable 對全體廟頁生效：以頁首 .summary 直答區塊為主（不再只限有沿革者）。
const speakable = ['h1', '.summary'];

// 廟宇頁 meta description（原本無此 prop、全站落回首頁通用文案，
// 與搜尋詞如「台南○○宮」不匹配）：僅用既有欄位（縣市鄉鎮／主祀／沿革）組成，不補新事實。
const regionLabel = county ? `${county.name}${township?.name ?? ''}` : '';
const introBits = [regionLabel && `位於${regionLabel}`, mainDeity && `主祀${mainDeity}`].filter(Boolean);
// 2026-07-30：原本的尾句是「神酷（folk.tw）廟宇資料庫收錄，資料源自內政部全國宗教資訊網。」——
// `history` 只有 22/7891 間有，其餘 ~7,869 間全落回這句**一字不差的樣板**，
// 對「台南○○宮」這類查詢毫無資訊量（GSC 實測廟宇頁 CTR 僅 1.76%）。
// 改為依序取「每頁天然不同」的既有衍生資料：沿革首句 → 主祀神聖誕 → 鄉鎮脈絡（間數/同主祀數）→ 可求籤。
// 全部來自既有欄位與 build 期聚合，**不新增任何事實**；真的都沒有才留最後那句通用語。
// 2026-07-31：慶(祭)典匯入後，2,500 間廟有了**該廟自己登記的年度祭典**。
// 它排在主祀神聖誕之前，因為那是這間廟獨有的事實，而聖誕是全台同主祀神數百間廟共用的日期；
// 且有祭典時就不再輸出聖誕句——兩者常是同一天（如「天上聖母聖誕」對農曆三月廿三），會重複。
const descTail = [
  historyFirstSentence ? `${historyFirstSentence}${/[。！？]$/.test(historyFirstSentence) ? '' : '。'}` : '',
  festivalLine,
  !festivalLine && birthdayLabel && mainDeity ? `${mainDeity}聖誕為${birthdayLabel}。` : '',
  townContext,
  lingqianSystems.length > 0 ? '本站提供主祀神靈籤的白話解籤。' : '',
]
  .filter(Boolean)
  .join('');
const templeDesc = `${t.name}${introBits.length ? introBits.join('，') + '。' : '。'}${
  descTail || '資料源自內政部全國宗教資訊網。'
}`;

// 廟宇頁 title：原本僅 t.name，導致大量同名廟（慶安宮／福德宮…）落回完全相同標題、無在地辨識度。
// 全站 7891 廟 100% 具 district，加上鄉鎮地名可消歧並強化在地搜尋匹配（僅用既有欄位，不補新事實）。
//
// 2026-07-31 再加「主祀○○」：GSC 實測廟宇頁佔全站曝光 91%，但前十名 CTR 只有產業基準的
// 0.17–0.42 倍，而第 11 名以後是正常的 0.99 倍——差別在於廟名查詢的 SERP 上方有 Google 地圖包
// 吃走點擊。在地圖包旁邊唯一能贏的是「地圖不提供的資訊」，且主祀神直接命中
// 「○○宮 主祀／拜什麼」這類**沒有地圖包**的修飾詞長尾。仍只用既有欄位，不補新事實。
//
// ⚠️ 兩道清洗規則不可省（`main_deity_raw` 是 MOI 原始欄位，很髒）：
//   ① 逗號分隔取首位——有廟登記了 7 尊（「虎爺將軍,韋馱佛祖,註生娘娘,關聖帝君…」），全塞進 title 無意義；
//      首位過長（>8 全形字）則回退到已對映的神明節點短名，再不行就整段不加。
//   ② 組出來超過 30 全形字就整段退回原樣，**不截字**——截字會把「｜神酷」切成半個詞。
// 實測：7,801/7,891（98.9%）加得上，中位數 20 全形字、p90 24、超過 30 字者 3 頁。
const TITLE_MAX = 30;
const TITLE_DEITY_MAX = 8;
const fullWidth = (s: string) => [...s].reduce((n, c) => n + (/[\x00-\xff]/.test(c) ? 0.5 : 1), 0);
const titleDeity = (() => {
  const first = (t.main_deity_raw ?? '').split(/[,，、;；]/)[0].trim();
  if (first && fullWidth(first) <= TITLE_DEITY_MAX) return first;
  const node = refOk ? deityName.get(t.main_deity_ref!) : '';
  return node && fullWidth(node) <= TITLE_DEITY_MAX ? node : '';
})();
const titleHead = regionLabel ? `${t.name}・${regionLabel}` : (t.district ? `${t.name}・${t.district}` : t.name);
const titleWithDeity = titleDeity ? `${titleHead}・主祀${titleDeity}` : titleHead;
// 站名「｜神酷」由 Base.astro 附加，長度判斷須把它算進去。
const templeTitle = fullWidth(`${titleWithDeity}｜神酷`) > TITLE_MAX ? titleHead : titleWithDeity;

// FAQ（AEO）：全數就既有欄位出題，faqPage 會過濾空答；無資料的題目不生，絕不杜撰。
const lingqianNames = lingqianSystems.map((s) => systemName.get(s.id) ?? s.id);
const festivalOrHistory = festivalLine
  ? festivalLine
  : historyFirstSentence
    ? `${historyFirstSentence}${/[。！？]$/.test(historyFirstSentence) ? '' : '。'}`
    : '';
const faq = faqPage([
  {
    q: `${t.name}主祀哪位神明？`,
    a: mainDeity
      ? `${t.name}主祀${mainDeity}${birthdayLabel ? `，聖誕為${birthdayLabel}` : ''}。`
      : '',
  },
  {
    q: `${t.name}在哪裡？`,
    a: regionLabelForSummary ? `${t.name}位於${regionLabelForSummary}。` : (t.district ? `${t.name}位於${t.district}。` : ''),
  },
  {
    q: `${t.name}可以求籤嗎？`,
    a: lingqianNames.length > 0 ? `可以。${t.name}主祀${mainDeity}，可線上查閱${lingqianNames.join('、')}與白話解籤。` : '',
  },
  {
    // 泛稱名（「祭典」「祀慶」等 756 間）的答句是「年度祭典在<日期>」＝答的是時間，
    // 故問句也要問時間，否則「主要祭典是什麼？」配上一個日期＝答非所問。
    q: !festivalLine
      ? `${t.name}的沿革為何？`
      : !t.main_festival && mainFestival && isGenericFestivalName(mainFestival.name)
        ? `${t.name}的年度祭典在什麼時候？`
        : `${t.name}的主要祭典是什麼？`,
    a: festivalOrHistory,
  },
]);

const jsonLd = [
  templePlace({
    id: temple.id,
    name: t.name,
    deity: mainDeity || undefined,
    address: t.district,
    lat: t.lat,
    lng: t.lng,
    website: t.website,
  }),
  breadcrumb([
    { name: '廟宇', path: '/temples/' },
    { name: t.name, path: `/temples/${temple.id}/` },
  ]),
  ...(faq ? [faq] : []),
];
---

<Base
  title={templeTitle}
  description={templeDesc}
  ogTitle={templeTitle}
  ogImage={`/og/temples/${encodeURIComponent(t.id)}.png`}
  ogImageAlt={`${t.name}${regionLabel ? `・${regionLabel}` : ''}`}
  ogType="article"
  jsonLd={jsonLd}
  speakable={speakable}
>
  <nav class="crumb">
    <a href="/temples/">廟宇</a>
    {county && <> ／ <a href={`/temples/region/${county.slug}/`}>{county.name}</a></>}
    {county && township && <> ／ <a href={`/temples/region/${county.slug}/${township.name}/`}>{township.name}</a></>}
  </nav>
  <h1>{t.name}</h1>

  <p class="summary">{summaryText}</p>

  <dl class="rec">
    {t.district && <div><dt>行政區</dt><dd>{t.district}</dd></div>}
    <div>
      <dt>主祀神祇</dt>
      <dd>
        {t.main_deity_raw}
        {refOk ? (
          <span> · <a href={`/deities/${t.main_deity_ref}/`}>{deityName.get(t.main_deity_ref!)}（圖譜）</a></span>
        ) : (
          t.main_deity_raw && <span class="muted small"> · 未對映神明節點</span>
        )}
      </dd>
    </div>
    {
      t.lng != null && t.lat != null && (
        <div>
          <dt>座標</dt>
          <dd>
            {t.lat}, {t.lng}
            <a class="map" href={`https://www.openstreetmap.org/?mlat=${t.lat}&mlon=${t.lng}#map=17/${t.lat}/${t.lng}/`} target="_blank" rel="noopener">地圖 ↗</a>
          </dd>
        </div>
      )
    }
  </dl>

  {t.lng != null && t.lat != null && <TempleMap name={t.name} lat={t.lat} lng={t.lng} uniqueName={uniqueName} />}

  {
    lingqianSystems.length > 0 && (
      <section class="temple-lingqian">
        <h2>到{t.name}求籤</h2>
        <p class="muted small">{mainDeity}的靈籤，可線上查閱籤詩與白話解籤：</p>
        <ul>
          {lingqianSystems.map((s) => (
            <li><a href={`/systems/${s.id}/`}>{systemName.get(s.id) ?? s.id}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  {
    hasHistory && (
      <section class="temple-history">
        <h2>沿革</h2>
        {t.founded && <p class="founded"><strong>創建</strong>　{t.founded}</p>}
        {t.history && <p class="history-body">{t.history}</p>}
        {t.main_festival && <p class="festival"><strong>主要祭典</strong>　{t.main_festival}</p>}
      </section>
    )
  }

  {
    festivalList.length > 0 && (
      <section class="temple-festivals">
        <h2>年度祭典</h2>
        <p class="muted small">
          以下為{t.name}向內政部登記的年度慶(祭)典。農曆日期為廟方登記值，括號內國曆為下一次對應日期。
        </p>
        <ul class="festival-list">
          {festivalList.map((f) => (
            <li>
              <span class="fdate">{festivalDateLabel(f, todayIso)}</span>
              <span class="fname">{f.name}</span>
              {f.desc && <span class="fdesc">{f.desc}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    hostedEvents.length > 0 && (
      <section>
        <h2>主辦民俗活動</h2>
        <ul>
          {hostedEvents.map((e) => (
            <li><a href={`/events/${e.id}/`}>{e.data.name}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  {
    neighbors.length > 0 && county && township && (
      <section class="nearby">
        <h2>{township.name}的其他宮廟</h2>
        {townContext && <p class="muted small">{townContext}</p>}
        <ul class="nearby-list">
          {neighbors.map((n) => (
            <li>
              <a href={`/temples/${n.id}/`}>{n.name}</a>
              {n.deity && <span class="muted small">　主祀 {n.deity}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {county && township && (
    <p class="region-link"><a href={`/temples/region/${county.slug}/${township.name}/`}>查看{county.name}{township.name}其他廟宇 →</a></p>
  )}
  {county && !township && (
    <p class="region-link"><a href={`/temples/region/${county.slug}/`}>查看{county.name}全部廟宇 →</a></p>
  )}

  {t.website && <p class="temple-site"><a href={t.website} target="_blank" rel="noopener">官方網站 →</a></p>}

  {t.sources.length > 0 && <p class="src"><Sources sources={t.sources} /></p>}

  <style>
    .crumb { color: var(--ink-soft); font-size: var(--text-sm); margin-bottom: 0.625rem; }
    .summary { font-size: var(--text-base); line-height: 1.8; margin: 0.75rem 0 1.25rem; }
    .rec { display: grid; gap: 0.5rem; margin: 1.25rem 0; }
    .rec > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.625rem; padding: 0.375rem 0; border-bottom: 1px dashed var(--line); }
    .rec dt { font-weight: 700; color: var(--accent); }
    .rec dd { margin: 0; }
    .map { margin-left: 0.75rem; font-size: var(--text-sm); }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; }
    .small { font-size: var(--text-sm); }
    .temple-history { margin-top: 1.5rem; }
    .temple-history .history-body { line-height: 1.8; }
    .temple-history .founded, .temple-history .festival { margin: 0.5rem 0; }
    .temple-history strong { color: var(--accent); margin-right: 0.375rem; }
    .temple-festivals { margin-top: 1.5rem; }
    .festival-list { list-style: none; padding: 0; margin: 0.75rem 0 0;
      display: flex; flex-direction: column; gap: 0.625rem; }
    .festival-list li { display: grid; grid-template-columns: 11rem 1fr; gap: 0.25rem 0.75rem;
      padding-bottom: 0.5rem; border-bottom: 1px dashed var(--line); }
    .festival-list .fdate { color: var(--accent); font-weight: 600; font-size: var(--text-sm); }
    .festival-list .fname { font-weight: 600; }
