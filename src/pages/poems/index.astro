---
import Base from '../../layouts/Base.astro';
import LeadVisual from '../../components/LeadVisual.astro';
import PoemShelf from '../../components/PoemShelf.astro';
import { getPoems, getSystems, systemHref } from '../../lib/queries';
import { HUB } from '../../lib/breadcrumbs';

const poems = await getPoems();
// 首數多的籤系在前（2026-08-08 改）：原本是由小到大，於是月老籤（27 首）排第一、
// 六十甲子籤這個旗艦系統被埋在第三段，而整頁有 16,000px 高，使用者根本捲不到。
const systems = (await getSystems()).sort((a, b) => b.data.count - a.data.count);
const systemHrefOf = await systemHref();
// 依籤系分組
const bySystem = new Map<string, typeof poems>();
for (const p of poems) {
  const id = p.data.system.id;
  (bySystem.get(id) ?? bySystem.set(id, []).get(id)!).push(p);
}
for (const list of bySystem.values()) list.sort((a, b) => a.data.no - b.data.no);
// GEO：列表頁 BreadcrumbList（P3）
---

<Base title="籤詩解碼" description="六十甲子籤、關聖帝君靈籤：四句本文、卦頭故事典故、白話賞析與分項解。" crumbs={[HUB.poems]}>
  <h1>籤詩解碼</h1>
  {/* 2026-08-08：導言原本把籤系用「與」串成「A與B與C與D」，四個「與」讀起來卡；
      而且那句同時兼著「跳到某個籤系」的導覽功能，可是它長得就是一句話。
      拆成兩件事：句子只講這頁有什麼，跳轉獨立成一排看得出可以點的按鈕。 */}
  {/* 套數＝全站有籤的籤系（2026-08-16 用戶抓錯）：原本只數本頁陳列的（poems 集合），
      有自有樞紐的籤系（藥籤住 /medicine-slips/，籤文不進 poems 集合）被漏數成 4。
      正確母體是 systems 資料本身；樞紐型籤系不在本頁攤開，但要列在跳轉列（連去它的樞紐），
      句子和按鈕才對得上「共 N 套」。 */}
  <p class="muted">共 {systems.filter((s) => s.data.count > 0).length} 套籤系：四句本文、卦頭故事典故、白話賞析與分項解。</p>
  <LeadVisual visual="qian-slips" alt="竹籤、紙卷與印記構成的籤詩通用插圖" />
  <PoemShelf />
  <nav class="sys-jumps" aria-label="跳到籤系">
    {systems
      .filter((s) => s.data.count > 0)
      .map((s) => {
        const shelved = (bySystem.get(s.id)?.length ?? 0) > 0;
        return (
          <a class="sys-jump" href={shelved ? `#${s.id}` : systemHrefOf(s.id)}>
            {s.data.name}<span class="n">{shelved ? bySystem.get(s.id)!.length : s.data.count}</span>
          </a>
        );
      })}
  </nav>
  <p class="allusion-link"><a href="/allusions/">看全部卦頭典故總覽 →</a></p>
  {
    systems.map((s) => {
      const list = bySystem.get(s.id) ?? [];
      if (list.length === 0) return null;
      return (
        <section id={s.id} class="sys">
          <h2>
            <a href={systemHrefOf(s.id)}>{s.data.name}</a>
            <span class="count muted">（{list.length} 首）</span>
          </h2>
          <div class="grid cols poem-grid">
            {list.map((p) => (
              <a class="poem-cell card" href={`/poems/${p.id}/`}>
                <span class="no">第 {p.data.no} 籤</span>
                <span class="gz">
                  {p.data.ganzhi ?? p.data.title}
                  {p.data.gua && ` · ${p.data.gua}`}
                  {!p.data.ganzhi && p.data.fortune && ` · ${p.data.fortune}`}
                </span>
                <span class="first muted">{p.data.lines[0]}…</span>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }
  <style>
    .sys-jumps { display: flex; flex-wrap: wrap; gap: 0.625rem; margin: 1rem 0 1.25rem; }
    .sys-jump {
      display: inline-flex; align-items: baseline; gap: 0.5rem;
      padding: 0.4375rem 1rem; border-radius: 999px;
      border: 1px solid var(--line); background: var(--paper-2);
      color: var(--ink); font-size: var(--text-sm);
    }
    .sys-jump:hover { border-color: var(--accent-soft); color: var(--accent); text-decoration: none; }
    .sys-jump .n { color: var(--ink-soft); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
    .sys { scroll-margin-top: 1rem; }
    h2 { border-bottom: 1px solid var(--accent-soft); padding-bottom: 0.375rem; margin-top: 2.25rem; }
    .count { font-size: var(--text-sm); font-weight: 400; }
    .poem-grid { margin-top: 1.25rem; }
    .poem-cell { display: flex; flex-direction: column; gap: 0.25rem; }
    .poem-cell .no { font-weight: 700; color: var(--ink); }
    .poem-cell .gz { color: var(--accent); font-size: var(--text-sm); }
    .poem-cell .first { font-size: var(--text-sm); }
  </style>
</Base>
