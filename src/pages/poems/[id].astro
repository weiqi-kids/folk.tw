---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import { getPoems, getAllusions, getSystems, interpretationById, allusionNameById, deitiesBySystem, poemsBySystem, systemHref } from '../../lib/queries';
import { breadcrumb, poemWork, faqPage } from '../../lib/seo';
import { stripOuterParens, withoutTerminalPunctuation } from '../../lib/text';

export const getStaticPaths = (async () => {
  const poems = await getPoems();
  const interps = await interpretationById();
  return poems.map((p) => ({ params: { id: p.id }, props: { poem: p, interp: interps.get(p.id) } }));
}) satisfies GetStaticPaths;

const { poem, interp } = Astro.props;
const d = poem.data;

// 宮廟合作主題（2026-08-14，P1）：?temple= 命中合作白名單 → client script 換上該廟專屬背景與落款，
// 並送 poem_open 歸因事件（與求籤頁 P0 同一套 temple 維度）。一般訪客（無參數）完全不受影響、
// 頁面靜態輸出不變（SEO 中性）。機制與連結慣例見 docs/temple-partner-links.md。
import partners from '../../data/temple-partners.json';
const partnerMap = Object.fromEntries(
  (partners as { temple: string; name: string; active: boolean; theme: { bg: string; credit: string } }[])
    .filter((p) => p.active)
    .map((p) => [p.temple, { name: p.name, bg: p.theme.bg, credit: p.theme.credit }]),
);

const allusions = await getAllusions();
const allusionById = new Map(allusions.map((a) => [a.id, a]));
const allusionName = await allusionNameById(); // 不過濾 draft，供顯示典故名
const systems = await getSystems();
const systemName = new Map(systems.map((s) => [s.id, s.data.name]));
const systemHrefOf = await systemHref();

// 接通「籤詩↔神明」子圖：採用本籤系之神明（直連神明頁）。
const deitiesForSystem = (await deitiesBySystem()).get(d.system.id) ?? [];
// 前後籤導覽：同系統依籤序，避免籤頁成為孤點。
const sysPoems = (await poemsBySystem()).get(d.system.id) ?? [];
const curIdx = sysPoems.findIndex((p) => p.id === poem.id);
const prevPoem = curIdx > 0 ? sysPoems[curIdx - 1] : null;
const nextPoem = curIdx >= 0 && curIdx < sysPoems.length - 1 ? sysPoems[curIdx + 1] : null;
const poemLabel = (p: typeof poem) => `第 ${p.data.no} 籤${(p.data.ganzhi || p.data.title) ? ` · ${p.data.ganzhi ?? p.data.title}` : ''}`;

// 白話賞析（版面主角，§0.5）＝ interpretation md body；八項分項解 ＝ frontmatter（次級）
const ai = interp?.data ?? {};
const ASPECTS = ['運勢', '求財', '姻緣', '六甲', '功名', '訴訟', '疾病', '行人', '失物'] as const;
const interpVals = ai as Record<string, string | undefined>;
const hasAnyInterp = ASPECTS.some((a) => interpVals[a]);
const hasShangxi = interp ? (interp.body ?? '').trim().length > 0 : false;
const ShangxiContent = interp && hasShangxi ? (await render(interp)).Content : null;

// SEO：每頁唯一描述（四句＋卦頭典故＋系統）；GEO：CreativeWork＋BreadcrumbList
const label = d.ganzhi ?? d.title ?? '';
const sysName = systemName.get(d.system.id) ?? '';
const firstAllusionName = d.allusions[0] ? allusionName.get(d.allusions[0].ref.id) : '';
const firstAllusionNote = d.allusions[0]?.note ?? '';
const pageDesc =
  `${sysName}第 ${d.no} 籤${label ? `「${label}」` : ''}${d.fortune ? `（${d.fortune}）` : ''}：` +
  `${d.lines.join('，')}。` +
  `${firstAllusionName ? `卦頭典故「${firstAllusionName}」${firstAllusionNote ? `，${withoutTerminalPunctuation(firstAllusionNote)}` : ''}。` : ''}白話賞析與八項分項解。`;
const ld: object[] = [
  poemWork({ id: poem.id, no: d.no, label, systemName: sysName, lines: d.lines, fortune: d.fortune }),
  breadcrumb([
    { name: '籤詩', path: '/poems/' },
    { name: sysName, path: systemHrefOf(d.system.id) },
    { name: `第 ${d.no} 籤`, path: `/poems/${poem.id}/` },
  ]),
];

// answer-first 一行摘要（P1-5）：系統＋第N籤＋干支/題＋吉凶，可被引用為直接答案
const labelGloss = label ? `「${label}」` : '';
const leadAnswer =
  `${sysName}第 ${d.no} 籤${labelGloss}` +
  `${d.fortune ? `，吉凶為${d.fortune}` : ''}` +
  `${firstAllusionName ? `，卦頭典故出自「${firstAllusionName}」` : ''}。`;
const shelfTitle = `${sysName}第 ${d.no} 籤${labelGloss}`;

// FAQPage（AEO，P1-4）：八項分項解即天然問答，逐項對映；空項略過。問題含系統＋第N籤＋label，利精準命中
const qlabel = `${sysName}第 ${d.no} 籤${labelGloss}`;
const ASPECT_Q: Record<(typeof ASPECTS)[number], string> = {
  運勢: `${qlabel}的運勢如何？`,
  求財: `${qlabel}求財順利嗎？`,
  姻緣: `${qlabel}的姻緣如何？`,
  六甲: `${qlabel}求子（六甲、生育）如何？`,
  功名: `${qlabel}的功名（考運）如何？`,
  訴訟: `${qlabel}的訴訟結果如何？`,
  疾病: `${qlabel}的疾病能否痊癒？`,
  行人: `${qlabel}問行人（出外的人）何時歸？`,
  失物: `${qlabel}的失物找得回嗎？`,
};
const faqItems = ASPECTS.filter((a) => interpVals[a]?.trim()).map((a) => ({
  q: ASPECT_Q[a],
  a: interpVals[a]!,
}));
const faq = faqPage(faqItems);
if (faq) ld.push(faq);
---

<Base
  title={`${d.lines[0] ? `${d.lines[0]}｜` : ''}${sysName}第 ${d.no} 籤${label ? `（${label}）` : ''}`}
  description={pageDesc}
  jsonLd={ld}
  ogType="article"
  ogImage={`/og/poems/${poem.id}.png`}
  ogImageAlt={`${sysName}第 ${d.no} 籤：${d.lines.join('，')}`}
  speakable={['h1', '.lead']}
>
  <nav class="crumb"><a href="/poems/">籤詩</a> ／ 第 {d.no} 籤</nav>

  <article class="poem-detail">
    <header class="ph">
      <h1>第 {d.no} 籤{(d.ganzhi || d.title) && ` · ${d.ganzhi ?? d.title}`}</h1>
      <div class="meta">
        <a class="tag" href={systemHrefOf(d.system.id)}>{systemName.get(d.system.id)}</a>
        {d.ganzhi && d.title && <span class="tag">{d.title}</span>}
        {d.gua && <span class="tag">{d.gua}卦</span>}
        {/* 擲筊組合（月老籤專屬）：現場是靠三次杯象找到自己那一首，不是抽籤支 */}
        {d.jiaobei && <span class="tag jiaobei">擲筊 {d.jiaobei}</span>}
        {d.wuxing && <span class="tag">{d.wuxing.element}·{d.wuxing.season}·{d.wuxing.direction}</span>}
        {/* 吉凶輔標：小、次級；本系統多無原生定級（A.3-1） */}
        {d.fortune && <span class="tag fortune">{d.fortune}</span>}
        {/* 收藏鈕放標籤列右側（2026-08-15 用戶裁示）；本機性說明歸 /about，不放頁面警語 */}
        <button
          class="save-btn"
          type="button"
          aria-pressed="false"
          data-poem-save
          data-id={poem.id}
          data-title={shelfTitle}
          data-system={sysName}
          data-href={`/poems/${poem.id}/`}
        >收藏這首</button>
      </div>
      {/* answer-first 一行摘要（P1-5）：可被引用為直接答案，仍保克制（小、次於四句主角） */}
      <p class="lead muted">{leadAnswer}</p>
    </header>
    {/* 分享卡（/og/poems/*.png）只作 og:image 用，不內嵌正文（2026-08-15 用戶裁示） */}

    {/* 主角：四句直書 */}
    <section class="lines-block">
      <div class="lines-zhi">
        {d.lines.map((l) => <p class="line">{l}</p>)}
      </div>
    </section>

    {/* 籤版原印的分項解：**照抄籤版、不改寫**，與本站自撰的九項分項解分開陳列。
        各籤版項目名稱與數量都不同（月老籤有福祿/生意/風水），硬套本站九項會變成我們的詮釋。 */}
    {
      d.official_interpretation.length > 0 && (
        <section class="official">
          <h2>籤版所印的分項解</h2>
          <ul class="oi">
            {d.official_interpretation.map((t) => <li>{t}</li>)}
          </ul>
          <p class="src muted small">照錄自籤版，未改寫。<a href="/about/">版本依據與授權說明</a></p>
        </section>
      )
    }

    {/* 白話賞析（版面主角，§0.5）：緊扣四句意象與典故，文化呈現非算命 */}
    {
      ShangxiContent && (
        <section class="shangxi">
          <h2>白話賞析</h2>
          <div class="prose"><ShangxiContent /></div>
        </section>
      )
    }

    {/* 典故（諸說並陳，各掛源） */}
    <section>
      <h2>卦頭故事 · 典故</h2>
      {
        d.allusions.length === 0 ? (
          <p class="pending">本籤典故待補。</p>
        ) : (
          d.allusions.map((a) => {
            const node = allusionById.get(a.ref.id);
            return (
              <div class="card allusion">
                <p class="aname">
                  {node ? (
                    <a href={`/allusions/${a.ref.id}/`}>{node.data.name}</a>
                  ) : (
                    <span>{allusionName.get(a.ref.id) ?? a.ref.id}</span>
                  )}
                  {node?.data.source && <span class="muted">（{stripOuterParens(node.data.source)}）</span>}
                </p>
                {a.note && <p class="muted small">記載：{a.note}</p>}
                {node && (node.body ?? '').trim().length > 0 ? (
                  <p class="muted small"><a href={`/allusions/${a.ref.id}/`}>讀白話故事與跨籤反查 →</a></p>
                ) : (
                  <p class="pending">白話故事撰寫中（公有領域題材，自行敘述後上架）。</p>
                )}
                {a.sources.length > 0 && (
                  <p class="src"><Sources sources={a.sources} /></p>
                )}
              </div>
            );
          })
        )
      }
    </section>

    {/* 分項解（八項） */}
    <section>
      <h2>分項解</h2>
      {
        hasAnyInterp ? (
          <>
            <dl class="interp">
              {ASPECTS.map((a) => (
                <div class="row">
                  <dt>{a}</dt>
                  <dd>{interpVals[a] ?? <span class="pending">待撰</span>}</dd>
                </div>
              ))}
            </dl>
            <p class="src interp-src">本站原創撰寫，<a href="/about/">撰寫原則與授權說明</a></p>
          </>
        ) : (
          <p class="pending">八項分項解待撰。</p>
        )
      }
    </section>

    {
      deitiesForSystem.length > 0 && (
        <section>
          <h2>採用此籤系之神明</h2>
          <ul class="deity-refs">
            {deitiesForSystem.map((dd) => (
              <li>
                <a href={`/deities/${dd.id}/`}>{dd.data.name}</a>
                <span class="muted small">　{dd.data.category}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {d.notes && (
      <section>
        <h2>校訂註記</h2>
        <p class="muted small">{d.notes}</p>
      </section>
    )}

    <nav class="poem-nav" aria-label="籤序導覽">
      {
        prevPoem ? (
          <a class="nav-btn" href={`/poems/${prevPoem.id}/`} rel="prev">‹ {poemLabel(prevPoem)}</a>
        ) : (
          <span class="nav-btn disabled">‹ 已是首籤</span>
        )
      }
      <a class="nav-btn" href={systemHrefOf(d.system.id)}>全部籤</a>
      {
        nextPoem ? (
          <a class="nav-btn" href={`/poems/${nextPoem.id}/`} rel="next">{poemLabel(nextPoem)} ›</a>
        ) : (
          <span class="nav-btn disabled">已是末籤 ›</span>
        )
      }
    </nav>

    <p class="src footer-src">{d.version_source}</p>
  </article>

  <div id="partnerCfg" data-partners={JSON.stringify(partnerMap)} data-poem-no={d.no} data-system={d.system.id} data-lines={d.lines.join('，')} hidden></div>

  <style>
    .crumb { color: var(--ink-soft); font-size: var(--text-sm); margin-bottom: 0.625rem; }
    .ph h1 { margin: 0.25rem 0 0.75rem; }
    .ph .meta { margin-bottom: 0.625rem; }
    .ph .lead { font-size: var(--text-sm); margin: 0.25rem 0 0; }
    .meta .save-btn { font: inherit; font-size: var(--text-sm); font-weight: 700; cursor: pointer; color: var(--accent); background: var(--paper-2); border: 1px solid var(--accent-soft); border-radius: 999px; padding: 0.25rem 0.875rem; }
    .meta .save-btn:hover, .meta .save-btn[aria-pressed="true"] { color: var(--paper); background: var(--accent); border-color: var(--accent); }
    .lines-block { margin: 2.25rem 0 2.75rem; display: flex; justify-content: center; }
    /* 四句直書（直排・右起），§0.5 四句直書
       🔴 flex-direction 一定要是 column，不可省略（2026-08-08 修）：
          在 writing-mode: vertical-rl 之下，flex 的 row＝沿**行內軸**排＝由上往下，
          於是四句被排成上下四段、每段各自再折成好幾欄，讀出來是
          「日出／光明／一向／萬事、便見／清淨／前途／清吉…」——順序全錯、讀不成一首詩；
          在沒有相符明體的機器上還會再退化成整團互相重疊的黑塊。
          column＝沿**區塊軸**排＝右到左，才是四句各佔一欄的直書。
          （已用同一份 CSS 在 Chromium 分別以 row／column 實測比對過。） */
    .lines-zhi {
      writing-mode: vertical-rl;
      text-orientation: upright;
      font-size: var(--text-xl);
      letter-spacing: 0.18em;
      line-height: 2.1;
      max-height: 22.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .lines-zhi .line { margin: 0; }
    @media (max-width: 42.5rem) {
      .lines-zhi { font-size: var(--text-lg); max-height: 18.75rem; }
    }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; margin-top: 2.5rem; }
    .allusion .aname { font-weight: 700; margin: 0 0 0.375rem; }
    .small { font-size: var(--text-sm); }
    .src { color: var(--gold); font-size: var(--text-xs); }
    .jiaobei { letter-spacing: 0.08em; }
    .oi { list-style: none; padding: 0; margin: 0.625rem 0; display: flex; flex-wrap: wrap; gap: 0.5rem 0.875rem; }
    .oi li { padding: 0.25rem 0.625rem; border: 1px solid var(--line); border-radius: 0.25rem; font-size: var(--text-sm); }
    .interp { margin: 0.625rem 0; }
    .interp .row { display: grid; grid-template-columns: 5rem 1fr; gap: 0.625rem; padding: 0.4375rem 0; border-bottom: 1px dashed var(--line); }
    .interp dt { font-weight: 700; color: var(--accent); }
    .interp dd { margin: 0; }
    .deity-refs { list-style: none; padding: 0; }
    .deity-refs li { padding: 0.375rem 0; }
    .poem-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem; margin-top: 2.5rem; }
    .poem-nav .nav-btn {
      padding: 0.375rem 1rem; border: 1px solid var(--line); border-radius: 0.5rem;
      background: var(--paper-2); color: var(--ink); font-size: var(--text-sm);
    }
    .poem-nav .nav-btn:hover { text-decoration: none; border-color: var(--accent-soft); }
    .poem-nav .nav-btn.disabled { color: var(--ink-soft); opacity: 0.45; pointer-events: none; }
    .footer-src { margin-top: 2.5rem; }
  </style>
  {/* 宮廟合作主題的樣式：元素由 client script 注入，必須 is:global 才套得到（check:scoped-styles）。
      背景圖直接設在 body 上（素材透明度內建於 SVG），不另疊 fixed 層——body 有不透明主題底色，
      z-index:-1 的層會被蓋住看不到。 */}
  <style is:global>
    .qian-card { margin: 1rem 0 1.5rem; padding: 0.875rem; border: 1px dashed var(--accent-soft); border-radius: 0.5rem; background: var(--paper-2); }
    .qian-card h3 { margin: 0 0 0.5rem; font-size: var(--text-base); }
    .qian-card .hint { color: var(--ink-soft); font-size: var(--text-xs); margin: 0.375rem 0; }
    .qian-card .row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-top: 0.5rem; }
    .qian-card button, .qian-card a.dl { font: inherit; font-size: var(--text-sm); font-weight: 700; cursor: pointer; color: var(--accent); background: var(--paper); border: 1px solid var(--accent-soft); border-radius: 999px; padding: 0.4375rem 1rem; }
    .qian-card button:disabled { opacity: 0.5; cursor: default; }
    .qian-card.drag { border-style: solid; border-color: var(--accent); background: var(--paper); }
    .qian-card .styles { display: flex; gap: 0.5rem; overflow-x: auto; padding: 0.25rem 0 0.5rem; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
    .qian-card .stylechip { flex: 0 0 auto; padding: 0; border-width: 2px; border-radius: 0.5rem; overflow: hidden; scroll-snap-align: start; }
    .qian-card .stylechip img { display: block; width: 4.5rem; height: 6.75rem; object-fit: cover; }
    .qian-card .stylechip[aria-pressed="true"] { border-color: var(--accent); background: var(--paper); }
    .qian-card .fname { font-size: var(--text-sm); color: var(--ink-soft); overflow-wrap: anywhere; }
    .qian-card .progress { height: 0.5rem; border-radius: 999px; background: var(--line); overflow: hidden; margin-top: 0.75rem; }
    .qian-card .progress i { display: block; height: 100%; width: 0; background: var(--accent); transition: width 0.2s; }
    .qian-card .progress.busy i { width: 100%; animation: qian-pulse 1.2s ease-in-out infinite; }
    @keyframes qian-pulse { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
    .qian-card img.result { max-width: 100%; border-radius: 0.5rem; margin-top: 0.75rem; border: 1px solid var(--line); }
    .qian-card .status { font-size: var(--text-sm); color: var(--ink-soft); }
  </style>
  <script>
    import { emitPoemEvent, isPoemSaved, rememberPoem, toggleSavedPoem } from '../../lib/poem-shelf';

    const button = document.querySelector<HTMLButtonElement>('button[data-poem-save]');
    if (button) {
      const item = {
        id: button.dataset.id!,
        title: button.dataset.title!,
        system: button.dataset.system!,
        href: button.dataset.href!,
      };
      const wasSaved = isPoemSaved(item.id);
      const paint = (saved: boolean) => {
        button.setAttribute('aria-pressed', String(saved));
        button.textContent = saved ? '已收藏 · 取消收藏' : '收藏這首';
      };
      rememberPoem(item);
      if (wasSaved) emitPoemEvent('revisit_saved_poem', item.id, 'poem_detail');
      paint(wasSaved);
      button.addEventListener('click', () => {
        const saved = toggleSavedPoem(item);
        emitPoemEvent(saved ? 'save_poem' : 'unsave_poem', item.id, 'poem_detail');
        paint(saved);
      });
    }

    // ── 宮廟合作主題＋祈福籤詩圖（2026-08-14）────────────────────────────────
    // ?temple= 合法即送 poem_open 歸因事件（temple 維度，與求籤頁 P0 同套）；
    // 再命中合作白名單才換主題與顯示生成器。生成器 UI 只在 api.folk.tw 健康檢查
    // 通過時出現（DNS/服務未就緒前自動隱藏，不需前端旗標）。
    const QIAN_API = 'https://api.folk.tw';
    const cfgEl = document.getElementById('partnerCfg');
    if (cfgEl) {
      const raw = new URLSearchParams(location.search).get('temple') || '';
      const tid = /^[a-z0-9_一-鿿-]{1,80}$/.test(raw) ? raw : '';
      const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
      const partnerData = JSON.parse(cfgEl.dataset.partners || '{}') as Record<string, { name: string; bg: string; credit: string }>;
      const partner = tid ? partnerData[tid] : undefined;
      if (tid && typeof gtag === 'function')
        gtag('event', 'poem_open', { temple: tid, poem_no: Number(cfgEl.dataset.poemNo), system: cfgEl.dataset.system });
      if (partner) {
        // 只換背景、不放落款 banner（2026-08-15 用戶裁示：授權已確認，不需頁面聲明）
        document.body.style.backgroundImage = `url(${partner.bg})`;
        document.body.style.backgroundSize = 'cover';
        document.body.style.backgroundAttachment = 'fixed';
        // 前後籤與「全部籤」帶著 temple 走，離開籤詩區則不帶（避免全站網址被參數污染）
        const qs = `?temple=${encodeURIComponent(tid)}`;
        document.querySelectorAll<HTMLAnchorElement>('.poem-nav a').forEach((a) => {
          a.setAttribute('href', `${a.getAttribute('href')}${qs}`);
        });
        // 祈福籤詩圖生成器：介面一律顯示（2026-08-15 用戶裁示——藏起來等於沒做），
        // 只有「生成」鈕在 API 未就緒時停用並註明。
        mountQianCard(tid, partner.name);
      } else {
        // 無合作廟（2026-08-15）：一般籤詩頁也有生成器——下載走隨機風格端點、
        // 上傳生成不帶 temple（服務端隨機抽 10 種風格之一）。
        mountQianCard('', '');
      }
    }
    function mountQianCard(tid: string, templeName: string) {
      const poemId = (location.pathname.match(/^\/poems\/([^/]+)\//) || [])[1] || '';
      if (!poemId) return;
      const box = document.createElement('section');
      box.className = 'qian-card';
      box.innerHTML = `
        <h3>把這支籤做成你的祈福籤詩圖</h3>
        <p class="hint">選一張照片，或直接把照片拖進這一塊，生成專屬於你的${templeName}祈福籤詩圖，可下載或分享。</p>
        <div class="styles" role="group" aria-label="選擇風格"></div>
        <div class="row">
          <input type="file" accept="image/*" hidden />
          <button type="button" class="pick">選擇照片</button>
          <span class="fname"></span>
          <button type="button" class="go" disabled>生成祈福籤詩圖</button>
          <span class="status" aria-live="polite"></span>
        </div>
        <div class="progress" hidden><i></i></div>`;
      document.querySelector('article.poem-detail .lines-block')?.after(box);
      const input = box.querySelector('input')!;
      const pick = box.querySelector<HTMLButtonElement>('.pick')!;
      const fname = box.querySelector<HTMLElement>('.fname')!;
      const btn = box.querySelector<HTMLButtonElement>('.go')!;
      const status = box.querySelector<HTMLElement>('.status')!;
      const progress = box.querySelector<HTMLElement>('.progress')!;
      const bar = progress.querySelector<HTMLElement>('i')!;
      let apiOk = false;
      let file: File | null = null;
      let styleSel = ''; // 載入時隨機預選一種（2026-08-15 用戶裁示：不設「隨機」格，開頁即隨機）
      const refresh = () => { btn.disabled = !(apiOk && file); };
      // 風格選擇器（2026-08-15 用戶要求：合成時要能自己挑風格）：清單與縮圖來自 API，
      // 之後加新風格不用改前端。合作廟頁選擇只影響「上傳生成」，直接下載仍是廟方版。
      const stylesRow = box.querySelector<HTMLElement>('.styles')!;
      fetch(`${QIAN_API}/v1/styles`)
        .then((r) => r.json())
        .then((list: { key: string; name: string; thumb: string }[]) => {
          if (!list.length) return;
          // 開頁隨機預選一種；只放縮圖不放文字（風格名進 title/aria-label），左右滑動換選。
          styleSel = list[Math.floor(Math.random() * list.length)].key;
          const mk = (key: string, name: string, thumb: string) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'stylechip';
            b.title = name;
            b.setAttribute('aria-label', name);
            const img = new Image();
            img.src = `${QIAN_API}${thumb}`;
            img.alt = name;
            img.loading = 'lazy';
            b.append(img);
            b.setAttribute('aria-pressed', String(key === styleSel));
            b.addEventListener('click', () => {
              styleSel = key;
              stylesRow.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            });
            return b;
          };
          for (const st of list) stylesRow.append(mk(st.key, st.name, st.thumb));
          stylesRow.querySelector('[aria-pressed="true"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
        })
        .catch(() => {});
      const setFile = (f: File | undefined | null) => {
        if (!f || !/^image\//.test(f.type)) return;
        file = f;
        fname.textContent = f.name;
        refresh();
      };
      fetch(`${QIAN_API}/healthz`, { method: 'GET' })
        .then((r) => {
          if (r.ok) { apiOk = true; status.textContent = ''; refresh(); }
          else { status.textContent = '生成服務尚未開通。'; }
          if (!tid) addReady();
        })
        .catch(() => { status.textContent = '生成服務尚未開通。'; });
      // 現成籤詩圖（無照片版）「直接下載」鈕：
      // 合作廟＝cards/ 的預生成圖（HEAD 探測有檔才顯示）；
      // 一般頁＝隨機風格端點（服務有回應就顯示——下載不吃 OpenAI，healthz 503 也能用）。
      const readyUrl = () =>
        tid
          ? `${QIAN_API}/cards/${encodeURIComponent(tid)}/${poemId}.png`
          : `${QIAN_API}/v1/qian-card/${poemId}${styleSel ? `?style=${styleSel}` : ''}`;
      const addReady = () => {
        const ready = document.createElement('button');
        ready.type = 'button';
        ready.textContent = '直接下載籤詩圖';
        ready.addEventListener('click', async () => {
          try {
            const blob = await (await fetch(readyUrl())).blob();
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = tid ? `${templeName}-祈福籤詩.png` : `祈福籤詩-${poemId}.png`;
            a.click();
            const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
            if (typeof gtag === 'function') gtag('event', 'qian_card_ready', { poem_id: poemId, ...(tid ? { temple: tid } : {}), ...(styleSel ? { style: styleSel } : {}) });
          } catch {}
        });
        box.querySelector('.row')?.prepend(ready);
      };
      if (tid) fetch(readyUrl(), { method: 'HEAD' }).then((r) => { if (r.ok) addReady(); }).catch(() => {});
      pick.addEventListener('click', () => input.click());
      input.addEventListener('change', () => setFile(input.files?.[0]));
      // 整塊 qian-card 都吃拖曳（2026-08-15 用戶要求）
      for (const ev of ['dragenter', 'dragover'] as const)
        box.addEventListener(ev, (e) => { e.preventDefault(); box.classList.add('drag'); });
      for (const ev of ['dragleave', 'drop'] as const)
        box.addEventListener(ev, (e) => { e.preventDefault(); box.classList.remove('drag'); });
      box.addEventListener('drop', (e) => setFile(e.dataTransfer?.files?.[0]));
      // 上傳走 XHR：fetch 拿不到上傳進度。上傳期間顯示實際 %，上傳完轉「生成中」脈動。
      const send = () =>
        new Promise<{ status: number; blob: Blob | null }>((resolve, reject) => {
          const fd = new FormData();
          fd.append('photo', file!);
          fd.append('poem', poemId);
          if (tid) fd.append('temple', tid);
          if (styleSel) fd.append('style', styleSel);
          const xhr = new XMLHttpRequest();
          xhr.open('POST', `${QIAN_API}/v1/qian-card`);
          xhr.responseType = 'blob';
          xhr.upload.addEventListener('progress', (e) => {
            if (e.lengthComputable) bar.style.width = `${Math.round((e.loaded / e.total) * 100)}%`;
          });
          xhr.upload.addEventListener('load', () => {
            progress.classList.add('busy');
            status.textContent = '生成中，約需半分鐘…';
          });
          xhr.addEventListener('load', () => resolve({ status: xhr.status, blob: xhr.status === 200 ? xhr.response : null }));
          xhr.addEventListener('error', reject);
          xhr.send(fd);
        });
      btn.addEventListener('click', async () => {
        if (!file) return;
        btn.disabled = true;
        bar.style.width = '0%';
        progress.classList.remove('busy');
        progress.hidden = false;
        status.textContent = '上傳中…';
        try {
          const res = await send();
          progress.hidden = true;
          progress.classList.remove('busy');
          if (res.status !== 200 || !res.blob) {
            status.textContent = res.status === 429 ? '今日生成名額已滿，明天再來。' : '生成失敗，請稍後再試。';
            btn.disabled = false;
            return;
          }
          const blob = res.blob;
          const url = URL.createObjectURL(blob);
          box.querySelector('img.result')?.remove();
          box.querySelector('.row.actions')?.remove();
          const img = new Image();
          img.className = 'result';
          img.alt = '祈福籤詩圖';
          img.src = url;
          box.append(img);
          const actions = document.createElement('div');
          actions.className = 'row actions';
          const dl = document.createElement('a');
          dl.className = 'dl';
          dl.textContent = '下載圖片';
          dl.href = url;
          dl.setAttribute('download', `${templeName}-祈福籤詩.png`);
          actions.append(dl);
          const file2 = new File([blob], 'qian-card.png', { type: 'image/png' });
          if (navigator.canShare?.({ files: [file2] })) {
            const share = document.createElement('button');
            share.type = 'button';
            share.textContent = '分享';
            share.addEventListener('click', () => navigator.share({ files: [file2] }).catch(() => {}));
            actions.append(share);
          }
          box.append(actions);
          status.textContent = '';
          btn.disabled = false;
          const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
          if (typeof gtag === 'function') gtag('event', 'qian_card', { poem_id: poemId, ...(tid ? { temple: tid } : {}), ...(styleSel ? { style: styleSel } : {}) });
        } catch {
          progress.hidden = true;
          progress.classList.remove('busy');
          status.textContent = '生成失敗，請稍後再試。';
          btn.disabled = false;
        }
      });
    }
  </script>
</Base>
