---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import RelatedSeasonalCampaign from '../../components/RelatedSeasonalCampaign.astro';
import { getPractices, getDeities, eventsByDeity } from '../../lib/queries';
import { faqPage, howTo } from '../../lib/seo';
import { HUB } from '../../lib/breadcrumbs';
import { releasedItems } from '../../lib/release-schedule';
import { todayInTaipei } from '../../lib/daily';
import festivals from '../../data/festivals.json';

export const getStaticPaths = (async () => {
  const practices = await getPractices();
  return practices.map((p) => ({ params: { id: p.id }, props: { practice: p } }));
}) satisfies GetStaticPaths;

const { practice } = Astro.props;
const p = practice.data;
const deities = await getDeities();
const deityName = new Map(deities.map((d) => [d.id, d.data.name]));
const deityById = new Map(deities.map((d) => [d.id, d.data]));
const isNode = (id: string) => deityName.has(id);
// 相關民俗活動：經由共同神明關聯（去重），避免習俗頁僅單向連神明。
const eventsByD = await eventsByDeity();
const relatedEvents = [
  ...new Map(p.deities.flatMap((id) => (eventsByD.get(id) ?? []).map((e) => [e.id, e]))).values(),
];
// 相關節日：festivals.json 的 practice_refs 是唯一對到本頁 id 的權威欄位；
// p.festival_ref（上面「關聯節日」）是季節描述文字，非節日代稱，故另開一列放真連結，不動原欄位。
// 🔴 基準日顯式傳進去（2026-08-21）：不帶 today 等於再讀一次「今日」，
// 而同一次 build 內不同頁在不同時刻 render，跨台北午夜就會有頁面用昨天、有頁面用今天。
// 唯一入口＝src/lib/daily.ts 的 todayInTaipei()（已 memoize 成整個 build 的基準日）。
const relatedFestivals = releasedItems(festivals, todayInTaipei().iso).filter((f) => (f.practice_refs as readonly string[] | undefined)?.includes(practice.id));

// 正文代表圖優先使用本習俗自己的授權紀實照。缺圖時只有「栽花換斗」能安全退到
// 已有授權的註生娘娘神像；收驚／入厝沒有足以代表儀式的可信圖，使用站內通用視覺，
// 並在圖說明標非儀式紀實，不拿其他習俗的照片冒充。
const fallbackDeityByPractice: Record<string, string> = { zaihua: 'zhusheng' };
const fallbackDeityId = fallbackDeityByPractice[practice.id];
const deityFallbackImage = fallbackDeityId ? deityById.get(fallbackDeityId)?.image : undefined;
const pageImage = p.image
  ? { ...p.image, genericNote: '' }
  : deityFallbackImage
    ? { ...deityFallbackImage, genericNote: `${deityName.get(fallbackDeityId) ?? '相關神明'}通用神像視覺，非${p.title}儀式紀實。` }
    : {
        src: '/og.png', alt: '神酷站內通用視覺', author: '神酷', license: '', source: '',
        genericNote: `站內通用視覺，非${p.title}儀式紀實。`,
      };
const pageImageWidth = pageImage.src === '/og.png' ? 1200 : 240;
const pageImageHeight = pageImage.src === '/og.png' ? 630 : 240;

// P1-4 AEO：FAQ 由真實資料生成（步驟／供品／禁忌／場合），缺資料自動略過。
const stepLine = p.steps
  .slice()
  .sort((a, b) => a.order - b.order)
  .map((s) => `${s.order}.${s.action}`)
  .join('；');
const supplies = [...p.offerings, ...p.joss_paper];

// P?-? HowTo（程序知識）：每步驟一筆，結合 誰做／用什麼／對誰／禁忌 成可讀句。
const sortedSteps = p.steps.slice().sort((a, b) => a.order - b.order);
const howToSteps = sortedSteps.map((s) => {
  const parts = [s.action];
  if (s.actor) parts.push(`由${s.actor}進行`);
  if (s.items.length) parts.push(`用${s.items.join('、')}`);
  if (s.target) parts.push(`對${s.target}`);
  if (s.note) parts.push(s.note);
  if (s.taboo.length) parts.push(`忌${s.taboo.join('、')}`);
  return { name: s.action || undefined, text: parts.filter(Boolean).join('，') };
});
const howToSupply = [...new Set([...p.offerings, ...p.joss_paper])];
const howToLd = howTo({
  name: p.category ? `${p.title}（${p.category}）` : p.title,
  description: p.summary,
  steps: howToSteps,
  supply: howToSupply.length ? howToSupply : undefined,
});
const faq = faqPage([
  {
    q: `${p.title}怎麼拜？步驟是什麼？`,
    a: stepLine ? `${p.title}的步驟為：${stepLine}。` : '',
  },
  {
    q: `${p.title}要準備什麼供品？`,
    a: supplies.length
      ? `${p.title}常備${p.offerings.length ? `供品${p.offerings.join('、')}` : ''}${p.offerings.length && p.joss_paper.length ? '，' : ''}${p.joss_paper.length ? `金紙${p.joss_paper.join('、')}` : ''}。`
      : '',
  },
  {
    q: `${p.title}有什麼禁忌？`,
    a: p.taboo.length ? `${p.title}的禁忌：${p.taboo.join('；')}。` : '',
  },
  {
    q: `${p.title}什麼時候做？`,
    a: p.occasion ? `${p.title}多於${p.occasion}進行。` : '',
  },
]);

// ⚠️ 這一頁的 FAQPage 排在 HowTo **之前**（歷史寫法），與 Base 的 `faq` prop（一律接在最後）
// 位置不同，改用它會動到線上輸出，故維持自組陣列。
const jsonLd: object[] = [
  ...(faq ? [faq] : []),
  ...(howToLd ? [howToLd] : []),
];
---

<Base
  title={p.title}
  description={p.occasion ? `${p.summary}｜${p.occasion}` : p.summary}
  kind="detail"
  og={{ family: 'visual', stem: 'prayer-light' }}
  jsonLd={jsonLd}
  answer="summary"
  crumbs={[HUB.practices, { name: p.title, path: `/practices/${practice.id}/` }]}
>
  <h1>{p.title}</h1>
  {p.summary && <p class="summary">{p.summary}</p>}
  <RelatedSeasonalCampaign festivalSlugs={relatedFestivals.map((f) => f.slug)} />
  <figure class="entry-photo">
    <img src={pageImage.src} alt={pageImage.alt} width={pageImageWidth} height={pageImageHeight} loading="lazy" decoding="async" />
    <figcaption class="muted small">
      {pageImage.genericNote && <span>{pageImage.genericNote} </span>}
      {
        pageImage.source ? (
          <>
            圖：<a href={pageImage.source} target="_blank" rel="noopener nofollow">{pageImage.author}</a>
            {pageImage.license && (
              <>
                ・{pageImage.license_url
                  ? <a href={pageImage.license_url} target="_blank" rel="noopener nofollow">{pageImage.license}</a>
                  : pageImage.license}
              </>
            )}
          </>
        ) : '圖：神酷站內素材'
      }
    </figcaption>
  </figure>

  <dl class="rec">
    {p.occasion && <div><dt>場合</dt><dd>{p.occasion}</dd></div>}
    {
      p.deities.length > 0 && (
        <div>
          <dt>對應神明</dt>
          <dd>
            {p.deities.map((id, i) => (
              <>
                {i > 0 && '、'}
                {isNode(id) ? <a href={`/deities/${id}/`}>{deityName.get(id)}</a> : <span>{id} <span class="tag">待建</span></span>}
              </>
            ))}
          </dd>
        </div>
      )
    }
    {p.festival_ref.length > 0 && <div><dt>關聯節日</dt><dd>{p.festival_ref.join('、')}</dd></div>}
    {
      relatedFestivals.length > 0 && (
        <div>
          <dt>相關節日活動</dt>
          <dd>
            {relatedFestivals.map((f, i) => (
              <>
                {i > 0 && '、'}
                <a href={`/festivals/${f.slug}/`}>{f.name}</a>
              </>
            ))}
          </dd>
        </div>
      )
    }
    {p.joss_paper.length > 0 && <div><dt>金紙</dt><dd>{p.joss_paper.map((j) => <span class="tag">{j}</span>)}</dd></div>}
    {p.offerings.length > 0 && <div><dt>供品</dt><dd>{p.offerings.map((o) => <span class="tag">{o}</span>)}</dd></div>}
  </dl>

  {/* 《臺灣民俗文物辭典》辭條引文（2026-08-20）：逐字引用、一個字不改寫。
      授權條件就是「標示資料來源連結」，所以來源連結是這一段的必要組成，不是後設警語。
      🔴 規則與神明頁那一段同源（src/pages/deities/[id].astro），改一邊要想到另一邊；
      驗收在不變量 practice/th-dict（逐條驗逐字渲染＋每條各自的連結）。
      擺在「儀節步驟」之前：辭典給的是這套儀式是什麼，讀者要先有定義再看步驟。 */}
  {
    p.th_dict && p.th_dict.length > 0 && (
      <section class="th-dict">
        <h2>辭典裡的{p.title}</h2>
        {p.th_dict.map((q) => (
          <>
            <blockquote class="th-quote">
              {q.excerpt.map((t) => <p>{t}</p>)}
            </blockquote>
            <p class="muted small th-src">
              引自國史館臺灣文獻館《臺灣民俗文物辭典》<a href={q.url} rel="noopener">{q.title}</a>
            </p>
          </>
        ))}
      </section>
    )
  }

  <section>
    <h2>儀節步驟</h2>
    {
      p.steps.length === 0 ? (
        <p class="pending">目前引用的來源沒有記載可逐步還原的儀節順序。</p>
      ) : (
        <ol class="steps">
          {p.steps.map((s) => (
            <li>
              <strong>{s.action}</strong>
              {s.actor && <span class="muted">（{s.actor}）</span>}
              {s.items.length > 0 && <span class="muted small">　用：{s.items.join('、')}</span>}
              {s.note && <div class="muted small">{s.note}</div>}
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section>
    <h2>地區差異</h2>
    {
      p.regional.length === 0 ? (
        <p class="pending">目前引用的來源沒有記載這項習俗的地區差異。</p>
      ) : (
        <ul>
          {p.regional.map((r) => (
            <li><strong>{r.area}</strong>：{r.note} <Sources sources={r.sources} prefix="（" variant="inline">）</Sources></li>
          ))}
        </ul>
      )
    }
  </section>

  {
    relatedEvents.length > 0 && (
      <section>
        <h2>相關民俗活動</h2>
        <ul class="event-refs">
          {relatedEvents.map((e) => (
            <li>
              <a href={`/events/${e.id}/`}>{e.data.name}</a>
              {e.data.region.length > 0 && <span class="muted small">　{e.data.region.join('、')}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Sources sources={p.sources} variant="footer" />

  <style>
    /* 辭典引文：與神明頁的 .moi-quote 同一套視覺（同樣是逐字引文區塊）。 */
    .th-quote { margin: 0.75rem 0 0.5rem; padding: 0 0 0 1rem;
      border-left: 3px solid var(--line); color: var(--ink); }
    .th-quote p { margin: 0 0 0.75rem; }
    .th-quote p:last-child { margin-bottom: 0; }
    .th-src { margin: 0; }
    .summary { font-size: var(--text-base); }
    .entry-photo { margin: 1.25rem 0; }
    .entry-photo img { display: block; width: min(100%, 30rem); height: auto; border-radius: 0.5rem; }
    .entry-photo figcaption { margin-top: 0.375rem; }
    .rec { display: grid; gap: 0.5rem; margin: 1.25rem 0; }
    .rec > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.625rem; padding: 0.375rem 0; border-bottom: 1px dashed var(--line); }
    .rec dt { font-weight: 700; color: var(--accent); }
    .rec dd { margin: 0; }
    h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.375rem; margin-top: 2rem; }
    .small { font-size: var(--text-sm); }
    .steps li { padding: 0.375rem 0; }
    .event-refs { list-style: none; padding: 0; }
    .event-refs li { padding: 0.375rem 0; }
  </style>
</Base>
