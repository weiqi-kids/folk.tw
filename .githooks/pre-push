#!/usr/bin/env bash
# push 前跑一次「快速 gate」——擋的是一個**流程**上的錯，不是某個程式的 bug。
#
# 🔴 為什麼要有這支（2026-08-08 實際發生）：
#   我的順序是「跑 pnpm check:doc-numbers ✓ → 又編輯了一份 docs → commit → push」，
#   於是我回報的「本機 gate 全綠」涵蓋的是**上一版**，而 CI 用最終版跑就紅了。
#   **驗證的效力綁在檔案內容上，不綁在「我今天跑過了」這件事上**——
#   跑完 gate 之後只要再動過任何檔，那次驗證就作廢。
#   人（含我）記不住這件事，所以把它移到 push 這個必經路徑上。
#
# 只跑**快、且純檔案掃描**的那幾道（實測合計約 7 秒）。
# 刻意不跑 `astro check`（約 40 秒）、`verify:almanac`、`build`（約 20 分）——
# 那些留給 CI（🔴 2026-08-19 起 CI 真的有跑 verify:almanac 了，之前這句是空話）。
# 這支的目的是「不要讓明顯的東西溜過去」，不是取代 CI。
#
# 🔴 gate 清單**不寫在這裡**：唯一真實來源是 scripts/lib/gates.mjs
#   （stages 含 'pre-push' 且 needs:'source' 的那些）。以前這裡手抄一份、
#   deploy.yml 手抄一份、CLAUDE.md 手抄一份、check-changed.sh 手抄一份，四份互相矛盾；
#   實害之一：check:anchor-text 吃 dist 卻被列在這裡，而 dist/ 在 .gitignore，
#   本機等於掃一份舊 build 空過（乾淨工作目錄則直接拋錯）。
#
# ⚠️ 已知限制，寫出來免得誤以為它保證了更多：
#   gate 掃的是**工作樹**，不是即將推送的那個 commit。工作樹乾淨時兩者相同（一般情況）；
#   髒的時候只會警告不會擋——因為髒工作樹對 cron 是正常的
#   （qiugian-aggregate-cron 會刻意留著 topical.json 的 WIP 不動它）。
#
# 安裝：`git config core.hooksPath .githooks`（已設定；換機器或重新 clone 要再跑一次）。
# 真的要跳過：`git push --no-verify`——那是刻意的動作，不會不小心發生。

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

# 沒有東西要推（例如純刪除 ref）就不擋。
read -r _local_ref _local_sha _remote_ref _remote_sha || exit 0
[ "${_local_sha:-}" = "0000000000000000000000000000000000000000" ] && exit 0

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "[pre-push] ⚠️ 工作樹有未提交的改動——以下 gate 掃的是工作樹，不是你要推的那個 commit。"
fi

# 🔴 記憶檔的檢查**只能在這裡跑**：記憶目錄不在 repo 裡，CI 上不存在。
#    而它比文件更該守——記憶每個 session 自動載入，過期數字會被當成前提用下去。
if ! out="$(node scripts/check-memory-numbers.mjs 2>&1)"; then
  echo "$out"
  echo "[pre-push] ✗ 記憶檔數字檢查沒過，push 已中止。"
  exit 1
fi

# gate 清單一律從 manifest 讀；讀不到就擋 push（沒有清單＝沒有驗證，不可默默放行）。
if ! _gates_raw="$(node scripts/lib/gates.mjs list pre-push 2>&1)"; then
  echo "$_gates_raw"
  echo "[pre-push] ✗ 讀不到 gate manifest（scripts/lib/gates.mjs），push 已中止。"
  exit 1
fi
mapfile -t GATES <<<"$_gates_raw"
if [ ${#GATES[@]} -eq 0 ] || [ -z "${GATES[0]}" ]; then
  echo "[pre-push] ✗ gate manifest 回了空清單，push 已中止。"
  exit 1
fi

failed=()
for g in "${GATES[@]}"; do
  if ! out="$(pnpm "$g" 2>&1)"; then
    failed+=("$g")
    echo "──────── ✗ $g ────────"
    echo "$out" | tail -25
  fi
done

if [ ${#failed[@]} -gt 0 ]; then
  echo
  echo "[pre-push] ✗ ${#failed[@]} 道 gate 沒過：${failed[*]}"
  echo "[pre-push]   push 已中止。修好再推——CI 會擋同樣的東西，只是要等 20 分鐘才知道。"
  echo "[pre-push]   （真的要跳過：git push --no-verify）"
  exit 1
fi

echo "[pre-push] ✓ ${#GATES[@]} 道快速 gate 通過（astro check／verify:almanac／build 仍由 CI 負責）"
exit 0
